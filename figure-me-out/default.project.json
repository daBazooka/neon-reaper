{
  "name": "FigureMeOut",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "src/shared" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": { "$path": "src/server/Main" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CameraMinZoomDistance": 0.5,
        "CameraMaxZoomDistance": 30,
        "DevCameraOcclusionMode": "Zoom",
        "DevComputerCameraMovementMode": "UserChoice",
        "DevTouchCameraMovementMode": "UserChoice"
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "Client": { "$path": "src/client/Client" }
      }
    },
    "Workspace": { "$className": "Workspace" },
    "Lighting": { "$className": "Lighting", "$properties": { "Technology": "Future" } }
  }
}
