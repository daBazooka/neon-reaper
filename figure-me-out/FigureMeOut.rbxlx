          <Item class="ModuleScript" referent="34">
            <Properties>
              <string name="Name">Keypad</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: the guess keypad. Press G while aiming at someone, type their three digits and it fires by itself.
-- Works with the keyboard and with the on-screen buttons (for phones and tablets).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))
local Rules = require(Shared:WaitForChild("Rules"))
local View = require(script.Parent:WaitForChild("View"))

local Keypad = {}

local C = UI.Colors
local deps
local panel, slotLabels, title, sub
local typed = ""
local target = nil

local DIGIT_KEYS = {}
for i = 0, 9 do
	DIGIT_KEYS[Enum.KeyCode[({ "Zero", "One", "Two", "Three", "Four", "Five", "Six", "Seven", "Eight", "Nine" })[i + 1]]] = tostring(i)
	DIGIT_KEYS[Enum.KeyCode[({ "KeypadZero", "KeypadOne", "KeypadTwo", "KeypadThree", "KeypadFour", "KeypadFive", "KeypadSix", "KeypadSeven", "KeypadEight", "KeypadNine" })[i + 1]]] = tostring(i)
end

function Keypad.isOpen()
	return panel ~= nil and panel.Visible
end

local function redraw()
	for i, l in slotLabels do
		local ch = string.sub(typed, i, i)
		l.Text = ch ~= "" and ch or "_"
		l.TextColor3 = ch ~= "" and C.Text or C.Muted
	end
end

function Keypad.init(gui, d)
	deps = d
	panel = UI.panel(gui, {
		Name = "Keypad",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -90),
		Size = UDim2.fromOffset(300, 292),
		Visible = false,
		ZIndex = 30,
	})
	title = UI.label(panel, {
		Position = UDim2.fromOffset(0, 8),
		Size = UDim2.new(1, 0, 0, 24),
		Font = UI.Fonts.Title,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Accent,
		Text = "WHO IS IT?",
		ZIndex = 31,
	})
	sub = UI.label(panel, {
		Position = UDim2.fromOffset(0, 30),
		Size = UDim2.new(1, 0, 0, 16),
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		Text = "type their 3 digits",
		ZIndex = 31,
	})
	slotLabels = {}
	for i = 1, Config.Number.Digits do
		local box = UI.new("Frame", {
			Position = UDim2.fromOffset(50 + (i - 1) * 68, 52),
			Size = UDim2.fromOffset(60, 52),
			BackgroundColor3 = C.Bg,
			BorderSizePixel = 0,
			ZIndex = 31,
		}, panel)
		UI.corner(box, 10)
		UI.stroke(box, C.Accent, 2)
		slotLabels[i] = UI.label(box, {
			Size = UDim2.fromScale(1, 1),
			Font = UI.Fonts.Title,
			TextSize = 34,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "_",
			ZIndex = 32,
		})
	end
	for n = 1, 10 do
		local digit = n == 10 and 0 or n
		local row, col = math.floor((n - 1) / 3), (n - 1) % 3
		if n == 10 then
			row, col = 3, 1
		end
		local b = UI.button(panel, {
			Position = UDim2.fromOffset(40 + col * 78, 114 + row * 42),
			Size = UDim2.fromOffset(70, 36),
			Text = tostring(digit),
			TextSize = 20,
			BackgroundColor3 = C.Card,
			ZIndex = 31,
		}, "card")
		b.MouseButton1Click:Connect(function()
			Keypad.press(tostring(digit))
		end)
	end
	local back = UI.button(panel, {
		Position = UDim2.fromOffset(40, 114 + 3 * 42),
		Size = UDim2.fromOffset(70, 36),
		Text = "⌫",
		TextSize = 20,
		BackgroundColor3 = C.Card,
		ZIndex = 31,
	}, "card")
	back.MouseButton1Click:Connect(function()
		Keypad.back()
	end)
	local cancel = UI.button(panel, {
		Position = UDim2.fromOffset(196, 114 + 3 * 42),
		Size = UDim2.fromOffset(70, 36),
		Text = "✕",
		TextSize = 20,
		BackgroundColor3 = C.Danger,
		ZIndex = 31,
	})
	cancel.MouseButton1Click:Connect(function()
		Keypad.close()
	end)
end

-- Opens the keypad for whoever is under the crosshair (or for `entity` when given). Returns true when it opened.
function Keypad.open(entity)
	if not panel then
		return false
	end
	if View.phase() ~= "play" or not View.amAlive() then
		return false
	end
	entity = entity or View.aimed()
	if not entity then
		deps.Toasts.push("Aim at someone first", "bad")
		Audio.error()
		return false
	end
	target = entity
	typed = ""
	title.Text = "WHO IS " .. entity.icon .. " " .. string.upper(entity.code) .. "?"
	sub.Text = "type their 3 digits"
	redraw()
	panel.Visible = true
	Audio.click()
	return true
end

function Keypad.close()
	if panel then
		panel.Visible = false
	end
	typed = ""
	target = nil
end

function Keypad.back()
	if #typed > 0 then
		typed = string.sub(typed, 1, #typed - 1)
		redraw()
	end
end

function Keypad.press(ch)
	if not Keypad.isOpen() or #typed >= Config.Number.Digits then
		return
	end
	typed ..= ch
	Audio.play("Click", 1 + #typed * 0.12, 0.5)
	redraw()
	if #typed == Config.Number.Digits then
		Keypad.submit()
	end
end

function Keypad.submit()
	local digits = Rules.parseGuess(typed)
	if not digits or not target then
		return
	end
	local id = target.id
	deps.send("Guess", id, digits)
	deps.Controls.guessSent(target)
	Keypad.close()
end

-- Called with every key press while the keypad is open. Returns true when the key was used.
function Keypad.key(input)
	if not Keypad.isOpen() then
		return false
	end
	local digit = DIGIT_KEYS[input.KeyCode]
	if digit then
		Keypad.press(digit)
		return true
	end
	if input.KeyCode == Enum.KeyCode.Backspace then
		Keypad.back()
		return true
	elseif input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.G then
		Keypad.close()
		return true
	end
	return false
end

return Keypad
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="35">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: the menu window: how to play, forehead plates you unlock by winning, your stats and the settings.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local Menu = {}

local player = Players.LocalPlayer
local C = UI.Colors
local deps
local window, body
local tabs = {} -- name -> { button, page }
local current
local plateCards = {}
local statLabels = {}
local toggles = {}

local TABS = { "How to play", "Plates", "Stats", "Settings" }

local STEPS = {
	{ "🪪", "Everybody has a secret number", "A 3-digit number is printed on every forehead. You can't see yours, but everybody else can." },
	{ "🎯", "Guess to knock people out", "Aim at someone, press G and type THEIR number. Right = they're out. Wrong = you freeze for 3 seconds and lose a bullet." },
	{ "🔭", "Find the numbers", "Hold the right mouse button for binoculars and read digits from across the map. Click to snap a photo: the notebook (V) joins up digits from several photos." },
	{ "💥", "Mess with their eyes", "Flashbangs blind everyone who sees them go off. Smoke grenades make a cloud nobody can see through. Grab 🎁 crates for decoys, scramblers, switcheroos and boots." },
	{ "🚫", "No hiding in corners", "Staring at a wall hides your number, so the game warns you. Ignore it and your number floats above your head for everyone!" },
	{ "👁", "Someone is always watching", "A wrong guess points an arrow at the guesser. In the last 30 seconds THE REVEAL shows every number. Last one standing wins!" },
}

local function page(name)
	local p = UI.new("ScrollingFrame", {
		Name = name,
		Position = UDim2.fromOffset(0, 0),
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		ZIndex = 62,
	}, body)
	return p
end

local function buildHowTo(p)
	UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, p)
	for i, s in STEPS do
		local card = UI.new("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 74), BackgroundColor3 = C.Card, BorderSizePixel = 0, ZIndex = 63 }, p)
		UI.corner(card, 12)
		UI.label(card, { Position = UDim2.fromOffset(8, 8), Size = UDim2.fromOffset(52, 52), Font = UI.Fonts.Title, TextSize = 36, TextXAlignment = Enum.TextXAlignment.Center, Text = s[1], ZIndex = 64 })
		UI.label(card, { Position = UDim2.fromOffset(66, 6), Size = UDim2.new(1, -74, 0, 20), Font = UI.Fonts.Title, TextSize = 15, TextColor3 = C.Accent, Text = s[2], ZIndex = 64 })
		UI.label(card, { Position = UDim2.fromOffset(66, 26), Size = UDim2.new(1, -74, 0, 44), Font = UI.Fonts.Body, TextSize = 12, TextColor3 = C.Muted, TextYAlignment = Enum.TextYAlignment.Top, Text = s[3], ZIndex = 64 })
	end
	local go = UI.button(p, { LayoutOrder = 100, Size = UDim2.new(1, -8, 0, 46), Text = "LET'S GO!", TextSize = 20, BackgroundColor3 = C.Good, ZIndex = 63 })
	go.MouseButton1Click:Connect(function()
		Audio.click()
		deps.send("Seen")
		Menu.close()
	end)
end

local function buildPlates(p)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(190, 118), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, p)
	for i, style in Config.PlateStyles do
		local card = UI.new("TextButton", { LayoutOrder = i, Text = "", AutoButtonColor = false, BackgroundColor3 = C.Card, BorderSizePixel = 0, ZIndex = 63 }, p)
		UI.corner(card, 12)
		local stroke = UI.stroke(card, C.Stroke, 2)
		local preview = UI.new("Frame", { Position = UDim2.fromOffset(34, 12), Size = UDim2.fromOffset(122, 50), BackgroundColor3 = style.Back, BorderSizePixel = 0, ZIndex = 64 }, card)
		UI.corner(preview, 6)
		UI.stroke(preview, style.Rim, 3)
		UI.label(preview, { Size = UDim2.fromScale(1, 1), Font = UI.Fonts.Title, TextSize = 36, TextColor3 = style.Text, TextXAlignment = Enum.TextXAlignment.Center, Text = "472", ZIndex = 65 })
		UI.label(card, { Position = UDim2.fromOffset(0, 68), Size = UDim2.new(1, 0, 0, 20), Font = UI.Fonts.Title, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Center, Text = style.Name, ZIndex = 64 })
		local status = UI.label(card, { Position = UDim2.fromOffset(0, 90), Size = UDim2.new(1, 0, 0, 20), Font = UI.Fonts.Bold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.Muted, Text = "", ZIndex = 64 })
		card.MouseButton1Click:Connect(function()
			if (player:GetAttribute("Wins") or 0) >= style.Wins then
				Audio.click()
				deps.send("Style", style.Id)
			else
				Audio.error()
				deps.Toasts.push("Win " .. style.Wins .. " match" .. (style.Wins == 1 and "" or "es") .. " to unlock " .. style.Name, "bad")
			end
		end)
		plateCards[style.Id] = { card = card, stroke = stroke, status = status, style = style }
	end
end

local function buildStats(p)
	UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, p)
	local rows = {
		{ "Wins", "🏆 Matches won" },
		{ "Streak", "🔥 Win streak" },
		{ "BestStreak", "⭐ Best win streak" },
		{ "Games", "🎮 Matches played" },
		{ "TotalKills", "🎯 Players eliminated" },
	}
	for i, r in rows do
		local row = UI.new("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 52), BackgroundColor3 = C.Card, BorderSizePixel = 0, ZIndex = 63 }, p)
		UI.corner(row, 12)
		UI.label(row, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.7, 0, 1, 0), Font = UI.Fonts.Bold, TextSize = 17, Text = r[2], ZIndex = 64 })
		statLabels[r[1]] = UI.label(row, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -14, 0, 0), Size = UDim2.fromOffset(110, 52), Font = UI.Fonts.Title, TextSize = 26, TextColor3 = C.Gold, TextXAlignment = Enum.TextXAlignment.Right, Text = "0", ZIndex = 64 })
	end
end

local function buildSettings(p)
	UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }, p)
	local rows = {
		{ "Music", "🎵 Music" },
		{ "Sfx", "🔊 Sound effects" },
		{ "Fx", "✨ Screen shake and flashes" },
	}
	for i, r in rows do
		local row = UI.new("Frame", { LayoutOrder = i, Size = UDim2.new(1, -8, 0, 52), BackgroundColor3 = C.Card, BorderSizePixel = 0, ZIndex = 63 }, p)
		UI.corner(row, 12)
		UI.label(row, { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(0.6, 0, 1, 0), Font = UI.Fonts.Bold, TextSize = 17, Text = r[2], ZIndex = 64 })
		local btn = UI.button(row, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(84, 34), Text = "ON", TextSize = 16, BackgroundColor3 = C.Good, ZIndex = 64 })
		btn.MouseButton1Click:Connect(function()
			local value = not (player:GetAttribute(r[1]) ~= false)
			player:SetAttribute(r[1], value)
			deps.send("Setting", r[1], value)
			Audio.click()
			Menu.applySettings()
			Menu.refresh()
		end)
		toggles[r[1]] = btn
	end
end

function Menu.applySettings()
	Audio.setMusic(player:GetAttribute("Music") ~= false)
	Audio.setSfx(player:GetAttribute("Sfx") ~= false)
end

function Menu.init(gui, d)
	deps = d
	window = UI.panel(gui, {
		Name = "Menu",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(470, 480),
		Visible = false,
		ZIndex = 60,
	})
	UI.label(window, { Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -70, 0, 30), Font = UI.Fonts.Title, TextSize = 24, TextColor3 = C.Accent, Text = "FIGURE ME OUT", ZIndex = 61 })
	local close = UI.button(window, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(40, 32), Text = "✕", TextSize = 18, BackgroundColor3 = C.Danger, ZIndex = 61 })
	close.MouseButton1Click:Connect(function()
		Audio.click()
		Menu.close()
	end)
	local tabBar = UI.new("Frame", { Position = UDim2.fromOffset(12, 48), Size = UDim2.new(1, -24, 0, 36), BackgroundTransparency = 1, ZIndex = 61 }, window)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, tabBar)
	body = UI.new("Frame", { Position = UDim2.fromOffset(12, 92), Size = UDim2.new(1, -24, 1, -104), BackgroundTransparency = 1, ZIndex = 61 }, window)
	local builders = { ["How to play"] = buildHowTo, Plates = buildPlates, Stats = buildStats, Settings = buildSettings }
	for _, name in TABS do
		local b = UI.button(tabBar, { Size = UDim2.fromOffset(104, 34), Text = name, TextSize = 13, BackgroundColor3 = C.Card, ZIndex = 62 }, "card")
		local p = page(name)
		builders[name](p)
		tabs[name] = { button = b, page = p }
		b.MouseButton1Click:Connect(function()
			Audio.click()
			Menu.open(name)
		end)
	end
	for _, key in { "Wins", "Streak", "BestStreak", "Games", "TotalKills", "Style", "Music", "Sfx", "Fx" } do
		player:GetAttributeChangedSignal(key):Connect(function()
			Menu.refresh()
			if key == "Music" or key == "Sfx" then
				Menu.applySettings()
			end
		end)
	end
	Menu.applySettings()
end

function Menu.isOpen()
	return window ~= nil and window.Visible
end

function Menu.open(name)
	name = tabs[name] and name or current or "How to play"
	current = name
	window.Visible = true
	for n, t in tabs do
		t.page.Visible = n == name
		t.button.BackgroundColor3 = n == name and C.Accent or C.Card
	end
	Menu.refresh()
end

function Menu.close()
	if window then
		window.Visible = false
	end
end

function Menu.toggle()
	if Menu.isOpen() then
		Menu.close()
	else
		Menu.open(current)
	end
end

function Menu.refresh()
	if not window then
		return
	end
	local wins = player:GetAttribute("Wins") or 0
	local equipped = player:GetAttribute("Style") or "classic"
	for id, c in plateCards do
		local unlocked = wins >= c.style.Wins
		c.card.BackgroundColor3 = unlocked and C.Card or Color3.fromRGB(28, 30, 44)
		c.stroke.Color = id == equipped and C.Good or C.Stroke
		c.stroke.Thickness = id == equipped and 4 or 2
		c.status.Text = id == equipped and "✓ EQUIPPED" or (unlocked and "tap to equip" or ("🔒 " .. c.style.Wins .. " wins"))
		c.status.TextColor3 = id == equipped and C.Good or C.Muted
	end
	for key, label in statLabels do
		label.Text = tostring(player:GetAttribute(key) or 0)
	end
	for key, btn in toggles do
		local on = player:GetAttribute(key) ~= false
		btn.Text = on and "ON" or "OFF"
		btn.BackgroundColor3 = on and C.Good or C.Disabled
	end
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">OwnPlate</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: you must never see your own forehead number. The plate is hidden on your screen only; everybody else
-- still sees it.
local Players = game:GetService("Players")

local OwnPlate = {}

local player = Players.LocalPlayer
local conn

local function hide(inst)
	if inst.Name == "NumberPlate" or inst.Name == "PlateRim" then
		inst.Transparency = 1
	elseif inst.Name == "PlateGui" then
		inst.Enabled = false
	end
end

local function watch(char)
	if conn then
		conn:Disconnect()
	end
	for _, d in char:GetDescendants() do
		hide(d)
	end
	conn = char.DescendantAdded:Connect(hide)
end

function OwnPlate.init()
	if player.Character then
		watch(player.Character)
	end
	player.CharacterAdded:Connect(watch)
end

return OwnPlate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">Results</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: the scoreboard at the end of every match.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))
local View = require(script.Parent:WaitForChild("View"))

local Results = {}

local player = Players.LocalPlayer
local C = UI.Colors
local deps
local panel, heading, sub, rowsFrame, footer

local MEDALS = { "🥇", "🥈", "🥉" }

function Results.init(gui, d)
	deps = d
	panel = UI.panel(gui, {
		Name = "Results",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 470),
		Visible = false,
		ZIndex = 55,
	})
	heading = UI.label(panel, {
		Position = UDim2.fromOffset(0, 12),
		Size = UDim2.new(1, 0, 0, 40),
		Font = UI.Fonts.Title,
		TextSize = 30,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Gold,
		Text = "",
		ZIndex = 56,
	})
	sub = UI.label(panel, {
		Position = UDim2.fromOffset(0, 54),
		Size = UDim2.new(1, 0, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		Text = "",
		ZIndex = 56,
	})
	rowsFrame = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(14, 86),
		Size = UDim2.new(1, -28, 1, -128),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 5,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		ZIndex = 56,
	}, panel)
	UI.new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4) }, rowsFrame)
	footer = UI.label(panel, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -10),
		Size = UDim2.new(1, 0, 0, 24),
		Font = UI.Fonts.Bold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = C.Muted,
		Text = "",
		ZIndex = 56,
	})
	task.spawn(function()
		while true do
			task.wait(0.25)
			if panel.Visible then
				if View.phase() ~= "results" then
					panel.Visible = false
				else
					footer.Text = "Next match in " .. math.ceil(View.timeLeft() + Config.Match.Intermission) .. "s"
				end
			end
		end
	end)
end

function Results.isOpen()
	return panel ~= nil and panel.Visible
end

-- rows: { { id, rank, label, who, kills, number, alive } }
function Results.show(rows, winnerId)
	if type(rows) ~= "table" then
		return
	end
	for _, c in rowsFrame:GetChildren() do
		if c:IsA("Frame") then
			c:Destroy()
		end
	end
	local myId = player:GetAttribute("EntityId") or player.UserId
	local mine
	for _, r in rows do
		if r.id == myId then
			mine = r
		end
	end
	local winner = rows[1]
	if winnerId == 0 or not winner then
		heading.Text = "NO WINNER"
	elseif winner.id == myId then
		heading.Text = "🏆 YOU WIN!"
	else
		heading.Text = "🏆 " .. winner.label .. " WINS"
	end
	if mine then
		sub.Text = "You finished #" .. mine.rank .. " of " .. #rows .. "  •  " .. mine.kills .. " eliminated"
	else
		sub.Text = "Spectating"
	end
	for _, r in rows do
		local isMe = r.id == myId
		local row = UI.new("Frame", {
			LayoutOrder = r.rank,
			Size = UDim2.new(1, -6, 0, 34),
			BackgroundColor3 = isMe and Color3.fromRGB(34, 84, 100) or C.Card,
			BorderSizePixel = 0,
			ZIndex = 57,
		}, rowsFrame)
		UI.corner(row, 8)
		UI.label(row, {
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.fromOffset(40, 34),
			Font = UI.Fonts.Title,
			TextSize = 18,
			Text = MEDALS[r.rank] or ("#" .. r.rank),
			ZIndex = 58,
		})
		UI.label(row, {
			Position = UDim2.fromOffset(52, 0),
			Size = UDim2.new(0.5, -50, 1, 0),
			Font = UI.Fonts.Bold,
			TextSize = 14,
			TextWrapped = false,
			Text = r.label .. (r.who ~= "Bot" and ("  (" .. r.who .. ")") or ""),
			ZIndex = 58,
		})
		UI.label(row, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -78, 0, 0),
			Size = UDim2.fromOffset(70, 34),
			Font = UI.Fonts.Bold,
			TextSize = 13,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = r.kills .. " out",
			ZIndex = 58,
		})
		UI.label(row, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -8, 0, 0),
			Size = UDim2.fromOffset(60, 34),
			Font = UI.Fonts.Title,
			TextSize = 18,
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Right,
			Text = r.number,
			ZIndex = 58,
		})
	end
	panel.Visible = true
	if winner and winner.id == myId and winnerId ~= 0 then
		Audio.win()
		deps.Fx.announce("VICTORY!", "Last one standing", C.Gold, 0.18)
	end
end

return Results
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">Scope</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: the binoculars. Hold the right mouse button (or Z, or tap the 🔭 slot) to zoom far across the map and
-- read digits off a forehead. You walk slowly while looking through them, and a flashbang knocks them down.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))
local View = require(script.Parent:WaitForChild("View"))

local Scope = {}

local deps
local overlay, range, zoomText
local on = false
local fov = Config.Scope.Fov
local normalSensitivity = 1

function Scope.isOn()
	return on
end

function Scope.init(gui, d)
	deps = d
	overlay = UI.new("Frame", { Name = "Scope", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false, ZIndex = 20 }, gui)
	-- a big circle whose very thick black outline covers everything outside it
	local ring = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(620, 620),
		BackgroundTransparency = 1,
		ZIndex = 20,
	}, overlay)
	UI.corner(ring, 310)
	UI.new("UIStroke", { Color = Color3.new(0, 0, 0), Thickness = 1400, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ring)
	UI.new("UIStroke", { Color = UI.Colors.Accent, Thickness = 3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Transparency = 0.2 }, ring)
	local function line(size, pos)
		UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = size, BackgroundColor3 = UI.Colors.Accent, BackgroundTransparency = 0.25, BorderSizePixel = 0, ZIndex = 21 }, overlay)
	end
	line(UDim2.fromOffset(2, 150), UDim2.fromScale(0.5, 0.5))
	line(UDim2.fromOffset(150, 2), UDim2.fromScale(0.5, 0.5))
	range = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0.5, 90),
		Size = UDim2.fromOffset(300, 30),
		Font = UI.Fonts.Title,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = UI.Colors.Accent,
		Text = "",
		ZIndex = 22,
	})
	zoomText = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0.5, -90),
		Size = UDim2.fromOffset(300, 24),
		Font = UI.Fonts.Bold,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = UI.Colors.Muted,
		Text = "",
		ZIndex = 22,
	})
	task.spawn(function()
		while true do
			task.wait(0.1)
			if on then
				Scope.update()
			end
		end
	end)
end

function Scope.update()
	if not View.amAlive() or View.phase() ~= "play" or (Players.LocalPlayer:GetAttribute("Stunned") == true) then
		Scope.set(false)
		return
	end
	local target, distance = View.aimed()
	if target then
		range.Text = target.icon .. " " .. target.code .. "  •  " .. math.floor(distance + 0.5) .. " m"
	else
		range.Text = ""
	end
	zoomText.Text = "ZOOM x" .. string.format("%.1f", Config.Scope.NormalFov / fov) .. "   (scroll to change)"
end

function Scope.set(value)
	value = value == true
	if value and (not View.amAlive() or View.phase() ~= "play" or deps.Alerts.isBlind()) then
		return
	end
	if value == on then
		return
	end
	on = value
	overlay.Visible = on
	pcall(function()
		Players.LocalPlayer.CameraMode = on and Enum.CameraMode.LockFirstPerson or Enum.CameraMode.Classic
	end)
	deps.Fx.setBaseFov(on and fov or Config.Scope.NormalFov)
	pcall(function()
		if on then
			normalSensitivity = UserInputService.MouseDeltaSensitivity
			UserInputService.MouseDeltaSensitivity = normalSensitivity * math.clamp(fov / Config.Scope.NormalFov * 1.6, 0.2, 1)
		else
			UserInputService.MouseDeltaSensitivity = normalSensitivity
		end
	end)
	deps.send("Scope", on)
	if on then
		Audio.play("Click", 0.8, 0.5)
		Scope.update()
	end
end

function Scope.toggle()
	Scope.set(not on)
end

-- Mouse wheel: positive = zoom in.
function Scope.zoom(direction)
	if not on then
		return
	end
	fov = math.clamp(fov - direction * 2, Config.Scope.MinFov, Config.Scope.MaxFov)
	deps.Fx.setBaseFov(fov)
	Scope.update()
end

return Scope
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Spectate</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: once you are out, you watch the others. The camera follows a living player; press ◀ ▶ (or the arrow
-- keys) to switch to somebody else.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))
local View = require(script.Parent:WaitForChild("View"))

local Spectate = {}

local player = Players.LocalPlayer
local C = UI.Colors
local bar, nameLabel
local watching = nil -- entity id
local active = false

function Spectate.isActive()
	return active
end

function Spectate.init(gui)
	bar = UI.panel(gui, {
		Name = "Spectate",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(400, 56),
		Visible = false,
		ZIndex = 35,
	})
	local function arrow(text, x, step)
		local b = UI.button(bar, {
			Position = UDim2.fromOffset(x, 8),
			Size = UDim2.fromOffset(44, 40),
			Text = text,
			TextSize = 20,
			BackgroundColor3 = C.Card,
			ZIndex = 36,
		}, "card")
		b.MouseButton1Click:Connect(function()
			Audio.click()
			Spectate.cycle(step)
		end)
	end
	arrow("◀", 8, -1)
	arrow("▶", 348, 1)
	nameLabel = UI.label(bar, {
		Position = UDim2.fromOffset(56, 4),
		Size = UDim2.new(1, -112, 1, -8),
		Font = UI.Fonts.Title,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		ZIndex = 36,
	})
	task.spawn(function()
		while true do
			task.wait(0.2)
			Spectate.update()
		end
	end)
end

local function living()
	local list = View.aliveOthers()
	table.sort(list, function(a, b)
		return a.id < b.id
	end)
	return list
end

function Spectate.cycle(step)
	local list = living()
	if #list == 0 then
		return
	end
	local index = 0
	for i, e in list do
		if e.id == watching then
			index = i
		end
	end
	index = (index - 1 + step) % #list + 1
	watching = list[index].id
	Spectate.update()
end

local function restoreCamera()
	local camera = View.camera()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if camera and hum then
		camera.CameraSubject = hum
	end
end

function Spectate.update()
	local phase = View.phase()
	local out = player:GetAttribute("Alive") ~= true and (phase == "play" or phase == "countdown")
	local list = out and living() or {}
	if #list == 0 then
		if active then
			active = false
			watching = nil
			bar.Visible = false
			restoreCamera()
		end
		return
	end
	local target
	for _, e in list do
		if e.id == watching then
			target = e
		end
	end
	if not target then
		target = list[1]
		watching = target.id
	end
	active = true
	bar.Visible = true
	nameLabel.Text = "👁 WATCHING  " .. target.icon .. " " .. target.code
	local camera = View.camera()
	local hum = target.model:FindFirstChildOfClass("Humanoid")
	if camera and hum and camera.CameraSubject ~= hum then
		camera.CameraSubject = hum
	end
end

return Spectate
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: small, calm notifications. Max three at once, identical messages merge into "x2",
-- and they sit above the dock so they never cover the action.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"))

local Toasts = {}

local holder
local active = {} -- list of { frame, text, count, label, token }

local KIND_COLOR = {
	info = UI.Colors.Cyan,
	good = UI.Colors.Good,
	gold = UI.Colors.Gold,
	bad = UI.Colors.Danger,
}

function Toasts.init(gui)
	holder = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.fromOffset(420, 110),
		BackgroundTransparency = 1,
	}, gui)
	UI.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
	}, holder)
end

local order = 0

local function remove(entry)
	local i = table.find(active, entry)
	if i then
		table.remove(active, i)
	end
	UI.tween(entry.frame, 0.25, { BackgroundTransparency = 1 })
	UI.tween(entry.label, 0.25, { TextTransparency = 1 })
	task.delay(0.3, function()
		entry.frame:Destroy()
	end)
end

function Toasts.push(text, kind)
	if not holder then
		return
	end
	local color = KIND_COLOR[kind or "info"] or UI.Colors.Cyan

	for _, entry in active do
		if entry.text == text then
			entry.count += 1
			entry.label.Text = text .. "  x" .. entry.count
			entry.token += 1
			local token = entry.token
			task.delay(2.8, function()
				if entry.token == token and table.find(active, entry) then
					remove(entry)
				end
			end)
			return
		end
	end

	if #active >= 2 then
		remove(active[1])
	end

	order += 1
	local frame = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(10, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	}, holder)
	UI.corner(frame, 13)
	UI.stroke(frame, color, 2, 0)
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, frame)
	local label = UI.label(frame, {
		Size = UDim2.fromOffset(10, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextWrapped = false,
		TextColor3 = UI.Colors.Text,
		Text = text,
	})
	local entry = { frame = frame, text = text, count = 1, label = label, token = 0 }
	table.insert(active, entry)
	task.delay(2.8, function()
		if entry.token == 0 and table.find(active, entry) then
			remove(entry)
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">View</string>
              <string name="Source"><![CDATA[-- FIGURE ME OUT: the client's picture of the match. Reads the attributes the server writes and finds the people in the
-- world, so every screen asks one place "who is there, is it my turn, what am I aiming at".
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Rules = require(Shared:WaitForChild("Rules"))

local View = {}

local player = Players.LocalPlayer
local cache, cacheAt = {}, -1
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

function View.now()
	return workspace:GetServerTimeNow()
end

function View.phase()
	return workspace:GetAttribute("Phase") or "lobby"
end

function View.timeLeft()
	return math.max(0, (workspace:GetAttribute("PhaseEnd") or 0) - View.now())
end

function View.aliveCount()
	return workspace:GetAttribute("Alive") or 0
end

function View.total()
	return workspace:GetAttribute("Total") or 0
end

function View.revealing()
	return workspace:GetAttribute("Reveal") == true
end

function View.camera()
	return workspace.CurrentCamera
end

function View.myHead()
	local char = player.Character
	return char and char:FindFirstChild("Head") or nil
end

function View.myId()
	return player:GetAttribute("EntityId") or player.UserId
end

-- True while I am a living player in the current match.
function View.amAlive()
	return player:GetAttribute("Alive") == true and (View.phase() == "play" or View.phase() == "countdown")
end

local function describe(model, source, alive, decoy)
	local id = source:GetAttribute("EntityId")
	if not id or not model then
		return nil
	end
	local head = model:FindFirstChild("Head")
	if not head then
		return nil
	end
	return {
		id = id,
		model = model,
		head = head,
		code = source:GetAttribute("Code") or "?",
		icon = source:GetAttribute("Icon") or "",
		alive = alive,
		decoy = decoy,
	}
end

-- Everyone in the match (and decoys). Cached for a moment because several screens ask each frame.
function View.entities()
	local now = os.clock()
	if now - cacheAt < 0.12 then
		return cache
	end
	cacheAt = now
	local list = {}
	for _, p in Players:GetPlayers() do
		local e = describe(p.Character, p, p:GetAttribute("Alive") == true, false)
		if e then
			e.player = p
			e.me = p == player
			table.insert(list, e)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, model in bots:GetChildren() do
			local e = describe(model, model, model:GetAttribute("Alive") == true, false)
			if e then
				table.insert(list, e)
			end
		end
	end
	local decoys = workspace:FindFirstChild("Decoys")
	if decoys then
		for _, model in decoys:GetChildren() do
			local e = describe(model, model, true, true)
			if e then
				table.insert(list, e)
			end
		end
	end
	cache = list
	return list
end

function View.byId(id)
	for _, e in View.entities() do
		if e.id == id then
			return e
		end
	end
	return nil
end

function View.aliveOthers()
	local list = {}
	for _, e in View.entities() do
		if e.alive and not e.me and not e.decoy then
			table.insert(list, e)
		end
	end
	return list
end

-- The centre and radius of the smoke cloud a puff belongs to.
function View.cloudOf(puff)
	local center = puff:GetAttribute("CloudCenter")
	local radius = puff:GetAttribute("CloudRadius")
	if center and radius then
		return center, radius
	end
	return puff.Position, puff.Size.X / 2
end

-- Is a wall or a smoke cloud in the way between two points?
function View.blocked(from, to)
	local arena = workspace:FindFirstChild("Arena")
	if arena then
		rayParams.FilterDescendantsInstances = { arena }
		if workspace:Raycast(from, to - from, rayParams) then
			return true
		end
	end
	local smoke = workspace:FindFirstChild("Smoke")
	if smoke then
		for _, s in smoke:GetChildren() do
			local center, radius = View.cloudOf(s)
			if Rules.segmentHitsSphere(from, to, center, radius) then
				return true
			end
		end
	end
	return false
end

-- Who is under the crosshair? Returns (entity, distance) for the closest-to-centre person I could shoot at, or nil.
function View.aimed()
	local head = View.myHead()
	local camera = View.camera()
	if not head or not camera then
		return nil
	end
	local origin, look = camera.CFrame.Position, camera.CFrame.LookVector
	local fov = camera.FieldOfView
	local limit = math.max(1.4, 5 * fov / 70) -- degrees; tighter when zoomed in
	local best, bestAngle, bestDistance
	for _, e in View.entities() do
		if not e.me and (e.alive or e.decoy) then
			local to = e.head.Position - origin
			local distance = to.Magnitude
			if distance > 1 and distance <= Config.Guess.MaxDistance then
				local angle = math.deg(math.acos(math.clamp(to.Unit:Dot(look), -1, 1)))
				if angle <= limit and (not bestAngle or angle < bestAngle) and not View.blocked(origin, e.head.Position) then
					best, bestAngle, bestDistance = e, angle, distance
				end
			end
		end
	end
	return best, bestDistance
end

return View
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="42">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
