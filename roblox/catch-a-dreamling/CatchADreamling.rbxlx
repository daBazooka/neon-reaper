<roblox version="4">
  <Item class="ReplicatedStorage" referent="0">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">Builder</string>
          <string name="Source"><![CDATA[-- Builds a dreamling Model out of plain parts: no meshes or uploaded assets needed.
-- The root part is the body; everything else is welded to it, so moving the root moves the dreamling.

local Config = require(script.Parent:WaitForChild("Config"))
local Logic = require(script.Parent:WaitForChild("Logic"))

local Builder = {}

local function rgb(t: {number}): Color3 return Color3.fromRGB(t[1], t[2], t[3]) end
Builder.rgb = rgb

local function part(parent: Instance, props: {[string]: any}): BasePart
	local p: BasePart = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = false
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Massless = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do if k ~= "Class" and k ~= "Mesh" then (p :: any)[k] = v end end
	if props.Mesh then
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Scale = props.Mesh
		m.Parent = p
	end
	p.Parent = parent
	return p
end

local function weld(a: BasePart, b: BasePart)
	local w = Instance.new("WeldConstraint")
	w.Part0 = a
	w.Part1 = b
	w.Parent = b
end

-- opts.anchored: anchor the root (world dreamlings and jar displays)
-- opts.label: add the floating name tag
-- opts.scale: extra scale on top of the mutation scale
function Builder.build(speciesId: string, mut: string?, opts: {anchored: boolean?, label: boolean?, scale: number?, star: number?}?): Model
	local o = opts or {}
	local sp = Config.SpeciesById[speciesId]
	local rar = Config.RarityById[sp.rarity]
	local model = Instance.new("Model")
	model.Name = sp.name
	local s = sp.size
	local col, col2 = rgb(sp.col), rgb(sp.col2)
	if mut == "golden" then col, col2 = Color3.fromRGB(255, 205, 60), Color3.fromRGB(255, 150, 30) end
	if mut == "galaxy" then col, col2 = Color3.fromRGB(40, 25, 90), Color3.fromRGB(170, 90, 255) end

	local root = part(model, { Name = "Root", Shape = if sp.feat == "square" then Enum.PartType.Block else Enum.PartType.Ball, Size = Vector3.new(s, s, s) * (if sp.feat == "square" then 0.9 else 1), Color = col, Anchored = o.anchored == true, Massless = false })
	if mut == "golden" then root.Material = Enum.Material.Foil end
	if mut == "galaxy" then root.Material = Enum.Material.Neon end
	model.PrimaryPart = root
	local cf = root.CFrame
	local function add(props: {[string]: any}, offset: CFrame): BasePart
		local p = part(model, props)
		p.CFrame = cf * offset
		weld(root, p)
		return p
	end

	-- belly shine and face (front is -Z)
	add({ Name = "Shine", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.28, Color = Color3.new(1, 1, 1), Transparency = 0.45 }, CFrame.new(-s * 0.2, s * 0.28, -s * 0.3))
	for _, side in {-1, 1} do
		add({ Name = "Eye", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.3, Color = Color3.new(1, 1, 1) }, CFrame.new(side * s * 0.2, s * 0.08, -s * 0.38))
		add({ Name = "Pupil", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.16, Color = Color3.fromRGB(25, 15, 45) }, CFrame.new(side * s * 0.2, s * 0.06, -s * 0.5))
		add({ Name = "Glint", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.06, Color = Color3.new(1, 1, 1), Material = Enum.Material.Neon }, CFrame.new(side * s * 0.2 + s * 0.04, s * 0.11, -s * 0.57))
		add({ Name = "Cheek", Color = Color3.fromRGB(255, 120, 160), Size = Vector3.new(s * 0.2, s * 0.1, s * 0.05), Mesh = Vector3.one, Transparency = 0.2 }, CFrame.new(side * s * 0.33, -s * 0.1, -s * 0.4))
	end
	add({ Name = "Mouth", Color = Color3.fromRGB(90, 20, 50), Size = Vector3.new(s * 0.16, s * 0.08, s * 0.05), Mesh = Vector3.one }, CFrame.new(0, -s * 0.12, -s * 0.47))

	local f = sp.feat
	local dark = col2
	if f == "leaf" or f == "sprout" then
		add({ Name = "Stem", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.3, s * 0.07, s * 0.07), Color = Color3.fromRGB(70, 150, 60) }, CFrame.new(0, s * 0.55, 0) * CFrame.Angles(0, 0, math.pi / 2))
		local sides: {number} = if f == "leaf" then {1} else {-1, 1}
		for _, side in sides do
			add({ Name = "Leaf", Color = Color3.fromRGB(110, 220, 90), Size = Vector3.new(s * 0.45, s * 0.12, s * 0.25), Mesh = Vector3.one }, CFrame.new(side * s * 0.18, s * 0.72, 0) * CFrame.Angles(0, 0, side * 0.5))
		end
	elseif f == "antenna" then
		add({ Name = "Stalk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.5, s * 0.06, s * 0.06), Color = dark }, CFrame.new(0, s * 0.68, 0) * CFrame.Angles(0, 0, math.pi / 2))
		local bulb = add({ Name = "Bulb", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.22, Color = Color3.fromRGB(255, 245, 150), Material = Enum.Material.Neon }, CFrame.new(0, s * 0.95, 0))
		local l = Instance.new("PointLight"); l.Color = bulb.Color; l.Range = 8; l.Brightness = 1.5; l.Parent = bulb
	elseif f == "bunny" then
		for _, side in {-1, 1} do
			add({ Name = "Ear", Color = col, Size = Vector3.new(s * 0.22, s * 0.7, s * 0.16), Mesh = Vector3.one }, CFrame.new(side * s * 0.2, s * 0.72, 0) * CFrame.Angles(0, 0, -side * 0.18))
			add({ Name = "EarIn", Color = Color3.fromRGB(255, 190, 220), Size = Vector3.new(s * 0.1, s * 0.5, s * 0.1), Mesh = Vector3.one }, CFrame.new(side * s * 0.2, s * 0.72, -s * 0.05) * CFrame.Angles(0, 0, -side * 0.18))
		end
	elseif f == "cat" then
		for _, side in {-1, 1} do
			add({ Class = "WedgePart", Name = "Ear", Color = dark, Size = Vector3.new(s * 0.08, s * 0.35, s * 0.3) }, CFrame.new(side * s * 0.28, s * 0.5, 0) * CFrame.Angles(0, math.pi / 2 * side, -side * 0.35))
		end
	elseif f == "horns" then
		for _, side in {-1, 1} do
			add({ Name = "Horn", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.4, s * 0.1, s * 0.1), Color = Color3.fromRGB(255, 245, 225) }, CFrame.new(side * s * 0.28, s * 0.55, 0) * CFrame.Angles(0, 0, math.pi / 2 - side * 0.5))
		end
	elseif f == "spikes" then
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			add({ Name = "Spike", Color = dark, Size = Vector3.one * s * 0.22, Material = Enum.Material.Glass, Transparency = 0.1 }, CFrame.new(math.cos(a) * s * 0.35, s * 0.4, math.sin(a) * s * 0.35) * CFrame.Angles(math.pi / 4, a, math.pi / 4))
		end
	elseif f == "drip" then
		for i, x in {-0.25, 0.05, 0.3} do
			add({ Name = "Drip", Shape = Enum.PartType.Ball, Size = Vector3.one * s * (0.16 + i * 0.03), Color = dark, Transparency = 0.15 }, CFrame.new(x * s, -s * 0.5, -s * 0.1))
		end
	elseif f == "cloud" then
		for i = 0, 5 do
			local a = i / 6 * math.pi * 2
			add({ Name = "Puff", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.55, Color = col }, CFrame.new(math.cos(a) * s * 0.42, math.sin(i) * s * 0.1, math.sin(a) * s * 0.42))
		end
	elseif f == "wings" then
		for _, side in {-1, 1} do
			add({ Name = "Wing", Color = dark, Size = Vector3.new(s * 0.9, s * 0.1, s * 0.55), Mesh = Vector3.one, Material = Enum.Material.Neon, Transparency = 0.15 }, CFrame.new(side * s * 0.75, s * 0.15, s * 0.05) * CFrame.Angles(0, 0, side * 0.35))
		end
	elseif f == "halo" then
		for i = 0, 11 do
			local a = i / 12 * math.pi * 2
			add({ Name = "Halo", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.1, Color = Color3.fromRGB(255, 240, 150), Material = Enum.Material.Neon }, CFrame.new(math.cos(a) * s * 0.36, s * 0.72, math.sin(a) * s * 0.36))
		end
	elseif f == "crown" then
		add({ Name = "Band", Shape = Enum.PartType.Cylinder, Size = Vector3.new(s * 0.14, s * 0.62, s * 0.62), Color = Color3.fromRGB(255, 200, 50), Material = Enum.Material.Foil }, CFrame.new(0, s * 0.48, 0) * CFrame.Angles(0, 0, math.pi / 2))
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2
			add({ Name = "Point", Color = Color3.fromRGB(255, 210, 60), Size = Vector3.one * s * 0.14, Material = Enum.Material.Foil }, CFrame.new(math.cos(a) * s * 0.26, s * 0.62, math.sin(a) * s * 0.26) * CFrame.Angles(math.pi / 4, a, math.pi / 4))
		end
		add({ Name = "Gem", Shape = Enum.PartType.Ball, Size = Vector3.one * s * 0.12, Color = Color3.fromRGB(255, 60, 120), Material = Enum.Material.Neon }, CFrame.new(0, s * 0.5, -s * 0.31))
	end

	-- rarity glow and aura
	if rar.order >= 3 or mut then
		local light = Instance.new("PointLight")
		light.Color = if mut == "golden" then Color3.fromRGB(255, 210, 90) else rgb(rar.color)
		light.Range = 6 + rar.order * 2
		light.Brightness = 1 + rar.order * 0.3
		light.Parent = root
	end
	if rar.order >= 4 or mut == "rainbow" or mut == "galaxy" or mut == "disco" then
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(rgb(rar.color), Color3.new(1, 1, 1))
		pe.LightEmission = 1
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, s * 0.18), NumberSequenceKeypoint.new(1, 0) })
		pe.Transparency = NumberSequence.new(0.2, 1)
		pe.Lifetime = NumberRange.new(0.8, 1.6)
		pe.Speed = NumberRange.new(1, 3)
		pe.SpreadAngle = Vector2.new(180, 180)
		pe.Rate = 4 + rar.order * 4
		if mut == "galaxy" then pe.Color = ColorSequence.new(Color3.fromRGB(200, 170, 255), Color3.new(1, 1, 1)); pe.Rate = 30 end
		pe.Parent = root
	end
	if mut == "golden" then
		local sp2 = Instance.new("Sparkles"); sp2.SparkleColor = Color3.fromRGB(255, 220, 90); sp2.Parent = root
	end
	if mut == "rainbow" then model:SetAttribute("Rainbow", true) end
	if mut == "disco" then
		model:SetAttribute("Disco", true)
		root.Material = Enum.Material.Neon
	end
	model:SetAttribute("Species", speciesId)
	model:SetAttribute("Mutation", mut or "")

	-- floating name tag
	if o.label then
		local bb = Instance.new("BillboardGui")
		bb.Name = "Tag"
		bb.Size = UDim2.fromOffset(220, 64)
		bb.StudsOffsetWorldSpace = Vector3.new(0, s * 0.85 + 1.8, 0)
		bb.MaxDistance = if rar.order >= 5 then 600 else 110
		bb.LightInfluence = 0
		bb.Adornee = root
		local function lbl(y: number, h: number, txt: string, color: Color3, bold: boolean)
			local t = Instance.new("TextLabel")
			t.BackgroundTransparency = 1
			t.Size = UDim2.new(1, 0, 0, h)
			t.Position = UDim2.fromOffset(0, y)
			t.Font = if bold then Enum.Font.FredokaOne else Enum.Font.GothamBold
			t.TextScaled = true
			t.Text = txt
			t.TextColor3 = color
			t.TextStrokeTransparency = 0.2
			t.TextStrokeColor3 = Color3.fromRGB(20, 10, 40)
			t.Parent = bb
			return t
		end
		local mutName = if mut then Config.MutationById[mut].name .. " " else ""
		lbl(0, 26, mutName .. sp.name, if mut == "golden" then Color3.fromRGB(255, 210, 70) else Color3.new(1, 1, 1), true)
		lbl(26, 18, string.upper(rar.name), rgb(rar.color), false).Name = "Rarity"
		lbl(44, 18, "+" .. Logic.fmt(Logic.jarIncome({ id = speciesId, mut = mut, star = 1 })) .. " /s", Color3.fromRGB(255, 240, 150), false)
		bb.Parent = root
	end

	local scale = (o.scale or 1) * (if mut == "giant" then 2 else if mut == "tiny" then 0.55 else 1)
	if scale ~= 1 then model:ScaleTo(scale) end
	return model
end

return Builder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- CATCH A DREAMLING! game data. Pure data only (no Roblox types) so it can be unit tested.
-- Colours are {r, g, b} 0-255.

local Config = {}

-- Put your Roblox IDs here after creating them on the Creator Hub.
-- Anything left at 0 is hidden from the in-game store.
Config.GamePasses = {
	DoubleSparkles = 0, -- 2x Sparkles forever
	VIP = 0,            -- +1 bag slot, golden name tag, +10% luck
	AutoCollect = 0,    -- Sparkles go straight to your balance
	SuperLuck = 0,      -- +50% mutation luck
}
Config.Products = {
	LuckPotion = 0,     -- 10 minutes of x2 luck
	SparklePack = 0,    -- 30 minutes of income, instantly
	SummonStarfall = 0, -- starts a Starfall event for the whole server
}

export type Rarity = { id: string, name: string, color: {number}, weight: number, catchTime: number, income: number, order: number }
Config.Rarities = {
	{ id = "C", name = "Common",    color = {190, 210, 230}, weight = 60,    catchTime = 0.6, income = 1,     order = 1 },
	{ id = "U", name = "Uncommon",  color = {110, 235, 130}, weight = 26,    catchTime = 1.0, income = 5,     order = 2 },
	{ id = "R", name = "Rare",      color = {80, 170, 255},  weight = 10,    catchTime = 1.6, income = 18,    order = 3 },
	{ id = "E", name = "Epic",      color = {190, 110, 255}, weight = 3.2,   catchTime = 2.4, income = 70,    order = 4 },
	{ id = "L", name = "Legendary", color = {255, 205, 60},  weight = 0.7,   catchTime = 3.5, income = 320,   order = 5 },
	{ id = "M", name = "Mythic",    color = {255, 70, 120},  weight = 0.09,  catchTime = 5.0, income = 1800,  order = 6 },
	{ id = "S", name = "Secret",    color = {255, 255, 255}, weight = 0.012, catchTime = 7.0, income = 12000, order = 7 },
} :: {Rarity}
Config.RarityById = {} :: {[string]: Rarity}
for _, r in Config.Rarities do Config.RarityById[r.id] = r end

-- feature: extra body parts the builder adds. size: body diameter in studs.
export type Species = { id: string, name: string, rarity: string, col: {number}, col2: {number}, feat: string, size: number, mult: number, lore: string }
Config.Species = {
	{ id = "puffle",   name = "Puffle",       rarity = "C", col = {120, 200, 255}, col2 = {60, 120, 230},  feat = "none",    size = 3,   mult = 1,   lore = "Just a happy little puff." },
	{ id = "mossy",    name = "Mossy",        rarity = "C", col = {130, 220, 120}, col2 = {60, 150, 70},   feat = "leaf",    size = 3,   mult = 1.2, lore = "Grows a leaf when it's proud." },
	{ id = "pebble",   name = "Pebble",       rarity = "C", col = {190, 185, 200}, col2 = {120, 115, 140}, feat = "square",  size = 2.8, mult = 1.4, lore = "Pretends to be a rock. Badly." },
	{ id = "blip",     name = "Blip",         rarity = "C", col = {110, 245, 235}, col2 = {40, 170, 190},  feat = "antenna", size = 2.6, mult = 1.6, lore = "Receives radio from the Moon." },
	{ id = "bunbun",   name = "Bunbun",       rarity = "U", col = {255, 180, 225}, col2 = {240, 100, 170}, feat = "bunny",   size = 3.2, mult = 1,   lore = "Hops in its sleep." },
	{ id = "zappy",    name = "Zappy",        rarity = "U", col = {255, 230, 90},  col2 = {255, 150, 40},  feat = "antenna", size = 3,   mult = 1.2, lore = "Tastes like lemonade lightning." },
	{ id = "leafy",    name = "Leafy",        rarity = "U", col = {170, 255, 120}, col2 = {70, 190, 80},   feat = "sprout",  size = 3.2, mult = 1.4, lore = "Photosynthesises dreams." },
	{ id = "bubbles",  name = "Bubbles",      rarity = "U", col = {150, 235, 255}, col2 = {70, 170, 230},  feat = "drip",    size = 3.4, mult = 1.6, lore = "Pops when surprised. Unpops later." },
	{ id = "frostbite",name = "Frostbite",    rarity = "R", col = {200, 245, 255}, col2 = {110, 190, 255}, feat = "spikes",  size = 3.4, mult = 1,   lore = "Cold hands, warm heart." },
	{ id = "emberkit", name = "Emberkit",     rarity = "R", col = {255, 150, 80},  col2 = {230, 60, 40},   feat = "horns",   size = 3.4, mult = 1.2, lore = "Toasts marshmallows by blinking." },
	{ id = "moonpaw",  name = "Moonpaw",      rarity = "R", col = {180, 140, 255}, col2 = {110, 70, 230},  feat = "cat",     size = 3.4, mult = 1.4, lore = "Only comes out when you blink." },
	{ id = "jellyfizz",name = "Jellyfizz",    rarity = "R", col = {255, 130, 200}, col2 = {200, 60, 160},  feat = "drip",    size = 3.6, mult = 1.6, lore = "Fizzy. Wobbly. Proud of it." },
	{ id = "cloudwhal",name = "Cloud Whale",  rarity = "E", col = {245, 248, 255}, col2 = {170, 185, 230}, feat = "cloud",   size = 4.2, mult = 1,   lore = "Sings to thunderstorms." },
	{ id = "prismo",   name = "Prismo",       rarity = "E", col = {140, 255, 240}, col2 = {90, 140, 255},  feat = "square",  size = 3.8, mult = 1.2, lore = "Made of solid rainbows." },
	{ id = "sirhoot",  name = "Sir Hoot",     rarity = "E", col = {210, 160, 110}, col2 = {140, 90, 60},   feat = "horns",   size = 3.8, mult = 1.4, lore = "Knows every answer. Tells none." },
	{ id = "neonbat",  name = "Neon Bat",     rarity = "E", col = {120, 90, 255},  col2 = {255, 60, 200},  feat = "wings",   size = 3.4, mult = 1.6, lore = "Upside down is its right side up." },
	{ id = "starwhale",name = "Starwhale",    rarity = "L", col = {60, 80, 200},   col2 = {20, 30, 90},    feat = "halo",    size = 5,   mult = 1,   lore = "Swims through the night sky." },
	{ id = "sunking",  name = "Sun King",     rarity = "L", col = {255, 220, 90},  col2 = {255, 140, 40},  feat = "crown",   size = 4.6, mult = 1.2, lore = "Rules the morning. Naps at noon." },
	{ id = "aurorafox",name = "Aurora Fox",   rarity = "L", col = {110, 255, 190}, col2 = {160, 90, 255},  feat = "cat",     size = 4.4, mult = 1.4, lore = "Its tail paints the northern lights." },
	{ id = "dreamdrake",name = "Dream Drake", rarity = "L", col = {255, 120, 150}, col2 = {140, 40, 120},  feat = "wings",   size = 4.8, mult = 1.6, lore = "Breathes bedtime stories." },
	{ id = "voidling", name = "Voidling",     rarity = "M", col = {40, 20, 70},    col2 = {170, 60, 255},  feat = "spikes",  size = 4.6, mult = 1,   lore = "Lives in the space between dreams." },
	{ id = "cosmojelly",name = "Cosmo Jelly", rarity = "M", col = {255, 90, 220},  col2 = {60, 200, 255},  feat = "drip",    size = 5,   mult = 1.3, lore = "Contains a small galaxy. Do not squeeze." },
	{ id = "kaleido",  name = "KALEIDO",      rarity = "S", col = {255, 255, 255}, col2 = {255, 90, 200},  feat = "crown",   size = 5.4, mult = 1,   lore = "Every second, it changes." },
	{ id = "dreamer",  name = "The Dreamer",  rarity = "S", col = {255, 250, 235}, col2 = {255, 210, 120}, feat = "halo",    size = 5.6, mult = 1.4, lore = "Some say it is dreaming all of us." },
} :: {Species}
Config.SpeciesById = {} :: {[string]: Species}
for _, s in Config.Species do Config.SpeciesById[s.id] = s end

export type Mutation = { id: string, name: string, mult: number, chance: number, color: {number}? }
-- chance: per spawn (before events and luck). Giant and Tiny also change size.
Config.Mutations = {
	{ id = "golden",  name = "Golden",  mult = 3,   chance = 0.03,  color = {255, 200, 50} },
	{ id = "rainbow", name = "Rainbow", mult = 6,   chance = 0.01 },
	{ id = "disco",   name = "Disco",   mult = 4,   chance = 0.0 },
	{ id = "galaxy",  name = "Galaxy",  mult = 10,  chance = 0.003, color = {30, 20, 70} },
	{ id = "giant",   name = "Giant",   mult = 2,   chance = 0.02 },
	{ id = "tiny",    name = "Tiny",    mult = 1.5, chance = 0.02 },
} :: {Mutation}
Config.MutationById = {} :: {[string]: Mutation}
for _, m in Config.Mutations do Config.MutationById[m.id] = m end

-- Upgrades bought with Sparkles: cost = base * k ^ level
export type Upgrade = { id: string, name: string, desc: string, base: number, k: number, max: number }
Config.Upgrades = {
	{ id = "netSpeed", name = "Faster Net",   desc = "Catch 13% faster per level",     base = 60,   k = 2.35, max = 12 },
	{ id = "reach",    name = "Longer Net",   desc = "+3 studs catch reach",           base = 90,   k = 2.3, max = 8 },
	{ id = "speed",    name = "Dream Boots",  desc = "+2 walk speed",                  base = 80,   k = 2.2, max = 8 },
	{ id = "bag",      name = "Bigger Bag",   desc = "Carry +1 dreamling at once",     base = 900,  k = 9,   max = 4 },
	{ id = "luck",     name = "Lucky Charm",  desc = "+20% mutation luck when you catch", base = 400, k = 2.5, max = 10 },
} :: {Upgrade}
Config.UpgradeById = {} :: {[string]: Upgrade}
for _, u in Config.Upgrades do Config.UpgradeById[u.id] = u end

Config.StartSlots = 4
Config.MaxSlots = 16
Config.SlotBase = 150
Config.SlotK = 2.6
Config.MaxStar = 5
Config.StarMult = 3            -- each merge star multiplies income by 3
Config.RebirthBase = 1500000
Config.RebirthK = 7
Config.RebirthBonus = 0.5      -- +50% income per rebirth
Config.OfflineRate = 0.5       -- offline earnings at half speed
Config.OfflineCapHours = 8
Config.SellSeconds = 45        -- selling a dreamling pays 45 seconds of its income

-- World and pacing
Config.MaxDreamlings = 22
Config.SpawnEvery = 2.4
Config.DreamlingLife = 95
Config.MeadowRadius = 115
Config.PlotRadius = 205
Config.PlotCount = 8
Config.BaseReach = 12
Config.BaseWalk = 18
Config.EventInterval = 200
Config.EventDuration = 60

-- Server-wide dream events. Effects are applied by the server (world) and the client (visuals).
export type DreamEvent = { id: string, name: string, desc: string, weight: number, color: {number} }
Config.Events = {
	{ id = "disco",   name = "DISCO NIGHT",      desc = "Half of all dreamlings spawn Disco (x4)!", weight = 10, color = {255, 90, 220} },
	{ id = "lowgrav", name = "LOW GRAVITY",      desc = "Jump to the moon!",                        weight = 10, color = {140, 200, 255} },
	{ id = "starfall",name = "STARFALL",         desc = "Legendaries fall from the sky!",           weight = 7,  color = {255, 220, 90} },
	{ id = "golden",  name = "GOLDEN HOUR",      desc = "Golden mutations x8 more likely!",         weight = 10, color = {255, 180, 60} },
	{ id = "candy",   name = "CANDY RAIN",       desc = "Grab the falling candy for Sparkles!",     weight = 10, color = {255, 150, 200} },
	{ id = "giant",   name = "GIANT DREAMLINGS", desc = "Every dreamling spawns Giant (x2)!",       weight = 8,  color = {120, 255, 160} },
	{ id = "speed",   name = "SPEED SURGE",      desc = "Everyone runs twice as fast!",             weight = 9,  color = {255, 110, 90} },
	{ id = "rainbow", name = "RAINBOW STORM",    desc = "Rainbow mutations x15 more likely!",       weight = 7,  color = {190, 120, 255} },
	{ id = "secret",  name = "SECRET HOUR",      desc = "Something strange is watching...",         weight = 2,  color = {30, 20, 60} },
} :: {DreamEvent}
Config.EventById = {} :: {[string]: DreamEvent}
for _, e in Config.Events do Config.EventById[e.id] = e end

-- Daily login rewards: multiples of your income per second (so they stay useful), plus potions.
Config.Daily = {
	{ incomeSecs = 120, min = 100 }, { incomeSecs = 180, min = 200 }, { incomeSecs = 240, min = 400, luckMin = 5 },
	{ incomeSecs = 300, min = 800 }, { incomeSecs = 420, min = 1500 }, { incomeSecs = 600, min = 3000, luckMin = 10 },
	{ incomeSecs = 1200, min = 10000, luckMin = 30 },
}

export type QuestType = { t: string, text: string, n: {number} }
Config.QuestTypes = {
	{ t = "catch",   text = "Catch %d dreamlings",             n = {8, 15, 25} },
	{ t = "rare",    text = "Catch %d Rare or better",         n = {1, 3, 5} },
	{ t = "mutated", text = "Catch %d mutated dreamlings",     n = {1, 2, 3} },
	{ t = "collect", text = "Collect Sparkles %d times",       n = {5, 10, 20} },
	{ t = "merge",   text = "Merge dreamlings %d times",       n = {1, 2, 3} },
	{ t = "event",   text = "Catch %d during a Dream Event",   n = {3, 6, 10} },
	{ t = "upgrade", text = "Buy %d upgrades",                 n = {2, 4, 6} },
} :: {QuestType}

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Logic</string>
          <string name="Source"><![CDATA[-- CATCH A DREAMLING! game rules as pure functions (no Roblox APIs), shared by server and client
-- and unit tested outside Roblox with Lune.

local Logic = {}
local Config = if script then require(script.Parent:WaitForChild("Config")) else nil

function Logic.setConfig(c) Config = c end

export type Jar = { id: string, mut: string?, star: number }

local SUFFIX = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }
function Logic.fmt(n: number): string
	if n ~= n then return "0" end
	if n < 1000 then return tostring(math.floor(n)) end
	local i = 1
	while n >= 1000 and i < #SUFFIX do n /= 1000; i += 1 end
	if n >= 100 then return string.format("%d%s", math.floor(n), SUFFIX[i]) end
	return string.format("%.1f%s", math.floor(n * 10) / 10, SUFFIX[i])
end

function Logic.species(id: string) return Config.SpeciesById[id] end
function Logic.rarity(id: string) return Config.RarityById[Config.SpeciesById[id].rarity] end

-- income per second of one jar
function Logic.jarIncome(jar: Jar): number
	local sp = Config.SpeciesById[jar.id]
	if not sp then return 0 end
	local r = Config.RarityById[sp.rarity]
	local m = if jar.mut then (Config.MutationById[jar.mut] and Config.MutationById[jar.mut].mult or 1) else 1
	return r.income * sp.mult * m * Config.StarMult ^ ((jar.star or 1) - 1)
end

function Logic.incomeMult(rebirths: number, double: boolean): number
	return (1 + rebirths * Config.RebirthBonus) * (if double then 2 else 1)
end

function Logic.totalIncome(jars: {Jar}, rebirths: number, double: boolean): number
	local s = 0
	for _, j in jars do s += Logic.jarIncome(j) end
	return s * Logic.incomeMult(rebirths, double)
end

function Logic.upgradeCost(id: string, lvl: number): number
	local u = Config.UpgradeById[id]
	return math.floor(u.base * u.k ^ lvl)
end
function Logic.slotCost(slots: number): number
	return math.floor(Config.SlotBase * Config.SlotK ^ (slots - Config.StartSlots))
end
function Logic.rebirthCost(rebirths: number): number
	return math.floor(Config.RebirthBase * Config.RebirthK ^ rebirths)
end

function Logic.catchTime(speciesId: string, netLvl: number): number
	return Logic.rarity(speciesId).catchTime * 0.87 ^ netLvl
end
function Logic.reach(lvl: number): number return Config.BaseReach + 3 * lvl end
function Logic.walk(lvl: number): number return Config.BaseWalk + 2 * lvl end
function Logic.bagSize(lvl: number, vip: boolean): number return 1 + lvl + (if vip then 1 else 0) end

-- pick a species for a new spawn. rng() returns [0,1)
function Logic.rollSpecies(rng: () -> number, eventId: string?, minOrder: number?): string
	local total = 0
	local w = {}
	for _, sp in Config.Species do
		local r = Config.RarityById[sp.rarity]
		local weight = r.weight / 1 -- per species share of its rarity is split below
		local n = 0
		for _, other in Config.Species do if other.rarity == sp.rarity then n += 1 end end
		weight /= n
		if eventId == "secret" and r.id == "S" then weight *= 60 end
		if eventId == "secret" and r.id == "M" then weight *= 8 end
		if minOrder and r.order < minOrder then weight = 0 end
		w[#w + 1] = { id = sp.id, w = weight }
		total += weight
	end
	local x = rng() * total
	for _, e in w do
		x -= e.w
		if x <= 0 then return e.id end
	end
	return w[#w].id
end

-- pick a mutation (or nil). luck multiplies every chance.
function Logic.rollMutation(rng: () -> number, eventId: string?, luck: number): string?
	if eventId == "giant" then return "giant" end
	if eventId == "disco" and rng() < 0.5 then return "disco" end
	for _, m in Config.Mutations do
		local c = m.chance * luck
		if eventId == "golden" and m.id == "golden" then c *= 8 end
		if eventId == "rainbow" and m.id == "rainbow" then c *= 15 end
		if rng() < c then return m.id end
	end
	return nil
end

-- merge every group of three identical dreamlings (same species and star) into one with star + 1.
-- the best mutation of the three is kept. Returns the new jar list and how many merges happened.
function Logic.mergeJars(jars: {Jar}): ({Jar}, number)
	local out: {Jar} = {}
	for _, j in jars do table.insert(out, { id = j.id, mut = j.mut, star = j.star or 1 }) end
	local merges = 0
	local changed = true
	while changed do
		changed = false
		local groups: {[string]: {number}} = {}
		for i, j in out do
			if j.star < Config.MaxStar then
				local k = j.id .. "#" .. j.star
				groups[k] = groups[k] or {}
				table.insert(groups[k], i)
			end
		end
		for _, idx in groups do
			if #idx >= 3 then
				local a, b, c = out[idx[1]], out[idx[2]], out[idx[3]]
				local best = a.mut
				for _, x in {a, b, c} do
					local mb = best and Config.MutationById[best] and Config.MutationById[best].mult or 1
					local mx = x.mut and Config.MutationById[x.mut] and Config.MutationById[x.mut].mult or 1
					if mx > mb then best = x.mut end
				end
				local merged: Jar = { id = a.id, mut = best, star = a.star + 1 }
				-- remove the three (highest index first) and put the merged one where the first was
				local rm = { idx[1], idx[2], idx[3] }
				table.sort(rm, function(p, q) return p > q end)
				for _, i in rm do table.remove(out, i) end
				table.insert(out, math.min(idx[1], #out + 1), merged)
				merges += 1
				changed = true
				break
			end
		end
	end
	return out, merges
end

function Logic.offlineEarnings(incomePerSec: number, secondsAway: number): number
	local s = math.clamp(secondsAway, 0, Config.OfflineCapHours * 3600)
	if s < 60 then return 0 end
	return math.floor(incomePerSec * s * Config.OfflineRate)
end

function Logic.sellValue(jar: Jar): number
	return math.floor(Logic.jarIncome(jar) * Config.SellSeconds)
end

function Logic.makeQuests(rng: () -> number, level: number)
	local pool = table.clone(Config.QuestTypes)
	local qs = {}
	local tier = math.clamp(level, 1, 3)
	for _ = 1, 3 do
		local i = math.floor(rng() * #pool) + 1
		local q = table.remove(pool, i)
		if q then
			table.insert(qs, { t = q.t, n = q.n[tier], p = 0, done = false, claimed = false, text = string.format(q.text, q.n[tier]) })
		end
	end
	return qs
end

function Logic.questReward(incomePerSec: number, n: number): number
	return math.max(150, math.floor(incomePerSec * 90 + 50 * n))
end

function Logic.dailyReward(day: number, incomePerSec: number)
	local d = Config.Daily[((day - 1) % #Config.Daily) + 1]
	return math.max(d.min, math.floor(incomePerSec * d.incomeSecs)), d.luckMin or 0
end

return Logic
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="6">
      <Properties>
        <string name="Name">Server</string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Data</string>
          <string name="Source"><![CDATA[-- Player saves in a DataStore. Every call is wrapped so the game still runs in Studio when API access
-- is off (progress just won't persist).

local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Data = {}
local STORE_NAME = "CatchADreamling_v1"
local store: DataStore? = nil
do
	local ok, s = pcall(function() return DataStoreService:GetDataStore(STORE_NAME) end)
	if ok then store = s else warn("[Dreamling] DataStore unavailable, progress will not save:", s) end
end

export type Save = {
	v: number, sparkles: number, unclaimed: number, total: number, rebirths: number,
	up: {[string]: number}, slots: number, jars: {any}, dex: {[string]: number},
	stats: {[string]: number}, quests: {any}, questDay: number, daily: { last: number, streak: number },
	lastSeen: number, luckUntil: number, tut: number, dexClaimed: {[string]: boolean}, receipts: {string},
}

function Data.default(): Save
	return {
		v = 1, sparkles = 0, unclaimed = 0, total = 0, rebirths = 0,
		up = { netSpeed = 0, reach = 0, speed = 0, bag = 0, luck = 0 },
		slots = 4, jars = {}, dex = {},
		stats = { caught = 0, rares = 0, legends = 0, mutated = 0, merges = 0, collects = 0, events = 0 },
		quests = {}, questDay = 0, daily = { last = 0, streak = 0 },
		lastSeen = 0, luckUntil = 0, tut = 0, dexClaimed = {}, receipts = {},
	}
end

-- copy saved values over the defaults so new fields added in updates always exist
local function merge(base: any, src: any): any
	if type(src) ~= "table" then return base end
	for k, v in src do
		local b = base[k]
		if type(b) == "table" and type(v) == "table" and next(b) ~= nil and #b == 0 then
			merge(b, v)
		elseif b == nil or type(b) == type(v) then
			base[k] = v
		end
	end
	return base
end

Data.profiles = {} :: {[Player]: Save}
Data.loaded = {} :: {[Player]: boolean}

local function key(p: Player): string return "p_" .. p.UserId end

function Data.load(p: Player): Save
	local d = Data.default()
	if store then
		for attempt = 1, 3 do
			local ok, res = pcall(function() return (store :: DataStore):GetAsync(key(p)) end)
			if ok then
				if res then d = merge(d, res) end
				Data.loaded[p] = true
				break
			end
			warn("[Dreamling] load failed (attempt " .. attempt .. "):", res)
			local msg = tostring(res)
			if string.find(msg, "Studio", 1, true) or string.find(msg, "publish", 1, true) or string.find(msg, "403", 1, true) then
				-- API access is off (usually Studio): play without saving instead of waiting
				store = nil
				break
			end
			task.wait(1.5 * attempt)
		end
	end
	Data.profiles[p] = d
	return d
end

function Data.save(p: Player, leaving: boolean?)
	local d = Data.profiles[p]
	if not d or not store then return end
	-- never overwrite a save we failed to read
	if not Data.loaded[p] then return end
	d.lastSeen = os.time()
	local ok, err = pcall(function()
		(store :: DataStore):UpdateAsync(key(p), function() return d end)
	end)
	if not ok then warn("[Dreamling] save failed:", err) end
	if leaving then Data.profiles[p] = nil; Data.loaded[p] = nil end
end

function Data.saveAll()
	for p in Data.profiles do task.spawn(Data.save, p) end
end

function Data.startAutosave()
	task.spawn(function()
		while true do
			task.wait(90)
			Data.saveAll()
		end
	end)
	game:BindToClose(function()
		if RunService:IsStudio() and not store then return end
		local left = 0
		for p in Data.profiles do
			left += 1
			task.spawn(function() Data.save(p, true); left -= 1 end)
		end
		local t0 = os.clock()
		while left > 0 and os.clock() - t0 < 25 do task.wait(0.2) end
	end)
end

-- ordered store for the global "most caught" board
local ordered: OrderedDataStore? = nil
pcall(function() ordered = DataStoreService:GetOrderedDataStore("CatchADreamling_Caught_v1") end)
function Data.pushLeaderboard(p: Player, caught: number)
	if not ordered then return end
	pcall(function() (ordered :: OrderedDataStore):SetAsync(key(p), math.floor(caught)) end)
end
function Data.topCaught(n: number): {{name: string, value: number}}
	local out = {}
	if not ordered then return out end
	local ok, pages = pcall(function() return (ordered :: OrderedDataStore):GetSortedAsync(false, n) end)
	if not ok or not pages then return out end
	for _, entry in (pages :: DataStorePages):GetCurrentPage() do
		local id = tonumber(string.sub(entry.key, 3)) or 0
		local name = "?"
		pcall(function() name = game:GetService("Players"):GetNameFromUserIdAsync(id) end)
		table.insert(out, { name = name, value = entry.value })
	end
	return out
end

return Data
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Game</string>
          <string name="Source"><![CDATA[-- Server game mechanics: dreamling spawning and wandering, the catching race, carrying catches home,
-- jars and income, merging, rebirths, quests, and the server-wide Dream Events.

local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local Builder = require(Shared:WaitForChild("Builder"))
local World = require(script.Parent:WaitForChild("World"))
local Data = require(script.Parent:WaitForChild("Data"))

local Game = {}
local rng = Random.new()
local function roll(): number return rng:NextNumber() end

export type Carry = { id: string, mut: string?, visual: Model? }
export type Session = {
	plot: World.Plot?, carry: {Carry}, catching: { model: Model, t0: number, dur: number }?,
	passes: {[string]: boolean}, lastToast: {[string]: number}, income: number,
}
Game.sessions = {} :: {[Player]: Session}
Game.plots = {} :: {World.Plot}
Game.remote = nil :: RemoteEvent?

-- dreamlings in the meadow
type Wild = { model: Model, id: string, mut: string?, born: number, caught: boolean, catchers: {[Player]: boolean}, tween: Tween? }
local wild: {[Model]: Wild} = {}
local wildFolder = Instance.new("Folder"); wildFolder.Name = "Dreamlings"; wildFolder.Parent = workspace

---------------------------------------------------------------- messaging
function Game.send(p: Player, kind: string, ...: any)
	if Game.remote then (Game.remote :: RemoteEvent):FireClient(p, kind, ...) end
end
function Game.sendAll(kind: string, ...: any)
	if Game.remote then (Game.remote :: RemoteEvent):FireAllClients(kind, ...) end
end
function Game.toast(p: Player, text: string, color: {number}?, key: string?, gap: number?)
	local s = Game.sessions[p]
	if key and s then
		local now = os.clock()
		if now - (s.lastToast[key] or -99) < (gap or 3) then return end
		s.lastToast[key] = now
	end
	Game.send(p, "toast", text, color)
end

---------------------------------------------------------------- derived player values
function Game.luck(p: Player): number
	local d, s = Data.profiles[p], Game.sessions[p]
	if not d or not s then return 1 end
	local l = 1 + d.up.luck * 0.2
	if s.passes.SuperLuck then l += 0.5 end
	if s.passes.VIP then l += 0.1 end
	if d.luckUntil > os.time() then l *= 2 end
	return l
end
function Game.bag(p: Player): number
	local d, s = Data.profiles[p], Game.sessions[p]
	return Logic.bagSize(d.up.bag, s ~= nil and s.passes.VIP == true)
end
function Game.income(p: Player): number
	local d, s = Data.profiles[p], Game.sessions[p]
	if not d or not s then return 0 end
	return Logic.totalIncome(d.jars, d.rebirths, s.passes.DoubleSparkles == true)
end

-- full state for the client UI
function Game.sync(p: Player)
	local d, s = Data.profiles[p], Game.sessions[p]
	if not d or not s then return end
	local carry = {}
	for _, c in s.carry do table.insert(carry, { id = c.id, mut = c.mut }) end
	Game.send(p, "sync", {
		sparkles = d.sparkles, unclaimed = d.unclaimed, income = Game.income(p), rebirths = d.rebirths,
		up = d.up, slots = d.slots, jars = d.jars, dex = d.dex, stats = d.stats, quests = d.quests,
		luckUntil = d.luckUntil, luck = Game.luck(p), bag = Game.bag(p), carry = carry, passes = s.passes,
		daily = d.daily, tut = d.tut, dexClaimed = d.dexClaimed,
	})
end

---------------------------------------------------------------- quests
function Game.quest(p: Player, t: string, amount: number?)
	local d = Data.profiles[p]
	if not d then return end
	for _, q in d.quests do
		if q.t == t and not q.done then
			q.p = math.min(q.n, q.p + (amount or 1))
			if q.p >= q.n then q.done = true; Game.toast(p, "Quest complete! Claim it in Quests", {255, 230, 90}) end
		end
	end
end
function Game.refreshQuests(p: Player)
	local d = Data.profiles[p]
	local day = math.floor(os.time() / 86400)
	if d.questDay ~= day or #d.quests == 0 then
		d.questDay = day
		d.quests = Logic.makeQuests(roll, math.clamp(1 + d.rebirths, 1, 3))
	end
end

---------------------------------------------------------------- plots and jars
function Game.assignPlot(p: Player)
	local s = Game.sessions[p]
	for _, plot in Game.plots do
		local taken = false
		for _, other in Game.sessions do if other.plot == plot then taken = true end end
		if not taken then
			s.plot = plot
			plot.sign.Text = p.DisplayName .. "'s Island"
			break
		end
	end
end

function Game.renderPlot(p: Player)
	local d, s = Data.profiles[p], Game.sessions[p]
	if not d or not s or not s.plot then return end
	local plot = s.plot :: World.Plot
	plot.jarFolder:ClearAllChildren()
	for i, ped in plot.slotParts do
		local unlocked = i <= d.slots
		ped.Color = if unlocked then Color3.fromRGB(255, 255, 255) else Color3.fromRGB(120, 110, 140)
		ped.Transparency = if unlocked then 0 else 0.3
		local slotCF = plot.slots[i]
		local jar = d.jars[i]
		if unlocked then
			local glass = World.part(plot.jarFolder, { Name = "Jar", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 6.4, 6.4), CFrame = CFrame.new(slotCF.Position + Vector3.new(0, 3.2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(210, 235, 255), Material = Enum.Material.Glass, Transparency = 0.72, CanCollide = false, CastShadow = false })
			World.part(plot.jarFolder, { Name = "Lid", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 6.8, 6.8), CFrame = CFrame.new(slotCF.Position + Vector3.new(0, 7, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = plot.color, Material = Enum.Material.SmoothPlastic, CanCollide = false })
			if jar then
				local m = Builder.build(jar.id, jar.mut, { anchored = true, scale = 0.7 })
				local h = m:GetExtentsSize().Y
				local fit = math.min(1, 5.2 / math.max(h, m:GetExtentsSize().X))
				if fit < 1 then m:ScaleTo(m:GetScale() * fit) end
				m:PivotTo(slotCF * CFrame.new(0, 3.2, 0))
				m.Parent = plot.jarFolder
				local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(160, 40); bb.StudsOffsetWorldSpace = Vector3.new(0, 8.6, 0); bb.MaxDistance = 70; bb.LightInfluence = 0; bb.Adornee = glass; bb.Parent = glass
				local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.Font = Enum.Font.FredokaOne; t.TextScaled = true
				t.TextColor3 = Color3.fromRGB(255, 240, 150); t.TextStrokeTransparency = 0
				t.Text = string.rep("★", jar.star) .. "  +" .. Logic.fmt(Logic.jarIncome(jar) * Logic.incomeMult(d.rebirths, s.passes.DoubleSparkles == true)) .. "/s"
				t.Parent = bb
				local prompt = Instance.new("ProximityPrompt")
				prompt.ActionText = "Sell for " .. Logic.fmt(Logic.sellValue(jar))
				prompt.ObjectText = (if jar.mut then Config.MutationById[jar.mut].name .. " " else "") .. Config.SpeciesById[jar.id].name
				prompt.HoldDuration = 1.2
				prompt.MaxActivationDistance = 9
				prompt.RequiresLineOfSight = false
				prompt.Parent = glass
				local index = i
				prompt.Triggered:Connect(function(who) if who == p then Game.sell(p, index) end end)
			end
		else
			local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(120, 34); bb.StudsOffsetWorldSpace = Vector3.new(0, 3, 0); bb.MaxDistance = 60; bb.LightInfluence = 0; bb.Adornee = ped; bb.Parent = plot.jarFolder
			local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.Font = Enum.Font.FredokaOne; t.TextScaled = true
			t.TextColor3 = Color3.fromRGB(230, 220, 255); t.TextStrokeTransparency = 0.2; t.Text = "LOCKED"; t.Parent = bb
		end
	end
	plot.sign.Text = p.DisplayName .. "'s Island" .. (if d.rebirths > 0 then "  ✦" .. d.rebirths else "")
end

function Game.freePlot(p: Player)
	local s = Game.sessions[p]
	if s and s.plot then
		(s.plot :: World.Plot).jarFolder:ClearAllChildren()
		;(s.plot :: World.Plot).sign.Text = "Empty island"
		;(s.plot :: World.Plot).income.Text = "COLLECT"
		s.plot = nil
	end
end

function Game.sell(p: Player, index: number)
	local d = Data.profiles[p]
	local jar = d and d.jars[index]
	if not jar then return end
	local v = Logic.sellValue(jar)
	table.remove(d.jars, index)
	d.sparkles += v; d.total += v
	Game.toast(p, "Sold for " .. Logic.fmt(v) .. " Sparkles", {255, 230, 90})
	Game.renderPlot(p); Game.sync(p)
end

function Game.collect(p: Player)
	local d = Data.profiles[p]
	if not d or d.unclaimed < 1 then return end
	local v = math.floor(d.unclaimed)
	d.unclaimed -= v
	d.sparkles += v
	d.stats.collects += 1
	Game.quest(p, "collect")
	Game.send(p, "collect", v)
	Game.sync(p)
end

---------------------------------------------------------------- carrying
local function attachCarry(p: Player, c: Carry, slot: number)
	local char = p.Character
	local head = char and char:FindFirstChild("Head") :: BasePart?
	if not head then return end
	if c.visual then c.visual:Destroy() end
	local m = Builder.build(c.id, c.mut, { scale = 0.42 })
	for _, bp in m:GetDescendants() do if bp:IsA("BasePart") then bp.Massless = true; bp.CanCollide = false; bp.Anchored = false end end
	local root = m.PrimaryPart :: BasePart
	local offsets = { Vector3.new(0, 3.4, 0), Vector3.new(-2.6, 3, 0.4), Vector3.new(2.6, 3, 0.4), Vector3.new(0, 5.6, 0.4), Vector3.new(0, 7.6, 0.4) }
	m:PivotTo(head.CFrame * CFrame.new(offsets[math.clamp(slot, 1, #offsets)]))
	local w = Instance.new("WeldConstraint"); w.Part0 = head; w.Part1 = root; w.Parent = root
	m.Parent = char
	c.visual = m
end
function Game.reattachCarry(p: Player)
	local s = Game.sessions[p]
	if not s then return end
	for i, c in s.carry do attachCarry(p, c, i) end
end

-- drop carried dreamlings into free jars when the player reaches their island
function Game.tryDeposit(p: Player)
	local s, d = Game.sessions[p], Data.profiles[p]
	if not s or not d or #s.carry == 0 or not s.plot then return end
	local char = p.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then return end
	local c = (s.plot :: World.Plot).center
	local flat = Vector3.new(hrp.Position.X - c.X, 0, hrp.Position.Z - c.Z)
	if flat.Magnitude > 31 or math.abs(hrp.Position.Y - c.Y) > 25 then return end
	local placed = 0
	while #s.carry > 0 and #d.jars < d.slots do
		local item = table.remove(s.carry, 1) :: Carry
		if item.visual then item.visual:Destroy() end
		table.insert(d.jars, { id = item.id, mut = item.mut, star = 1 })
		placed += 1
	end
	if placed > 0 then
		Game.send(p, "deposit", placed)
		Game.renderPlot(p)
		Game.reattachCarry(p)
		Game.sync(p)
		-- a merge hint when three match
		local _, merges = Logic.mergeJars(d.jars)
		if merges > 0 then Game.toast(p, "You have 3 of a kind! Press MERGE to evolve them", {150, 255, 200}, "mergehint", 20) end
	end
	if #s.carry > 0 then
		Game.toast(p, "Your jars are full! Buy more jars, merge, or sell one", {255, 140, 120}, "full", 6)
	end
end

---------------------------------------------------------------- wild dreamlings
local function poof(pos: Vector3, color: Color3, n: number?)
	local a = Instance.new("Part")
	a.Anchored = true; a.CanCollide = false; a.CanQuery = false; a.Transparency = 1; a.Size = Vector3.one; a.CFrame = CFrame.new(pos); a.Parent = workspace
	local pe = Instance.new("ParticleEmitter")
	pe.Color = ColorSequence.new(color, Color3.new(1, 1, 1)); pe.LightEmission = 1
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
	pe.Speed = NumberRange.new(10, 22); pe.SpreadAngle = Vector2.new(180, 180); pe.Lifetime = NumberRange.new(0.5, 1); pe.Rate = 0
	pe.Parent = a
	pe:Emit(n or 40)
	Debris:AddItem(a, 2)
end
Game.poof = poof

local function hoverHeight(m: Model): number return m:GetExtentsSize().Y / 2 + 1.2 end

local function wander(w: Wild)
	local m = w.model
	local root = m.PrimaryPart :: BasePart
	local r = Config.RarityById[Config.SpeciesById[w.id].rarity]
	local speed = 7 - r.order * 0.5
	local base: CFrame? = nil
	while m.Parent and not w.caught do
		if next(w.catchers) then
			-- being caught: wiggle in place
			if w.tween then (w.tween :: Tween):Cancel(); w.tween = nil end
			base = base or root.CFrame
			root.CFrame = (base :: CFrame) * CFrame.Angles(0, 0, math.rad(rng:NextNumber(-14, 14)))
			task.wait(0.1)
		else
			if base then root.CFrame = base; base = nil end
			local here = root.Position
			local a = rng:NextNumber(0, math.pi * 2)
			local target = here + Vector3.new(math.cos(a), 0, math.sin(a)) * rng:NextNumber(8, 22)
			local flat = Vector3.new(target.X, 0, target.Z)
			if flat.Magnitude > Config.MeadowRadius - 4 then flat = flat.Unit * (Config.MeadowRadius - 10) end
			if flat.Magnitude < 16 then flat = flat.Unit * 18 end
			local dest = flat + Vector3.new(0, hoverHeight(m) + rng:NextNumber(0, 2), 0)
			local dist = (dest - here).Magnitude
			local dir = (dest - here) * Vector3.new(1, 0, 1)
			local goal = if dir.Magnitude > 0.1 then CFrame.lookAt(dest, dest + dir) else root.CFrame.Rotation + dest
			local t = TweenService:Create(root, TweenInfo.new(math.max(0.5, dist / speed), Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { CFrame = goal })
			w.tween = t
			t:Play()
			local done = false
			local conn = t.Completed:Connect(function() done = true end)
			local t0 = os.clock()
			while not done and not next(w.catchers) and not w.caught and m.Parent and os.clock() - t0 < 12 do task.wait(0.1) end
			conn:Disconnect()
			if not next(w.catchers) then task.wait(rng:NextNumber(0.3, 1.8)) end
		end
	end
end

function Game.spawnDreamling(minOrder: number?): Model
	local ev = Game.eventId()
	local id = Logic.rollSpecies(roll, ev, minOrder)
	local mut = Logic.rollMutation(roll, ev, 1)
	local sp = Config.SpeciesById[id]
	local r = Config.RarityById[sp.rarity]
	local m = Builder.build(id, mut, { anchored = true, label = true })
	local pos = World.randomMeadowPoint()
	m:PivotTo(CFrame.new(pos + Vector3.new(0, hoverHeight(m), 0)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0))
	local root = m.PrimaryPart :: BasePart
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Catch!"
	prompt.ObjectText = (if mut then Config.MutationById[mut].name .. " " else "") .. sp.name .. " · " .. r.name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = Logic.reach(Config.UpgradeById.reach.max) + m:GetExtentsSize().X / 2
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	prompt.Triggered:Connect(function(p) Game.startCatch(p, m) end)
	-- rare ones get a beam of light the whole server can see
	if r.order >= 5 then
		local a0 = Instance.new("Attachment"); a0.Parent = root
		local a1 = Instance.new("Attachment"); a1.Position = Vector3.new(0, 220, 0); a1.Parent = root
		local beam = Instance.new("Beam"); beam.Attachment0 = a0; beam.Attachment1 = a1; beam.Width0 = 4; beam.Width1 = 10
		beam.Color = ColorSequence.new(Builder.rgb(r.color)); beam.LightEmission = 1; beam.FaceCamera = true
		beam.Transparency = NumberSequence.new(0.2, 1); beam.Parent = root
		Game.sendAll("announce", "✨ A " .. string.upper(r.name) .. " " .. (if mut then string.upper(Config.MutationById[mut].name) .. " " else "") .. string.upper(sp.name) .. " appeared in the Meadow!", r.color)
	end
	m.Parent = wildFolder
	local w: Wild = { model = m, id = id, mut = mut, born = os.clock(), caught = false, catchers = {} }
	wild[m] = w
	task.spawn(wander, w)
	return m
end

local function despawn(w: Wild)
	wild[w.model] = nil
	if w.model.Parent then
		local r = Config.RarityById[Config.SpeciesById[w.id].rarity]
		poof((w.model.PrimaryPart :: BasePart).Position, Builder.rgb(r.color), 20)
		w.model:Destroy()
	end
end

function Game.startCatch(p: Player, m: Model)
	local w = wild[m]
	local s, d = Game.sessions[p], Data.profiles[p]
	if not w or w.caught or not s or not d then return end
	if s.catching then return end
	if #s.carry >= Game.bag(p) then
		Game.toast(p, "Your bag is full! Take your dreamlings home first", {255, 140, 120}, "bag", 2)
		return
	end
	local char = p.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then return end
	local reach = Logic.reach(d.up.reach) + m:GetExtentsSize().X / 2
	if (hrp.Position - (m.PrimaryPart :: BasePart).Position).Magnitude > reach + 1 then
		Game.toast(p, "Too far! Get closer or buy a Longer Net", {255, 200, 120}, "far", 2)
		return
	end
	local dur = Logic.catchTime(w.id, d.up.netSpeed)
	s.catching = { model = m, t0 = os.clock(), dur = dur }
	w.catchers[p] = true
	Game.send(p, "catchStart", m, dur)
end

local function endCatch(p: Player, ok: boolean, why: string?)
	local s = Game.sessions[p]
	if not s or not s.catching then return end
	local w = wild[(s.catching :: any).model]
	if w then w.catchers[p] = nil end
	s.catching = nil
	Game.send(p, "catchEnd", ok, why)
end

local function caught(p: Player, w: Wild)
	local s, d = Game.sessions[p], Data.profiles[p]
	w.caught = true
	for other in w.catchers do if other ~= p then endCatch(other, false, p.DisplayName .. " caught it first!") end end
	endCatch(p, true)
	local sp = Config.SpeciesById[w.id]
	local r = Config.RarityById[sp.rarity]
	local pos = (w.model.PrimaryPart :: BasePart).Position
	wild[w.model] = nil
	w.model:Destroy()
	poof(pos, Builder.rgb(r.color), 30 + r.order * 10)
	-- your Lucky Charm can mutate it as you catch it
	local mut = w.mut
	local lucky = false
	if not mut then
		local l = Game.luck(p) - 1
		if l > 0 then
			local m2 = Logic.rollMutation(roll, nil, l)
			if m2 and m2 ~= "giant" and m2 ~= "tiny" then mut = m2; lucky = true end
		end
	end
	local c: Carry = { id = w.id, mut = mut }
	table.insert(s.carry, c)
	attachCarry(p, c, #s.carry)
	d.stats.caught += 1
	if r.order >= 3 then d.stats.rares += 1; Game.quest(p, "rare") end
	if r.order >= 5 then d.stats.legends += 1 end
	if mut then d.stats.mutated += 1; Game.quest(p, "mutated") end
	Game.quest(p, "catch")
	if Game.eventId() then d.stats.events += 1; Game.quest(p, "event") end
	local isNew = d.dex[w.id] == nil
	d.dex[w.id] = (d.dex[w.id] or 0) + 1
	local bonus = 0
	if isNew then
		bonus = math.max(40, math.floor(r.income * 25 + Game.income(p) * 20))
		d.sparkles += bonus; d.total += bonus
	end
	Game.send(p, "caught", w.id, mut, isNew, bonus, lucky)
	if r.order >= 6 or (mut == "galaxy") then
		Game.sendAll("announce", "🌟 " .. p.DisplayName .. " caught a " .. string.upper(r.name) .. " " .. (if mut then string.upper(Config.MutationById[mut].name) .. " " else "") .. string.upper(sp.name) .. "!", r.color)
	end
	local ls = p:FindFirstChild("leaderstats")
	local cv = ls and ls:FindFirstChild("Caught") :: IntValue?
	if cv then cv.Value = d.stats.caught end
	if #s.carry >= Game.bag(p) then Game.toast(p, "Bag full! Take them home to your island", {150, 220, 255}, "bagfull", 8) end
	Game.sync(p)
end

-- runs ten times a second: catch progress, despawns
function Game.catchTick()
	for p, s in Game.sessions do
		local c = s.catching
		if c then
			local w = wild[c.model]
			local char = p.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
			if not w or w.caught or not c.model.Parent then
				endCatch(p, false, "It got away!")
			elseif not hrp or (hrp.Position - (c.model.PrimaryPart :: BasePart).Position).Magnitude > Logic.reach(Data.profiles[p].up.reach) + c.model:GetExtentsSize().X / 2 + 7 then
				endCatch(p, false, "Too far away!")
			elseif os.clock() - c.t0 >= c.dur then
				caught(p, w)
			end
		end
	end
	local now = os.clock()
	for _, w in wild do
		if not w.caught and not next(w.catchers) and now - w.born > Config.DreamlingLife then despawn(w) end
	end
end

function Game.spawnTick()
	local n = 0
	for _ in wild do n += 1 end
	if n < Config.MaxDreamlings then Game.spawnDreamling() end
end

---------------------------------------------------------------- merge, upgrades, rebirth
function Game.merge(p: Player)
	local d = Data.profiles[p]
	local jars, merges = Logic.mergeJars(d.jars)
	if merges == 0 then Game.toast(p, "You need 3 of the same dreamling (same stars) to merge", {255, 200, 120}); return end
	d.jars = jars
	d.stats.merges += merges
	Game.quest(p, "merge", merges)
	Game.send(p, "merged", merges)
	Game.renderPlot(p); Game.sync(p)
end

function Game.buyUpgrade(p: Player, id: string)
	local d = Data.profiles[p]
	local u = Config.UpgradeById[id]
	if not d or not u then return end
	local lvl = d.up[id] or 0
	if lvl >= u.max then return end
	local cost = Logic.upgradeCost(id, lvl)
	if d.sparkles < cost then Game.toast(p, "Not enough Sparkles", {255, 140, 120}, "poor", 1); return end
	d.sparkles -= cost
	d.up[id] = lvl + 1
	Game.quest(p, "upgrade")
	Game.send(p, "bought", id)
	Game.applyCharacter(p)
	Game.sync(p)
end

function Game.buySlot(p: Player)
	local d = Data.profiles[p]
	if d.slots >= Config.MaxSlots then return end
	local cost = Logic.slotCost(d.slots)
	if d.sparkles < cost then Game.toast(p, "Not enough Sparkles", {255, 140, 120}, "poor", 1); return end
	d.sparkles -= cost
	d.slots += 1
	Game.quest(p, "upgrade")
	Game.send(p, "bought", "slot")
	Game.renderPlot(p); Game.sync(p)
end

function Game.rebirth(p: Player)
	local d = Data.profiles[p]
	local cost = Logic.rebirthCost(d.rebirths)
	if d.sparkles < cost then Game.toast(p, "Rebirth needs " .. Logic.fmt(cost) .. " Sparkles", {255, 140, 120}); return end
	d.rebirths += 1
	d.sparkles = 0; d.unclaimed = 0
	d.jars = {}; d.slots = Config.StartSlots
	d.up = { netSpeed = 0, reach = 0, speed = 0, bag = 0, luck = 0 }
	local s = Game.sessions[p]
	for _, c in s.carry do if c.visual then c.visual:Destroy() end end
	s.carry = {}
	Game.sendAll("announce", "🔁 " .. p.DisplayName .. " was REBORN! (x" .. string.format("%.1f", Logic.incomeMult(d.rebirths, false)) .. " Sparkles forever)", {200, 150, 255})
	Game.send(p, "reborn", d.rebirths)
	Game.applyCharacter(p)
	Game.renderPlot(p); Game.sync(p)
end

function Game.claimQuest(p: Player, i: number)
	local d = Data.profiles[p]
	local q = d.quests[i]
	if not q or not q.done or q.claimed then return end
	q.claimed = true
	local v = Logic.questReward(Game.income(p), q.n)
	d.sparkles += v; d.total += v
	Game.send(p, "reward", "Quest reward", v)
	Game.sync(p)
end

---------------------------------------------------------------- character
function Game.applyCharacter(p: Player)
	local d = Data.profiles[p]
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not d or not hum then return end
	local ws = Logic.walk(d.up.speed)
	if Game.eventId() == "speed" then ws *= 2 end
	hum.WalkSpeed = ws
	hum.UseJumpPower = true
	hum.JumpPower = 55
end

---------------------------------------------------------------- dream events
local currentEvent: string? = nil
local defaultGravity = workspace.Gravity
function Game.eventId(): string? return currentEvent end

local function tweenLight(props: {[string]: any}, t: number?)
	TweenService:Create(Lighting, TweenInfo.new(t or 2.5), props):Play()
end

local function startEvent(id: string, by: string?)
	if currentEvent then return end
	currentEvent = id
	local e = Config.EventById[id]
	workspace:SetAttribute("EventId", id)
	workspace:SetAttribute("EventEnds", workspace:GetServerTimeNow() + Config.EventDuration)
	Game.sendAll("event", id, by)
	if id == "lowgrav" then workspace.Gravity = 55 end
	if id == "disco" then tweenLight({ ClockTime = 0.5 }) end
	if id == "golden" then tweenLight({ ClockTime = 17.7 }) end
	if id == "secret" then
		tweenLight({ ClockTime = 22.5 })
		local atm = Lighting:FindFirstChildOfClass("Atmosphere")
		if atm then TweenService:Create(atm, TweenInfo.new(3), { Density = 0.5, Color = Color3.fromRGB(80, 40, 120) }):Play() end
	end
	for p in Game.sessions do Game.applyCharacter(p) end
	task.spawn(function()
		local t0 = os.clock()
		local stars = 0
		while currentEvent == id and os.clock() - t0 < Config.EventDuration do
			if id == "candy" then
				for _ = 1, 3 do Game.dropCandy() end
			end
			if id == "starfall" and stars < 3 and os.clock() - t0 > stars * 18 + 2 then
				stars += 1
				task.spawn(Game.starfall)
			end
			if id ~= "candy" then Game.spawnTick() end
			task.wait(if id == "candy" then 0.35 else 0.8)
		end
		Game.endEvent()
	end)
	print("[Dreamling] Dream event:", e.name)
end
Game.startEvent = startEvent

function Game.endEvent()
	local id = currentEvent
	if not id then return end
	currentEvent = nil
	workspace:SetAttribute("EventId", "")
	workspace:SetAttribute("NextEvent", workspace:GetServerTimeNow() + Config.EventInterval)
	workspace.Gravity = defaultGravity
	tweenLight({ ClockTime = 14.5 })
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if atm then TweenService:Create(atm, TweenInfo.new(3), { Density = 0.28, Color = Color3.fromRGB(255, 205, 240) }):Play() end
	for p in Game.sessions do Game.applyCharacter(p) end
	Game.sendAll("eventEnd", id)
end

function Game.eventLoop()
	workspace:SetAttribute("NextEvent", workspace:GetServerTimeNow() + 75)
	while true do
		task.wait(1)
		local nextAt = workspace:GetAttribute("NextEvent") :: number?
		if not currentEvent and nextAt and workspace:GetServerTimeNow() >= nextAt then
			local total = 0
			for _, e in Config.Events do total += e.weight end
			local x = rng:NextNumber() * total
			local pickId = Config.Events[1].id
			for _, e in Config.Events do x -= e.weight; if x <= 0 then pickId = e.id; break end end
			startEvent(pickId)
		end
	end
end

-- a falling star crashes into the meadow and a Legendary (or better) climbs out
function Game.starfall()
	local target = World.randomMeadowPoint()
	local star = World.part(workspace, { Name = "FallingStar", Shape = Enum.PartType.Ball, Size = Vector3.one * 5, CFrame = CFrame.new(target + Vector3.new(80, 260, 40)), Color = Color3.fromRGB(255, 240, 150), Material = Enum.Material.Neon, CanCollide = false })
	local fire = Instance.new("Fire"); fire.Heat = 20; fire.Size = 14; fire.Color = Color3.fromRGB(255, 210, 90); fire.SecondaryColor = Color3.fromRGB(255, 100, 200); fire.Parent = star
	local tw = TweenService:Create(star, TweenInfo.new(2.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { CFrame = CFrame.new(target + Vector3.new(0, 2, 0)) })
	tw:Play()
	tw.Completed:Wait()
	poof(target, Color3.fromRGB(255, 230, 120), 90)
	star:Destroy()
	Game.sendAll("impact", target)
	local m = Game.spawnDreamling(5)
	m:PivotTo(CFrame.new(target + Vector3.new(0, hoverHeight(m), 0)))
end

-- candy falls anywhere on the meadow; touching one pays out a slice of your income
function Game.dropCandy()
	local pos = World.randomMeadowPoint() + Vector3.new(0, 90, 0)
	local c = World.part(workspace, { Name = "Candy", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, CFrame = CFrame.new(pos), Color = Color3.fromHSV(rng:NextNumber(), 0.5, 1), Material = Enum.Material.Neon, Anchored = false, CanCollide = true })
	c.CanTouch = true
	local got = false
	c.Touched:Connect(function(hit)
		if got then return end
		local p = Players:GetPlayerFromCharacter(hit.Parent)
		if not p or not Data.profiles[p] then return end
		got = true
		local v = math.max(15, math.floor(Game.income(p) * 6))
		local d = Data.profiles[p]
		d.sparkles += v; d.total += v
		Game.send(p, "candy", v)
		poof(c.Position, c.Color, 14)
		c:Destroy()
	end)
	Debris:AddItem(c, 14)
end

return Game
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- CATCH A DREAMLING! server entry: builds the world, handles players, remotes, purchases and loops.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Logic = require(Shared:WaitForChild("Logic"))
local World = require(script.Parent:WaitForChild("World"))
local Data = require(script.Parent:WaitForChild("Data"))
local Game = require(script.Parent:WaitForChild("Game"))

-- remotes
local remotes = Instance.new("Folder"); remotes.Name = "Remotes"; remotes.Parent = ReplicatedStorage
local toClient = Instance.new("RemoteEvent"); toClient.Name = "ToClient"; toClient.Parent = remotes
local toServer = Instance.new("RemoteEvent"); toServer.Name = "ToServer"; toServer.Parent = remotes
Game.remote = toClient

Game.plots = World.build()
Data.startAutosave()

---------------------------------------------------------------- players
local function ownsPass(p: Player, id: number): boolean
	if id == 0 then return false end
	local ok, res = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(p.UserId, id) end)
	return ok and res == true
end

local function onCharacter(p: Player, char: Model)
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then return end
	task.wait(0.2)
	Game.applyCharacter(p)
	Game.reattachCarry(p)
	-- start at home
	local s = Game.sessions[p]
	if s and s.plot then
		local hrp = char:WaitForChild("HumanoidRootPart", 5) :: BasePart?
		if hrp then char:PivotTo((s.plot :: World.Plot).cf * CFrame.new(0, 5, -12)) end
	end
	if s and s.passes.VIP then
		local head = char:FindFirstChild("Head")
		if head then
			local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(120, 30); bb.StudsOffset = Vector3.new(0, 2.6, 0); bb.MaxDistance = 80; bb.Parent = head
			local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.Font = Enum.Font.FredokaOne; t.TextScaled = true
			t.Text = "★ VIP ★"; t.TextColor3 = Color3.fromRGB(255, 215, 80); t.TextStrokeTransparency = 0; t.Parent = bb
		end
	end
end

local function onJoin(p: Player)
	local d = Data.load(p)
	if not p.Parent then Data.profiles[p] = nil; Data.loaded[p] = nil; return end
	local s: Game.Session = { plot = nil, carry = {}, catching = nil, passes = {}, lastToast = {}, income = 0 }
	for name, id in Config.GamePasses do s.passes[name] = ownsPass(p, id) end
	Game.sessions[p] = s
	Game.assignPlot(p)
	if not s.plot then task.delay(3, function() Game.toast(p, "All 8 islands are taken on this server! Set Max Players to 8 in Game Settings.", {255, 140, 120}) end) end
	Game.refreshQuests(p)

	local ls = Instance.new("Folder"); ls.Name = "leaderstats"; ls.Parent = p
	local caught = Instance.new("IntValue"); caught.Name = "Caught"; caught.Value = d.stats.caught; caught.Parent = ls
	local sp = Instance.new("StringValue"); sp.Name = "Sparkles"; sp.Value = Logic.fmt(d.sparkles); sp.Parent = ls
	local rb = Instance.new("IntValue"); rb.Name = "Rebirths"; rb.Value = d.rebirths; rb.Parent = ls

	Game.renderPlot(p)
	p.CharacterAdded:Connect(function(c) onCharacter(p, c) end)
	if p.Character then task.spawn(onCharacter, p, p.Character) end
	Game.sync(p)

	-- welcome back: offline earnings and the daily gift
	local income = Game.income(p)
	if d.lastSeen > 0 then
		local away = os.time() - d.lastSeen
		local amt = Logic.offlineEarnings(income, away)
		if amt > 0 then
			d.unclaimed += amt
			Game.send(p, "offline", amt, away)
		end
	end
	local day = math.floor(os.time() / 86400)
	if d.daily.last ~= day then
		d.daily.streak = if d.daily.last == day - 1 then d.daily.streak + 1 else 1
		d.daily.last = day
		local amt, luckMin = Logic.dailyReward(d.daily.streak, income)
		d.sparkles += amt; d.total += amt
		if luckMin > 0 then d.luckUntil = math.max(d.luckUntil, os.time()) + luckMin * 60 end
		Game.send(p, "daily", d.daily.streak, amt, luckMin)
	end
	Game.sync(p)
end

local function onLeave(p: Player)
	local s, d = Game.sessions[p], Data.profiles[p]
	if s and d then
		-- anything still carried goes into free jars, the rest is sold
		for _, c in s.carry do
			if #d.jars < d.slots then table.insert(d.jars, { id = c.id, mut = c.mut, star = 1 })
			else local v = Logic.sellValue({ id = c.id, mut = c.mut, star = 1 }); d.sparkles += v end
		end
		s.carry = {}
		Data.pushLeaderboard(p, d.stats.caught)
	end
	Game.freePlot(p)
	Game.sessions[p] = nil
	Data.save(p, true)
end

Players.PlayerAdded:Connect(onJoin)
Players.PlayerRemoving:Connect(onLeave)
for _, p in Players:GetPlayers() do task.spawn(onJoin, p) end

---------------------------------------------------------------- collect pads
for _, plot in Game.plots do
	plot.pad.CanTouch = true
	plot.pad.Touched:Connect(function(hit)
		local p = Players:GetPlayerFromCharacter(hit.Parent)
		if not p then return end
		local s = Game.sessions[p]
		if s and s.plot == plot then Game.collect(p) end
	end)
end

---------------------------------------------------------------- remotes from clients
local lastCall: {[Player]: number} = {}
toServer.OnServerEvent:Connect(function(p: Player, kind: any, arg: any)
	if typeof(kind) ~= "string" then return end
	local now = os.clock()
	if now - (lastCall[p] or 0) < 0.12 then return end
	lastCall[p] = now
	if not Data.profiles[p] or not Game.sessions[p] then return end
	if kind == "buy" and typeof(arg) == "string" then Game.buyUpgrade(p, arg)
	elseif kind == "slot" then Game.buySlot(p)
	elseif kind == "merge" then Game.merge(p)
	elseif kind == "rebirth" then Game.rebirth(p)
	elseif kind == "sell" and typeof(arg) == "number" then Game.sell(p, math.floor(arg))
	elseif kind == "claimQuest" and typeof(arg) == "number" then Game.claimQuest(p, math.floor(arg))
	elseif kind == "collect" then Game.collect(p)
	elseif kind == "home" then
		local s = Game.sessions[p]
		local char = p.Character
		if s.plot and char then char:PivotTo((s.plot :: World.Plot).cf * CFrame.new(0, 5, -12)) end
	elseif kind == "tut" and typeof(arg) == "number" then
		Data.profiles[p].tut = math.max(Data.profiles[p].tut, math.clamp(math.floor(arg), 0, 10))
	elseif kind == "sync" then Game.sync(p)
	end
end)
Players.PlayerRemoving:Connect(function(p) lastCall[p] = nil end)

---------------------------------------------------------------- purchases
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p, passId, bought)
	if not bought then return end
	local s = Game.sessions[p]
	if not s then return end
	for name, id in Config.GamePasses do if id == passId then s.passes[name] = true end end
	Game.toast(p, "Thank you! Your pass is active", {255, 215, 80})
	Game.renderPlot(p); Game.sync(p)
end)

MarketplaceService.ProcessReceipt = function(info)
	local p = Players:GetPlayerByUserId(info.PlayerId)
	local d = p and Data.profiles[p]
	if not p or not d then return Enum.ProductPurchaseDecision.NotProcessedYet end
	d.receipts = d.receipts or {}
	if table.find(d.receipts, info.PurchaseId) then return Enum.ProductPurchaseDecision.PurchaseGranted end
	local id = info.ProductId
	if id == Config.Products.LuckPotion and id ~= 0 then
		d.luckUntil = math.max(d.luckUntil, os.time()) + 600
		Game.toast(p, "Luck Potion active: x2 luck for 10 minutes!", {150, 255, 150})
	elseif id == Config.Products.SparklePack and id ~= 0 then
		local v = math.max(2000, math.floor(Game.income(p) * 1800))
		d.sparkles += v; d.total += v
		Game.send(p, "reward", "Sparkle Pack", v)
	elseif id == Config.Products.SummonStarfall and id ~= 0 then
		if Game.eventId() then Game.endEvent() end
		Game.startEvent("starfall", p.DisplayName)
	else
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	table.insert(d.receipts, info.PurchaseId)
	while #d.receipts > 50 do table.remove(d.receipts, 1) end
	Game.sync(p)
	task.spawn(Data.save, p)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

---------------------------------------------------------------- loops
-- income: every second each island earns into its collect pad (or straight in with Auto Collect)
task.spawn(function()
	while true do
		task.wait(1)
		for p, s in Game.sessions do
			local d = Data.profiles[p]
			if d then
				local inc = Game.income(p)
				s.income = inc
				if s.passes.AutoCollect then d.sparkles += inc else d.unclaimed += inc end
				d.total += inc
				if s.plot then (s.plot :: World.Plot).income.Text = "COLLECT\n+" .. Logic.fmt(d.unclaimed) end
				local ls = p:FindFirstChild("leaderstats")
				local sv = ls and ls:FindFirstChild("Sparkles") :: StringValue?
				if sv then sv.Value = Logic.fmt(d.sparkles) end
				local rv = ls and ls:FindFirstChild("Rebirths") :: IntValue?
				if rv then rv.Value = d.rebirths end
				Game.send(p, "stats", d.sparkles, d.unclaimed, inc, Game.luck(p))
			end
		end
	end
end)

-- catching and deposits
task.spawn(function()
	local k = 0
	while true do
		task.wait(0.1)
		Game.catchTick()
		k += 1
		if k % 3 == 0 then for p in Game.sessions do Game.tryDeposit(p) end end
	end
end)

-- spawning
task.spawn(function()
	for _ = 1, 12 do Game.spawnDreamling() end
	while true do
		task.wait(Config.SpawnEvery)
		if not Game.eventId() then Game.spawnTick() end
	end
end)

task.spawn(Game.eventLoop)

-- the meadow leaderboard (most dreamlings caught, all time)
task.spawn(function()
	local board: BasePart? = nil
	for _, d in workspace:WaitForChild("DreamWorld"):GetChildren() do if d:GetAttribute("IsLeaderboard") then board = d :: BasePart end end
	if not board then return end
	local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Front; sg.CanvasSize = Vector2.new(360, 440); sg.LightInfluence = 0; sg.Parent = board
	local list = Instance.new("TextLabel"); list.Size = UDim2.fromScale(1, 1); list.BackgroundTransparency = 1; list.Font = Enum.Font.FredokaOne
	list.TextColor3 = Color3.new(1, 1, 1); list.TextSize = 24; list.TextYAlignment = Enum.TextYAlignment.Top; list.TextStrokeTransparency = 0.3; list.Parent = sg
	list.Text = "TOP DREAMLING CATCHERS\n\nloading..."
	while true do
		for p, d in Data.profiles do Data.pushLeaderboard(p, d.stats.caught) end
		local top = Data.topCaught(10)
		local lines = { "TOP DREAMLING CATCHERS", "" }
		for i, e in top do table.insert(lines, i .. ".  " .. e.name .. "  —  " .. Logic.fmt(e.value)) end
		if #top == 0 then table.insert(lines, if RunService:IsStudio() then "(needs API access in Studio)" else "Be the first!") end
		list.Text = table.concat(lines, "\n")
		task.wait(120)
	end
end)

print("[Dreamling] Catch a Dreamling! server ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[-- Builds the whole world in code when the server starts: dreamy lighting, the floating Dream Meadow,
-- eight floating home islands with jars, rainbow bridges and sky decorations.

local Lighting = game:GetService("Lighting")
local Config = require(game:GetService("ReplicatedStorage"):WaitForChild("Shared"):WaitForChild("Config"))

local World = {}

local rng = Random.new(20260930)
local function part(parent: Instance, props: {[string]: any}): BasePart
	local p: BasePart = Instance.new(props.Class or "Part") :: BasePart
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do if k ~= "Class" then (p :: any)[k] = v end end
	p.Parent = parent
	return p
end
World.part = part

local function hsv(h: number, s: number, v: number): Color3 return Color3.fromHSV(h % 1, s, v) end

local function setupLighting()
	Lighting.ClockTime = 14.5
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(120, 100, 160)
	Lighting.OutdoorAmbient = Color3.fromRGB(175, 150, 205)
	Lighting.EnvironmentDiffuseScale = 0.5
	Lighting.EnvironmentSpecularScale = 0.6
	Lighting.GlobalShadows = true
	for _, c in Lighting:GetChildren() do c:Destroy() end
	local atm = Instance.new("Atmosphere")
	atm.Density = 0.28; atm.Offset = 0.1; atm.Color = Color3.fromRGB(255, 205, 240); atm.Decay = Color3.fromRGB(150, 110, 255); atm.Glare = 0.3; atm.Haze = 1.4
	atm.Parent = Lighting
	local bloom = Instance.new("BloomEffect"); bloom.Intensity = 0.7; bloom.Size = 30; bloom.Threshold = 1.3; bloom.Parent = Lighting
	local cc = Instance.new("ColorCorrectionEffect"); cc.Name = "DreamColor"; cc.Saturation = 0.18; cc.Contrast = 0.06; cc.TintColor = Color3.fromRGB(255, 245, 255); cc.Parent = Lighting
	local rays = Instance.new("SunRaysEffect"); rays.Intensity = 0.08; rays.Spread = 0.8; rays.Parent = Lighting
	local sky = Instance.new("Sky"); sky.CelestialBodiesShown = true; sky.StarCount = 3000; sky.Parent = Lighting
	local clouds = workspace.Terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover = 0.5; clouds.Density = 0.55; clouds.Color = Color3.fromRGB(255, 225, 250)
	clouds.Parent = workspace.Terrain
end

-- a floating island: a grassy disc with rocky layers hanging underneath
local function island(parent: Instance, center: Vector3, radius: number, top: Color3, rock: Color3)
	part(parent, { Name = "Top", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, radius * 2, radius * 2), CFrame = CFrame.new(center - Vector3.new(0, 3, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = top, Material = Enum.Material.Grass })
	local r, y = radius * 0.92, -6
	for i = 1, 5 do
		part(parent, { Name = "Rock", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, r * 2, r * 2), CFrame = CFrame.new(center + Vector3.new(0, y - 3.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = rock:Lerp(Color3.new(0, 0, 0), i * 0.06), Material = Enum.Material.Slate, CanCollide = i == 1 })
		y -= 7; r *= 0.72
	end
	local tip = part(parent, { Name = "Crystal", Size = Vector3.new(3, 9, 3), CFrame = CFrame.new(center + Vector3.new(0, y - 2, 0)) * CFrame.Angles(0, math.pi / 4, 0), Color = hsv(rng:NextNumber(), 0.5, 1), Material = Enum.Material.Neon, CanCollide = false })
	local l = Instance.new("PointLight"); l.Color = tip.Color; l.Range = 18; l.Brightness = 2; l.Parent = tip
end

local function candyTree(parent: Instance, pos: Vector3, h: number, hue: number)
	part(parent, { Name = "Trunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(h, 1.6, 1.6), CFrame = CFrame.new(pos + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(255, 240, 230), Material = Enum.Material.SmoothPlastic })
	for i = 1, 3 do
		local off = Vector3.new(rng:NextNumber(-2, 2), h + (i - 1) * 2.2, rng:NextNumber(-2, 2))
		part(parent, { Name = "Fluff", Shape = Enum.PartType.Ball, Size = Vector3.one * (7 - i * 1.3), CFrame = CFrame.new(pos + off), Color = hsv(hue + i * 0.03, 0.35, 1), CanCollide = false })
	end
end

local function flowers(parent: Instance, center: Vector3, radius: number, n: number, avoid: number)
	for _ = 1, n do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(avoid, radius)
		local p = center + Vector3.new(math.cos(a) * d, 0.35, math.sin(a) * d)
		part(parent, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(0.6, 1.2), CFrame = CFrame.new(p), Color = hsv(rng:NextNumber(), 0.55, 1), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
	end
end

local function signGui(p: BasePart, text: string, color: Color3): TextLabel
	local sg = Instance.new("SurfaceGui")
	sg.Face = Enum.NormalId.Front
	sg.CanvasSize = Vector2.new(600, 200)
	sg.LightInfluence = 0
	sg.Parent = p
	local t = Instance.new("TextLabel")
	t.Size = UDim2.fromScale(1, 1)
	t.BackgroundTransparency = 1
	t.Font = Enum.Font.FredokaOne
	t.TextScaled = true
	t.Text = text
	t.TextColor3 = color
	t.TextStrokeTransparency = 0
	t.TextStrokeColor3 = Color3.fromRGB(40, 20, 70)
	t.Parent = sg
	return t
end

export type Plot = { index: number, center: Vector3, cf: CFrame, slots: {CFrame}, slotParts: {BasePart}, pad: BasePart, sign: TextLabel, income: TextLabel, folder: Folder, jarFolder: Folder, color: Color3 }

function World.build(): {Plot}
	setupLighting()
	local map = Instance.new("Folder"); map.Name = "DreamWorld"; map.Parent = workspace

	-- Dream Meadow
	local R = Config.MeadowRadius
	island(map, Vector3.zero, R + 15, Color3.fromRGB(165, 235, 180), Color3.fromRGB(150, 120, 200))
	flowers(map, Vector3.zero, R + 10, 260, 18)
	for i = 1, 26 do
		local a, d = rng:NextNumber(0, math.pi * 2), rng:NextNumber(35, R + 5)
		candyTree(map, Vector3.new(math.cos(a) * d, 0, math.sin(a) * d), rng:NextNumber(6, 11), rng:NextNumber())
	end
	-- the Dream Tree in the middle
	part(map, { Name = "DreamTrunk", Shape = Enum.PartType.Cylinder, Size = Vector3.new(26, 7, 7), CFrame = CFrame.new(0, 13, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(200, 170, 255) })
	for i = 1, 7 do
		local a = i / 7 * math.pi * 2
		part(map, { Name = "DreamLeaves", Shape = Enum.PartType.Ball, Size = Vector3.one * rng:NextNumber(12, 17), CFrame = CFrame.new(math.cos(a) * 8, 27 + rng:NextNumber(-2, 4), math.sin(a) * 8), Color = hsv(0.85 + i * 0.03, 0.35, 1), CanCollide = false })
	end
	for i = 1, 30 do
		local a = rng:NextNumber(0, math.pi * 2)
		local b = part(map, { Name = "FairyLight", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, CFrame = CFrame.new(math.cos(a) * rng:NextNumber(9, 15), rng:NextNumber(20, 34), math.sin(a) * rng:NextNumber(9, 15)), Color = hsv(i / 30, 0.4, 1), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
		if i % 5 == 0 then local l = Instance.new("PointLight"); l.Color = b.Color; l.Range = 14; l.Parent = b end
	end
	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true; spawn.Size = Vector3.new(12, 1, 12); spawn.CFrame = CFrame.new(0, 0.5, 22); spawn.Neutral = true
	spawn.Material = Enum.Material.Neon; spawn.Color = Color3.fromRGB(255, 200, 240); spawn.Transparency = 0.3; spawn.Duration = 0
	spawn.Parent = map

	-- sky decorations
	local sky = Instance.new("Folder"); sky.Name = "Sky"; sky.Parent = map
	for i = 1, 14 do
		local a = i / 14 * math.pi * 2 + rng:NextNumber(-0.2, 0.2)
		local d = rng:NextNumber(420, 700)
		island(sky, Vector3.new(math.cos(a) * d, rng:NextNumber(-60, 160), math.sin(a) * d), rng:NextNumber(18, 40), hsv(rng:NextNumber(), 0.3, 1), hsv(rng:NextNumber(), 0.3, 0.7))
	end
	local moon = part(sky, { Name = "DreamMoon", Shape = Enum.PartType.Ball, Size = Vector3.one * 160, CFrame = CFrame.new(-600, 420, -900), Color = Color3.fromRGB(255, 225, 250), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false })
	local ml = Instance.new("PointLight"); ml.Range = 60; ml.Brightness = 0.5; ml.Parent = moon
	for i = 1, 5 do
		part(sky, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.5, 240 + i * 50, 240 + i * 50), CFrame = CFrame.new(-600, 420, -900) * CFrame.Angles(0.4, 0.2, math.pi / 2 + 0.3), Color = hsv(i / 5, 0.5, 1), Material = Enum.Material.Neon, Transparency = 0.82, CanCollide = false, CastShadow = false })
	end

	-- home islands
	local plots: {Plot} = {}
	local PR = Config.PlotRadius
	local plotFolder = Instance.new("Folder"); plotFolder.Name = "Plots"; plotFolder.Parent = workspace
	for i = 1, Config.PlotCount do
		local a = (i - 1) / Config.PlotCount * math.pi * 2
		local center = Vector3.new(math.cos(a) * PR, 0, math.sin(a) * PR)
		local cf = CFrame.lookAt(center, Vector3.new(0, 0, 0))
		local hue = (i - 1) / Config.PlotCount
		local color = hsv(hue, 0.45, 1)
		local folder = Instance.new("Folder"); folder.Name = "Plot" .. i; folder.Parent = plotFolder
		island(folder, center, 30, hsv(hue, 0.22, 0.98), hsv(hue, 0.35, 0.75))
		-- rainbow bridge to the meadow
		local from = center + (Vector3.zero - center).Unit * 29
		local to = (center).Unit * (R + 12)
		local seg = 7
		for k = 0, seg - 1 do
			local p0 = from:Lerp(to, k / seg)
			local p1 = from:Lerp(to, (k + 1) / seg)
			local mid = (p0 + p1) / 2
			part(folder, { Name = "Bridge", Size = Vector3.new(10, 1.2, (p1 - p0).Magnitude + 0.2), CFrame = CFrame.lookAt(mid - Vector3.new(0, 0.6, 0), p1 - Vector3.new(0, 0.6, 0)), Color = hsv(k / seg, 0.55, 1), Material = Enum.Material.Neon, Transparency = 0.15 })
		end
		-- jar slots: a 4 x 4 grid behind the collect pad
		local slots: {CFrame} = {}
		local slotParts: {BasePart} = {}
		local n = 0
		for row = 0, 3 do
			for colI = 0, 3 do
				n += 1
				-- cf looks at the meadow (-Z points toward it), so +Z is the far side where the jars sit
				local scf = cf * CFrame.new((colI - 1.5) * 10, 0, -6 + row * 8.5)
				table.insert(slots, scf + Vector3.new(0, 1, 0))
				local ped = part(folder, { Name = "Pedestal" .. n, Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 7, 7), CFrame = CFrame.new(scf.Position + Vector3.new(0, 0.5, 0)) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(255, 255, 255), Material = Enum.Material.Marble })
				table.insert(slotParts, ped)
			end
		end
		-- collect pad near the bridge
		local padPos = (cf * CFrame.new(0, 0.2, -18)).Position
		local pad = part(folder, { Name = "CollectPad", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, 9, 9), CFrame = CFrame.new(padPos) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromRGB(255, 225, 90), Material = Enum.Material.Neon })
		local pl = Instance.new("PointLight"); pl.Color = pad.Color; pl.Range = 14; pl.Brightness = 2; pl.Parent = pad
		local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(200, 60); bb.StudsOffset = Vector3.new(0, 4, 0); bb.MaxDistance = 90; bb.LightInfluence = 0; bb.Parent = pad
		local income = Instance.new("TextLabel"); income.Size = UDim2.fromScale(1, 1); income.BackgroundTransparency = 1; income.Font = Enum.Font.FredokaOne; income.TextScaled = true
		income.TextColor3 = Color3.fromRGB(255, 240, 150); income.TextStrokeTransparency = 0; income.Text = "COLLECT"; income.Parent = bb
		-- name sign at the back
		local back = cf * CFrame.new(0, 7, 27)
		local board = part(folder, { Name = "Sign", Size = Vector3.new(22, 7, 1), CFrame = CFrame.lookAt(back.Position, center + Vector3.new(0, 7, 0)), Color = color, Material = Enum.Material.SmoothPlastic })
		part(folder, { Name = "Post", Size = Vector3.new(1.2, 7, 1.2), CFrame = CFrame.new(back.Position - Vector3.new(0, 6, 0)), Color = Color3.fromRGB(255, 255, 255) })
		local sign = signGui(board, "Empty island", Color3.new(1, 1, 1))
		local jarFolder = Instance.new("Folder"); jarFolder.Name = "Jars"; jarFolder.Parent = folder
		table.insert(plots, { index = i, center = center, cf = cf, slots = slots, slotParts = slotParts, pad = pad, sign = sign, income = income, folder = folder, jarFolder = jarFolder, color = color })
	end

	-- the leaderboard stand in the meadow
	local lb = part(map, { Name = "Leaderboard", Size = Vector3.new(18, 22, 1), CFrame = CFrame.lookAt(Vector3.new(-30, 11, 30), Vector3.new(0, 11, 0)), Color = Color3.fromRGB(60, 30, 110), Material = Enum.Material.SmoothPlastic })
	lb:SetAttribute("IsLeaderboard", true)
	return plots
end

-- a random point on the meadow for a new dreamling (keeps clear of the Dream Tree)
function World.randomMeadowPoint(): Vector3
	local a = rng:NextNumber(0, math.pi * 2)
	local d = math.sqrt(rng:NextNumber(0.03, 1)) * (Config.MeadowRadius - 6) + 6
	if d < 18 then d = 18 end
	return Vector3.new(math.cos(a) * d, 0, math.sin(a) * d)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="11">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="12">
