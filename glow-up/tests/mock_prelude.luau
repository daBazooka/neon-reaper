local classMembers = {}
local function membersOf(cls)
	if classMembers[cls] then return classMembers[cls] end
	local set = {}
	local c = cls
	while c and c ~= "" and API_CLASSES[c] do
		for n in string.gmatch(API_CLASSES[c][2], "%S+") do set[n] = true end
		c = API_CLASSES[c][1]
	end
	classMembers[cls] = set
	return set
end
local BAD = {}
local function bad(kind, a, b)
	local key = kind .. " " .. a .. "." .. tostring(b)
	if not BAD[key] then BAD[key] = true; print(key) end
end
local classOf = setmetatable({}, {__mode = "k"})
local function mk(name, class)
	local store, attrs = {}, {}
	local mt = {}
	local function sub() return mk(name .. ".?") end
	mt.__index = function(t, k)
		if class and type(k) == "string" and not membersOf(class)[k] then bad("BADREAD", class, k) end
		if k == "SetAttribute" then return function(_, key, v) attrs[key] = v end end
		if k == "GetAttribute" then return function(_, key) return attrs[key] end end
		if store[k] ~= nil then return store[k] end
		if k == "X" or k == "Y" or k == "Z" or k == "Magnitude" or k == "Scale" or k == "Value" or k == "TimeLength" or k == "PlaybackSpeed" then return 1 end
		if k == "Health" then return 100 end
		return sub()
	end
	mt.__newindex = function(t, k, v)
		if class and type(k) == "string" and not membersOf(class)[k] then bad("BADPROP", class, k) end
		store[k] = v
	end
	mt.__call = function() return sub() end
	for _, m in {"__add","__sub","__mul","__div","__unm","__concat","__mod","__pow","__idiv"} do mt[m] = function() return sub() end end
	mt.__lt = function() return true end
	mt.__le = function() return true end
	mt.__len = function() return 3 end
	mt.__iter = function() return function() return nil end end
	local obj = setmetatable({}, mt)
	if class then classOf[obj] = class end
	return obj
end
local function U(n) return mk(n) end

-- virtual clock + scheduler
local clock = 1000
local waiting = {}   -- {time, co}
local timers = {}    -- {time, fn}
local function resume(co, ...)
	local ok, err = coroutine.resume(co, ...)
	if not ok then print("COROUTINE ERROR:", err) end
end
local task = {
	spawn = function(f, ...) local co = coroutine.create(f); resume(co, ...); return co end,
	wait = function(n) table.insert(waiting, {clock + (n or 0.03), coroutine.running()}); coroutine.yield() end,
	delay = function(n, f) table.insert(timers, {clock + n, f}) end,
	defer = function(f, ...) local co = coroutine.create(f); resume(co, ...) end,
}
local function advance(seconds, step)
	step = step or 0.05
	local target = clock + seconds
	while clock < target do
		clock += step
		local due = {}
		for i = #waiting, 1, -1 do if waiting[i][1] <= clock then table.insert(due, 1, table.remove(waiting, i)) end end
		for _, w in due do resume(w[2]) end
		local dueT = {}
		for i = #timers, 1, -1 do if timers[i][1] <= clock then table.insert(dueT, 1, table.remove(timers, i)) end end
		for _, t in dueT do local co = coroutine.create(t[2]); resume(co) end
		if _G.__tick then _G.__tick(clock) end
	end
end

