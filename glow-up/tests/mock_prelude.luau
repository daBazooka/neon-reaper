-- node tree for require()/WaitForChild
local nodes = {}
local sources = {}
local function node(name, parent, source)
	local n = {Name = name, Parent = parent, children = {}, source = source, loaded = false}
	if parent then parent.children[name] = n end
	return setmetatable(n, {__index = function(t, k)
		if k == "WaitForChild" or k == "FindFirstChild" then return function(self, cn) return self.children[cn] end end
		local c = rawget(t, "children")[k]
		if c then return c end
		return nil
	end})
end
local function require(n)
	if not n.loaded then
		n.loaded = true
		n.value = sources[n](n)
	end
	return n.value
end

