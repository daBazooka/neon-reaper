	{ Id = "head_solar", Name = "Solar Crown", Slot = "Head", Rarity = "Legendary", Icon = "☀️", Build = { Kind = "crown", Color = C(255, 205, 80), Sparkle = true } },
	{ Id = "head_horns", Name = "Void Horns", Slot = "Head", Rarity = "Mythic", Icon = "😈", Build = { Kind = "horns", Color = C(255, 70, 170), Sparkle = true } },
	-- Back
	{ Id = "back_cape", Name = "Street Cape", Slot = "Back", Rarity = "Common", Icon = "🧥", Build = { Kind = "cape", Color = C(150, 50, 80) } },
	{ Id = "back_neon", Name = "Neon Cape", Slot = "Back", Rarity = "Rare", Icon = "🦸", Build = { Kind = "cape", Color = C(60, 190, 255), Glow = true } },
	{ Id = "back_angel", Name = "Angel Wings", Slot = "Back", Rarity = "Epic", Icon = "🕊️", Build = { Kind = "wings", Color = C(255, 244, 220) } },
	{ Id = "back_phoenix", Name = "Phoenix Wings", Slot = "Back", Rarity = "Legendary", Icon = "🔥", Build = { Kind = "wings", Color = C(255, 130, 50), Sparkle = true } },
	{ Id = "back_galaxy", Name = "Galaxy Wings", Slot = "Back", Rarity = "Mythic", Icon = "🌌", Build = { Kind = "wings", Color = C(150, 100, 255), Sparkle = true } },
	-- Face
	{ Id = "face_shades", Name = "Midnight Shades", Slot = "Face", Rarity = "Common", Icon = "🕶️", Build = { Kind = "visor", Color = C(25, 25, 35) } },
	{ Id = "face_visor", Name = "Neon Visor", Slot = "Face", Rarity = "Rare", Icon = "🥽", Build = { Kind = "visor", Color = C(80, 230, 255), Glow = true } },
	{ Id = "face_gold", Name = "Gold Mask", Slot = "Face", Rarity = "Epic", Icon = "🎭", Build = { Kind = "mask", Color = C(255, 205, 90) } },
	{ Id = "face_cyber", Name = "Cyber Mask", Slot = "Face", Rarity = "Legendary", Icon = "🤖", Build = { Kind = "mask", Color = C(90, 255, 160), Glow = true } },
	{ Id = "face_void", Name = "Void Gaze", Slot = "Face", Rarity = "Mythic", Icon = "👁️", Build = { Kind = "visor", Color = C(255, 70, 180), Glow = true, Sparkle = true } },
	-- Aura
	{ Id = "aura_spark", Name = "Cyan Sparks", Slot = "Aura", Rarity = "Common", Icon = "✨", Build = { Kind = "aura", Color = C(100, 220, 255) } },
	{ Id = "aura_haze", Name = "Pink Haze", Slot = "Aura", Rarity = "Rare", Icon = "🌸", Build = { Kind = "aura", Color = C(255, 120, 200) } },
	{ Id = "aura_flare", Name = "Gold Flare", Slot = "Aura", Rarity = "Epic", Icon = "🔆", Build = { Kind = "aura", Color = C(255, 205, 80) } },
	{ Id = "aura_storm", Name = "Emerald Storm", Slot = "Aura", Rarity = "Legendary", Icon = "🌪️", Build = { Kind = "aura", Color = C(90, 255, 160) } },
	{ Id = "aura_nova", Name = "Prismatic Nova", Slot = "Aura", Rarity = "Mythic", Icon = "🌈", Build = { Kind = "aura", Color = C(255, 255, 255), Rainbow = true } },
	-- Trail
	{ Id = "trail_spark", Name = "Spark Trail", Slot = "Trail", Rarity = "Common", Icon = "💨", Build = { Kind = "trail", Color = C(100, 220, 255) } },
	{ Id = "trail_pink", Name = "Rose Trail", Slot = "Trail", Rarity = "Rare", Icon = "💗", Build = { Kind = "trail", Color = C(255, 120, 200) } },
	{ Id = "trail_gold", Name = "Gold Trail", Slot = "Trail", Rarity = "Epic", Icon = "🟡", Build = { Kind = "trail", Color = C(255, 205, 80) } },
	{ Id = "trail_emerald", Name = "Emerald Trail", Slot = "Trail", Rarity = "Legendary", Icon = "💚", Build = { Kind = "trail", Color = C(90, 255, 160) } },
	{ Id = "trail_prism", Name = "Prism Trail", Slot = "Trail", Rarity = "Mythic", Icon = "🌈", Build = { Kind = "trail", Color = C(255, 255, 255), Rainbow = true } },
}

Config.CosmeticById = {}
Config.CosmeticsByRarity = {}
for _, rarity in Config.RarityOrder do
	Config.CosmeticsByRarity[rarity] = {}
end
for _, c in Config.Cosmetics do
	Config.CosmeticById[c.Id] = c
	table.insert(Config.CosmeticsByRarity[c.Rarity], c)
end

function Config.CosmeticPower(c, stars)
	return Config.Rarities[c.Rarity].Power * (1 + Config.StarBonus * (stars - 1))
end
function Config.CosmeticAps(c, stars)
	return Config.Rarities[c.Rarity].Aps * (1 + Config.StarBonus * (stars - 1))
end

--------------------------------------------------------------------------------
-- Crates
--------------------------------------------------------------------------------
Config.Crates = {
	{ Id = "street", Name = "Street Crate", Icon = "📦", Cost = 300, Color = C(110, 160, 255), Odds = { Common = 70, Rare = 26, Epic = 4 } },
	{
		Id = "neon",
		Name = "Neon Crate",
		Icon = "🎁",
		Cost = 4000,
		Color = C(255, 110, 205),
		Odds = { Rare = 60, Epic = 34, Legendary = 6 },
		PityAfter = 10,
		PityMin = "Epic",
	},
	{
		Id = "icon",
		Name = "Icon Crate",
		Icon = "💎",
		Cost = 60000,
		Color = C(255, 204, 84),
		Odds = { Epic = 62, Legendary = 34, Mythic = 4 },
		PityAfter = 8,
		PityMin = "Legendary",
	},
}
Config.CrateById = {}
for _, crate in Config.Crates do
	Config.CrateById[crate.Id] = crate
end

--------------------------------------------------------------------------------
-- Aura shards scattered around the district
--------------------------------------------------------------------------------
Config.ShardTypes = {
	{ Name = "Apple", Kind = "apple", Value = 2, Weight = 70, Scale = 0, Color = C(220, 50, 50) },
	{ Name = "Protein Shake", Kind = "shake", Value = 12, Weight = 22, Scale = 0.2, Color = C(120, 190, 255) },
	{ Name = "Dumbbell", Kind = "dumbbell", Value = 60, Weight = 7, Scale = 0.4, Color = C(90, 95, 110) },
	{ Name = "Trophy", Kind = "trophy", Value = 300, Weight = 1, Scale = 0.6, Color = C(255, 205, 60) },
}
Config.ShardMutations = {
	{ Name = "Rainbow", Chance = 0.005, Mult = 10, Color = C(255, 120, 200) },
	{ Name = "Shiny", Chance = 0.04, Mult = 3, Color = C(255, 245, 160) },
}
Config.ShardRespawn = 4
Config.ChainWindow = 2.5
Config.ChainMax = 30
function Config.ChainMult(chain)
	return 1 + math.min(chain, Config.ChainMax) * 0.05
end
function Config.ShardTier(name)
	for i, t in Config.ShardTypes do
		if t.Name == name then
			return i
		end
	end
	return 1
end
-- Shards pay more as you rank up, so early crates stay exciting without trivialising late ones.
function Config.RankScaling(rankIndex)
	return 1 + (rankIndex - 1) * 0.6
end

--------------------------------------------------------------------------------
-- Duels
--------------------------------------------------------------------------------
Config.Duel = {
	Countdown = 3,
	Length = 7,
	MaxTapsPerSecond = 14,
	QueueBotAfter = 6,
	Cooldown = 4,
}

--------------------------------------------------------------------------------
-- Mog Competition: a group flex-off on the central stage every few minutes
--------------------------------------------------------------------------------
Config.Competition = {
	Gap = 150, -- seconds between competitions
	EntryTime = 30,
	Countdown = 3,
	Length = 8,
	MinFieldSize = 6, -- bots fill empty spots so it always feels like a crowd
	BotNames = { "Mogger Mike", "Sigma Sam", "Chad Chris", "Aura Alex", "Rizz Ron", "Gigachad Gus" },
}

--------------------------------------------------------------------------------
-- Runway: walking it earns a steady trickle scaled by your Glow Score
--------------------------------------------------------------------------------
Config.Runway = { MinZ = 26, MaxZ = 96, HalfWidth = 7, AuraPerScore = 0.04 }

--------------------------------------------------------------------------------
-- Quests (an endless chain of small goals)
--------------------------------------------------------------------------------
local QUEST_KINDS = { "swings", "shards", "train", "duel", "crate", "perfect" }
function Config.MakeQuest(done, rebirths)
	local kind = QUEST_KINDS[done % #QUEST_KINDS + 1]
	local step = done // #QUEST_KINDS
	local goal, per
	if kind == "swings" then
		goal, per = math.min(40 + step * 15, 400), 2
	elseif kind == "shards" then
		goal, per = math.min(25 + step * 8, 150), 6
	elseif kind == "train" then
		goal, per = math.min(5 + step, 20), 40
	elseif kind == "duel" then
		goal, per = math.min(1 + step // 2, 6), 180
	elseif kind == "crate" then
		goal, per = math.min(1 + step // 3, 4), 250
	else
		goal, per = math.min(3 + step, 15), 70
	end
	return { Kind = kind, Goal = goal, Reward = math.floor(goal * per * (1 + rebirths)) }
end
function Config.QuestText(kind, goal)
	if kind == "swings" then
		return string.format("Swing your hammer %d times", goal)
	elseif kind == "shards" then
		return string.format("Collect %d pickups", goal)
	elseif kind == "train" then
		return string.format("Land %d training reps", goal)
	elseif kind == "duel" then
		return string.format("Win %d duel%s", goal, goal == 1 and "" or "s")
	elseif kind == "crate" then
		return string.format("Open %d crate%s", goal, goal == 1 and "" or "s")
	end
	return string.format("Hit %d PERFECT reps", goal)
end

--------------------------------------------------------------------------------
-- Daily rewards (7-day cycle). Aura is multiplied by (1 + rebirths).
--------------------------------------------------------------------------------
Config.Daily = {
	{ Aura = 150 },
	{ Aura = 300 },
	{ Aura = 500, Crates = 1 },
	{ Aura = 800 },
	{ Aura = 1500, Crates = 2 },
	{ Aura = 2500 },
	{ Aura = 5000, Crates = 3 },
}

--------------------------------------------------------------------------------
-- Server events
--------------------------------------------------------------------------------
Config.EventGap = { 150, 280 }
Config.Events = {
	{ Id = "Golden", Name = "GOLDEN HOUR", Icon = "🌟", Desc = "All Aura x2", Duration = 90, AuraMult = 2, Tint = C(255, 240, 200) },
	{ Id = "Storm", Name = "PICKUP STORM", Icon = "☄️", Desc = "Gym goodies are raining down", Duration = 60, Tint = C(215, 230, 255) },
	{ Id = "Frenzy", Name = "DUEL FRENZY", Icon = "⚔️", Desc = "Duel rewards x3", Duration = 90, DuelMult = 3, Tint = C(255, 215, 220) },
	{ Id = "Runway", Name = "RUNWAY NIGHT", Icon = "💃", Desc = "Runway Aura x4", Duration = 90, RunwayMult = 4, Tint = C(235, 215, 255) },
}
Config.EventById = {}
for _, e in Config.Events do
	Config.EventById[e.Id] = e
end

--------------------------------------------------------------------------------
-- Audio (sounds that ship with Roblox; swap any for an asset id from the Creator Store)
--------------------------------------------------------------------------------
Config.Sounds = {
	Tone = "rbxasset://sounds/electronicpingshort.wav",
	Bass = "rbxasset://sounds/bass.wav",
	Click = "rbxasset://sounds/button.wav",
	Flash = "rbxasset://sounds/flashbulb.wav",
}
Config.MusicTrackId = "" -- optional looping song id; empty = generative ambient music
Config.MusicVolume = 0.28
Config.SfxVolume = 0.8

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">HammerModel</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: builds the 3D model of a hammer from simple parts (nothing to import).
-- Used for the pedestals in the shop and for the hammer in your hand.
local HammerModel = {}

-- opts.scale shrinks/grows it; opts.anchored for display pieces; the handle is the PrimaryPart.
function HammerModel.build(hammer, cf, parent, opts)
	opts = opts or {}
	local s = opts.scale or 1
	local model = Instance.new("Model")
	model.Name = "Hammer_" .. hammer.Id
	local mat = Enum.Material[hammer.Material] or Enum.Material.Metal
	local function piece(name, size, at, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = cf * CFrame.new(at.Position * s) * (at - at.Position)
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.Anchored = opts.anchored == true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local handle = piece("Handle", Vector3.new(0.7, 6, 0.7), CFrame.new(), hammer.Handle, Enum.Material.Wood)
	local top = CFrame.new(0, 3, 0)
	if hammer.Style == "mallet" then
		piece("Head", Vector3.new(4, 2.4, 2.4), top * CFrame.Angles(0, 0, math.pi / 2), hammer.Head, mat, Enum.PartType.Cylinder)
	elseif hammer.Style == "chisel" then
		piece("Head", Vector3.new(0.9, 3.4, 2.2), top * CFrame.new(0, 1, 0), hammer.Head, mat)
		piece("Tip", Vector3.new(0.9, 1.4, 1.4), top * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.pi / 4), hammer.Head, mat)
	elseif hammer.Style == "spiked" then
		piece("Head", Vector3.new(3.6, 2.4, 2.4), top, hammer.Head, mat)
		for side = -1, 1, 2 do
			piece("Spike", Vector3.new(1.2, 1.2, 1.2), top * CFrame.new(side * 2.2, 0, 0) * CFrame.Angles(0, 0, math.pi / 4), hammer.Head, mat)
		end
	else
		piece("Head", Vector3.new(3.4, 2.2, 2.2), top, hammer.Head, mat)
		piece("Band", Vector3.new(3.6, 0.5, 2.4), top * CFrame.new(0, -0.9, 0), hammer.Handle, Enum.Material.SmoothPlastic)
	end
	model.PrimaryPart = handle
	model.Parent = parent
	return model
end

return HammerModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the client design system. One place for colours, fonts and reusable components
-- so every screen looks like it belongs to the same game.
local TweenService = game:GetService("TweenService")

local Config = require(script.Parent:WaitForChild("Config"))
local Util = require(script.Parent:WaitForChild("Util"))

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(20, 28, 54),
	Panel = Color3.fromRGB(34, 48, 88),
	Card = Color3.fromRGB(54, 72, 128),
	CardHover = Color3.fromRGB(72, 94, 160),
	Stroke = Color3.fromRGB(10, 14, 30),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(186, 200, 232),
	Accent = Color3.fromRGB(62, 140, 255),
	Accent2 = Color3.fromRGB(255, 170, 40),
	Good = Color3.fromRGB(62, 200, 92),
	Gold = Color3.fromRGB(255, 200, 40),
	Cyan = Color3.fromRGB(90, 200, 255),
	Danger = Color3.fromRGB(232, 72, 72),
	Disabled = Color3.fromRGB(96, 104, 134),
	-- Aesthetic accents, one per kind of information so each part of the screen is recognisable
	Pink = Color3.fromRGB(255, 112, 176),
	Orange = Color3.fromRGB(255, 150, 60),
	Mint = Color3.fromRGB(84, 224, 176),
	Purple = Color3.fromRGB(162, 112, 255),
	Sky = Color3.fromRGB(88, 186, 255),
	Yellow = Color3.fromRGB(255, 218, 70),
}

UI.Fonts = {
	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
}

UI.fmt = Util.fmt

function UI.new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in props do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

function UI.corner(inst, radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, inst)
end

function UI.stroke(inst, color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Stroke,
		Thickness = thickness or 2.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

function UI.gradient(inst, c1, c2, rotation)
	return UI.new("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 90,
	}, inst)
end

function UI.padding(inst, all)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
	}, inst)
end

function UI.tween(inst, seconds, props, style, direction)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

-- Squash-and-stretch on a UIScale.
function UI.pop(scaleObj, amount)
	scaleObj.Scale = amount or 1.12
	UI.tween(scaleObj, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
end

function UI.label(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = UI.Fonts.Body,
		TextSize = 16,
		TextColor3 = UI.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = false,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.6,
	}
	for k, v in props do
		base[k] = v
	end
	return UI.new("TextLabel", base, parent)
end

-- A rounded glass panel.
function UI.panel(parent, props)
	local base = {
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
	}
	local radius = props.Radius or 14
	for k, v in props do
		if k ~= "Radius" then
			base[k] = v
		end
	end
	local frame = UI.new("Frame", base, parent)
	UI.corner(frame, radius)
	UI.stroke(frame)
	UI.gradient(frame, Color3.new(1, 1, 1), Color3.fromRGB(196, 200, 214), 90)
	return frame
end

-- Button with hover/press feedback. style: "primary" (gradient) | "card" | "ghost".
function UI.button(parent, props, style)
	style = style or "primary"
	local base = {
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = UI.Fonts.Title,
		TextSize = 16,
		TextColor3 = UI.Colors.Text,
		Text = "",
		BackgroundColor3 = style == "card" and UI.Colors.Card or UI.Colors.Good,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.3,
	}
	local radius = props.Radius or 12
	for k, v in props do
		if k ~= "Radius" then
			base[k] = v
		end
	end
	local btn = UI.new("TextButton", base, parent)
	UI.corner(btn, radius)
	local scale = UI.new("UIScale", {}, btn)
	UI.stroke(btn, UI.Colors.Stroke, 2.5, 0)
	local grad = UI.gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(190, 196, 210), 90)
	local baseColor = base.BackgroundColor3
	btn.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.04 })
		if style == "card" then
			UI.tween(btn, 0.12, { BackgroundColor3 = UI.Colors.CardHover })
		end
	end)
	btn.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
		if style == "card" then
			UI.tween(btn, 0.12, { BackgroundColor3 = baseColor })
		end
	end)
	btn.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.06, { Scale = 0.95 })
	end)
	btn.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.1, { Scale = 1.04 })
	end)
	return btn, scale, grad
end

-- Horizontal progress bar. Returns an object with :set(alpha) and .fill / .back.
function UI.bar(parent, props, fillColor)
	local back = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(14, 11, 32),
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
	}, parent)
	UI.corner(back, 99)
	UI.stroke(back, UI.Colors.Stroke, 2, 0)
	local fill = UI.new("Frame", {
		BackgroundColor3 = fillColor or UI.Colors.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
	}, back)
	UI.corner(fill, 99)
	UI.gradient(fill, Color3.new(1, 1, 1), Color3.fromRGB(170, 176, 190), 90)
	local self = { back = back, fill = fill }
	function self.set(alpha)
		fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
	end
	return self
end

function UI.rarityColor(rarity)
	return Config.Rarities[rarity].Color
end

return UI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: small shared helpers.
local Util = {}

-- 1234 -> "1,234", 15300 -> "15.3K", 4.2e6 -> "4.20M" ...
function Util.fmt(n)
	n = math.floor(n + 0.5)
	if n >= 1e15 then
		return string.format("%.2fQ", n / 1e15)
	elseif n >= 1e12 then
		return string.format("%.2fT", n / 1e12)
	elseif n >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	elseif n >= 1000 then
		local s = tostring(n)
		return s:sub(1, #s - 3) .. "," .. s:sub(-3)
	end
	return tostring(n)
end

-- Triangle wave 0..1..0 with period 2 (used for the training bar so client and server agree).
function Util.tri(x)
	return 1 - math.abs(x % 2 - 1)
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

-- Seconds -> "1:05"
function Util.clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- Parses "id:stars,id:stars" (the replicated inventory string).
function Util.parseInventory(text)
	local inv = {}
	for id, stars in string.gmatch(text or "", "([%w_]+):(%d+)") do
		inv[id] = tonumber(stars)
	end
	return inv
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="9">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: server entry point. Creates the network channels, builds the world, wires every
-- system together, and routes client requests.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

-- Network channels: Action = client asks the server, Notify = server tells the client.
local net = Instance.new("Folder")
net.Name = "Net"
net.Parent = ReplicatedStorage
local Action = Instance.new("RemoteEvent")
Action.Name = "Action"
Action.Parent = net
local Notify = Instance.new("RemoteEvent")
Notify.Name = "Notify"
Notify.Parent = net

local Modules = script:WaitForChild("Modules")
local Data = require(Modules.Data)
local Stats = require(Modules.Stats)
local Appearance = require(Modules.Appearance)
local Quirks = require(Modules.Quirks)
local Cosmetics = require(Modules.Cosmetics)
local Nameplate = require(Modules.Nameplate)
local Quests = require(Modules.Quests)
local Daily = require(Modules.Daily)
local Shards = require(Modules.Shards)
local Training = require(Modules.Training)
local Crates = require(Modules.Crates)
local Duels = require(Modules.Duels)
local Competition = require(Modules.Competition)
local Shop = require(Modules.Shop)
local Events = require(Modules.Events)
local Runway = require(Modules.Runway)
local Board = require(Modules.Board)
local Hammers = require(Modules.Hammers)
local Pets = require(Modules.Pets)
local Aura = require(Modules.Aura)
local Playtime = require(Modules.Playtime)
local World = require(Modules.World)

--------------------------------------------------------------------------------
-- World + systems
--------------------------------------------------------------------------------
print("[TrueAdam] server starting")
local okWorld, info = pcall(World.build)
if okWorld then
	Duels.setArena(info.arena, info.battle)
	Competition.setStage(info.stage, info.compBoard)
	Shards.build(info.slots)
	Board.init(info.board)
	print("[TrueAdam] world built, shards:", #info.slots)
else
	warn("[TrueAdam] World.build FAILED:", info)
end
-- Rebuild the face/hair/belly and any worn items whenever the body changes.
Appearance.setHook(function(p)
	Quirks.apply(p)
	Cosmetics.apply(p)
	Aura.apply(p)
end)
Shards.init()
Competition.init()
Training.init()
Pets.init()
Runway.init()
Events.init()
Data.init()

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------
local function onCharacter(p)
	local char = p.Character
	if not char then
		return
	end
	char:WaitForChild("HumanoidRootPart")
	char:WaitForChild("Humanoid")
	Stats.applyMovement(p)
	Appearance.onCharacter(p)
	Cosmetics.onCharacter(p)
	Nameplate.onCharacter(p)
	Hammers.attach(p)
	Pets.refresh(p)
end

local function onPlayer(p)
	local profile = Data.load(p)
	Stats.init(p)
	Quests.init(p)
	Daily.refresh(p)
	Playtime.init(p)
	Nameplate.init(p)
	Cosmetics.sync(p)

	-- Your look keeps earning while you're away.
	if profile.LastSeen then
		local away = math.clamp(os.time() - profile.LastSeen, 0, 2 * 3600)
		local gain = math.floor((p:GetAttribute("AuraRate") or 0) * away * 0.5)
		if gain > 0 then
			Stats.addAura(p, gain, { raw = true })
			p:SetAttribute("OfflineGain", gain)
		end
	end

	p.CharacterAdded:Connect(function()
		onCharacter(p)
	end)
	if p.Character then
		task.spawn(onCharacter, p)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayer, p)
end

Players.PlayerRemoving:Connect(function(p)
	Training.release(p)
	Hammers.release(p)
	Pets.release(p)
	Playtime.release(p)
	Duels.release(p)
	Competition.release(p)
	Stats.forget(p)
end)

--------------------------------------------------------------------------------
-- Idle income + daily refresh
--------------------------------------------------------------------------------
task.spawn(function()
	local tick = 0
	while true do
		task.wait(1)
		tick += 1
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Ready") then
				local rate = p:GetAttribute("AuraRate") or 0
				if rate > 0 then
					Stats.addAuraFractional(p, rate * Stats.eventMult("AuraMult"), { raw = true })
				end
				Playtime.tick(p)
				if tick % 30 == 0 then
					Daily.refresh(p)
				end
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- Client requests (rate limited)
--------------------------------------------------------------------------------
-- Everything you can use is activated by a button on screen (or E). The server checks how close your
-- character is, so it works the same from any camera angle.
local INTERACT_SLACK = 8
local interactions = {
	Gym = function(p)
		Training.start(p, "Power")
	end,
	Studio = function(p)
		Training.start(p, "Style")
	end,
	Lounge = function(p)
		Training.start(p, "Charm")
	end,
	Crates = function(p)
		Stats.send(p, "openMenu", "Crates")
	end,
	Ring = Duels.joinQueue,
	Battle = Duels.stageFight,
	Bot = Duels.duelBot,
	Stage = Competition.enter,
}

local function nearTo(p, pos, radius)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local d = root.Position - pos
	return Vector3.new(d.X, 0, d.Z).Magnitude <= radius + INTERACT_SLACK
end

local function interact(p, id)
	local hammerId = string.match(id, "^Hammer:(%d+)$")
	if hammerId then
		local n = tonumber(hammerId)
		if Config.HammerById[n] and nearTo(p, Config.HammerPos(n), Config.HammerRadius) then
			Hammers.use(p, n)
		end
		return
	end
	local handler = interactions[id]
	for _, entry in Config.Interactables do
		if entry.Id == id and handler and nearTo(p, Config.InteractPos(entry), entry.Radius) then
			handler(p)
			return
		end
	end
end

local SETTING_KEYS = { Music = true, Sfx = true, Duels = true, Fx = true }
local budget = {}

Action.OnServerEvent:Connect(function(p, kind, a, b)
	if type(kind) ~= "string" or not p:GetAttribute("Ready") then
		return
	end
	local now = os.clock()
	local state = budget[p]
	if not state or now - state.t > 1 then
		state = { t = now, n = 0 }
		budget[p] = state
	end
	state.n += 1
	if state.n > 60 then
		return
	end

	if kind == "Equip" or kind == "Unequip" then
		Cosmetics.handle(p, kind, a)
	elseif kind == "Buy" or kind == "Rebirth" then
		Shop.handle(p, kind, a)
	elseif kind == "OpenCrate" and type(a) == "string" then
		Crates.open(p, a)
	elseif kind == "Hatch" or kind == "PetEquip" or kind == "PetUnequip" then
		Pets.handle(p, kind, a)
	elseif kind == "Swing" then
		Hammers.swing(p)
	elseif kind == "Interact" and type(a) == "string" then
		interact(p, a)
	elseif kind == "Claim" then
		Daily.claim(p)
	elseif kind == "TrainHit" or kind == "TrainCancel" then
		Training.handle(p, kind, a)
	elseif kind == "DuelTaps" then
		Duels.handle(p, kind, a)
	elseif kind == "CompTaps" then
		Competition.handle(p, kind, a)
	elseif kind == "Setting" and type(a) == "string" and SETTING_KEYS[a] then
		Stats.setSetting(p, a, b)
	end
end)

Players.PlayerRemoving:Connect(function(p)
	budget[p] = nil
end)

print("[TrueAdam] ready")
]]></string>
      </Properties>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Appearance</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: your character's body changes as you level. Level 1 is a short, wide,
-- big-headed gag character; by level 1000 you're tall and athletic. It's all cartoon-style
-- body scaling, no skin or face changes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)

local Appearance = {}

local onChanged -- set by Main so accessories can be rebuilt at the new size

function Appearance.setHook(fn)
	onChanged = fn
end

local SCALE_VALUES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale", "BodyTypeScale", "BodyProportionScale" }

-- The head's unscaled ("nominal") size, so accessories fit no matter how big the head currently is.
local function nominalHead(char)
	local head = char and char:FindFirstChild("Head")
	if not head then
		return Vector3.new(2, 1, 1)
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local scaleValue = hum and hum:FindFirstChild("HeadScale")
	local current = (scaleValue and scaleValue:IsA("NumberValue") and scaleValue.Value) or 1
	if current <= 0 then
		current = 1
	end
	return head.Size / current
end

-- Target head size (after the level's scaling). Used to place face features.
function Appearance.headDims(p)
	local profile = Data.get(p)
	local level = profile and profile.Level or 1
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		return nominalHead(p.Character) * Config.AppearanceScales(level).HeadScale
	end
	local head = p.Character and p.Character:FindFirstChild("Head")
	return head and head.Size or Vector3.new(2, 1, 1)
end

-- Target torso size (R15 upper torso is about 2 x 1.6 x 1 before scaling).
function Appearance.torsoDims(p)
	local profile = Data.get(p)
	local level = profile and profile.Level or 1
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		local s = Config.AppearanceScales(level)
		return Vector3.new(2 * s.BodyWidthScale, 1.6 * s.BodyHeightScale, 1 * s.BodyDepthScale)
	end
	local torso = p.Character and p.Character:FindFirstChild("Torso")
	return torso and torso.Size or Vector3.new(2, 2, 1)
end

-- Scale numbers accessories should use for this player (so hats and wings fit the body).
-- Accessories are designed for a head about 2 studs wide.
function Appearance.accessoryScales(p)
	local profile = Data.get(p)
	local level = profile and profile.Level or 1
	local s = Config.AppearanceScales(level)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		local nominal = nominalHead(p.Character)
		return s.HeadScale * nominal.X / 2, (s.BodyHeightScale + s.BodyWidthScale) / 2
	end
	local scale = p.Character and p.Character:GetScale() or 1
	return scale, scale
end

function Appearance.update(p, instant)
	local profile = Data.get(p)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not profile or not hum then
		return
	end
	local target = Config.AppearanceScales(profile.Level)

	-- Skin tone also improves with every level.
	local colors = char:FindFirstChildOfClass("BodyColors")
	if colors then
		local tone = Config.SkinTone(profile.Level)
		colors.HeadColor3 = tone
		colors.TorsoColor3 = tone
		colors.LeftArmColor3 = tone
		colors.RightArmColor3 = tone
	end

	if hum.RigType == Enum.HumanoidRigType.R15 then
		for _, name in SCALE_VALUES do
			local value = hum:FindFirstChild(name)
			if value and value:IsA("NumberValue") then
				if instant then
					value.Value = target[name]
				else
					TweenService:Create(value, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Value = target[name] }):Play()
				end
			end
		end
	else
		-- R6 characters can only be scaled evenly.
		local uniform = (target.BodyHeightScale + target.BodyWidthScale) / 2
		pcall(function()
			char:ScaleTo(uniform)
		end)
	end
	if onChanged then
		onChanged(p)
	end
end

function Appearance.onCharacter(p)
	local char = p.Character
	local hum = char and char:WaitForChild("Humanoid", 5)
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		-- Wait for the scale values to exist before setting them.
		for _, name in SCALE_VALUES do
			hum:WaitForChild(name, 3)
		end
	end
	Appearance.update(p, true)
end

return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Aura</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the aura around your character grows with every level. More sparks, then flames, a glowing
-- ring on the ground, a light and finally a halo. Colour follows your looks tier. Everyone can see it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)

local Aura = {}

local TAG = "GlowAuraFx"
local SPARKS = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function clear(char)
	for _, child in char:GetDescendants() do
		if child.Name == TAG then
			child:Destroy()
		end
	end
end

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Name = TAG
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	for k, v in props do
		e[k] = v
	end
	e.Parent = parent
	return e
end

function Aura.apply(p)
	local char = p.Character
	local profile = Data.get(p)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not profile or not root then
		return
	end
	clear(char)
	local level = profile.Level
	local tier = Config.RankFor(level)
	local color = Config.Ranks[tier].Color
	local bright = color:Lerp(Color3.new(1, 1, 1), 0.35)

	-- Layer 1: sparks that rise around you (always on, denser every level)
	emitter(root, {
		Texture = SPARKS,
		Color = ColorSequence.new(bright, color),
		LightEmission = 0.5,
		Rate = math.min(3 + level * 0.1, 70),
		Lifetime = NumberRange.new(1, 1.6),
		Acceleration = Vector3.new(0, 3, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 + math.min(level / 100, 2)), NumberSequenceKeypoint.new(1, 0) }),
	})
	-- Layer 2: flames from tier 6 up
	if tier >= 6 then
		emitter(root, {
			Texture = FIRE,
			Color = ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.4)),
			LightEmission = 0.7,
			Rate = math.min(4 + (tier - 5) * 2.5, 50),
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(25, 25),
			Acceleration = Vector3.new(0, 6, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5 + tier * 0.1), NumberSequenceKeypoint.new(1, 0) }),
		})
	end
	-- Light that gets brighter with the tier
	local light = Instance.new("PointLight")
	light.Name = TAG
	light.Color = color
	light.Brightness = 0.3 + tier * 0.06
	light.Range = 10 + tier * 0.8
	light.Parent = root
	-- Layer 3: a glowing ring on the ground from tier 10 up
	if tier >= 10 then
		local ring = Instance.new("Part")
		ring.Name = TAG
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.2, 5 + tier * 0.25, 5 + tier * 0.25)
		ring.Color = color
		ring.Material = Enum.Material.SmoothPlastic
		ring.Transparency = 0.55
		ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.Massless = false, false, false, true
		ring.CFrame = root.CFrame * CFrame.new(0, -2.9, 0) * CFrame.Angles(0, 0, math.pi / 2)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = ring
		weld.Parent = ring
		ring.Parent = char
	end
	-- Layer 4: a halo above the head from tier 20 up
	local head = char:FindFirstChild("Head")
	if tier >= 20 and head then
		local halo = Instance.new("Part")
		halo.Name = TAG
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.25, 3.2, 3.2)
		halo.Color = Color3.fromRGB(255, 236, 140)
		halo.Material = Enum.Material.SmoothPlastic
		halo.Transparency = 0.15
		halo.CanCollide, halo.CanQuery, halo.CanTouch, halo.Massless = false, false, false, true
		halo.CFrame = head.CFrame * CFrame.new(0, head.Size.Y * 0.5 + 1.4, 0) * CFrame.Angles(0, 0, math.pi / 2)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = halo
		weld.Parent = halo
		halo.Parent = char
	end
end

return Aura
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Board</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the "Top Moggers" screen: the highest levels on this server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local Board = {}

function Board.init(label)
	if not label then
		return
	end
	task.spawn(function()
		while true do
			local list = Players:GetPlayers()
			table.sort(list, function(x, y)
				local lx, ly = x:GetAttribute("Level") or 1, y:GetAttribute("Level") or 1
				if lx ~= ly then
					return lx > ly
				end
				return (x:GetAttribute("GlowScore") or 0) > (y:GetAttribute("GlowScore") or 0)
			end)
			local lines = {}
			for i = 1, math.min(8, #list) do
				local p = list[i]
				local rank = Config.Ranks[p:GetAttribute("Rank") or 1]
				table.insert(lines, string.format("%d.  %s   —   Lv %s   (%s)", i, p.DisplayName, Util.fmt(p:GetAttribute("Level") or 1), rank.Name))
			end
			label.Text = #lines > 0 and table.concat(lines, "\n") or "Nobody here yet."
			task.wait(8)
		end
	end)
end

return Board
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Competition</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the Mog Competition. Every few minutes entries open at the central stage.
-- Everyone who entered flexes (taps) for 8 seconds; the higher your Mog Power and the faster you
-- tap, the higher you place. Bots fill the field so it always feels like a crowd.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Competition = {}

local cfg = Config.Competition
local rng = Random.new()
local stage -- { center = Vector3 }
local board -- TextLabel on the stage screen
local entrants = {} -- Player -> true
local battle -- active battle table
local state = "idle"

function Competition.setStage(info, boardLabel)
	stage = info
	board = boardLabel
end

local function setState(newState, endsAt)
	state = newState
	workspace:SetAttribute("CompState", newState)
	workspace:SetAttribute("CompEnd", endsAt or 0)
end

local function setBoard(text)
	if board then
		board.Text = text
	end
end

local function sayAll(...)
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Ready") then
			Stats.send(p, ...)
		end
	end
end

local function validEntrant(p)
	return p.Parent ~= nil and p:GetAttribute("Ready") and not p:GetAttribute("InDuel")
end

function Competition.enter(p)
	if state ~= "open" then
		local left = math.max(0, (workspace:GetAttribute("CompEnd") or 0) - workspace:GetServerTimeNow())
		Stats.toast(p, "Entries are closed. Next competition in " .. Util.clock(left), "info")
		return
	end
	if entrants[p] then
		Stats.toast(p, "You're already entered. Stay near the stage!", "info")
		return
	end
	if p:GetAttribute("InDuel") or p:GetAttribute("Training") then
		Stats.toast(p, "Finish what you're doing first", "bad")
		return
	end
	entrants[p] = true
	Stats.toast(p, "You're in the Mog Competition! Stay near the stage", "good")
end

function Competition.taps(p, n)
	if not battle or battle.over or type(n) ~= "number" then
		return
	end
	local entry = battle.byPlayer[p]
	if not entry then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < battle.tStart - 0.1 or now > battle.tEnd + 0.2 then
		return
	end
	local allowed = Config.Duel.MaxTapsPerSecond * math.max(0, now - battle.tStart) + 4
	entry.taps = math.min(entry.taps + math.clamp(math.floor(n), 0, 20), allowed)
end

--------------------------------------------------------------------------------
-- Battle
--------------------------------------------------------------------------------
local function setFrozen(p, frozen)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if frozen then
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
	else
		Stats.applyMovement(p)
	end
end

local function placeOnStage(p, index, count)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if root and stage then
		local x = (index - (count + 1) / 2) * 6
		local pos = stage.center + Vector3.new(x, 3.5, 4)
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
	end
end

local function ranking(entries, forPlayer)
	local sorted = table.clone(entries)
	table.sort(sorted, function(a, b)
		return a.taps > b.taps
	end)
	local out = {}
	for i = 1, math.min(6, #sorted) do
		out[i] = { n = sorted[i].name, t = sorted[i].taps, m = sorted[i].player == forPlayer }
	end
	return out
end

local function finish(b)
	b.over = true
	local maxTaps = Config.Duel.MaxTapsPerSecond * cfg.Length
	local topScore = 1
	for _, e in b.entries do
		topScore = math.max(topScore, e.score)
	end
	for _, e in b.entries do
		e.points = (math.min(e.taps, maxTaps) / maxTaps) * 40 + (e.score / topScore) * 60
		e.points *= 0.95 + rng:NextNumber() * 0.1
	end
	table.sort(b.entries, function(x, y)
		return x.points > y.points
	end)

	local summary = {}
	for i = 1, math.min(5, #b.entries) do
		summary[i] = { n = b.entries[i].name, p = math.floor(b.entries[i].points + 0.5) }
	end

	for place, e in b.entries do
		local p = e.player
		if p then
			setFrozen(p, false)
			p:SetAttribute("InDuel", false)
			if p.Parent then
				local profile = Data.get(p)
				if profile then
					local multiplier = place == 1 and 3 or place == 2 and 2 or place == 3 and 1.4 or 0.6
					local aura = Stats.addAura(p, (200 + topScore * 0.5) * multiplier)
					local xp = (place == 1 and 400) or (place == 2 and 250) or (place == 3 and 150) or 80
					if place == 1 then
						Stats.addFreeCrates(p, 1)
						profile.Wins += 1
						p:SetAttribute("Wins", profile.Wins)
					end
					Stats.addXP(p, xp)
					Stats.send(p, "compEnd", place, #b.entries, aura, place == 1, summary)
				end
			end
		end
	end
	battle = nil
end

local function runBattle()
	local humans = {}
	for p in entrants do
		if validEntrant(p) then
			table.insert(humans, p)
		end
	end
	entrants = {}
	if #humans == 0 then
		setBoard("No entrants this time.\nNext competition soon!")
		return
	end

	local avgScore = 0
	for _, p in humans do
		avgScore += Stats.score(p)
	end
	avgScore /= #humans

	local entries = {}
	local byPlayer = {}
	for _, p in humans do
		local entry = { player = p, name = p.DisplayName, score = Stats.score(p), taps = 0 }
		table.insert(entries, entry)
		byPlayer[p] = entry
	end
	local botIndex = 0
	while #entries < cfg.MinFieldSize do
		botIndex += 1
		table.insert(entries, {
			name = cfg.BotNames[(botIndex - 1) % #cfg.BotNames + 1],
			score = math.max(20, avgScore * (0.6 + rng:NextNumber() * 0.8)),
			taps = 0,
			rate = 5 + rng:NextNumber() * 5,
		})
	end

	local now = workspace:GetServerTimeNow()
	local b = {
		entries = entries,
		byPlayer = byPlayer,
		tStart = now + cfg.Countdown,
		tEnd = now + cfg.Countdown + cfg.Length,
		over = false,
	}
	battle = b
	setState("battle", b.tEnd)

	for i, p in humans do
		p:SetAttribute("InDuel", true)
		placeOnStage(p, i, #humans)
		setFrozen(p, true)
		local roster = {}
		for _, e in entries do
			table.insert(roster, { n = e.name, s = math.floor(e.score), m = e.player == p })
		end
		Stats.send(p, "compStart", b.tStart, cfg.Length, roster)
	end
	setBoard("MOG COMPETITION\nIN PROGRESS!")

	while workspace:GetServerTimeNow() < b.tEnd + 0.4 do
		task.wait(0.4)
		local t = workspace:GetServerTimeNow()
		for _, e in entries do
			if e.rate and t > b.tStart then
				e.taps = math.floor((math.min(t, b.tEnd) - b.tStart) * e.rate)
			end
		end
		for _, p in humans do
			if p.Parent then
				Stats.send(p, "compProgress", ranking(entries, p))
			end
		end
	end
	finish(b)
	local top = b.entries[1]
	setBoard(string.format("WINNER: %s\n(%d points)", top.name, math.floor(top.points + 0.5)))
	task.wait(8)
end

--------------------------------------------------------------------------------
-- Schedule
--------------------------------------------------------------------------------
function Competition.init()
	task.spawn(function()
		task.wait(20)
		while true do
			-- Waiting for the next one
			local nextAt = workspace:GetServerTimeNow() + cfg.Gap
			setState("idle", nextAt)
			while workspace:GetServerTimeNow() < nextAt do
				setBoard("MOG COMPETITION\nnext in " .. Util.clock(nextAt - workspace:GetServerTimeNow()))
				task.wait(1)
			end

			-- Entries open
			entrants = {}
			local closeAt = workspace:GetServerTimeNow() + cfg.EntryTime
			setState("open", closeAt)
			sayAll("toast", "🏆 MOG COMPETITION is open! Press E at the stage to enter", "gold")
			while workspace:GetServerTimeNow() < closeAt do
				local count = 0
				for _ in entrants do
					count += 1
				end
				setBoard(string.format("ENTRIES OPEN\n%s left  ·  %d entered", Util.clock(closeAt - workspace:GetServerTimeNow()), count))
				task.wait(1)
			end

			runBattle()
		end
	end)
end

function Competition.release(p)
	entrants[p] = nil
	if battle and battle.byPlayer[p] then
		battle.byPlayer[p].player = nil
	end
end

function Competition.handle(p, kind, a)
	if kind == "CompTaps" then
		Competition.taps(p, a)
	end
end

return Competition
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the wardrobe. Owns the inventory (with star levels) and builds the glowing
-- accessories players wear. Everything is made from parts and effects, so nothing needs uploading.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Appearance = require(script.Parent.Appearance)

local Cosmetics = {}

local FOLDER = "GlowCosmetics"

--------------------------------------------------------------------------------
-- Inventory
--------------------------------------------------------------------------------
local function writeInventory(p, profile)
	local parts = {}
	for id, stars in profile.Inv do
		table.insert(parts, id .. ":" .. stars)
	end
	table.sort(parts)
	p:SetAttribute("Inv", table.concat(parts, ","))
	for _, slot in Config.Slots do
		p:SetAttribute("Eq_" .. slot, profile.Eq[slot] or "")
	end
end

function Cosmetics.sync(p)
	local profile = Data.get(p)
	if profile then
		writeInventory(p, profile)
	end
end

-- Returns "new", "star" (duplicate levelled up) or "max" (duplicate of a max-star item), plus the stars.
function Cosmetics.grant(p, id)
	local profile = Data.get(p)
	local c = Config.CosmeticById[id]
	if not profile or not c then
		return nil
	end
	local stars = profile.Inv[id]
	local status
	if not stars then
		profile.Inv[id] = 1
		status = "new"
	elseif stars < Config.MaxStars then
		profile.Inv[id] = stars + 1
		status = "star"
	else
		status = "max"
	end
	writeInventory(p, profile)
	Stats.recompute(p)
	return status, profile.Inv[id]
end

function Cosmetics.equip(p, id)
	local profile = Data.get(p)
	local c = Config.CosmeticById[id]
	if not profile or not c or not profile.Inv[id] then
		return
	end
	profile.Eq[c.Slot] = id
	writeInventory(p, profile)
	Stats.recompute(p)
	Cosmetics.apply(p)
end

function Cosmetics.unequip(p, slot)
	local profile = Data.get(p)
	if not profile or not table.find(Config.Slots, slot) then
		return
	end
	profile.Eq[slot] = nil
	writeInventory(p, profile)
	Stats.recompute(p)
	Cosmetics.apply(p)
end

--------------------------------------------------------------------------------
-- Visuals
--------------------------------------------------------------------------------
local function accessoryPart(props)
	local part = Instance.new("Part")
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		part[k] = v
	end
	return part
end

local ctxNow -- the build context currently being used (for size scaling)

-- Positions `part` relative to `base` and welds it there. Accessories scale with the body so
-- a hat still fits a big head and wings still fit a wide back.
local function attach(part, base, offset, folder)
	local s = (ctxNow and base == ctxNow.head) and ctxNow.hs or (ctxNow and ctxNow.bs or 1)
	part.Size = part.Size * s
	local rotation = offset - offset.Position
	part.CFrame = base.CFrame * (CFrame.new(offset.Position * s) * rotation)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function glowMaterial(spec)
	return spec.Glow and Enum.Material.Metal or Enum.Material.SmoothPlastic
end

local function sparkle(parent, color, rate)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Rate = rate or 12
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = parent
	return e
end

local function rainbow()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 140)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 90)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 255, 160)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 190, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
	})
end

local builders = {}

function builders.cap(spec, ctx)
	local band = accessoryPart({ Size = Vector3.new(2.15, 0.55, 2.15), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
	attach(band, ctx.head, CFrame.new(0, 0.7, 0), ctx.folder)
	local brim = accessoryPart({ Size = Vector3.new(1.7, 0.15, 1.0), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
	attach(brim, ctx.head, CFrame.new(0, 0.5, -1.2), ctx.folder)
end

function builders.halo(spec, ctx)
	local ring = accessoryPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.14, 2.7, 2.7),
		Color = spec.Color,
		Material = Enum.Material.SmoothPlastic,
	})
	attach(ring, ctx.head, CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.pi / 2), ctx.folder)
	local light = Instance.new("PointLight")
	light.Color = spec.Color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = ring
end

function builders.crown(spec, ctx)
	local base = accessoryPart({ Size = Vector3.new(2.1, 0.45, 2.1), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
	attach(base, ctx.head, CFrame.new(0, 0.85, 0), ctx.folder)
	for i = 1, 5 do
		local angle = (i / 5) * math.pi * 2
		local spike = accessoryPart({
			Size = Vector3.new(0.38, 1.0, 0.38),
			Color = spec.Color,
			Material = Enum.Material.SmoothPlastic,
		})
		attach(spike, ctx.head, CFrame.new(math.cos(angle) * 0.85, 1.4, math.sin(angle) * 0.85), ctx.folder)
		if spec.Sparkle and i == 1 then
			sparkle(spike, spec.Color, 14)
		end
	end
end

function builders.horns(spec, ctx)
	for side = -1, 1, 2 do
		local horn = accessoryPart({ Size = Vector3.new(0.4, 1.5, 0.4), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
		attach(horn, ctx.head, CFrame.new(side * 0.75, 1.15, 0) * CFrame.Angles(0, 0, -side * 0.45), ctx.folder)
		if spec.Sparkle then
			sparkle(horn, spec.Color, 16)
		end
	end
end

function builders.cape(spec, ctx)
	local body = accessoryPart({
		Size = Vector3.new(2.0, 3.1, 0.15),
		Color = spec.Color,
		Material = glowMaterial(spec),
	})
	attach(body, ctx.torso, CFrame.new(0, -0.35, 0.78) * CFrame.Angles(0.12, 0, 0), ctx.folder)
	if spec.Glow then
		local edge = accessoryPart({ Size = Vector3.new(2.1, 0.12, 0.2), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic })
		attach(edge, ctx.torso, CFrame.new(0, -1.9, 0.9) * CFrame.Angles(0.12, 0, 0), ctx.folder)
	end
end

function builders.wings(spec, ctx)
	for side = -1, 1, 2 do
		for i = 1, 3 do
			local feather = accessoryPart({
				Size = Vector3.new(0.18, 2.8 - i * 0.55, 1.1),
				Color = spec.Color,
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.12 * i,
			})
			attach(
				feather,
				ctx.torso,
				CFrame.new(side * (0.9 + i * 0.7), 1.0 - i * 0.35, 0.8)
					* CFrame.Angles(0.15, side * 0.7, side * (0.35 + i * 0.12)),
				ctx.folder
			)
			if spec.Sparkle and i == 3 then
				sparkle(feather, spec.Color, 10)
			end
		end
	end
end

function builders.visor(spec, ctx)
	local bar = accessoryPart({
		Size = Vector3.new(2.05, 0.5, 0.25),
		Color = spec.Color,
		Material = glowMaterial(spec),
		Transparency = spec.Glow and 0.15 or 0,
	})
	attach(bar, ctx.head, CFrame.new(0, 0.15, -0.62), ctx.folder)
	if spec.Sparkle then
		sparkle(bar, spec.Color, 8)
	end
end

function builders.mask(spec, ctx)
	local plate = accessoryPart({ Size = Vector3.new(1.95, 1.1, 0.2), Color = spec.Color, Material = glowMaterial(spec) })
	attach(plate, ctx.head, CFrame.new(0, 0, -0.62), ctx.folder)
	local slit = accessoryPart({ Size = Vector3.new(1.5, 0.18, 0.22), Color = Color3.new(0.05, 0.05, 0.1), Material = Enum.Material.SmoothPlastic })
	attach(slit, ctx.head, CFrame.new(0, 0.15, -0.72), ctx.folder)
end

function builders.aura(spec, ctx)
	local e = Instance.new("ParticleEmitter")
	e.Name = "GlowAura"
	e.Color = spec.Rainbow and rainbow() or ColorSequence.new(spec.Color)
	e.LightEmission = 1
	e.Rate = 28
	e.Lifetime = NumberRange.new(1.2, 2.2)
	e.Speed = NumberRange.new(1, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = ctx.root
	local light = Instance.new("PointLight")
	light.Name = "GlowAuraLight"
	light.Color = spec.Rainbow and Color3.fromRGB(255, 200, 255) or spec.Color
	light.Range = 14
	light.Brightness = 1.2
	light.Parent = ctx.root
end

function builders.trail(spec, ctx)
	local a0 = Instance.new("Attachment")
	a0.Name = "GlowTrailA0"
	a0.Position = Vector3.new(0, 0.9, 0)
	a0.Parent = ctx.root
	local a1 = Instance.new("Attachment")
	a1.Name = "GlowTrailA1"
	a1.Position = Vector3.new(0, -0.9, 0)
	a1.Parent = ctx.root
	local trail = Instance.new("Trail")
	trail.Name = "GlowTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.8
	trail.LightEmission = 1
	trail.Color = spec.Rainbow and rainbow() or ColorSequence.new(spec.Color, Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = ctx.root
end

local function clear(char)
	local old = char:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		for _, child in root:GetChildren() do
			if string.sub(child.Name, 1, 4) == "Glow" then
				child:Destroy()
			end
		end
	end
end

-- Rebuilds everything the player is wearing.
function Cosmetics.apply(p)
	local char = p.Character
	local profile = Data.get(p)
	if not char or not profile then
		return
	end
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not head or not root or not torso then
		return
	end
	clear(char)
	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	folder.Parent = char
	local hs, bs = Appearance.accessoryScales(p)
	local ctx = { head = head, root = root, torso = torso, folder = folder, hs = hs, bs = bs }
	ctxNow = ctx
	for _, slot in Config.Slots do
		local id = profile.Eq[slot]
		local c = id and Config.CosmeticById[id]
		if c then
			local build = builders[c.Build.Kind]
			if build then
				local ok, err = pcall(build, c.Build, ctx)
				if not ok then
					warn("[TrueAdam] cosmetic failed:", id, err)
				end
			end
		end
	end
end

function Cosmetics.onCharacter(p)
	Cosmetics.sync(p)
	Cosmetics.apply(p)
end

function Cosmetics.handle(p, kind, a, b)
	if kind == "Equip" and type(a) == "string" then
		Cosmetics.equip(p, a)
	elseif kind == "Unequip" and type(a) == "string" then
		Cosmetics.unequip(p, a)
	end
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Crates</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: crate opening. The server decides every roll; the client only plays the reveal.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Cosmetics = require(script.Parent.Cosmetics)
local Quests = require(script.Parent.Quests)

local Crates = {}

local rng = Random.new()

local function rollRarity(crate, luck, onlyAtLeast)
	local minOrder = onlyAtLeast and Config.Rarities[onlyAtLeast].Order or 0
	local lowest = math.huge
	for name in crate.Odds do
		lowest = math.min(lowest, Config.Rarities[name].Order)
	end

	local total, weights = 0, {}
	for _, name in Config.RarityOrder do
		local base = crate.Odds[name]
		local order = Config.Rarities[name].Order
		if base and order >= minOrder then
			-- Luck boosts every drop above the crate's lowest tier.
			local w = order == lowest and base or base * luck
			weights[name] = w
			total += w
		end
	end

	local roll = rng:NextNumber() * total
	for _, name in Config.RarityOrder do
		local w = weights[name]
		if w then
			roll -= w
			if roll <= 0 then
				return name
			end
		end
	end
	return onlyAtLeast or Config.RarityOrder[1]
end

function Crates.open(p, crateId)
	local crate = Config.CrateById[crateId]
	local profile = Data.get(p)
	if not crate or not profile then
		return
	end

	if crateId == "street" and profile.FreeCrates > 0 then
		profile.FreeCrates -= 1
		p:SetAttribute("FreeCrates", profile.FreeCrates)
	elseif not Stats.spend(p, crate.Cost) then
		Stats.toast(p, "Not enough Aura for a " .. crate.Name, "bad")
		return
	end

	local luck = Config.LuckMult(profile.Levels.Luck or 0)
	local pity = profile.Pity[crateId] or 0
	local forced = crate.PityAfter and pity + 1 >= crate.PityAfter
	local rarity = rollRarity(crate, luck, forced and crate.PityMin or nil)

	if crate.PityMin then
		if Config.Rarities[rarity].Order >= Config.Rarities[crate.PityMin].Order then
			profile.Pity[crateId] = 0
		else
			profile.Pity[crateId] = pity + 1
		end
	end

	if crate.PityAfter then
		p:SetAttribute("Pity_" .. crateId, profile.Pity[crateId] or 0)
	end

	local pool = Config.CosmeticsByRarity[rarity]
	local pick = pool[rng:NextInteger(1, #pool)]
	local status, stars = Cosmetics.grant(p, pick.Id)

	local refund = 0
	if status == "max" then
		refund = math.floor(crate.Cost * 0.3)
		Stats.addAura(p, refund, { raw = true })
	end

	profile.CratesOpened += 1
	Stats.addXP(p, 8)
	Quests.progress(p, "crate", 1)
	Stats.send(p, "crate", crateId, pick.Id, status, stars, refund)
end

return Crates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Daily</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: 7-day login streak. Missing a day restarts the cycle.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Daily = {}

local function today()
	return os.time() // 86400
end

local function nextDay(profile)
	local d = profile.Daily
	if d.Last >= today() - 1 then
		return d.Streak % #Config.Daily + 1
	end
	return 1
end

function Daily.refresh(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	p:SetAttribute("DailyReady", profile.Daily.Last < today())
	p:SetAttribute("DailyDay", nextDay(profile))
	p:SetAttribute("DailyStreak", profile.Daily.Streak)
end

function Daily.claim(p)
	local profile = Data.get(p)
	if not profile or profile.Daily.Last >= today() then
		return
	end
	local day = nextDay(profile)
	local reward = Config.Daily[day]
	local aura = reward.Aura * (1 + profile.Rebirths)
	profile.Daily.Streak = profile.Daily.Last == today() - 1 and profile.Daily.Streak + 1 or 1
	profile.Daily.Last = today()
	Stats.addAura(p, aura, { raw = true })
	if reward.Crates then
		Stats.addFreeCrates(p, reward.Crates)
	end
	Daily.refresh(p)
	Stats.send(p, "daily", day, aura, reward.Crates or 0)
end

return Daily
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: player save data. Loads/saves with DataStores when available; the game also runs
-- fine in unpublished places (progress just isn't kept).
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Data = {}

local profiles = {}
local savable = {}

local storeOk, store = pcall(function()
	return DataStoreService:GetDataStore("SubFiveToTrueAdamV1")
end)
if not storeOk then
	warn("[TrueAdam] Saving disabled (publish the place to enable it).")
	store = nil
end

local function defaults()
	return {
		Aura = 0,
		Level = 1,
		XP = 0,
		Power = 0,
		Style = 0,
		Charm = 0,
		Rebirths = 0,
		Levels = {},
		Inv = {}, -- cosmetic id -> stars
		Eq = {}, -- slot -> cosmetic id
		FreeCrates = 0,
		Wins = 0,
		Duels = 0,
		BestStreak = 0,
		Reps = 0,
		Swings = 0,
		Stage = 0, -- stage battles cleared
		Pets = {}, -- pet id -> copies owned
		PetsEq = {}, -- list of equipped pet ids
		Hatched = 0,
		Hammer = 1,
		HammersOwned = { ["1"] = true },
		Perfects = 0,
		CratesOpened = 0,
		Pity = { neon = 0, icon = 0 },
		QuestsDone = 0,
		Quest = nil,
		Daily = { Last = 0, Streak = 0 },
		Settings = { Music = true, Sfx = true, Duels = true, Fx = true },
		LastSeen = nil,
	}
end

-- Fills in anything missing so old saves keep working after updates.
local function reconcile(target, template)
	for k, v in template do
		if target[k] == nil then
			target[k] = type(v) == "table" and table.clone(v) or v
		elseif type(v) == "table" and type(target[k]) == "table" then
			reconcile(target[k], v)
		end
	end
end

function Data.load(p)
	local data
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("u" .. p.UserId)
		end)
		if ok then
			savable[p] = true
			data = result
		else
			warn("[TrueAdam] load failed (saving off for this session):", result)
		end
	end
	data = type(data) == "table" and data or {}
	reconcile(data, defaults())
	profiles[p] = data
	return data
end

function Data.get(p)
	return profiles[p]
end

function Data.save(p)
	local profile = profiles[p]
	if not store or not profile or not savable[p] then
		return
	end
	profile.LastSeen = os.time()
	local ok, err = pcall(function()
		store:SetAsync("u" .. p.UserId, profile)
	end)
	if not ok then
		warn("[TrueAdam] save failed:", err)
	end
end

function Data.release(p)
	Data.save(p)
	profiles[p] = nil
	savable[p] = nil
end

function Data.init()
	Players.PlayerRemoving:Connect(Data.release)
	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for _, p in Players:GetPlayers() do
			task.spawn(Data.save, p)
		end
		task.wait(3)
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in Players:GetPlayers() do
				task.spawn(Data.save, p)
			end
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Duels</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: "mog" duels. Two players (or a player and a bot) face off in a 7-second tap battle.
-- Your Glow Score gives you an edge, but a fast tapper can upset a higher-ranked rival.
-- Losing never costs you anything: you still get a consolation reward.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)

local Duels = {}

local rng = Random.new()
local arena -- { padA = CFrame, padB = CFrame, center = Vector3 }
local battleArena -- same, for the stage-battle lane
local queue = {} -- ordered list of waiting players
local duelOf = {} -- Player -> duel
local lastEnd = {} -- Player -> os.clock() of last duel end

function Duels.setArena(info, battle)
	arena = info
	battleArena = battle
end

local function removeFromQueue(p)
	local i = table.find(queue, p)
	if i then
		table.remove(queue, i)
	end
end

local function canDuel(p, forBattle)
	local profile = Data.get(p)
	if not profile or not (forBattle and battleArena or arena) then
		return false, "Duels aren't ready yet"
	end
	if not forBattle and not profile.Settings.Duels then
		return false, "Turn Duels on in Settings first"
	end
	if duelOf[p] or p:GetAttribute("InDuel") then
		return false, "You're already in a duel"
	end
	if p:GetAttribute("Training") then
		return false, "Finish training first"
	end
	if lastEnd[p] and os.clock() - lastEnd[p] < Config.Duel.Cooldown then
		return false, "Catch your breath for a second"
	end
	return true
end

local function setFrozen(p, frozen)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if frozen then
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
	else
		Stats.applyMovement(p)
	end
end

local function place(p, cf, where)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 3, 0), where.center + Vector3.new(0, 3, 0))
	end
end

local function effort(taps, myScore, oppScore)
	local maxTaps = Config.Duel.MaxTapsPerSecond * Config.Duel.Length
	local share = myScore / math.max(1, myScore + oppScore)
	return (math.min(taps, maxTaps) / maxTaps) * 50 + share * 50
end

local function finish(duel)
	if duel.over then
		return
	end
	duel.over = true
	local a, b = duel.a, duel.b
	local ta, tb = duel.tapsA, duel.tapsB

	local ea = effort(ta, duel.scoreA, duel.scoreB) * (0.94 + rng:NextNumber() * 0.12)
	local eb = effort(tb, duel.scoreB, duel.scoreA) * (0.94 + rng:NextNumber() * 0.12)
	local aWins = ea >= eb

	local function settle(p, wins, oppScore, myTaps, oppTaps, myEff, oppEff)
		if not p or p.Parent == nil then
			return
		end
		local profile = Data.get(p)
		if not profile then
			return
		end
		duelOf[p] = nil
		lastEnd[p] = os.clock()
		p:SetAttribute("InDuel", false)
		setFrozen(p, false)

		local reward = 60 + oppScore * 0.35
		local stage = duel.stage
		if stage then
			local def = Config.Battle.Stages[stage]
			reward = def.Reward
			local first = wins and stage > (profile.Stage or 0)
			if first then
				profile.Stage = stage
				p:SetAttribute("Stage", stage)
				Stats.addFreeCrates(p, stage % 5 == 0 and 2 or 0)
			else
				reward *= 0.4
			end
			Stats.send(p, "stageResult", stage, wins, first, profile.Stage or 0)
		end
		if wins then
			local streak = (p:GetAttribute("DuelStreak") or 0) + 1
			p:SetAttribute("DuelStreak", streak)
			profile.Wins += 1
			profile.BestStreak = math.max(profile.BestStreak, streak)
			p:SetAttribute("Wins", profile.Wins)
			reward *= 1 + math.min(streak - 1, 10) * 0.1
			Quests.progress(p, "duel", 1)
		else
			p:SetAttribute("DuelStreak", 0)
			reward *= 0.25
		end
		profile.Duels += 1
		Stats.addXP(p, wins and (40 + oppScore * 0.05) or 15)
		reward *= Stats.eventMult("DuelMult")
		local given = Stats.addAura(p, math.max(10, reward))
		Stats.send(p, "duelEnd", wins, given, myTaps, oppTaps, myEff, oppEff, p:GetAttribute("DuelStreak") or 0)
	end

	settle(a, aWins, duel.scoreB, ta, tb, ea, eb)
	settle(b, not aWins, duel.scoreA, tb, ta, eb, ea)
end

local function startDuel(a, b, opts)
	opts = opts or {}
	local where = opts.arena or arena
	removeFromQueue(a)
	if b then
		removeFromQueue(b)
	end
	local cfg = Config.Duel
	local now = workspace:GetServerTimeNow()
	local scoreA = Stats.score(a)
	local scoreB = opts.score or (b and Stats.score(b))
	if not scoreB then
		local streak = a:GetAttribute("DuelStreak") or 0
		scoreB = math.max(20, math.floor(scoreA * (0.75 + rng:NextNumber() * 0.5) * (1 + math.min(streak, 6) * 0.04)))
	end

	local duel = {
		a = a,
		b = b,
		scoreA = scoreA,
		scoreB = scoreB,
		tapsA = 0,
		tapsB = 0,
		tStart = now + cfg.Countdown,
		tEnd = now + cfg.Countdown + cfg.Length,
		botRate = opts.rate or (6 + rng:NextNumber() * 4),
		stage = opts.stage,
		over = false,
	}
	duelOf[a] = duel
	a:SetAttribute("InDuel", true)
	place(a, where.padA, where)
	setFrozen(a, true)
	if b then
		duelOf[b] = duel
		b:SetAttribute("InDuel", true)
		place(b, where.padB, where)
		setFrozen(b, true)
	end

	local function info(p)
		return p and { p.DisplayName, p:GetAttribute("Rank") or 1 } or { opts.name or "Mogger Bot", opts.rank or Config.RankFor(math.max(1, math.floor(scoreB / 10))) }
	end
	local ia, ib = info(a), info(b)
	Stats.send(a, "duelStart", ib[1], ib[2], scoreB, scoreA, duel.tStart, cfg.Length)
	if b then
		Stats.send(b, "duelStart", ia[1], ia[2], scoreA, scoreB, duel.tStart, cfg.Length)
	end

	-- Live progress for both sides (and the bot's simulated taps).
	task.spawn(function()
		while not duel.over do
			task.wait(0.25)
			local t = workspace:GetServerTimeNow()
			if not b and t > duel.tStart then
				local elapsed = math.min(t, duel.tEnd) - duel.tStart
				duel.tapsB = math.floor(elapsed * duel.botRate)
			end
			if a.Parent then
				Stats.send(a, "duelProgress", duel.tapsB)
			end
			if b and b.Parent then
				Stats.send(b, "duelProgress", duel.tapsA)
			end
		end
	end)
	task.delay(cfg.Countdown + cfg.Length + 0.5, function()
		finish(duel)
	end)
end

function Duels.joinQueue(p)
	local ok, why = canDuel(p)
	if not ok then
		if table.find(queue, p) then
			removeFromQueue(p)
			Stats.toast(p, "Left the duel queue", "info")
		else
			Stats.toast(p, why, "bad")
		end
		return
	end
	if table.find(queue, p) then
		removeFromQueue(p)
		Stats.toast(p, "Left the duel queue", "info")
		return
	end
	for _, other in queue do
		if other ~= p and other.Parent and canDuel(other) then
			startDuel(other, p)
			return
		end
	end
	table.insert(queue, p)
	Stats.toast(p, "Searching for a rival... a bot steps in after " .. Config.Duel.QueueBotAfter .. "s", "info")
	task.delay(Config.Duel.QueueBotAfter, function()
		if table.find(queue, p) and p.Parent and canDuel(p) then
			startDuel(p, nil)
		end
	end)
end

-- One of the 15 stage battles. Only the next unbeaten stage (or any earlier one) can be fought.
function Duels.stageFight(p)
	local ok, why = canDuel(p, true)
	if not ok then
		Stats.toast(p, why, "bad")
		return
	end
	local profile = Data.get(p)
	local cleared = profile.Stage or 0
	local stage = math.min(cleared + 1, Config.Battle.Count)
	local def = Config.Battle.Stages[stage]
	startDuel(p, nil, {
		arena = battleArena,
		stage = stage,
		name = "Stage " .. stage .. ": " .. def.Name,
		rank = def.Rank,
		score = def.Power,
		rate = def.Rate,
	})
	if battleArena.setOpponent then
		battleArena.setOpponent(def)
	end
end

function Duels.duelBot(p)
	local ok, why = canDuel(p)
	if not ok then
		Stats.toast(p, why, "bad")
		return
	end
	startDuel(p, nil)
end

function Duels.taps(p, n)
	local duel = duelOf[p]
	if not duel or duel.over or type(n) ~= "number" then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < duel.tStart - 0.1 or now > duel.tEnd + 0.2 then
		return
	end
	local elapsed = math.max(0, now - duel.tStart)
	local allowed = Config.Duel.MaxTapsPerSecond * elapsed + 4
	n = math.clamp(math.floor(n), 0, 20)
	if duel.a == p then
		duel.tapsA = math.min(duel.tapsA + n, allowed)
	else
		duel.tapsB = math.min(duel.tapsB + n, allowed)
	end
end

function Duels.release(p)
	removeFromQueue(p)
	local duel = duelOf[p]
	duelOf[p] = nil
	lastEnd[p] = nil
	if duel and not duel.over then
		-- A player who leaves forfeits; the other side is paid out immediately.
		if duel.a == p then
			duel.tapsA = 0
		else
			duel.tapsB = 0
		end
		finish(duel)
	end
end

function Duels.handle(p, kind, a)
	if kind == "DuelTaps" then
		Duels.taps(p, a)
	end
end

return Duels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: a server-wide event every few minutes. Clients read the "Event" attributes on workspace.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Shards = require(script.Parent.Shards)

local Events = {}

local rng = Random.new()

local function tint(color)
	local effect = Lighting:FindFirstChild("GlowTint")
	if effect then
		TweenService:Create(effect, TweenInfo.new(2), { TintColor = color }):Play()
	end
end

local function start(ev)
	workspace:SetAttribute("Event", ev.Id)
	workspace:SetAttribute("EventEnd", workspace:GetServerTimeNow() + ev.Duration)
	tint(ev.Tint)
	if ev.Id == "Storm" then
		Shards.storm(50)
	end
end

local function finish()
	workspace:SetAttribute("Event", "")
	tint(Color3.new(1, 1, 1))
	Shards.clearTemp()
end

function Events.init()
	workspace:SetAttribute("Event", "")
	task.spawn(function()
		task.wait(45)
		while true do
			local ev = Config.Events[rng:NextInteger(1, #Config.Events)]
			start(ev)
			task.wait(ev.Duration)
			finish()
			task.wait(rng:NextInteger(Config.EventGap[1], Config.EventGap[2]))
		end
	end)
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Hammers</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: click / tap to swing a hammer, plus buying and equipping hammers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)
local HammerModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HammerModel"))

local Hammers = {}

local lastSwing = {}
local combo = {} -- player -> swings in a row
local frenzyUntil = {} -- player -> os.clock when frenzy ends
local rng = Random.new()

local function setFrenzyEffect(p, on)
	local head = p.Character and p.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("FrenzyFx")
	if old then
		old:Destroy()
	end
	if on then
		local e = Instance.new("ParticleEmitter")
		e.Name = "FrenzyFx"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 40), Color3.fromRGB(255, 80, 60))
		e.LightEmission = 0.6
		e.Rate = 40
		e.Lifetime = NumberRange.new(0.6, 1.1)
		e.Speed = NumberRange.new(3, 8)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		e.Parent = head
	end
end

function Hammers.current(p)
	local profile = Data.get(p)
	return profile and Config.HammerById[profile.Hammer] or Config.Hammers[1]
end

function Hammers.swing(p)
	local profile = Data.get(p)
	if not profile or p:GetAttribute("Training") or p:GetAttribute("InDuel") then
		return
	end
	local now = os.clock()
	if now - (lastSwing[p] or 0) < Config.SwingInterval * 0.8 then
		return
	end
	local hammer = Hammers.current(p)
	-- Mog Streak: keep swinging without pausing to build up to FRENZY (double Aura).
	local f = Config.Frenzy
	if now - (lastSwing[p] or 0) <= f.Window + Config.SwingInterval then
		combo[p] = (combo[p] or 0) + 1
	else
		combo[p] = 1
	end
	lastSwing[p] = now
	local frenzy = (frenzyUntil[p] or 0) > now
	if not frenzy and combo[p] >= f.Combo then
		frenzy = true
		combo[p] = 0
		frenzyUntil[p] = now + f.Duration
		p:SetAttribute("FrenzyEnd", workspace:GetServerTimeNow() + f.Duration)
		setFrenzyEffect(p, true)
		Stats.send(p, "frenzy", f.Duration)
		task.delay(f.Duration + 0.1, function()
			if (frenzyUntil[p] or 0) <= os.clock() then
				setFrenzyEffect(p, false)
			end
		end)
	end
	p:SetAttribute("SwingCombo", combo[p] or 0)

	-- Variable reward: any swing can crit.
	local c = Config.Crit
	local roll = rng:NextNumber()
	local tag, critMult = nil, 1
	if roll < c.JackpotChance then
		tag, critMult = "jackpot", c.JackpotMult
	elseif roll < c.JackpotChance + c.Chance then
		tag, critMult = "crit", c.Mult
	end
	local gained = Stats.addAura(p, Config.SwingBase(profile.Level) * hammer.Mult * critMult * (frenzy and f.Mult or 1))
	profile.Swings += 1
	p:SetAttribute("Swings", profile.Swings)
	Stats.addXP(p, 0.6)
	Quests.progress(p, "swings", 1)
	Stats.send(p, "swing", gained, tag, frenzy)
end

-- Step on a pedestal and press the button: buys the hammer, or equips it if you own it.
function Hammers.use(p, id)
	local profile = Data.get(p)
	local hammer = Config.HammerById[id]
	if not profile or not hammer then
		return
	end
	local key = tostring(id)
	if not profile.HammersOwned[key] then
		if not Stats.spend(p, hammer.Price) then
			Stats.toast(p, "Not enough Aura for the " .. hammer.Name, "bad")
			return
		end
		profile.HammersOwned[key] = true
		Stats.send(p, "hammer", id, "bought")
	else
		if profile.Hammer == id then
			return
		end
		Stats.send(p, "hammer", id, "equipped")
	end
	profile.Hammer = id
	Stats.recompute(p)
	Hammers.attach(p)
end

-- Puts the equipped hammer in your right hand so everyone can see it.
function Hammers.attach(p)
	local char = p.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:WaitForChild("RightHand", 3))
	if not hand then
		return
	end
	local old = char:FindFirstChild("GlowHammer")
	if old then
		old:Destroy()
	end
	local hammer = Hammers.current(p)
	local model = HammerModel.build(hammer, hand.CFrame, char, { scale = 0.6 })
	model.Name = "GlowHammer"
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = model.PrimaryPart
	weld.C0 = CFrame.new(0, -0.35, -0.2) * CFrame.Angles(math.rad(-80), 0, 0)
	weld.Parent = model.PrimaryPart
	for _, child in model:GetChildren() do
		if child ~= model.PrimaryPart and child:IsA("BasePart") then
			local w = Instance.new("WeldConstraint")
			w.Part0 = model.PrimaryPart
			w.Part1 = child
			w.Parent = child
		end
	end
end

function Hammers.release(p)
	lastSwing[p] = nil
	combo[p] = nil
	frenzyUntil[p] = nil
end

return Hammers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Nameplate</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the tag above every player. It says what they are (their looks tier)
-- and their level, so everyone can see who's a Sub 5 and who's a True Adam.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local Nameplate = {}

local function build(p, head)
	local old = head:FindFirstChild("GlowPlate")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "GlowPlate"
	gui.Size = UDim2.fromOffset(320, 66)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 110
	gui.LightInfluence = 0
	gui.Parent = head

	local tier = Instance.new("TextLabel")
	tier.Name = "Rank"
	tier.Size = UDim2.new(1, 0, 0, 36)
	tier.BackgroundTransparency = 1
	tier.Font = Enum.Font.GothamBlack
	tier.TextScaled = true
	tier.TextStrokeTransparency = 0
	tier.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	tier.Parent = gui

	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.Position = UDim2.fromOffset(0, 36)
	name.Size = UDim2.new(1, 0, 0, 22)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextSize = 17
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.2
	name.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	name.Parent = gui
end

local function refresh(p)
	local head = p.Character and p.Character:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("GlowPlate")
	if not gui then
		return
	end
	local rank = Config.Ranks[p:GetAttribute("Rank") or 1]
	local stars = p:GetAttribute("Rebirths") or 0
	gui.Rank.Text = (stars > 0 and ("★" .. stars .. " ") or "") .. rank.Full:upper()
	gui.Rank.TextColor3 = rank.Color
	gui.Name.Text = string.format("%s  ·  Lv %s", p.DisplayName, Util.fmt(p:GetAttribute("Level") or 1))
end

function Nameplate.onCharacter(p)
	local char = p.Character
	local head = char and char:WaitForChild("Head", 5)
	if not head then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	build(p, head)
	refresh(p)
end

function Nameplate.init(p)
	for _, attr in { "Rank", "Level", "Rebirths" } do
		p:GetAttributeChangedSignal(attr):Connect(function()
			refresh(p)
		end)
	end
end

return Nameplate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: pets. Hatch eggs, equip up to 3; they follow you around (everyone sees them),
-- add to your Aura multiplier and earn Aura per second. The server decides every roll.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Pets = {}

local rng = Random.new()
local followers = {} -- player -> { { model, id } }
local folder

local SIZE = { Common = 1, Rare = 1.15, Epic = 1.3, Legendary = 1.5, Mythic = 1.75 }
local OFFSETS = { Vector3.new(-4, -1.4, 4.5), Vector3.new(0, -1.4, 7), Vector3.new(4, -1.4, 4.5) }

--------------------------------------------------------------------------------
-- Rolling
--------------------------------------------------------------------------------
local function rollPet(egg, luck)
	local lowest = math.huge
	for name in egg.Odds do
		lowest = math.min(lowest, Config.Rarities[name].Order)
	end
	local total, weights = 0, {}
	for _, name in Config.RarityOrder do
		local base = egg.Odds[name]
		if base then
			local w = Config.Rarities[name].Order == lowest and base or base * luck
			weights[name] = w
			total += w
		end
	end
	local roll = rng:NextNumber() * total
	local rarity = Config.RarityOrder[1]
	for _, name in Config.RarityOrder do
		local w = weights[name]
		if w then
			roll -= w
			rarity = name
			if roll <= 0 then
				break
			end
		end
	end
	local pool = {}
	for _, pet in Config.Pets do
		if pet.Rarity == rarity then
			table.insert(pool, pet)
		end
	end
	return pool[rng:NextInteger(1, #pool)]
end

function Pets.hatch(p, eggId)
	local egg = Config.EggById[eggId]
	local profile = Data.get(p)
	if not egg or not profile then
		return
	end
	if not Stats.spend(p, egg.Cost) then
		Stats.toast(p, "Not enough Aura for a " .. egg.Name, "bad")
		return
	end
	local pet = rollPet(egg, Config.LuckMult(profile.Levels.Luck or 0))
	local copies = (profile.Pets[pet.Id] or 0) + 1
	profile.Pets[pet.Id] = copies
	profile.Hatched += 1
	-- A new pet goes straight into an empty slot.
	if #profile.PetsEq < Config.PetSlots and not table.find(profile.PetsEq, pet.Id) then
		table.insert(profile.PetsEq, pet.Id)
	end
	Stats.recompute(p)
	Stats.addXP(p, 5)
	Pets.refresh(p)
	Stats.send(p, "hatch", egg.Id, pet.Id, copies)
end

function Pets.equip(p, id)
	local profile = Data.get(p)
	if not profile or not profile.Pets[id] or not Config.PetById[id] then
		return
	end
	if table.find(profile.PetsEq, id) then
		return
	end
	if #profile.PetsEq >= Config.PetSlots then
		Stats.toast(p, "All " .. Config.PetSlots .. " pet slots are full. Unequip one first.", "bad")
		return
	end
	table.insert(profile.PetsEq, id)
	Stats.recompute(p)
	Pets.refresh(p)
end

function Pets.unequip(p, id)
	local profile = Data.get(p)
	local at = profile and table.find(profile.PetsEq, id)
	if not at then
		return
	end
	table.remove(profile.PetsEq, at)
	Stats.recompute(p)
	Pets.refresh(p)
end

function Pets.handle(p, kind, id)
	if kind == "Hatch" and type(id) == "string" then
		Pets.hatch(p, id)
	elseif kind == "PetEquip" and type(id) == "string" then
		Pets.equip(p, id)
	elseif kind == "PetUnequip" and type(id) == "string" then
		Pets.unequip(p, id)
	end
end

--------------------------------------------------------------------------------
-- Followers (simple models made of balls)
--------------------------------------------------------------------------------
local function ball(model, name, size, color, material)
	local part = Instance.new("Part")
	part.Name = name
	part.Shape = Enum.PartType.Ball
	part.Size = Vector3.one * size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Massless = true
	part.Parent = model
	return part
end

local function buildPet(pet)
	local s = SIZE[pet.Rarity] or 1
	local model = Instance.new("Model")
	model.Name = "Pet_" .. pet.Id
	local body = ball(model, "Body", 2.4 * s, pet.Color)
	model.PrimaryPart = body
	local offsets = { [body] = CFrame.new() }
	local function add(part, cf)
		offsets[part] = cf
	end
	add(ball(model, "Head", 1.9 * s, pet.Color), CFrame.new(0, 1.7 * s, -0.3 * s))
	for side = -1, 1, 2 do
		add(ball(model, "Eye", 0.5 * s, Color3.new(1, 1, 1)), CFrame.new(side * 0.45 * s, 1.95 * s, -1.05 * s))
		add(ball(model, "Pupil", 0.25 * s, Color3.new(0, 0, 0)), CFrame.new(side * 0.45 * s, 1.95 * s, -1.25 * s))
		if pet.Style == "ears" or pet.Style == "mane" then
			add(ball(model, "Ear", 0.7 * s, pet.Color), CFrame.new(side * 0.8 * s, 2.7 * s, -0.2 * s))
		elseif pet.Style == "floppy" then
			add(ball(model, "Ear", 0.8 * s, pet.Color:Lerp(Color3.new(0, 0, 0), 0.25)), CFrame.new(side * 1.05 * s, 1.9 * s, -0.2 * s))
		elseif pet.Style == "horns" then
			add(ball(model, "Horn", 0.55 * s, Color3.fromRGB(250, 240, 220)), CFrame.new(side * 0.7 * s, 2.8 * s, -0.2 * s))
		elseif pet.Style == "fin" then
			add(ball(model, "Fin", 0.6 * s, pet.Color:Lerp(Color3.new(1, 1, 1), 0.3)), CFrame.new(side * 1.3 * s, 0.3 * s, 0))
		end
	end
	if pet.Style == "mane" then
		add(ball(model, "Mane", 2.8 * s, Color3.fromRGB(190, 110, 30)), CFrame.new(0, 1.7 * s, 0.4 * s))
	elseif pet.Style == "fin" then
		add(ball(model, "Fin", 0.7 * s, pet.Color:Lerp(Color3.new(1, 1, 1), 0.3)), CFrame.new(0, 3 * s, 0))
	elseif pet.Style == "halo" then
		local halo = Instance.new("Part")
		halo.Name = "Halo"
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.2, 1.8 * s, 1.8 * s)
		halo.Color = Color3.fromRGB(255, 232, 120)
		halo.Material = Enum.Material.SmoothPlastic
		halo.Anchored, halo.CanCollide, halo.CanQuery, halo.CanTouch, halo.Massless = true, false, false, false, true
		halo.Parent = model
		add(halo, CFrame.new(0, 3.1 * s, -0.3 * s) * CFrame.Angles(0, 0, math.pi / 2))
		local light = Instance.new("PointLight")
		light.Color = pet.Color
		light.Range = 12
		light.Brightness = 1
		light.Parent = body
	end
	add(ball(model, "Tail", 0.9 * s, pet.Color), CFrame.new(0, 0.2 * s, 1.4 * s))
	return model, offsets
end

local function clearFollowers(p)
	local list = followers[p]
	if list then
		for _, f in list do
			f.model:Destroy()
		end
	end
	followers[p] = nil
end

-- Rebuilds the visible pets so they match the equipped list.
function Pets.refresh(p)
	clearFollowers(p)
	local profile = Data.get(p)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not profile or not root or not folder then
		return
	end
	local list = {}
	for i, id in profile.PetsEq do
		local pet = Config.PetById[id]
		if pet then
			local model, offsets = buildPet(pet)
			model.Parent = folder
			local cf = root.CFrame * CFrame.new(OFFSETS[i] or OFFSETS[2])
			table.insert(list, { model = model, offsets = offsets, slot = i, cf = cf })
		end
	end
	followers[p] = list
end

function Pets.release(p)
	clearFollowers(p)
end

function Pets.init()
	folder = Instance.new("Folder")
	folder.Name = "GlowPets"
	folder.Parent = workspace
	local last = 0
	RunService.Heartbeat:Connect(function(dt)
		local now = os.clock()
		if now - last < 0.05 then
			return
		end
		last = now
		for p, list in followers do
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
			if root then
				for _, f in list do
					local target = root.CFrame * CFrame.new(OFFSETS[f.slot] or OFFSETS[2]) * CFrame.new(0, math.sin(now * 3 + f.slot) * 0.4, 0)
					f.cf = f.cf:Lerp(target, 0.3)
					-- face the same way as the owner
					local flat = CFrame.new(f.cf.Position) * (root.CFrame - root.CFrame.Position)
					for part, off in f.offsets do
						part.CFrame = flat * off
					end
				end
			end
		end
	end)
end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Playtime</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: play-time gifts. Stay in the server and gifts arrive on their own (Aura + crates),
-- each one bigger than the last. The HUD shows a countdown to the next one.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Playtime = {}

local sessions = {} -- player -> { joined = os.clock(), claimed = number }

function Playtime.init(p)
	sessions[p] = { joined = os.clock(), claimed = 0 }
	p:SetAttribute("GiftAt", workspace:GetServerTimeNow() + Config.Gifts[1].Time)
end

function Playtime.release(p)
	sessions[p] = nil
end

-- Called once a second for every player.
function Playtime.tick(p)
	local session = sessions[p]
	local profile = Data.get(p)
	if not session or not profile then
		return
	end
	local elapsed = os.clock() - session.joined
	local nextGift = Config.Gifts[session.claimed + 1]
	if nextGift and elapsed >= nextGift.Time then
		session.claimed += 1
		local aura = Config.GiftAura(profile.Level, nextGift.Size)
		Stats.addAura(p, aura, { raw = true })
		if nextGift.Crates > 0 then
			Stats.addFreeCrates(p, nextGift.Crates)
		end
		local following = Config.Gifts[session.claimed + 1]
		p:SetAttribute("GiftAt", following and (workspace:GetServerTimeNow() + following.Time - elapsed) or 0)
		Stats.send(p, "gift", aura, nextGift.Crates, session.claimed, #Config.Gifts)
	end
end

return Playtime
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: an endless chain of small goals. There is always exactly one active quest.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Quests = {}

local function writeQuest(p, quest)
	p:SetAttribute("QuestKind", quest.Kind)
	p:SetAttribute("QuestGoal", quest.Goal)
	p:SetAttribute("QuestReward", quest.Reward)
	p:SetAttribute("QuestProgress", quest.Progress or 0)
end

local function newQuest(p)
	local profile = Data.get(p)
	local q = Config.MakeQuest(profile.QuestsDone, profile.Rebirths)
	q.Progress = 0
	profile.Quest = q
	writeQuest(p, q)
end

function Quests.init(p)
	local profile = Data.get(p)
	local q = profile.Quest
	if type(q) == "table" and q.Kind and q.Goal and q.Reward then
		writeQuest(p, q)
	else
		newQuest(p)
	end
end

-- absolute = true means "progress is the max value reached" (not used by current quests, kept for flexibility).
function Quests.progress(p, kind, amount, absolute)
	local profile = Data.get(p)
	local q = profile and profile.Quest
	if not q or q.Kind ~= kind then
		return
	end
	q.Progress = absolute and math.max(q.Progress, amount) or q.Progress + amount
	if q.Progress < q.Goal then
		p:SetAttribute("QuestProgress", q.Progress)
		return
	end

	profile.QuestsDone += 1
	Stats.addAura(p, q.Reward, { raw = true })
	Stats.addXP(p, 25 + profile.QuestsDone * 5)
	local bonus = ""
	if profile.QuestsDone % 5 == 0 then
		Stats.addFreeCrates(p, 1)
		bonus = " + free crate"
	end
	Stats.send(p, "quest", Config.QuestText(q.Kind, q.Goal), q.Reward, bonus)
	newQuest(p)
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Quirks</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the gag that gives the game its name. Everyone starts with a goofy face, a big
-- belly and hair all over their face and body. As you level up it all fades away until you look normal
-- (around level 600) and keep getting more athletic. Everything is built from simple parts.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Appearance = require(script.Parent.Appearance)

local Quirks = {}

local FOLDER = "GlowQuirks"
local FUR = Color3.fromRGB(46, 32, 22)

local function bit(props)
	local part = Instance.new("Part")
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		part[k] = v
	end
	return part
end

local function stick(part, base, offset, folder)
	part.CFrame = base.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function ball(size, color)
	return bit({ Shape = Enum.PartType.Ball, Size = Vector3.one * size, Color = color })
end

local function restoreFace(head)
	for _, child in head:GetChildren() do
		if child:IsA("Decal") then
			child.Transparency = 0
		end
	end
end

local function hideFace(head)
	for _, child in head:GetChildren() do
		if child:IsA("Decal") then
			child.Transparency = 1
		end
	end
end

-- Finds a body part by its R15 or R6 name.
local function limb(char, r15, r6)
	return char:FindFirstChild(r15) or char:FindFirstChild(r6)
end

function Quirks.apply(p)
	local char = p.Character
	local profile = Data.get(p)
	if not char or not profile then
		return
	end
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not head or not torso then
		return
	end
	local old = char:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end

	local w = Config.Weirdness(profile.Level)
	if w <= 0.02 then
		restoreFace(head)
		return
	end

	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	folder.Parent = char

	local T = Appearance.torsoDims(p)
	local dims = Appearance.headDims(p)
	local W, H, D = dims.X, dims.Y, dims.Z
	local skin = head.Color
	local rng = Random.new(p.UserId) -- same layout every time, so hair doesn't "jump" between levels

	-- e: how exaggerated the face still is (shrinks a little with every level)
	local e = 0.45 + 0.55 * w
	-- ===== The face =====
	if w > 0.15 then
		hideFace(head)
		local faceZ = -D * 0.5
		-- Mismatched, cross-eyed eyes
		stick(ball(W * 0.34 * e, Color3.new(1, 1, 1)), head, CFrame.new(-W * 0.22, H * 0.1, faceZ), folder)
		stick(ball(W * 0.2, Color3.new(1, 1, 1)), head, CFrame.new(W * 0.2, H * 0.2, faceZ), folder)
		stick(ball(W * 0.13, Color3.new(0, 0, 0)), head, CFrame.new(-W * 0.14, H * 0.08, faceZ - W * 0.15), folder)
		stick(ball(W * 0.09, Color3.new(0, 0, 0)), head, CFrame.new(W * 0.15, H * 0.18, faceZ - W * 0.08), folder)
		-- One big hairy unibrow
		stick(bit({ Size = Vector3.new(W * 0.8, H * 0.13 * e, D * 0.12), Color = FUR }), head, CFrame.new(0, H * 0.34, faceZ) * CFrame.Angles(0, 0, 0.12), folder)
		-- Giant nose with nostrils
		stick(ball(W * 0.3 * e, skin), head, CFrame.new(0, -H * 0.1, faceZ - W * 0.08), folder)
		stick(ball(W * 0.07, Color3.fromRGB(40, 20, 20)), head, CFrame.new(-W * 0.07, -H * 0.16, faceZ - W * 0.28), folder)
		stick(ball(W * 0.07, Color3.fromRGB(40, 20, 20)), head, CFrame.new(W * 0.07, -H * 0.16, faceZ - W * 0.28), folder)
		-- Crooked mouth with buck teeth
		stick(bit({ Size = Vector3.new(W * 0.5, H * 0.1, D * 0.06), Color = Color3.fromRGB(70, 20, 30) }), head, CFrame.new(W * 0.04, -H * 0.34, faceZ) * CFrame.Angles(0, 0, 0.14), folder)
		for side = -1, 1, 2 do
			if w > 0.45 then
			stick(bit({ Size = Vector3.new(W * 0.11, H * 0.17, D * 0.06), Color = Color3.fromRGB(250, 248, 235) }), head, CFrame.new(W * 0.04 + side * W * 0.065, -H * 0.4, faceZ - D * 0.02), folder)
			end
		end
		-- Bushy mustache
		for side = -1, 1, 2 do
			if w > 0.3 then
			stick(bit({ Size = Vector3.new(W * 0.3, H * 0.12, D * 0.1), Color = FUR }), head, CFrame.new(side * W * 0.16, -H * 0.24, faceZ - D * 0.04) * CFrame.Angles(0, 0, -side * 0.18), folder)
			end
		end
	else
		restoreFace(head)
	end

	-- ===== Hair all over the face =====
	local faceHair = math.ceil(34 * w)
	for _ = 1, faceHair do
		local x = (rng:NextNumber() - 0.5) * W * 0.95
		local y = -H * (0.12 + rng:NextNumber() * 0.4)
		local zFront = rng:NextNumber() < 0.7
		local z = zFront and (-D * 0.5) or (-D * 0.3 + rng:NextNumber() * D * 0.4)
		local xSide = zFront and x or ((rng:NextNumber() < 0.5 and -1 or 1) * W * 0.5)
		stick(ball(W * (0.1 + rng:NextNumber() * 0.12), FUR), head, CFrame.new(xSide, y, z), folder)
	end
	-- Messy hair on top
	local topHair = math.ceil(16 * w)
	for _ = 1, topHair do
		local x = (rng:NextNumber() - 0.5) * W * 0.8
		local z = (rng:NextNumber() - 0.5) * D * 0.8
		local tuft = bit({ Size = Vector3.new(W * 0.08, H * (0.25 + rng:NextNumber() * 0.25), W * 0.08), Color = FUR })
		stick(tuft, head, CFrame.new(x, H * 0.55, z) * CFrame.Angles((rng:NextNumber() - 0.5) * 0.9, 0, (rng:NextNumber() - 0.5) * 0.9), folder)
	end

	-- ===== Belly =====
	local bellySize = math.max(T.X, 2) * 0.85 * (0.3 + 0.7 * w)
	local belly = ball(bellySize, skin)
	stick(belly, torso, CFrame.new(0, -T.Y * 0.35, -T.Z * 0.5 - bellySize * 0.05), folder)
	stick(ball(bellySize * 0.1, Color3.fromRGB(80, 50, 40)), torso, CFrame.new(0, -T.Y * 0.3, -T.Z * 0.5 - bellySize * 0.5), folder)

	-- ===== Hair on the body =====
	local arms = {
		limb(char, "LeftUpperArm", "Left Arm"),
		limb(char, "RightUpperArm", "Right Arm"),
	}
	local bodyHair = math.ceil(60 * w)
	for i = 1, bodyHair do
		local base, offset
		if i % 3 == 0 and arms[1] then
			base = arms[(i % 2) + 1] or arms[1]
			offset = CFrame.new((rng:NextNumber() < 0.5 and -1 or 1) * 0.55, (rng:NextNumber() - 0.5) * 0.9, (rng:NextNumber() - 0.5) * 0.5)
		else
			base = torso
			local face = rng:NextInteger(1, 3)
			if face == 1 then -- front (chest)
				offset = CFrame.new((rng:NextNumber() - 0.5) * T.X * 0.8, T.Y * (0.05 + rng:NextNumber() * 0.4), -T.Z * 0.5)
			elseif face == 2 then -- back
				offset = CFrame.new((rng:NextNumber() - 0.5) * T.X * 0.8, (rng:NextNumber() - 0.5) * T.Y * 0.8, T.Z * 0.5)
			else -- sides
				offset = CFrame.new((rng:NextNumber() < 0.5 and -1 or 1) * T.X * 0.5, (rng:NextNumber() - 0.5) * T.Y * 0.8, (rng:NextNumber() - 0.5) * T.Z * 0.7)
			end
		end
		local tuft = bit({ Size = Vector3.new(0.14, 0.5 + rng:NextNumber() * 0.4, 0.14), Color = FUR })
		stick(tuft, base, offset * CFrame.Angles((rng:NextNumber() - 0.5) * 1.2, 0, (rng:NextNumber() - 0.5) * 1.2), folder)
	end
end

return Quirks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Runway</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the runway in the middle of the district. Walk it for a steady Aura trickle that
-- scales with your Glow Score, so a great look pays you just for strutting.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Stats = require(script.Parent.Stats)

local Runway = {}

function Runway.init()
	local halfWidth = Config.Runway.HalfWidth
	task.spawn(function()
		while true do
			task.wait(1)
			for _, p in Players:GetPlayers() do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				local profileReady = p:GetAttribute("Ready")
				if root and profileReady and not p:GetAttribute("InDuel") then
					local pos = root.Position
					local onRunway = math.abs(pos.X) <= halfWidth and pos.Z >= Config.Runway.MinZ and pos.Z <= Config.Runway.MaxZ and pos.Y < 8
					local walking = root.AssemblyLinearVelocity.Magnitude > 4
					p:SetAttribute("OnRunway", onRunway)
					if onRunway and walking then
						local perSecond = math.max(2, Stats.score(p) * Config.Runway.AuraPerScore)
						Stats.addAuraFractional(p, perSecond * Stats.eventMult("RunwayMult"))
						Stats.addXP(p, math.max(0.5, Stats.score(p) * 0.004))
					end
				end
			end
		end
	end)
end

return Runway
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Shards</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the gym-and-health pickups scattered around the plaza: apples, protein shakes,
-- dumbbells and trophies. Walk near one to grab it. Chaining pickups quickly builds a multiplier.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")
local CollectionService = game:GetService("CollectionService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)

local Shards = {}

local rng = Random.new()
local folder
local live = {} -- item Model -> slot
local slots = {}

local function pickType(luck)
	local total, weights = 0, {}
	for i, t in Config.ShardTypes do
		local w = t.Weight * (i >= 3 and (1 + luck * 0.5) or 1)
		weights[i] = w
		total += w
	end
	local roll = rng:NextNumber() * total
	for i, t in Config.ShardTypes do
		roll -= weights[i]
		if roll <= 0 then
			return t
		end
	end
	return Config.ShardTypes[1]
end

local function rollMutation()
	for _, m in Config.ShardMutations do
		if rng:NextNumber() < m.Chance then
			return m
		end
	end
	return nil
end

--------------------------------------------------------------------------------
-- Item models (simple parts, so they read as real objects)
--------------------------------------------------------------------------------
local UP = CFrame.Angles(0, 0, math.pi / 2) -- turns a (sideways) cylinder upright

local function piece(model, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		p[k] = v
	end
	p.Parent = model
	return p
end

local function ballPiece(model, size, cf, color)
	return piece(model, { Shape = Enum.PartType.Ball, Size = Vector3.one * size, CFrame = cf, Color = color })
end

local function cyl(model, length, diameter, cf, color, material)
	return piece(model, {
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(length, diameter, diameter),
		CFrame = cf,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
	})
end

local builders = {}

function builders.apple(model, cf, s, color)
	local body = ballPiece(model, 2.2 * s, cf, color)
	piece(model, { Size = Vector3.new(0.16, 0.6, 0.16) * s, CFrame = cf * CFrame.new(0, 1.15 * s, 0), Color = Color3.fromRGB(100, 70, 40) })
	piece(model, { Size = Vector3.new(0.8, 0.12, 0.45) * s, CFrame = cf * CFrame.new(0.4 * s, 1.3 * s, 0) * CFrame.Angles(0, 0, 0.4), Color = Color3.fromRGB(70, 180, 70) })
	return body
end

function builders.shake(model, cf, s, color)
	local body = cyl(model, 3 * s, 1.5 * s, cf * UP, color)
	cyl(model, 1.1 * s, 1.56 * s, cf * UP, Color3.fromRGB(250, 250, 252)) -- label band
	cyl(model, 0.5 * s, 1.6 * s, cf * CFrame.new(0, 1.75 * s, 0) * UP, Color3.fromRGB(40, 40, 48)) -- lid
	return body
end

function builders.dumbbell(model, cf, s, color)
	local bar = cyl(model, 3.4 * s, 0.5 * s, cf, Color3.fromRGB(200, 205, 215), Enum.Material.Metal)
	for side = -1, 1, 2 do
		cyl(model, 0.55 * s, 2.3 * s, cf * CFrame.new(side * 1.25 * s, 0, 0), color, Enum.Material.Metal)
		cyl(model, 0.45 * s, 1.5 * s, cf * CFrame.new(side * 1.7 * s, 0, 0), Color3.fromRGB(190, 195, 205), Enum.Material.Metal)
	end
	return bar
end

function builders.trophy(model, cf, s, color)
	local cup = cyl(model, 1.7 * s, 2 * s, cf * CFrame.new(0, 0.5 * s, 0) * UP, color, Enum.Material.Metal)
	cyl(model, 1.1 * s, 0.4 * s, cf * CFrame.new(0, -0.7 * s, 0) * UP, color, Enum.Material.Metal)
	piece(model, { Size = Vector3.new(1.8, 0.4, 1.8) * s, CFrame = cf * CFrame.new(0, -1.4 * s, 0), Color = Color3.fromRGB(60, 40, 30), Material = Enum.Material.Wood })
	for side = -1, 1, 2 do
		cyl(model, 0.25 * s, 0.9 * s, cf * CFrame.new(side * 1.15 * s, 0.6 * s, 0), color, Enum.Material.Metal)
	end
	return cup
end

local function spawn(slot)
	local t = pickType(slot.luck)
	local mut = rollMutation()
	local itemColor = mut and mut.Color or t.Color

	local model = Instance.new("Model")
	model.Name = "Shard"
	local scale = 1 + t.Scale * 0.5 + (mut and 0.2 or 0)
	local primary = builders[t.Kind](model, CFrame.new(slot.pos), scale, t.Color)
	model.PrimaryPart = primary

	model:SetAttribute("Value", t.Value * (mut and mut.Mult or 1))
	model:SetAttribute("Tier", t.Name)
	model:SetAttribute("Mut", mut and mut.Name or nil)
	model:SetAttribute("ItemColor", itemColor)
	model:SetAttribute("Pos", slot.pos)

	-- Only valuable or mutated ones twinkle, so the plaza stays clean.
	if mut or t.Value >= 60 then
		local e = Instance.new("ParticleEmitter")
		e.Color = ColorSequence.new(Color3.new(1, 1, 1), itemColor)
		e.LightEmission = 0.5
		e.Rate = mut and 14 or 5
		e.Lifetime = NumberRange.new(0.8, 1.5)
		e.Speed = NumberRange.new(0.5, 1.5)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		e.Parent = primary
	end

	CollectionService:AddTag(model, "Shard")
	model.Parent = folder
	live[model] = slot
end

function Shards.build(slotPositions)
	folder = Instance.new("Folder")
	folder.Name = "Pickups"
	folder.Parent = workspace
	for _, pos in slotPositions do
		local slot = { pos = pos, luck = 0 }
		table.insert(slots, slot)
		spawn(slot)
	end
end

-- A burst of rich temporary pickups (Pickup Storm event).
function Shards.storm(count)
	local r = Config.PlazaRadius - 10
	for _ = 1, count do
		local a = rng:NextNumber() * math.pi * 2
		local d = math.sqrt(rng:NextNumber()) * r
		spawn({ pos = Vector3.new(math.cos(a) * d, 3.4, math.sin(a) * d), luck = 6, temp = true })
	end
end

function Shards.clearTemp()
	for shard, slot in live do
		if slot.temp then
			live[shard] = nil
			shard:Destroy()
		end
	end
end

local function collect(p, shard, slot)
	if not live[shard] then
		return
	end
	live[shard] = nil
	shard:SetAttribute("Taken", true)

	local now = workspace:GetServerTimeNow()
	local chain = p:GetAttribute("Chain") or 0
	if now > (p:GetAttribute("ChainExpire") or 0) then
		chain = 0
	end
	chain = math.min(chain + 1, Config.ChainMax)
	p:SetAttribute("Chain", chain)
	p:SetAttribute("ChainExpire", now + Config.ChainWindow)

	local rank = p:GetAttribute("Rank") or 1
	local value = shard:GetAttribute("Value")
	local base = value * Config.RankScaling(rank) * Config.ChainMult(chain)
	local gained = Stats.addAura(p, base)
	Stats.addXP(p, value)
	Stats.send(p, "shard", slot.pos, gained, shard:GetAttribute("Tier"), shard:GetAttribute("ItemColor"), shard:GetAttribute("Mut"), chain)
	Quests.progress(p, "shards", 1)

	Debris:AddItem(shard, 0.3) -- the client flies it into the player first
	if not slot.temp then
		task.delay(Config.ShardRespawn, function()
			spawn(slot)
		end)
	end
end

function Shards.init()
	local acc = 0
	RunService.Heartbeat:Connect(function(dt)
		acc += dt
		if acc < 0.1 then
			return
		end
		acc = 0
		for _, p in Players:GetPlayers() do
			local char = p.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if root and hum and hum.Health > 0 then
				local radius = p:GetAttribute("MagnetRadius") or 9
				local pos = root.Position
				for shard, slot in live do
					if (slot.pos - pos).Magnitude <= radius then
						collect(p, shard, slot)
					end
				end
			end
		end
	end)
end

return Shards
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: upgrades and rebirth.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Shop = {}

local upgradeById = {}
for _, def in Config.Upgrades do
	upgradeById[def.Id] = def
end

function Shop.buy(p, id)
	local def = upgradeById[id]
	local profile = Data.get(p)
	if not def or not profile then
		return
	end
	local level = profile.Levels[id] or 0
	if level >= def.Max then
		return
	end
	if not Stats.spend(p, Config.UpgradeCost(def, level)) then
		Stats.toast(p, "Not enough Aura", "bad")
		return
	end
	profile.Levels[id] = level + 1
	p:SetAttribute("Lv_" .. id, level + 1)
	Stats.applyMovement(p)
	Stats.recompute(p)
	Stats.send(p, "upgrade", id, level + 1)
end

function Shop.rebirth(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	if profile.Level < Config.RebirthRequirement(profile.Rebirths) then
		Stats.toast(p, "Reach level " .. Config.RebirthRequirement(profile.Rebirths) .. " to rebirth", "bad")
		return
	end
	profile.Rebirths += 1
	profile.Power, profile.Style, profile.Charm = 0, 0, 0
	profile.Levels = {}
	for _, def in Config.Upgrades do
		p:SetAttribute("Lv_" .. def.Id, 0)
	end
	Stats.setAura(p, 0)
	Stats.addFreeCrates(p, 2)
	Stats.applyMovement(p)
	Stats.recompute(p)
	Stats.send(p, "rebirth", profile.Rebirths)
end

function Shop.handle(p, kind, a)
	if kind == "Buy" and type(a) == "string" then
		Shop.buy(p, a)
	elseif kind == "Rebirth" then
		Shop.rebirth(p)
	end
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the heart of progression. Owns Aura, stats, Glow Score, rank and the
-- attributes the client reads. Every other system goes through here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Appearance = require(script.Parent.Appearance)

local Stats = {}

local function notify()
	return ReplicatedStorage:WaitForChild("Net"):WaitForChild("Notify")
end

--------------------------------------------------------------------------------
-- Small helpers
--------------------------------------------------------------------------------
function Stats.toast(p, text, kind)
	notify():FireClient(p, "toast", text, kind or "info")
end

function Stats.send(p, ...)
	notify():FireClient(p, ...)
end

local function currentEvent()
	local id = workspace:GetAttribute("Event")
	return id and id ~= "" and Config.EventById[id] or nil
end

function Stats.eventMult(kind)
	local ev = currentEvent()
	return ev and ev[kind] or 1
end

--------------------------------------------------------------------------------
-- Derived values
--------------------------------------------------------------------------------
function Stats.level(p, id)
	local profile = Data.get(p)
	return profile and profile.Levels[id] or 0
end

-- "Mog Power": what duels and competitions compare. Level, stats and gear all count.
function Stats.computeScore(profile)
	local statTotal = profile.Power + profile.Style + profile.Charm
	local total = statTotal * Config.StatScore + profile.Level * 8
	for slot, id in profile.Eq do
		local c = Config.CosmeticById[id]
		local stars = profile.Inv[id]
		if c and stars then
			total += Config.CosmeticPower(c, stars)
		end
	end
	return math.floor(total * Config.RebirthMult(profile.Rebirths))
end

-- Extra Aura multiplier and Aura/second from equipped pets.
function Stats.petBonus(profile)
	local mult, aps = 0, 0
	for _, id in profile.PetsEq do
		local pet = Config.PetById[id]
		local copies = profile.Pets[id]
		if pet and copies then
			mult += Config.PetMult(pet, copies)
			aps += Config.PetAps(pet, copies)
		end
	end
	return mult, aps
end

function Stats.computeRate(profile)
	local total = 0
	for slot, id in profile.Eq do
		local c = Config.CosmeticById[id]
		local stars = profile.Inv[id]
		if c and stars then
			total += Config.CosmeticAps(c, stars)
		end
	end
	local _, petAps = Stats.petBonus(profile)
	return (total + petAps) * Config.RebirthMult(profile.Rebirths) * Config.BoostMult(profile.Levels.Boost or 0)
end

function Stats.score(p)
	return p:GetAttribute("GlowScore") or 0
end

--------------------------------------------------------------------------------
-- Attribute mirror (what the client sees)
--------------------------------------------------------------------------------
local function setLeaderstat(p, name, value)
	local ls = p:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v then
		v.Value = value
	end
end

function Stats.ownedString(profile)
	local ids = {}
	for k in profile.HammersOwned do
		table.insert(ids, tonumber(k))
	end
	table.sort(ids)
	return table.concat(ids, ",")
end

function Stats.recompute(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	local oldRank = p:GetAttribute("Rank") or 1
	local score = Stats.computeScore(profile)
	local rank = Config.RankFor(profile.Level)

	p:SetAttribute("GlowScore", score)
	p:SetAttribute("AuraRate", Stats.computeRate(profile))
	p:SetAttribute("Rank", rank)
	p:SetAttribute("Level", profile.Level)
	p:SetAttribute("XP", math.floor(profile.XP))
	p:SetAttribute("XPNeeded", Config.XPForLevel(profile.Level))
	p:SetAttribute("Power", math.floor(profile.Power * 10) / 10)
	p:SetAttribute("Style", math.floor(profile.Style * 10) / 10)
	p:SetAttribute("Charm", math.floor(profile.Charm * 10) / 10)
	p:SetAttribute("Rebirths", profile.Rebirths)
	p:SetAttribute("RebirthNeed", Config.RebirthRequirement(profile.Rebirths))
	p:SetAttribute("Hammer", profile.Hammer)
	p:SetAttribute("HammersOwned", Stats.ownedString(profile))
	p:SetAttribute("Swings", profile.Swings)
	p:SetAttribute("Stage", profile.Stage)
	local petMult = Stats.petBonus(profile)
	p:SetAttribute("PetMult", petMult)
	p:SetAttribute("PetsEq", table.concat(profile.PetsEq, ","))
	local owned = {}
	for id, n in profile.Pets do
		table.insert(owned, id .. ":" .. n)
	end
	table.sort(owned)
	p:SetAttribute("Pets", table.concat(owned, ","))
	setLeaderstat(p, "Level", profile.Level)
	setLeaderstat(p, "Rebirths", profile.Rebirths)

	if rank > oldRank and p:GetAttribute("Ready") then
		Stats.send(p, "rank", rank)
	end
	p:SetAttribute("MagnetRadius", Config.MagnetRadius(profile.Levels.Magnet or 0))
end

--------------------------------------------------------------------------------
-- XP and levels
--------------------------------------------------------------------------------
-- Your look speeds up levelling: more stats and better gear means more XP from everything.
function Stats.xpMult(p)
	local profile = Data.get(p)
	if not profile then
		return 1
	end
	local power = (profile.Power + profile.Style + profile.Charm) * Config.StatScore
	for _, id in profile.Eq do
		local c = Config.CosmeticById[id]
		local stars = profile.Inv[id]
		if c and stars then
			power += Config.CosmeticPower(c, stars)
		end
	end
	return (1 + power / 120) * Config.RebirthMult(profile.Rebirths)
end

function Stats.addXP(p, base)
	local profile = Data.get(p)
	if not profile or profile.Level >= Config.MaxLevel then
		return
	end
	profile.XP += base * Stats.xpMult(p)
	local leveled = false
	local needed = Config.XPForLevel(profile.Level)
	while profile.XP >= needed and profile.Level < Config.MaxLevel do
		profile.XP -= needed
		profile.Level += 1
		needed = Config.XPForLevel(profile.Level)
		leveled = true
		local aura = profile.Level * 15 * (1 + profile.Rebirths)
		Stats.addAura(p, aura, { raw = true })
		local crates = profile.Level % 10 == 0 and 1 or 0
		if crates > 0 then
			Stats.addFreeCrates(p, crates)
		end
		if p:GetAttribute("Ready") then
			Stats.send(p, "level", profile.Level, aura, crates)
		end
	end
	if profile.Level >= Config.MaxLevel then
		profile.XP = 0
	end
	Stats.recompute(p)
	if leveled then
		Appearance.update(p)
	end
end

function Stats.init(p)
	local profile = Data.get(p)

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in { "Aura", "Level", "Rebirths" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
	end
	ls.Parent = p

	p:SetAttribute("Aura", math.floor(profile.Aura))
	setLeaderstat(p, "Aura", math.floor(profile.Aura))
	for _, def in Config.Upgrades do
		p:SetAttribute("Lv_" .. def.Id, profile.Levels[def.Id] or 0)
	end
	p:SetAttribute("FreeCrates", profile.FreeCrates)
	for _, crate in Config.Crates do
		if crate.PityAfter then
			p:SetAttribute("Pity_" .. crate.Id, profile.Pity[crate.Id] or 0)
		end
	end
	p:SetAttribute("Wins", profile.Wins)
	p:SetAttribute("DuelStreak", 0)
	p:SetAttribute("Chain", 0)
	p:SetAttribute("ChainExpire", 0)
	for key, value in profile.Settings do
		p:SetAttribute("Set_" .. key, value)
	end
	Stats.recompute(p)
	p:SetAttribute("Ready", true)
end

--------------------------------------------------------------------------------
-- Aura
--------------------------------------------------------------------------------
function Stats.getAura(p)
	local profile = Data.get(p)
	return profile and profile.Aura or 0
end

local function writeAura(p, profile)
	profile.Aura = math.max(0, profile.Aura)
	local shown = math.floor(profile.Aura)
	p:SetAttribute("Aura", shown)
	setLeaderstat(p, "Aura", shown)
end

-- Adds Aura including every multiplier. opts.raw skips multipliers. Returns the amount given.
function Stats.addAura(p, base, opts)
	local profile = Data.get(p)
	if not profile then
		return 0
	end
	local amount = base
	if not (opts and opts.raw) then
		amount = base
			* Config.RebirthMult(profile.Rebirths)
			* Config.BoostMult(profile.Levels.Boost or 0)
			* Stats.eventMult("AuraMult")
			* (1 + (Stats.petBonus(profile)))
	end
	amount = math.max(0, math.floor(amount + 0.5))
	profile.Aura += amount
	writeAura(p, profile)
	return amount
end

-- Fractional income (runway, idle rate) accumulates here so small amounts aren't lost.
local fractions = {}
function Stats.addAuraFractional(p, base, opts)
	local profile = Data.get(p)
	if not profile then
		return 0
	end
	local amount = base
	if not (opts and opts.raw) then
		amount = base * Config.RebirthMult(profile.Rebirths) * Stats.eventMult("AuraMult")
	end
	local acc = (fractions[p] or 0) + amount
	local whole = math.floor(acc)
	fractions[p] = acc - whole
	if whole > 0 then
		profile.Aura += whole
		writeAura(p, profile)
	end
	return whole
end

function Stats.spend(p, cost)
	local profile = Data.get(p)
	if not profile or profile.Aura < cost then
		return false
	end
	profile.Aura -= cost
	writeAura(p, profile)
	return true
end

function Stats.setAura(p, value)
	local profile = Data.get(p)
	if profile then
		profile.Aura = value
		writeAura(p, profile)
	end
end

function Stats.addStat(p, stat, amount)
	local profile = Data.get(p)
	if not profile or profile[stat] == nil then
		return
	end
	profile[stat] += amount
	Stats.recompute(p)
end

function Stats.addFreeCrates(p, n)
	local profile = Data.get(p)
	profile.FreeCrates += n
	p:SetAttribute("FreeCrates", profile.FreeCrates)
end

function Stats.setSetting(p, key, value)
	local profile = Data.get(p)
	if profile and profile.Settings[key] ~= nil then
		profile.Settings[key] = value and true or false
		p:SetAttribute("Set_" .. key, profile.Settings[key])
	end
end

--------------------------------------------------------------------------------
-- Movement
--------------------------------------------------------------------------------
function Stats.applyMovement(p)
	local profile = Data.get(p)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not profile or not hum then
		return
	end
	hum.WalkSpeed = Config.WalkSpeed(profile.Levels.Boots or 0)
	hum.UseJumpPower = false
	hum.JumpHeight = 7.5
end

function Stats.forget(p)
	fractions[p] = nil
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Training</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the training minigame. A marker sweeps a bar; hit the zone for stat gains.
-- The server picks the zone, computes where the marker was when you pressed, and grades it,
-- so the result can't be faked from the client.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)

local Training = {}

local rng = Random.new()
local sessions = {} -- Player -> session

local GOOD_WIDTH = 0.26
local PERFECT_WIDTH = 0.09
local REP_TIMEOUT = 5

local function newRep(session)
	session.rep += 1
	session.token += 1
	session.resolved = false
	session.speed = 0.9 + 0.15 * session.rep
	session.center = 0.3 + rng:NextNumber() * 0.4
	session.startedAt = workspace:GetServerTimeNow() + 1.1
	return {
		rep = session.rep,
		reps = Config.TrainReps,
		startedAt = session.startedAt,
		speed = session.speed,
		center = session.center,
		goodWidth = GOOD_WIDTH,
		perfectWidth = PERFECT_WIDTH,
	}
end

local resolve

local function armTimeout(p, session)
	local token = session.token
	task.delay(REP_TIMEOUT + 1.1, function()
		if sessions[p] == session and session.token == token and not session.resolved then
			resolve(p, session, "miss")
		end
	end)
end

resolve = function(p, session, grade)
	if session.resolved then
		return
	end
	session.resolved = true
	local profile = Data.get(p)
	local gain = 0

	if grade == "perfect" then
		session.streak += 1
	elseif grade == "miss" then
		session.streak = 0
	end

	if grade ~= "miss" and profile then
		local base = grade == "perfect" and 2 or 1
		local streakMult = 1 + math.min(session.streak, 5) * 0.1
		gain = base * Config.TrainMult(profile.Levels.Training or 0) * streakMult
		Stats.addStat(p, session.stat, gain)
		Stats.addAura(p, gain * 4 * Config.RankScaling(p:GetAttribute("Rank") or 1))
		Stats.addXP(p, gain * 10)
		profile.Reps += 1
		Quests.progress(p, "train", 1)
		if grade == "perfect" then
			profile.Perfects += 1
			Quests.progress(p, "perfect", 1)
		end
		session.total += gain
	end

	local nextRep
	local done = session.rep >= Config.TrainReps
	if not done then
		nextRep = newRep(session)
		armTimeout(p, session)
	end
	Stats.send(p, "trainRep", session.rep - (done and 0 or 1), grade, gain, session.streak, nextRep)
	if done then
		Stats.send(p, "trainEnd", session.stat, session.total)
		sessions[p] = nil
		p:SetAttribute("Training", false)
	end
end

function Training.start(p, stat)
	if sessions[p] or p:GetAttribute("InDuel") or not Config.Stats[stat] then
		return
	end
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	local session = {
		stat = stat,
		rep = 0,
		token = 0,
		streak = 0,
		total = 0,
		resolved = true,
		origin = root and root.Position,
	}
	sessions[p] = session
	p:SetAttribute("Training", true)
	local cfg = newRep(session)
	armTimeout(p, session)
	Stats.send(p, "trainStart", stat, cfg)
end

function Training.cancel(p)
	if sessions[p] then
		sessions[p] = nil
		p:SetAttribute("Training", false)
		Stats.send(p, "trainEnd", nil, 0)
	end
end

function Training.hit(p, clientTime)
	local session = sessions[p]
	if not session or session.resolved then
		return
	end
	local now = workspace:GetServerTimeNow()
	local t = type(clientTime) == "number" and clientTime or now
	t = math.clamp(t, now - 0.6, now)
	if t < session.startedAt then
		return
	end
	local marker = Util.tri((t - session.startedAt) * session.speed)
	local dist = math.abs(marker - session.center)
	local grade = "miss"
	if dist <= PERFECT_WIDTH / 2 then
		grade = "perfect"
	elseif dist <= GOOD_WIDTH / 2 then
		grade = "good"
	end
	resolve(p, session, grade)
end

function Training.init()
	-- Walking away from the station cancels the session.
	task.spawn(function()
		while true do
			task.wait(1)
			for p, session in sessions do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if not root or (session.origin and (root.Position - session.origin).Magnitude > 22) then
					Training.cancel(p)
				end
			end
		end
	end)
end

function Training.release(p)
	sessions[p] = nil
end

function Training.handle(p, kind, a)
	if kind == "TrainHit" then
		Training.hit(p, a)
	elseif kind == "TrainCancel" then
		Training.cancel(p)
	end
end

return Training
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: builds the whole town from code (nothing to import).
-- A bright daytime plaza with grass, concrete, brick and wood: three training pavilions, a crate
-- shop, a boxing ring for duels, a catwalk, and the big Mog Competition stage in the middle.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local HammerModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HammerModel"))

local World = {}

local rng = Random.new(77)
local PLAZA = Config.PlazaRadius
local C3 = Color3.fromRGB
local M = Enum.Material

-- A classic Roblox palette.
local RED, BLUE, YELLOW, GREEN = C3(196, 40, 28), C3(13, 105, 172), C3(245, 205, 48), C3(75, 151, 75)
local WHITE, CONCRETE, DARK, WOOD = C3(242, 243, 243), C3(176, 176, 180), C3(60, 62, 70), C3(124, 92, 70)
local BRICK, ASPHALT, GRASS = C3(166, 106, 70), C3(58, 60, 66), C3(91, 154, 76)

--------------------------------------------------------------------------------
-- Building helpers
--------------------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function block(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or M.SmoothPlastic }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return part(parent, props)
end

-- Flat cylinder whose top face is at center.Y.
local function disk(parent, name, center, radius, thickness, color, material)
	return part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, center.Y - thickness / 2, center.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = material or M.SmoothPlastic,
	})
end

-- Upright cylinder centred at `center`.
local function post(parent, name, center, radius, height, color, material)
	return part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = material or M.SmoothPlastic,
	})
end

-- A painted sign board whose front faces `facing`.
local function sign(parent, position, facing, size, text, boardColor, textColor)
	local cf = CFrame.lookAt(position, position + facing)
	block(parent, "SignFrame", size + Vector3.new(1, 1, 0), cf * CFrame.new(0, 0, 0.3), WHITE, M.SmoothPlastic, { CanCollide = false })
	local face = block(parent, "Sign", size, cf, boardColor, M.SmoothPlastic, { CanCollide = false })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(size.X * 50, size.Y * 50)
	gui.LightInfluence = 0.2
	gui.Parent = face
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor or WHITE
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = C3(0, 0, 0)
	label.Text = text
	label.Parent = gui
	return face, label
end

local function tree(parent, pos)
	local h = 7 + rng:NextNumber() * 5
	post(parent, "Trunk", pos + Vector3.new(0, h / 2, 0), 1, h, C3(110, 80, 55), M.Wood)
	local leafColor = C3(60 + rng:NextInteger(0, 30), 130 + rng:NextInteger(0, 30), 55)
	local r = 5 + rng:NextNumber() * 2
	for i = 1, 3 do
		part(parent, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.one * (r * (1.25 - i * 0.12)),
			Position = pos + Vector3.new((i - 2) * 1.6, h + 1.5 + i * 1.4, (i % 2) * 1.2),
			Color = leafColor,
			Material = M.Grass,
			CanCollide = false,
		})
	end
end

local function lamp(parent, pos)
	post(parent, "LampPole", pos + Vector3.new(0, 6, 0), 0.35, 12, DARK, M.Metal)
	local bulb = part(parent, {
		Name = "LampHead",
		Size = Vector3.new(1.8, 0.8, 1.8),
		Position = pos + Vector3.new(0, 12.3, 0),
		Color = C3(255, 244, 200),
		Material = M.SmoothPlastic,
		CanCollide = false,
	})
	local light = Instance.new("PointLight")
	light.Range = 22
	light.Brightness = 0.8
	light.Color = C3(255, 238, 200)
	light.Parent = bulb
end

local function bench(parent, cf)
	block(parent, "BenchSeat", Vector3.new(6, 0.5, 1.8), cf * CFrame.new(0, 1.6, 0), WOOD, M.Wood)
	block(parent, "BenchBack", Vector3.new(6, 1.6, 0.4), cf * CFrame.new(0, 2.6, 0.8), WOOD, M.Wood)
	for side = -1, 1, 2 do
		block(parent, "BenchLeg", Vector3.new(0.4, 1.6, 1.6), cf * CFrame.new(side * 2.6, 0.8, 0), DARK, M.Metal)
	end
end

local function building(parent, pos, w, h, d, color, facingCenter)
	local cf = CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
	block(parent, "Building", Vector3.new(w, h, d), cf * CFrame.new(0, h / 2, 0), color, M.Concrete)
	block(parent, "Roof", Vector3.new(w + 1, 1.2, d + 1), cf * CFrame.new(0, h + 0.6, 0), DARK, M.SmoothPlastic)
	local rows = math.max(1, math.floor((h - 8) / 9))
	for r = 1, rows do
		local y = 5 + (r - 1) * 9
		for _, face in { { 0, -d / 2 - 0.1, w * 0.8, 0.3 }, { 0, d / 2 + 0.1, w * 0.8, 0.3 } } do
			block(parent, "Window", Vector3.new(face[3], 3.4, face[4]), cf * CFrame.new(face[1], y + 2, face[2]), C3(160, 205, 235), M.Glass, { Transparency = 0.25, CanCollide = false })
		end
		for side = -1, 1, 2 do
			block(parent, "Window", Vector3.new(0.3, 3.4, d * 0.8), cf * CFrame.new(side * (w / 2 + 0.1), y + 2, 0), C3(160, 205, 235), M.Glass, { Transparency = 0.25, CanCollide = false })
		end
	end
	block(parent, "Door", Vector3.new(4, 6, 0.3), cf * CFrame.new(0, 3, -d / 2 - 0.15), BLUE, M.SmoothPlastic, { CanCollide = false })
end

--------------------------------------------------------------------------------
-- Lighting: a bright, clear day
--------------------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.4
	Lighting.Ambient = C3(110, 112, 120)
	Lighting.OutdoorAmbient = C3(125, 128, 140)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4

	for _, child in Lighting:GetChildren() do
		if
			child:IsA("Atmosphere")
			or child:IsA("BloomEffect")
			or child:IsA("ColorCorrectionEffect")
			or child:IsA("SunRaysEffect")
			or child:IsA("DepthOfFieldEffect")
			or child:IsA("BlurEffect")
			or child:IsA("Sky")
		then
			child:Destroy()
		end
	end

	Instance.new("Sky").Parent = Lighting

	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.22
	atmo.Offset = 0.25
	atmo.Color = C3(199, 214, 235)
	atmo.Decay = C3(160, 185, 215)
	atmo.Glare = 0.2
	atmo.Haze = 0.6
	atmo.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.25
	bloom.Size = 20
	bloom.Threshold = 1.8
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Spread = 0.6
	rays.Parent = Lighting

	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "GlowTint"
	tint.Saturation = 0.1
	tint.Contrast = 0.04
	tint.Parent = Lighting
end

--------------------------------------------------------------------------------
-- Pavilions (training stations)
--------------------------------------------------------------------------------
local function pavilion(parent, pos, inward, roofColor, signText, signColor, floorColor, floorMaterial, wallColor)
	local cf = CFrame.lookAt(pos, pos + inward)
	block(parent, "Floor", Vector3.new(32, 0.8, 30), cf * CFrame.new(0, 0.5, 0), floorColor or C3(160, 160, 166), floorMaterial or M.Concrete)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			block(parent, "Pillar", Vector3.new(1.8, 13, 1.8), cf * CFrame.new(sx * 14.5, 7.3, sz * 13.5), WHITE, M.Concrete)
		end
	end
	block(parent, "Roof", Vector3.new(35, 1.4, 33), cf * CFrame.new(0, 14.4, 0), roofColor)
	block(parent, "RoofTrim", Vector3.new(36, 0.6, 34), cf * CFrame.new(0, 13.5, 0), WHITE)
	block(parent, "BackWall", Vector3.new(32, 12, 1), cf * CFrame.new(0, 7, 14.6), wallColor or C3(214, 208, 196), M.Concrete)
	sign(parent, (cf * CFrame.new(0, 18.6, -16)).Position, inward, Vector3.new(26, 5, 0.6), signText, signColor)
	return cf
end

local function stationAt(name)
	local pos = Config.StationPos(name)
	local inward = Config.StationFront(name)
	return pos, inward, Vector3.new(-inward.Z, 0, inward.X)
end

--------------------------------------------------------------------------------
-- Hammer shop: a row of LEGO-stud pedestals right where you spawn. The client adds the OWNED /
-- EQUIPPED / price labels (they differ per player).
--------------------------------------------------------------------------------
local function buildHammerRow(parent)
	local row = Instance.new("Folder")
	row.Name = "HammerRow"
	row.Parent = parent
	for _, hammer in Config.Hammers do
		local pos = Config.HammerPos(hammer.Id)
		local color = hammer.Head
		local pedestal = block(row, "Pedestal", Vector3.new(8, 1.4, 8), CFrame.new(pos + Vector3.new(0, 0.7, 0)), C3(60, 66, 90), M.SmoothPlastic)
		pedestal:SetAttribute("HammerId", hammer.Id)
		block(row, "PedestalTop", Vector3.new(8.4, 0.5, 8.4), CFrame.new(pos + Vector3.new(0, 1.65, 0)), color, M.SmoothPlastic)
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				part(row, {
					Name = "Stud",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.5, 1.8, 1.8),
					CFrame = CFrame.new(pos + Vector3.new(sx * 2.2, 2.15, sz * 2.2)) * CFrame.Angles(0, 0, math.pi / 2),
					Color = color,
					Material = M.SmoothPlastic,
					CanCollide = false,
				})
			end
		end
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 16
		light.Brightness = 1.2
		light.Parent = pedestal
		local display = HammerModel.build(hammer, CFrame.new(pos + Vector3.new(0, 6.6, 0)) * CFrame.Angles(0, math.rad(30), math.rad(-18)), row, { anchored = true })
		display.Name = "HammerDisplay"
		local face = sign(row, pos + Vector3.new(0, 3.3, 3.6), Vector3.new(0, 0, 1), Vector3.new(7.4, 1.6, 0.4), hammer.Name .. "  x" .. hammer.Mult, C3(30, 34, 52), color)
		face.Orientation = face.Orientation + Vector3.new(-25, 0, 0)
	end
	sign(row, Vector3.new(0, 16, Config.HammerRowZ + 14), Vector3.new(0, 0, 1), Vector3.new(34, 5, 0.6), "🔨  HAMMER SHOP  🔨", C3(200, 120, 20))
	for side = -1, 1, 2 do
		block(row, "SignPost", Vector3.new(1.2, 16, 1.2), CFrame.new(side * 18, 8, Config.HammerRowZ + 14.4), DARK, M.Metal)
	end
end


--------------------------------------------------------------------------------
-- Platforms: raised, studded round platforms where training and battles happen
--------------------------------------------------------------------------------
-- `cf` sits on the surface the platform stands on. Returns the CFrame of the platform's top.
local function platform(parent, cf, radius, color, text)
	local h = 1.2
	local origin = cf.Position
	disk(parent, "PlatformBase", origin + Vector3.new(0, h, 0), radius + 1.2, h, C3(70, 74, 92), M.Concrete)
	local top = disk(parent, "PlatformTop", origin + Vector3.new(0, h + 0.3, 0), radius, 0.3, color, M.SmoothPlastic)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 3
	light.Brightness = 0.9
	light.Parent = top
	for i = 1, 14 do
		local a = (i / 14) * math.pi * 2
		part(parent, {
			Name = "Stud",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 1.7, 1.7),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(a) * radius * 0.78, h + 0.65, math.sin(a) * radius * 0.78)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = color:Lerp(WHITE, 0.35),
			Material = M.SmoothPlastic,
			CanCollide = false,
		})
	end
	for i = 1, 16 do
		local a = (i / 16) * math.pi * 2
		local at = origin + Vector3.new(math.cos(a) * (radius + 0.9), h + 1.1, math.sin(a) * (radius + 0.9))
		-- leave a gap in front (local -Z) for the steps
		local local_ = cf:PointToObjectSpace(at)
		if not (local_.Z < -radius * 0.55 and math.abs(local_.X) < 4.2) then
			post(parent, "Bollard", at, 0.35, 2.2, DARK, M.Metal)
			part(parent, { Name = "BollardCap", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Position = at + Vector3.new(0, 1.3, 0), Color = color, Material = M.SmoothPlastic, CanCollide = false })
		end
	end
	block(parent, "StepLow", Vector3.new(8, h * 0.45, 2.6), cf * CFrame.new(0, h * 0.225, -(radius + 2.5)), C3(150, 150, 158), M.Concrete)
	block(parent, "StepHigh", Vector3.new(8, h * 0.9, 2.6), cf * CFrame.new(0, h * 0.45, -(radius + 0.9)), C3(165, 165, 172), M.Concrete)
	local label = block(parent, "PlatformLabel", Vector3.new(radius * 1.3, 0.1, radius * 1.3), cf * CFrame.new(0, h + 0.5, 0), color, M.SmoothPlastic, { CanCollide = false, Transparency = 1 })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(300, 300)
	gui.Parent = label
	local tx = Instance.new("TextLabel")
	tx.Size = UDim2.fromScale(1, 1)
	tx.BackgroundTransparency = 1
	tx.Font = Enum.Font.GothamBlack
	tx.TextScaled = true
	tx.TextColor3 = WHITE
	tx.TextStrokeTransparency = 0
	tx.Text = text
	tx.Parent = gui
	return cf * CFrame.new(0, h + 0.45, 0)
end

local function trainingPlatforms(parent)
	for name, info in { Gym = { RED, "💪 TRAIN" }, Studio = { C3(150, 70, 190), "💈 STYLE" }, Lounge = { C3(40, 130, 150), "🛋️ CHARM" } } do
		local pos, inward = stationAt(name)
		local cf = CFrame.lookAt(pos, pos + inward) * CFrame.new(0, 0.9, -7)
		platform(parent, cf, 6, info[1], info[2])
	end
end

--------------------------------------------------------------------------------
-- Stage battle arena: a long studded lane, opaque side walls, a glass back wall, and an NPC opponent
--------------------------------------------------------------------------------
local function studded(parent, name, size, cf, color, extra)
	local p = block(parent, name, size, cf, color, M.Plastic, extra)
	p.TopSurface = Enum.SurfaceType.Studs
	return p
end

local function buildBattle(parent)
	local pos, inward = Config.BattlePos(), Config.BattleFront()
	local cf = CFrame.lookAt(pos, pos + inward)
	local LANE = 64
	studded(parent, "BattleFloor", Vector3.new(30, 1, LANE), cf * CFrame.new(0, 0.5, 0), C3(176, 190, 214))
	for side = -1, 1, 2 do
		studded(parent, "BattleWall", Vector3.new(2, 18, LANE), cf * CFrame.new(side * 16, 9.5, 0), C3(70, 92, 180))
	end
	block(parent, "BattleGlass", Vector3.new(30, 18, 1.2), cf * CFrame.new(0, 9.5, LANE / 2), C3(150, 200, 235), M.SmoothPlastic, { Transparency = 0.4 })
	-- entry arch + sign (faces the plaza)
	for side = -1, 1, 2 do
		block(parent, "BattlePillar", Vector3.new(2, 20, 2), cf * CFrame.new(side * 15, 10.5, -LANE / 2), DARK, M.Metal)
	end
	block(parent, "BattleBeam", Vector3.new(32, 2, 2), cf * CFrame.new(0, 21, -LANE / 2), DARK, M.Metal)
	sign(parent, (cf * CFrame.new(0, 25, -LANE / 2)).Position, cf.LookVector, Vector3.new(28, 5, 0.6), "⚔️  STAGE BATTLE", C3(40, 70, 170))
	block(parent, "BattleRamp", Vector3.new(16, 0.5, 4), cf * CFrame.new(0, 0.25, -LANE / 2 - 2), C3(150, 150, 158), M.Concrete)

	local padA = platform(parent, cf * CFrame.new(0, 1, -14), 5.5, C3(250, 205, 50), "YOU")
	local padB = platform(parent, cf * CFrame.new(0, 1, 14), 5.5, C3(150, 60, 220), "VS")

	-- The opponent: a blocky NPC whose look changes with the stage.
	local npc = Instance.new("Model")
	npc.Name = "StageOpponent"
	npc.Parent = parent
	local standCF = padB * CFrame.Angles(0, math.pi, 0)
	local skin = C3(214, 190, 150)
	local torso = block(npc, "NpcTorso", Vector3.new(4, 4.4, 2.2), standCF * CFrame.new(0, 4.8, 0), BLUE, M.SmoothPlastic)
	local head = part(npc, { Name = "NpcHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, Position = (standCF * CFrame.new(0, 8.4, 0)).Position, Color = skin, Material = M.SmoothPlastic })
	local belly = part(npc, { Name = "NpcBelly", Shape = Enum.PartType.Ball, Size = Vector3.one * 4.4, Position = (standCF * CFrame.new(0, 3.9, -0.7)).Position, Color = skin, Material = M.SmoothPlastic })
	for _, d in { { -0.6, 0.3 }, { 0.6, 0.3 } } do
		part(npc, { Name = "NpcEye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, Position = (standCF * CFrame.new(d[1], 8.7, -1.35)).Position, Color = WHITE, Material = M.SmoothPlastic, CanCollide = false })
		part(npc, { Name = "NpcPupil", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Position = (standCF * CFrame.new(d[1], 8.7, -1.65)).Position, Color = C3(0, 0, 0), Material = M.SmoothPlastic, CanCollide = false })
	end
	block(npc, "NpcMouth", Vector3.new(1.2, 0.25, 0.2), standCF * CFrame.new(0, 7.9, -1.45), C3(110, 30, 40), M.SmoothPlastic, { CanCollide = false })
	for side = -1, 1, 2 do
		block(npc, "NpcArm", Vector3.new(1.4, 4.2, 1.4), standCF * CFrame.new(side * 3, 4.9, 0) * CFrame.Angles(0, 0, side * 0.2), skin, M.SmoothPlastic)
		block(npc, "NpcLeg", Vector3.new(1.8, 3.2, 1.8), standCF * CFrame.new(side * 1, 1.6, 0), DARK, M.SmoothPlastic)
	end
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(280, 54)
	tag.StudsOffset = Vector3.new(0, 4.2, 0)
	tag.MaxDistance = 120
	tag.AlwaysOnTop = true
	tag.Adornee = head
	tag.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 20
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0
	label.TextWrapped = true
	label.Text = "STAGE 1\n" .. Config.Battle.Stages[1].Name
	label.Parent = tag

	local function setOpponent(def)
		label.Text = string.format("STAGE %d / %d\n%s", def.Index, Config.Battle.Count, def.Name)
		label.TextColor3 = Config.Ranks[def.Rank].Color
		torso.Color = def.Color
		local fat = math.max(0, 1 - (def.Index - 1) / 8)
		belly.Transparency = fat > 0.05 and 0 or 1
		belly.Size = Vector3.one * (2 + 2.4 * fat)
		torso.Size = Vector3.new(3.2 + 1.2 * fat, 4.4, 2.2)
	end
	setOpponent(Config.Battle.Stages[1])
	return { padA = padA, padB = padB, center = (cf * CFrame.new(0, 2.5, 0)).Position, setOpponent = setOpponent }
end

local function buildGym(parent)
	local pos, inward = stationAt("Gym")
	local cf = pavilion(parent, pos, inward, RED, "💪  GYM", C3(150, 30, 20), C3(48, 50, 56), M.Slate, C3(150, 60, 55))
	-- Bench press
	block(parent, "Bench", Vector3.new(2.4, 1.2, 6.5), cf * CFrame.new(0, 1.9, 2), C3(40, 40, 46), M.SmoothPlastic)
	for side = -1, 1, 2 do
		block(parent, "BenchStand", Vector3.new(0.6, 3, 0.6), cf * CFrame.new(side * 2.4, 2.3, 1), DARK, M.Metal)
	end
	local bar = cf * CFrame.new(0, 4.6, 1)
	block(parent, "Bar", Vector3.new(11, 0.5, 0.5), bar, C3(200, 205, 215), M.Metal, { Shape = Enum.PartType.Cylinder })
	for side = -1, 1, 2 do
		block(parent, "Plate", Vector3.new(0.8, 3.4, 3.4), bar * CFrame.new(side * 4.6, 0, 0), C3(30, 30, 36), M.Metal, { Shape = Enum.PartType.Cylinder })
		block(parent, "Plate", Vector3.new(0.7, 2.4, 2.4), bar * CFrame.new(side * 5.3, 0, 0), RED, M.Metal, { Shape = Enum.PartType.Cylinder })
	end
	-- Dumbbell rack along the back wall
	block(parent, "Rack", Vector3.new(14, 2.4, 2.6), cf * CFrame.new(-8, 2, 12.6), DARK, M.Metal)
	for i = 1, 6 do
		local d = cf * CFrame.new(-13.5 + i * 1.9, 3.7, 12.6)
		block(parent, "Dumbbell", Vector3.new(1.8, 0.4, 0.4), d, C3(200, 205, 215), M.Metal, { Shape = Enum.PartType.Cylinder })
		for side = -1, 1, 2 do
			block(parent, "DumbbellHead", Vector3.new(0.5, 1, 1), d * CFrame.new(side * 0.8, 0, 0), C3(30, 30, 36), M.Metal, { Shape = Enum.PartType.Cylinder })
		end
	end
	block(parent, "Mirror", Vector3.new(14, 7, 0.3), cf * CFrame.new(7, 6, 14), C3(190, 215, 235), M.Glass, { Transparency = 0.35, Reflectance = 0.3 })
end

local function buildStudio(parent)
	local pos, inward = stationAt("Studio")
	local cf = pavilion(parent, pos, inward, C3(190, 70, 140), "💈  STYLE STUDIO", C3(130, 40, 100), C3(242, 190, 214), M.Marble, C3(236, 170, 200))
	for i, x in { -7, 7 } do
		local c = cf * CFrame.new(x, 0, 2)
		post(parent, "ChairBase", (c * CFrame.new(0, 1, 0)).Position, 1.3, 0.6, DARK, M.Metal)
		post(parent, "ChairPost", (c * CFrame.new(0, 1.8, 0)).Position, 0.35, 1.4, C3(200, 205, 215), M.Metal)
		block(parent, "ChairSeat", Vector3.new(3.2, 0.9, 3.2), c * CFrame.new(0, 2.8, 0), RED, M.Leather)
		block(parent, "ChairBack", Vector3.new(3.2, 3.6, 0.9), c * CFrame.new(0, 4.4, -1.5), RED, M.Leather)
		block(parent, "ChairHead", Vector3.new(1.8, 1.2, 0.8), c * CFrame.new(0, 6.7, -1.5), RED, M.Leather)
		for side = -1, 1, 2 do
			block(parent, "ChairArm", Vector3.new(0.5, 0.5, 2.6), c * CFrame.new(side * 1.8, 3.9, 0), DARK, M.Metal)
		end
	end
	for i = 1, 3 do
		local x = (i - 2) * 9.5
		block(parent, "MirrorFrame", Vector3.new(7.6, 8.6, 0.5), cf * CFrame.new(x, 6.2, 13.9), DARK, M.Wood)
		block(parent, "Mirror", Vector3.new(6.8, 7.8, 0.3), cf * CFrame.new(x, 6.2, 13.6), C3(195, 220, 240), M.Glass, { Transparency = 0.3, Reflectance = 0.35 })
	end
	block(parent, "Counter", Vector3.new(26, 2.6, 1.8), cf * CFrame.new(0, 2, 12.4), WOOD, M.Wood)
	for i = 1, 7 do
		post(parent, "Bottle", (cf * CFrame.new(-10 + i * 2.7, 4, 12.4)).Position, 0.4, 1.4, ({ BLUE, GREEN, YELLOW, RED })[i % 4 + 1], M.Glass)
	end
end

local function buildLounge(parent)
	local pos, inward = stationAt("Lounge")
	local cf = pavilion(parent, pos, inward, C3(60, 140, 190), "🛋️  CHARM LOUNGE", C3(30, 90, 140), C3(170, 122, 84), M.WoodPlanks, C3(96, 170, 190))
	disk(parent, "Rug", (cf * CFrame.new(0, 0.9, 1)).Position, 9, 0.1, C3(190, 70, 90), M.Fabric)
	block(parent, "SofaSeat", Vector3.new(11, 1.6, 4), cf * CFrame.new(0, 2, 11), C3(120, 80, 150), M.Fabric)
	block(parent, "SofaBack", Vector3.new(11, 3.6, 1), cf * CFrame.new(0, 4, 12.6), C3(100, 64, 130), M.Fabric)
	for side = -1, 1, 2 do
		block(parent, "SofaArm", Vector3.new(1, 3, 4), cf * CFrame.new(side * 5.8, 2.6, 11), C3(100, 64, 130), M.Fabric)
	end
	block(parent, "TableTop", Vector3.new(6, 0.5, 3), cf * CFrame.new(0, 2.5, 5), WOOD, M.Wood)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			block(parent, "TableLeg", Vector3.new(0.4, 1.6, 0.4), cf * CFrame.new(sx * 2.4, 1.6, 5 + sz * 1.1), WOOD, M.Wood)
		end
	end
	for _, x in { -13, 13 } do
		post(parent, "Pot", (cf * CFrame.new(x, 1.8, 11)).Position, 1.2, 2, C3(170, 100, 70), M.Concrete)
		part(parent, { Name = "Plant", Shape = Enum.PartType.Ball, Size = Vector3.one * 4, Position = (cf * CFrame.new(x, 4.4, 11)).Position, Color = GREEN, Material = M.Grass, CanCollide = false })
	end
end

local function buildCrateShop(parent)
	local pos, inward = stationAt("Crates")
	local cf = CFrame.lookAt(pos, pos + inward)
	block(parent, "Base", Vector3.new(26, 0.8, 20), cf * CFrame.new(0, 0.5, 0), C3(150, 120, 90), M.Wood)
	block(parent, "BackWall", Vector3.new(24, 11, 1), cf * CFrame.new(0, 6.3, 9), C3(214, 190, 150), M.Wood)
	block(parent, "Counter", Vector3.new(16, 3.4, 3.4), cf * CFrame.new(0, 2.5, 1.5), WOOD, M.Wood)
	block(parent, "CounterTop", Vector3.new(17, 0.5, 4), cf * CFrame.new(0, 4.4, 1.5), C3(80, 58, 44), M.Wood)
	for side = -1, 1, 2 do
		block(parent, "Post", Vector3.new(1.2, 12.5, 1.2), cf * CFrame.new(side * 12, 6.8, -6), WHITE, M.Wood)
	end
	-- Striped awning
	for i = 1, 10 do
		local x = -11.25 + (i - 1) * 2.5
		block(parent, "Awning", Vector3.new(2.5, 0.4, 15), cf * CFrame.new(x, 12.4, -1) * CFrame.Angles(math.rad(-9), 0, 0), i % 2 == 0 and WHITE or RED, M.Fabric)
	end
	sign(parent, (cf * CFrame.new(0, 17, -8.8)).Position, inward, Vector3.new(22, 4.4, 0.6), "🎁  CRATE SHOP", C3(30, 90, 140))
	for i, crate in Config.Crates do
		local box = cf * CFrame.new((i - 2) * 4.4, 5.8, 1.5)
		block(parent, "CrateDisplay", Vector3.new(2.6, 2.6, 2.6), box, WOOD, M.Wood)
		block(parent, "CrateLid", Vector3.new(2.8, 0.4, 2.8), box * CFrame.new(0, 1.4, 0), crate.Color, M.SmoothPlastic)
		block(parent, "CrateRibbon", Vector3.new(0.5, 2.7, 2.9), box, crate.Color, M.SmoothPlastic)
	end
	for i = 1, 3 do
		block(parent, "StackedCrate", Vector3.new(3, 3, 3), cf * CFrame.new(-10.5 + (i % 2) * 0.4, 2.4 + (i - 1) * 3, 7), WOOD, M.Wood)
		block(parent, "StackedCrate", Vector3.new(3, 3, 3), cf * CFrame.new(10.5 - (i % 2) * 0.4, 2.4 + (i - 1) * 3, 7), WOOD, M.Wood)
	end
end

local function buildDummy(parent, at, facing)
	local cf = CFrame.lookAt(at, at + facing)
	post(parent, "DummyBase", (cf * CFrame.new(0, 0.5, 0)).Position, 2.2, 0.8, DARK, M.Metal)
	post(parent, "DummyPole", (cf * CFrame.new(0, 3, 0)).Position, 0.4, 5, C3(200, 205, 215), M.Metal)
	local body = block(parent, "Dummy", Vector3.new(3, 5, 2.4), cf * CFrame.new(0, 6.2, 0), C3(214, 190, 150), M.Fabric)
	part(parent, { Name = "DummyHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, Position = (cf * CFrame.new(0, 10, 0)).Position, Color = C3(214, 190, 150), Material = M.Fabric })
	for side = -1, 1, 2 do
		block(parent, "DummyArm", Vector3.new(1, 4, 1), cf * CFrame.new(side * 2.2, 6.4, 0) * CFrame.Angles(0, 0, side * 0.25), C3(214, 190, 150), M.Fabric)
	end
	block(parent, "Target", Vector3.new(2.2, 2.2, 0.3), cf * CFrame.new(0, 6.6, -1.25), RED, M.SmoothPlastic, { CanCollide = false })
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(220, 40)
	tag.StudsOffset = Vector3.new(0, 4.5, 0)
	tag.MaxDistance = 90
	tag.Adornee = body
	tag.Parent = body
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 22
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0
	label.Text = "MOGGER BOT"
	label.Parent = tag
end

local function buildRing(parent)
	local pos, inward, tangent = stationAt("Ring")
	local cf = CFrame.lookAt(pos, pos + inward)
	-- Platform with steps toward the plaza
	block(parent, "RingStepLow", Vector3.new(14, 0.9, 5), cf * CFrame.new(0, 0.45, -26.5), C3(150, 150, 156), M.Concrete)
	block(parent, "RingStepHigh", Vector3.new(14, 1.8, 5), cf * CFrame.new(0, 0.9, -23), C3(160, 160, 166), M.Concrete)
	block(parent, "RingBase", Vector3.new(40, 2.6, 40), cf * CFrame.new(0, 1.3, 0), C3(120, 120, 126), M.Concrete)
	block(parent, "Canvas", Vector3.new(36, 0.2, 36), cf * CFrame.new(0, 2.7, 0), C3(228, 224, 214), M.Fabric)
	-- Corner posts + ropes
	local top = Vector3.new(0, 2.8, 0)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			block(parent, "CornerPost", Vector3.new(1.2, 7, 1.2), cf * CFrame.new(sx * 17.4, 6.2, sz * 17.4), (sx * sz > 0) and RED or BLUE, M.SmoothPlastic)
			block(parent, "CornerPad", Vector3.new(1.8, 2.2, 1.8), cf * CFrame.new(sx * 17.4, 4.8, sz * 17.4), (sx * sz > 0) and RED or BLUE, M.Fabric)
		end
	end
	for i, y in { 4.2, 5.8, 7.4 } do
		local color = i == 2 and WHITE or (i == 1 and RED or BLUE)
		for side = -1, 1, 2 do
			block(parent, "RopeX", Vector3.new(34.8, 0.35, 0.35), cf * CFrame.new(0, y, side * 17.4), color, M.SmoothPlastic, { CanCollide = false })
			block(parent, "RopeZ", Vector3.new(0.35, 0.35, 34.8), cf * CFrame.new(side * 17.4, y, 0), color, M.SmoothPlastic, { CanCollide = false })
		end
	end
	-- Corner markers where duelists stand
	local padA = cf * CFrame.new(-10, 2.9, 0)
	local padB = cf * CFrame.new(10, 2.9, 0)
	disk(parent, "CornerA", padA.Position, 3.5, 0.15, BLUE, M.SmoothPlastic).CanCollide = false
	disk(parent, "CornerB", padB.Position, 3.5, 0.15, RED, M.SmoothPlastic).CanCollide = false
	sign(parent, (cf * CFrame.new(0, 15, 20)).Position, inward, Vector3.new(26, 5, 0.6), "🥊  DUEL RING", C3(150, 30, 20))
	for side = -1, 1, 2 do
		block(parent, "SignPost", Vector3.new(1.2, 15, 1.2), cf * CFrame.new(side * 15, 7.5, 20), DARK, M.Metal)
	end
	buildDummy(parent, (cf * CFrame.new(-26, 0.4, -8)).Position, inward)
	return { padA = padA, padB = padB, center = pos + Vector3.new(0, 2.8, 0) }
end

--------------------------------------------------------------------------------
-- The Mog Competition stage (centre of the plaza)
--------------------------------------------------------------------------------
local function buildStage(parent)
	disk(parent, "StageStep", Vector3.new(0, 0.9, 0), 28, 0.9, C3(150, 150, 156), M.Concrete)
	disk(parent, "Stage", Vector3.new(0, 1.8, 0), 24, 0.9, C3(196, 196, 202), M.Concrete)
	disk(parent, "StageEmblem", Vector3.new(0, 1.85, 0), 15, 0.1, YELLOW, M.SmoothPlastic)
	disk(parent, "StageEmblemInner", Vector3.new(0, 1.9, 0), 13.5, 0.1, C3(196, 196, 202), M.Concrete)
	-- Canopy
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			block(parent, "StagePillar", Vector3.new(2, 31, 2), CFrame.new(sx * 32, 15.5, sz * 22), DARK, M.Metal)
		end
	end
	block(parent, "StageRoof", Vector3.new(70, 2, 48), CFrame.new(0, 32, 0), C3(48, 50, 58), M.Metal)
	block(parent, "StageRoofTrim", Vector3.new(71, 0.7, 49), CFrame.new(0, 30.7, 0), YELLOW, M.SmoothPlastic)
	for i = 1, 8 do
		local x = -28 + (i - 1) * 8
		local lampPart = block(parent, "StageLight", Vector3.new(2.4, 1.6, 2.4), CFrame.new(x, 30, (i % 2 == 0) and -8 or 8), C3(230, 230, 235), M.Metal, { CanCollide = false })
		local light = Instance.new("SpotLight")
		light.Face = Enum.NormalId.Bottom
		light.Angle = 70
		light.Range = 60
		light.Brightness = 1.6
		light.Color = C3(255, 244, 220)
		light.Parent = lampPart
	end
	-- Banners
	sign(parent, Vector3.new(0, 25.5, 23), Vector3.new(0, 0, 1), Vector3.new(48, 9, 0.8), "SUB 5 TO TRUE ADAM", C3(20, 70, 140), C3(255, 214, 70))
	local _, boardLabel = sign(parent, Vector3.new(0, 14.5, 23), Vector3.new(0, 0, 1), Vector3.new(34, 8, 0.8), "MOG COMPETITION\nsoon...", C3(30, 30, 38), WHITE)
	boardLabel.TextScaled = true
	for side = -1, 1, 2 do
		block(parent, "BannerPost", Vector3.new(1.4, 31, 1.4), CFrame.new(side * 27, 15.5, 23), DARK, M.Metal)
	end
	-- Podium
	local function podium(x, h, color, number)
		block(parent, "Podium", Vector3.new(8, h, 6), CFrame.new(x, 1.8 + h / 2, -14), color, M.Metal)
		local face, label = sign(parent, Vector3.new(x, 1.8 + h / 2, -10.9), Vector3.new(0, 0, 1), Vector3.new(5, math.max(1.6, h - 0.6), 0.2), number, color, WHITE)
		return face
	end
	podium(0, 3.6, C3(230, 190, 50), "1")
	podium(-9, 2.5, C3(190, 195, 205), "2")
	podium(9, 1.6, C3(190, 120, 60), "3")
	-- Bleachers on both sides
	for side = -1, 1, 2 do
		for tier = 1, 3 do
			block(parent, "Bleacher", Vector3.new(6, tier * 2, 22), CFrame.new(side * (42 + tier * 6), tier, 0), C3(110, 90, 70), M.Wood)
		end
	end
	return boardLabel
end

--------------------------------------------------------------------------------
-- Catwalk, Top Moggers board, ground and town
--------------------------------------------------------------------------------
local function buildCatwalk(parent)
	local z1, z2, hw = Config.Runway.MinZ, Config.Runway.MaxZ, Config.Runway.HalfWidth
	local length = z2 - z1
	block(parent, "Catwalk", Vector3.new(hw * 2, 0.6, length), CFrame.new(0, 0.5, (z1 + z2) / 2), WHITE, M.SmoothPlastic)
	for side = -1, 1, 2 do
		block(parent, "CatwalkEdge", Vector3.new(0.6, 0.3, length), CFrame.new(side * (hw - 0.4), 0.9, (z1 + z2) / 2), YELLOW, M.SmoothPlastic, { CanCollide = false })
	end
	for z = z1 + 5, z2 - 5, 10 do
		block(parent, "CatwalkLine", Vector3.new(hw * 2 - 1.5, 0.1, 0.5), CFrame.new(0, 0.85, z), C3(210, 210, 215), M.SmoothPlastic, { CanCollide = false })
	end
	sign(parent, Vector3.new(0, 11, z2 + 4), Vector3.new(0, 0, 1), Vector3.new(24, 5, 0.6), "💃  CATWALK  ·  walk it for Aura", C3(130, 40, 100))
	for side = -1, 1, 2 do
		block(parent, "CatwalkSignPost", Vector3.new(1.2, 12, 1.2), CFrame.new(side * 11, 6, z2 + 4), DARK, M.Metal)
	end
end

local function buildBoard(parent)
	local a = math.rad(148)
	local pos = Vector3.new(math.cos(a) * 132, 11, math.sin(a) * 132)
	local facing = Vector3.new(-math.cos(a), 0, -math.sin(a))
	local face = sign(parent, pos, facing, Vector3.new(34, 18, 0.8), "", C3(30, 40, 70))
	local gui = face:FindFirstChildOfClass("SurfaceGui")
	local title = gui:FindFirstChildOfClass("TextLabel")
	title.Size = UDim2.new(1, 0, 0.2, 0)
	title.Text = "🏆  TOP MOGGERS"
	title.TextColor3 = YELLOW
	local list = Instance.new("TextLabel")
	list.Position = UDim2.fromScale(0.04, 0.22)
	list.Size = UDim2.fromScale(0.92, 0.74)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.GothamBold
	list.TextSize = 36
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.TextColor3 = WHITE
	list.TextStrokeTransparency = 0.3
	list.Text = "Nobody here yet."
	list.Parent = gui
	local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
	for side = -1, 1, 2 do
		block(parent, "BoardPost", Vector3.new(1.4, 11, 1.4), CFrame.new(pos + tangent * (side * 14) - Vector3.new(0, 5.5, 0)), DARK, M.Metal)
	end
	return list
end

local function buildGround(parent)
	-- Grass field
	block(parent, "Grass", Vector3.new(720, 2, 720), CFrame.new(0, -1, 0), GRASS, M.Grass)
	-- Plaza with a brick border
	disk(parent, "PlazaBorder", Vector3.new(0, 0.18, 0), PLAZA + 4, 0.4, BRICK, M.Brick)
	disk(parent, "Plaza", Vector3.new(0, 0.26, 0), PLAZA, 0.5, CONCRETE, M.Concrete)
	for _, r in { 60, 108 } do
		local ring = disk(parent, "PlazaRing", Vector3.new(0, 0.3, 0), r, 0.1, BRICK, M.Brick)
		ring.CanCollide = false
		local inner = disk(parent, "PlazaRingInner", Vector3.new(0, 0.33, 0), r - 1.5, 0.12, CONCRETE, M.Concrete)
		inner.CanCollide = false
	end
	-- Roads out of the plaza in the four directions, with dashed centre lines
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local mid = dir * (PLAZA + 4 + 90)
		local alongX = dir.X ~= 0
		block(parent, "Road", Vector3.new(alongX and 180 or 20, 0.2, alongX and 20 or 180), CFrame.new(mid.X, 0.1, mid.Z), ASPHALT, M.Asphalt)
		for i = 1, 12 do
			local d = PLAZA + 14 + (i - 1) * 14
			block(parent, "RoadLine", Vector3.new(alongX and 6 or 0.7, 0.05, alongX and 0.7 or 6), CFrame.new(dir.X * d, 0.24, dir.Z * d), YELLOW, M.SmoothPlastic, { CanCollide = false })
		end
	end
	-- Invisible walls around the field
	for _, w in {
		{ Vector3.new(720, 80, 2), Vector3.new(0, 38, 360) },
		{ Vector3.new(720, 80, 2), Vector3.new(0, 38, -360) },
		{ Vector3.new(2, 80, 720), Vector3.new(360, 38, 0) },
		{ Vector3.new(2, 80, 720), Vector3.new(-360, 38, 0) },
	} do
		part(parent, { Name = "EdgeWall", Size = w[1], Position = w[2], Transparency = 1, CanQuery = false })
	end
end

local function buildTown(parent)
	-- Buildings beyond the plaza, away from the roads
	local colors = { C3(206, 190, 160), C3(176, 140, 120), C3(150, 160, 175), C3(190, 170, 130), C3(160, 130, 110) }
	local count = 0
	local attempts = 0
	while count < 22 and attempts < 200 do
		attempts += 1
		local a = rng:NextNumber() * math.pi * 2
		local r = 205 + rng:NextNumber() * 100
		local x, z = math.cos(a) * r, math.sin(a) * r
		if math.abs(x) > 24 and math.abs(z) > 24 then
			count += 1
			building(parent, Vector3.new(x, 0, z), 24 + rng:NextNumber() * 14, 30 + rng:NextNumber() * 40, 22 + rng:NextNumber() * 10, colors[rng:NextInteger(1, #colors)])
		end
	end
	-- Trees on the grass
	local trees = 0
	attempts = 0
	while trees < 70 and attempts < 400 do
		attempts += 1
		local a = rng:NextNumber() * math.pi * 2
		local r = PLAZA + 14 + rng:NextNumber() * 190
		local x, z = math.cos(a) * r, math.sin(a) * r
		if math.abs(x) > 18 and math.abs(z) > 18 then
			trees += 1
			tree(parent, Vector3.new(x, 0, z))
		end
	end
	-- Lamps and benches around the plaza edge
	for i = 1, 20 do
		local a = (i / 20) * math.pi * 2
		lamp(parent, Vector3.new(math.cos(a) * (PLAZA - 6), 0.5, math.sin(a) * (PLAZA - 6)))
	end
	for i = 1, 12 do
		local a = (i / 12) * math.pi * 2 + 0.13
		local pos = Vector3.new(math.cos(a) * (PLAZA - 14), 0.5, math.sin(a) * (PLAZA - 14))
		bench(parent, CFrame.lookAt(pos, Vector3.new(0, 0.5, 0)))
	end
end

--------------------------------------------------------------------------------
-- Coin placement
--------------------------------------------------------------------------------
local function shardSlots(avoid)
	local slots = {}
	local attempts = 0
	while #slots < 150 and attempts < 3000 do
		attempts += 1
		local a = rng:NextNumber() * math.pi * 2
		local r = 8 + math.sqrt(rng:NextNumber()) * (PLAZA - 16)
		local x, z = math.cos(a) * r, math.sin(a) * r
		local ok = true
		for _, zone in avoid do
			if (Vector3.new(x, 0, z) - zone.pos).Magnitude < zone.r then
				ok = false
			end
		end
		if math.abs(x) < 14 and z > 20 and z < 104 then
			ok = false
		end
		if ok then
			table.insert(slots, Vector3.new(x, 3.4, z))
		end
	end
	return slots
end

--------------------------------------------------------------------------------
-- Entry point
--------------------------------------------------------------------------------
function World.build()
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child.Name == "SpawnLocation" or child.Name == "GlowWorld" then
			child:Destroy()
		end
	end
	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "GlowWorld"
	world.Parent = workspace

	buildGround(world)
	buildTown(world)
	buildCatwalk(world)
	local boardLabel = buildBoard(world)
	local compBoard = buildStage(world)

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.6, 138)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = world

	buildHammerRow(world)
	buildGym(world)
	buildStudio(world)
	buildLounge(world)
	buildCrateShop(world)
	local arena = buildRing(world)
	trainingPlatforms(world)
	local battle = buildBattle(world)

	local avoid = { { pos = Vector3.zero, r = 36 }, { pos = Vector3.new(0, 0, 124), r = 56 }, { pos = Config.BattlePos(), r = 40 } }
	for name in Config.Stations do
		table.insert(avoid, { pos = (stationAt(name)), r = 28 })
	end

	return {
		slots = shardSlots(avoid),
		arena = arena,
		battle = battle,
		board = boardLabel,
		compBoard = compBoard,
		stage = { center = Vector3.new(0, 1.8, 0) },
	}
end

return World
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="33">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="34">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="35">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: client entry point. Builds the interface, wires the menu tabs, and routes everything
-- the server tells us (pickups, rewards, training, duels) to the right place.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local Net = ReplicatedStorage:WaitForChild("Net")
local Action = Net:WaitForChild("Action")
local Notify = Net:WaitForChild("Notify")

local Modules = script:WaitForChild("Modules")
local Fx = require(Modules.Fx)
local Toasts = require(Modules.Toasts)
local Menu = require(Modules.Menu)
local Hud = require(Modules.Hud)
local TabWardrobe = require(Modules.TabWardrobe)
local TabCrates = require(Modules.TabCrates)
local TabUpgrades = require(Modules.TabUpgrades)
local TabPets = require(Modules.TabPets)
local TabProfile = require(Modules.TabProfile)
local TabRewards = require(Modules.TabRewards)
local TabSettings = require(Modules.TabSettings)
local TrainingUI = require(Modules.TrainingUI)
local DuelUI = require(Modules.DuelUI)
local CompetitionUI = require(Modules.CompetitionUI)
local Orbs = require(Modules.Orbs)
local Interact = require(Modules.Interact)
local HammerRow = require(Modules.HammerRow)
local Swing = require(Modules.Swing)

-- Wait for the server to finish setting this player up.
while not player:GetAttribute("Ready") do
	task.wait(0.1)
end

local gui = UI.new("ScreenGui", {
	Name = "GlowUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	IgnoreGuiInset = false,
}, player:WaitForChild("PlayerGui"))

--------------------------------------------------------------------------------
-- Build
--------------------------------------------------------------------------------
Audio.Init()
Fx.init(gui)
Orbs.init()
Menu.init(gui)
Menu.addTab("Wardrobe", "👗", function(page)
	return TabWardrobe.build(page, Action)
end)
Menu.addTab("Crates", "🎁", function(page)
	return TabCrates.build(page, Action)
end)
Menu.addTab("Pets", "🐾", function(page)
	return TabPets.build(page, Action)
end)
Menu.addTab("Upgrades", "⬆️", function(page)
	return TabUpgrades.build(page, Action)
end)
Menu.addTab("Profile", "📈", function(page)
	return TabProfile.build(page)
end)
Menu.addTab("Rewards", "📅", function(page)
	return TabRewards.build(page, Action)
end)
Menu.addTab("Settings", "⚙️", function(page)
	return TabSettings.build(page, Action)
end)
Hud.init(gui, Menu, Action)
Toasts.init(gui)
TrainingUI.init(gui, Action)
DuelUI.init(gui, Action)
CompetitionUI.init(gui, Action)
Interact.init(gui, Action, Menu)
HammerRow.init()
Swing.init(gui, Action, Menu)

TabSettings.apply()
Audio.startMusic()
for _, key in { "Music", "Sfx" } do
	player:GetAttributeChangedSignal("Set_" .. key):Connect(TabSettings.apply)
end

Menu.onChanged(function(name)
	if name == "Wardrobe" then
		Hud.setNewItem(false)
	end
end)

task.spawn(function()
	while true do
		task.wait(0.25)
		Menu.refresh()
	end
end)

--------------------------------------------------------------------------------
-- Server messages
--------------------------------------------------------------------------------
local handlers = {}

function handlers.shard(pos, gained, tier, color, mut, chain)
	local tierIndex = Config.ShardTier(tier)
	Audio.pickup(chain, tierIndex + (mut and 2 or 0))
	Fx.burst(pos, color, 5 + tierIndex * 4 + (mut and 14 or 0))
	Fx.punch(1 + tierIndex * 0.8 + (mut and 3 or 0))
	-- Only notable pickups get a floating number; the Aura counter covers the rest.
	if mut or tierIndex >= 3 then
		local text = (mut and (mut:upper() .. "! ") or "") .. "+" .. Util.fmt(gained)
		Fx.floatText(pos, text, color, mut and 26 or 22)
	end
	if mut then
		Fx.shake(0.25, 0.3)
		Fx.flash(color, 0.22, 0.35)
	end
	if chain == 10 or chain == 20 or chain == Config.ChainMax then
		Audio.milestone(chain)
		Toasts.push("CHAIN x" .. chain .. "!", "gold")
		Hud.pulseChain()
	end
end

function handlers.toast(text, kind)
	if kind == "bad" then
		Audio.error()
	end
	Toasts.push(text, kind)
end

function handlers.rank(rankIndex)
	local rank = Config.Ranks[rankIndex]
	Audio.rank()
	Fx.shake(0.4, 0.5)
	Fx.flash(rank.Color, 0.35, 0.9)
	Fx.announce(rank.Full:upper(), "NEW LOOKS TIER!", rank.Color, 0.2)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		Fx.ring(root.Position, rank.Color, 50)
		Fx.pillar(root.Position, rank.Color, 110)
		Fx.burst(root.Position, rank.Color, 60)
	end
end

-- Plain level-ups stay small (a toast); every 10th level gets a proper moment.
function handlers.level(level, aura, crates)
	Audio.quest()
	Audio.say("levelup")
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		Fx.ring(root.Position, UI.Colors.Gold, level % 10 == 0 and 40 or 18)
		Fx.pillar(root.Position, UI.Colors.Gold, level % 10 == 0 and 90 or 40)
		Fx.burst(root.Position, UI.Colors.Gold, level % 10 == 0 and 50 or 16)
	end
	if level % 10 == 0 then
		Audio.levelUp()
		Fx.shake(0.3, 0.4)
		Fx.flash(UI.Colors.Gold, 0.25, 0.6)
		Fx.announce("LEVEL " .. level, "+" .. Util.fmt(aura) .. " Aura" .. (crates > 0 and "  +  free crate" or ""), UI.Colors.Gold, 0.3)
	else
		Toasts.push(string.format("Level %d!  +%s Aura", level, Util.fmt(aura)), "gold")
	end
end

function handlers.compStart(...)
	Menu.close()
	CompetitionUI.start(...)
end

function handlers.compProgress(list)
	CompetitionUI.progress(list)
end

function handlers.compEnd(...)
	CompetitionUI.finish(...)
end

function handlers.quest(text, reward, bonus)
	Audio.quest()
	Hud.pulseQuest()
	Toasts.push(string.format("Quest complete: %s  +✦%s%s", text, Util.fmt(reward), bonus or ""), "good")
end

function handlers.daily(day, aura, crates)
	Audio.daily()
	Toasts.push(string.format("Day %d claimed  +✦%s%s", day, Util.fmt(aura), crates > 0 and ("  +" .. crates .. " 🎁") or ""), "gold")
end

function handlers.crate(crateId, cosmeticId, status, stars, refund)
	Menu.open("Crates")
	TabCrates.reveal(crateId, cosmeticId, status, stars, refund)
	if status == "new" then
		Hud.setNewItem(true)
	end
end

function handlers.upgrade()
	Audio.purchase()
end

function handlers.rebirth(n)
	Audio.ascend()
	Fx.shake(0.7, 0.9)
	Fx.flash(Color3.new(1, 1, 1), 1, 1.4)
	Fx.announce("REBORN", "★" .. n .. "  ·  +50% Aura and XP, forever", UI.Colors.Gold, 0.3)
end

function handlers.swing(gained, tag, frenzy)
	Swing.result(gained, tag, frenzy)
end

function handlers.frenzy(seconds)
	Audio.milestone(20)
	Fx.shake(0.4, 0.4)
	Fx.flash(UI.Colors.Orange, 0.3, 0.5)
	Fx.announce("MOG FRENZY!", "x2 Aura for " .. seconds .. " seconds, keep swinging", UI.Colors.Orange, 0.22)
end

function handlers.gift(aura, crates, index, total)
	Audio.daily()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		Fx.ring(root.Position, UI.Colors.Mint, 26)
		Fx.burst(root.Position, UI.Colors.Mint, 30)
	end
	Toasts.push(string.format("🎁 Play-time gift %d/%d:  +%s Aura%s", index, total, Util.fmt(aura), crates > 0 and ("  +" .. crates .. " crate" .. (crates > 1 and "s" or "")) or ""), "gold")
end

function handlers.hammer(id, how)
	local hammer = Config.HammerById[id]
	Audio.purchase()
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root then
		Fx.burst(root.Position, hammer.Head, 20)
	end
	Toasts.push(string.format("%s %s  ·  x%d Aura per swing", hammer.Name, how == "bought" and "bought and equipped" or "equipped", hammer.Mult), "gold")
end

function handlers.hatch(eggId, petId, copies)
	local pet = Config.PetById[petId]
	local rarity = Config.Rarities[pet.Rarity]
	Audio.reveal(Config.Rarities[pet.Rarity].Order)
	Fx.shake(0.15 + rarity.Order * 0.08, 0.3)
	Fx.flash(rarity.Color, 0.15 + rarity.Order * 0.05, 0.5)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if root and rarity.Order >= 3 then
		Fx.ring(root.Position, rarity.Color, 14 + rarity.Order * 6)
		Fx.pillar(root.Position, rarity.Color, 30 + rarity.Order * 14)
		Fx.burst(root.Position, rarity.Color, 20 + rarity.Order * 10)
	end
	Fx.announce(pet.Name:upper(), string.format("%s pet  ·  +%d%% Aura%s", pet.Rarity, math.floor(Config.PetMult(pet, copies) * 100 + 0.5), copies > 1 and ("  ·  " .. string.rep("★", Config.PetStars(copies))) or "  ·  NEW!"), rarity.Color, 0.25)
end

function handlers.stageResult(stage, won, first, cleared)
	local def = Config.Battle.Stages[stage]
	if won then
		Audio.say(first and "stage" or "win")
		if first then
			Fx.announce("STAGE " .. stage .. " CLEARED!", stage < Config.Battle.Count and ("Next: " .. Config.Battle.Stages[stage + 1].Name) or "You beat every opponent!", def.Color, 0.25)
		end
	else
		Toasts.push("Stage " .. stage .. " (" .. def.Name .. ") beat you. Level up and try again!", "bad")
	end
end

function handlers.openMenu(tab)
	Menu.open(tab)
end

function handlers.trainStart(stat, cfg)
	Menu.close()
	TrainingUI.start(stat, cfg)
end

function handlers.trainRep(...)
	TrainingUI.rep(...)
end

function handlers.trainEnd(stat, total)
	TrainingUI.finish(stat, total)
end

function handlers.duelStart(...)
	Menu.close()
	DuelUI.start(...)
end

function handlers.duelProgress(oppTaps)
	DuelUI.progress(oppTaps)
end

function handlers.duelEnd(...)
	DuelUI.finish(...)
end

Notify.OnClientEvent:Connect(function(kind, ...)
	local handler = handlers[kind]
	if handler then
		local ok, err = pcall(handler, ...)
		if not ok then
			warn("[TrueAdam] UI handler '" .. tostring(kind) .. "' failed:", err)
		end
	end
end)

--------------------------------------------------------------------------------
-- Welcome back
--------------------------------------------------------------------------------
task.spawn(function()
	task.wait(2.5)
	if (player:GetAttribute("Level") or 1) <= 1 and (player:GetAttribute("XP") or 0) < 5 then
		Fx.announce("SUB 5", "That's you. Level up to evolve!", Config.Ranks[1].Color, 0.22)
		task.wait(3)
	end
	local gain = player:GetAttribute("OfflineGain")
	if gain and gain > 0 then
		Toasts.push("Welcome back! Your look earned ✦" .. Util.fmt(gain) .. " while you were away", "gold")
	elseif player:GetAttribute("DailyReady") then
		Toasts.push("Your daily reward is ready", "gold")
	end
end)
]]></string>
        </Properties>
        <Item class="Folder" referent="36">
          <Properties>
            <string name="Name">Modules</string>
          </Properties>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">CompetitionUI</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: Mog Competition overlay. Everyone on stage flexes (taps) for 8 seconds; a live
-- leaderboard shows who's ahead, then the final placings and your reward.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local CompetitionUI = {}

local C = UI.Colors
local Action
local root, title, center, tapButton, tapScale, listFrame, rows, resultPanel, resultTitle, resultBody
local comp -- { tStart, length, myTaps, lastTick, started }
local pendingSend, lastSend = 0, 0

local function tap()
	if not comp then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < comp.tStart or now > comp.tStart + comp.length then
		return
	end
	comp.myTaps += 1
	pendingSend += 1
	Audio.play("Tone", 0.9 + (comp.myTaps % 8) * 0.07, 0.35)
	UI.pop(tapScale, 0.93)
end

function CompetitionUI.init(gui, action)
	Action = action
	root = UI.new("Frame", {
		Name = "Competition",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
	}, gui)

	title = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(420, 26),
		Font = UI.Fonts.Title,
		TextSize = 18,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "🏆 MOG COMPETITION",
		ZIndex = 31,
	})
	center = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(400, 70),
		Font = UI.Fonts.Title,
		TextSize = 56,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
		ZIndex = 32,
	})

	-- Live leaderboard (right side)
	listFrame = UI.panel(root, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, -20),
		Size = UDim2.fromOffset(190, 190),
		ZIndex = 31,
	})
	UI.label(listFrame, {
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.new(1, -20, 0, 16),
		Font = UI.Fonts.Title,
		TextSize = 11,
		TextWrapped = false,
		Text = "LIVE RANKING",
		ZIndex = 32,
	})
	rows = {}
	for i = 1, 6 do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(8, 26 + (i - 1) * 26),
			Size = UDim2.new(1, -16, 0, 22),
			BackgroundColor3 = C.Card,
			ZIndex = 32,
		}, listFrame)
		UI.corner(row, 8)
		local fill = UI.new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 32,
		}, row)
		UI.corner(fill, 8)
		local label = UI.label(row, {
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.new(1, -16, 1, 0),
			Font = UI.Fonts.Bold,
			TextSize = 10,
			TextWrapped = false,
			Text = "",
			ZIndex = 34,
		})
		rows[i] = { row = row, fill = fill, label = label }
	end

	tapButton = UI.button(root, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(180, 64),
		Text = "FLEX!",
		TextSize = 28,
		ZIndex = 33,
		Radius = 16,
	}, "primary")
	tapScale = UI.new("UIScale", {}, tapButton)
	tapButton.Activated:Connect(tap)

	-- Results panel
	resultPanel = UI.panel(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(340, 270),
		Visible = false,
		ZIndex = 40,
	})
	resultTitle = UI.label(resultPanel, {
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 34),
		Font = UI.Fonts.Title,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
		ZIndex = 41,
	})
	resultBody = UI.label(resultPanel, {
		Position = UDim2.fromOffset(18, 52),
		Size = UDim2.new(1, -36, 1, -100),
		Font = UI.Fonts.Bold,
		TextSize = 13,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		ZIndex = 41,
	})
	local close = UI.button(resultPanel, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(140, 34),
		Text = "CONTINUE",
		ZIndex = 42,
	}, "primary")
	close.Activated:Connect(function()
		Audio.click()
		root.Visible = false
		resultPanel.Visible = false
	end)

	ContextActionService:BindActionAtPriority("GlowCompTap", function(_, state)
		if comp then
			if state == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)

	RunService.RenderStepped:Connect(function()
		if not comp then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < comp.tStart then
			local left = math.ceil(comp.tStart - now)
			center.Text = tostring(left)
			center.TextColor3 = C.Gold
			if left ~= comp.lastTick then
				comp.lastTick = left
				Audio.countdown(false, left)
			end
			tapButton.BackgroundTransparency = 0.5
		elseif now <= comp.tStart + comp.length then
			if not comp.started then
				comp.started = true
				Audio.countdown(true)
				Fx.punch(6)
			end
			center.Text = "FLEX!"
			center.TextColor3 = C.Good
			tapButton.BackgroundTransparency = 0
			title.Text = string.format("🏆 MOG COMPETITION  ·  %.1fs", comp.tStart + comp.length - now)
		end
		if pendingSend > 0 and os.clock() - lastSend > 0.1 then
			Action:FireServer("CompTaps", pendingSend)
			pendingSend = 0
			lastSend = os.clock()
		end
	end)
end

local function drawRoster(list)
	local top = 1
	for _, e in list do
		top = math.max(top, e.t or 0)
	end
	for i, ref in rows do
		local e = list[i]
		ref.row.Visible = e ~= nil
		if e then
			ref.label.Text = string.format("%d.  %s", i, e.n)
			ref.label.TextColor3 = e.m and C.Gold or C.Text
			ref.fill.Size = UDim2.fromScale(math.clamp((e.t or 0) / math.max(top, 20), 0, 1), 1)
			ref.fill.BackgroundColor3 = e.m and C.Gold or C.Accent
		end
	end
end

function CompetitionUI.start(tStart, length, roster)
	comp = { tStart = tStart, length = length, myTaps = 0, lastTick = 0 }
	pendingSend = 0
	local list = {}
	for _, e in roster do
		table.insert(list, { n = e.n, t = 0, m = e.m })
	end
	drawRoster(list)
	title.Text = "🏆 MOG COMPETITION"
	resultPanel.Visible = false
	tapButton.Visible = true
	listFrame.Visible = true
	center.Text = ""
	root.Visible = true
end

function CompetitionUI.progress(list)
	if comp then
		drawRoster(list)
	end
end

function CompetitionUI.finish(place, total, aura, winner, summary)
	if pendingSend > 0 then
		Action:FireServer("CompTaps", pendingSend)
		pendingSend = 0
	end
	comp = nil
	tapButton.Visible = false
	listFrame.Visible = false
	center.Text = ""
	title.Text = "🏆 MOG COMPETITION"
	local lines = {}
	for i, e in summary do
		table.insert(lines, string.format("%d.  %s  —  %d pts", i, e.n, e.p))
	end
	resultTitle.Text = winner and "YOU WON! 👑" or string.format("YOU PLACED #%d OF %d", place, total)
	resultTitle.TextColor3 = winner and C.Gold or C.Cyan
	resultBody.Text = table.concat(lines, "\n") .. string.format("\n\nReward: +✦%s Aura%s", Util.fmt(aura), winner and "  +  a free crate" or "")
	resultPanel.Visible = true
	if winner then
		Audio.win()
		Fx.flash(C.Gold, 0.4, 0.8)
		Fx.shake(0.5, 0.6)
	else
		Audio.lose()
	end
end

return CompetitionUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="38">
            <Properties>
              <string name="Name">DuelUI</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: duel overlay. Both sides tap as fast as they can for 7 seconds; Mog Power gives an
-- edge but speed can upset a higher rank. Win or lose, you always get rewarded.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local DuelUI = {}

local player = Players.LocalPlayer
local C = UI.Colors
local Action
local root, myName, myInfo, oppName, oppInfo, myBar, oppBar, center, tapButton, tapScale, resultLabel
local duel -- { tStart, length, myTaps, oppTaps, sent, lastTickSecond }
local pendingSend = 0
local lastSend = 0

local function card(parent, anchorX, color)
	local c = UI.panel(parent, {
		AnchorPoint = Vector2.new(anchorX, 0),
		Position = UDim2.new(anchorX, anchorX == 0 and 12 or -12, 0, 8),
		Size = UDim2.fromOffset(190, 52),
		ZIndex = 31,
	})
	c:FindFirstChildOfClass("UIStroke").Color = color
	local name = UI.label(c, {
		Position = UDim2.fromOffset(12, 5),
		Size = UDim2.new(1, -24, 0, 20),
		Font = UI.Fonts.Title,
		TextSize = 14,
		TextXAlignment = anchorX == 0 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = 32,
	})
	local info = UI.label(c, {
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 18),
		Font = UI.Fonts.Bold,
		TextSize = 10,
		TextColor3 = C.Muted,
		TextXAlignment = anchorX == 0 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = 32,
	})
	return name, info
end

local function tap()
	if not duel then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < duel.tStart or now > duel.tStart + duel.length then
		return
	end
	duel.myTaps += 1
	pendingSend += 1
	Audio.play("Tone", 0.9 + (duel.myTaps % 8) * 0.07, 0.35)
	UI.pop(tapScale, 0.93)
end

function DuelUI.init(gui, action)
	Action = action
	root = UI.new("Frame", {
		Name = "Duel",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
	}, gui)
	myName, myInfo = card(root, 0, C.Cyan)
	oppName, oppInfo = card(root, 1, C.Accent2)

	local bars = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(280, 36),
		BackgroundTransparency = 1,
		ZIndex = 31,
	}, root)
	myBar = UI.bar(bars, { Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, 0, 0, 12) }, C.Sky)
	oppBar = UI.bar(bars, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 12) }, C.Pink)

	center = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(400, 70),
		Font = UI.Fonts.Title,
		TextSize = 56,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0.2,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = "",
		ZIndex = 32,
	})
	resultLabel = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.43),
		Size = UDim2.fromOffset(520, 40),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		ZIndex = 32,
	})

	tapButton = UI.button(root, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(180, 64),
		Text = "TAP!",
		TextSize = 28,
		ZIndex = 33,
		Radius = 16,
	}, "primary")
	tapButton.Font = UI.Fonts.Title
	tapScale = UI.new("UIScale", {}, tapButton)
	tapButton.Activated:Connect(tap)

	ContextActionService:BindActionAtPriority("GlowDuelTap", function(_, state)
		if duel then
			if state == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)

	RunService.RenderStepped:Connect(function()
		if not duel then
			return
		end
		local now = workspace:GetServerTimeNow()
		local maxTaps = Config.Duel.MaxTapsPerSecond * duel.length
		myBar.set(duel.myTaps / maxTaps * 2.2)
		oppBar.set(duel.oppTaps / maxTaps * 2.2)

		if now < duel.tStart then
			local left = math.ceil(duel.tStart - now)
			center.Text = tostring(left)
			center.TextColor3 = C.Gold
			if left ~= duel.lastTick then
				duel.lastTick = left
				Audio.countdown(false, left)
			end
			tapButton.BackgroundTransparency = 0.5
		elseif now <= duel.tStart + duel.length then
			if not duel.started then
				duel.started = true
				Audio.countdown(true)
				Fx.punch(6)
			end
			center.Text = "TAP!"
			center.TextColor3 = C.Good
			tapButton.BackgroundTransparency = 0
			local remaining = duel.tStart + duel.length - now
			resultLabel.Text = string.format("%.1fs", remaining)
			resultLabel.TextColor3 = C.Text
		end

		if pendingSend > 0 and os.clock() - lastSend > 0.1 then
			Action:FireServer("DuelTaps", pendingSend)
			pendingSend = 0
			lastSend = os.clock()
		end
	end)
end

function DuelUI.start(oppNameText, oppRank, oppScore, myScore, tStart, length)
	local myRank = Config.Ranks[player:GetAttribute("Rank") or 1]
	local opp = Config.Ranks[oppRank] or Config.Ranks[1]
	myName.Text = player.DisplayName
	myName.TextColor3 = myRank.Color
	myInfo.Text = string.format("%s  ·  POWER %s", myRank.Name:upper(), Util.fmt(myScore))
	oppName.Text = oppNameText
	oppName.TextColor3 = opp.Color
	oppInfo.Text = string.format("%s  ·  POWER %s", opp.Name:upper(), Util.fmt(oppScore))
	duel = { tStart = tStart, length = length, myTaps = 0, oppTaps = 0, lastTick = 0 }
	pendingSend = 0
	resultLabel.Text = ""
	tapButton.Visible = true
	root.Visible = true
end

function DuelUI.progress(oppTaps)
	if duel then
		duel.oppTaps = oppTaps
	end
end

function DuelUI.finish(win, given, myTaps, oppTaps, myEff, oppEff, streak)
	if not duel then
		return
	end
	if pendingSend > 0 then
		Action:FireServer("DuelTaps", pendingSend)
		pendingSend = 0
	end
	duel.oppTaps = oppTaps
	tapButton.Visible = false
	if win then
		center.Text = "MOG!"
		center.TextColor3 = C.Gold
		Audio.win()
		Fx.flash(C.Gold, 0.4, 0.8)
		Fx.shake(0.5, 0.6)
		resultLabel.Text = string.format("You out-glowed %s   ·   +✦%s%s", oppName.Text, Util.fmt(given), streak > 1 and ("   ·   🔥 streak " .. streak) or "")
	else
		center.Text = "RESPECT"
		center.TextColor3 = C.Cyan
		Audio.lose()
		resultLabel.Text = string.format("%s took this one   ·   still earned +✦%s", oppName.Text, Util.fmt(given))
	end
	resultLabel.TextColor3 = C.Text
	local finished = duel
	duel = nil
	task.delay(3.6, function()
		if duel == nil then
			root.Visible = false
		end
	end)
	return finished
end

return DuelUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="39">
            <Properties>
              <string name="Name">Fx</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: game-feel effects. Camera punch/shake, floating text, particle bursts and the big
-- centred callouts. Everything respects the "Effects" setting so players can tone it down.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))

local Fx = {}

local player = Players.LocalPlayer
local camera = workspace:WaitForChild("Camera")
local gui
local baseFov, targetFov = 70, 70
local fovKick = 0
local shakeMag, shakeTime = 0, 0
local flashFrame

local function effectsOn()
	return player:GetAttribute("Set_Fx") ~= false
end

function Fx.init(screenGui)
	gui = screenGui
	flashFrame = UI.new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 90,
		Active = false,
	}, gui)

	RunService.RenderStepped:Connect(function(dt)
		fovKick = fovKick * (1 - math.min(1, dt * 12))
		baseFov += (targetFov - baseFov) * math.min(1, dt * 4)
		camera.FieldOfView = baseFov + fovKick
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			if shakeTime > 0 and effectsOn() then
				shakeTime -= dt
				local m = shakeMag * math.clamp(shakeTime / 0.3, 0, 1)
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
			else
				shakeMag = 0
				shakeTime = 0
				hum.CameraOffset = Vector3.zero
			end
		end
	end)
end

-- The zone cameras change the resting field of view through this.
function Fx.setBaseFov(fov)
	targetFov = fov or 70
end

function Fx.punch(amount)
	if effectsOn() then
		fovKick = math.max(fovKick, amount)
	end
end

function Fx.shake(mag, dur)
	if effectsOn() then
		shakeMag = math.max(shakeMag, mag)
		shakeTime = math.max(shakeTime, dur)
	end
end

function Fx.flash(color, strength, dur)
	if not effectsOn() or not flashFrame then
		return
	end
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	UI.tween(flashFrame, dur or 0.5, { BackgroundTransparency = 1 })
end

local function anchorAt(pos, lifetime)
	local anchor = UI.new("Part", {
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 1,
		Size = Vector3.one * 0.1,
		Position = pos,
	}, workspace)
	Debris:AddItem(anchor, lifetime)
	return anchor
end

-- Rising number in the world. Only used for notable pickups so the screen stays calm.
function Fx.floatText(pos, text, color, size)
	if not effectsOn() then
		return
	end
	local anchor = anchorAt(pos + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2), 1.3)
	local bb = UI.new("BillboardGui", {
		Adornee = anchor,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(240, size + 10),
	}, anchor)
	local label = UI.label(bb, {
		Size = UDim2.fromScale(1, 1),
		Font = UI.Fonts.Title,
		TextSize = size,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.25,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = text,
		TextWrapped = false,
	})
	local grow = UI.new("UIScale", { Scale = 0.4 }, label)
	UI.tween(grow, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	UI.tween(bb, 1.1, { StudsOffset = Vector3.new(0, 6, 0) })
	UI.tween(label, 1.1, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

function Fx.burst(pos, color, count)
	if not effectsOn() then
		return
	end
	local anchor = anchorAt(pos, 1.5)
	local e = UI.new("ParticleEmitter", {
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Rate = 0,
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
	}, anchor)
	e:Emit(count)
end

-- Expanding shockwave ring on the ground.
function Fx.ring(pos, color, radius)
	if not effectsOn() then
		return
	end
	local part = UI.new("Part", {
		Name = "FxRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(pos.X, pos.Y - 2.5, pos.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.2,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, workspace)
	local d = (radius or 24) * 2
	UI.tween(part, 0.55, { Size = Vector3.new(0.4, d, d), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(part, 0.7)
end

-- A tall beam of light that shoots up and fades (level-ups, big hatches).
function Fx.pillar(pos, color, height)
	if not effectsOn() then
		return
	end
	local h = height or 70
	local part = UI.new("Part", {
		Name = "FxPillar",
		Size = Vector3.new(5, h, 5),
		Position = Vector3.new(pos.X, pos.Y - 2.5 + h / 2, pos.Z),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.45,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, workspace)
	UI.tween(part, 0.9, { Size = Vector3.new(0.4, h, 0.4), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(part, 1)
end

-- Big centred callout. Reserved for moments that deserve it (rank ups, rebirths, combos).
function Fx.announce(title, sub, color, y)
	if not gui then
		return
	end
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, y or 0.2, 0),
		Size = UDim2.fromOffset(520, 80),
		BackgroundTransparency = 1,
		ZIndex = 60,
	}, gui)
	local scale = UI.new("UIScale", { Scale = 0.3 }, holder)
	local t = UI.label(holder, {
		Size = UDim2.new(1, 0, 0, 44),
		Font = UI.Fonts.Title,
		TextSize = 38,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.1,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = title,
		ZIndex = 60,
	})
	local s = UI.label(holder, {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Bold,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = sub or "",
		ZIndex = 60,
	})
	UI.tween(scale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.9, function()
		UI.tween(t, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		UI.tween(s, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.6)
		holder:Destroy()
	end)
end

return Fx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">HammerRow</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: floating OWNED / EQUIPPED / price labels over every hammer pedestal.
-- They are different for each player, so they are drawn here instead of on the pedestal itself.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))

local HammerRow = {}

local player = Players.LocalPlayer
local C = UI.Colors
local tags = {} -- hammer id -> { frame, status, stroke }

local function ownedSet()
	local set = {}
	for n in string.gmatch(player:GetAttribute("HammersOwned") or "1", "%d+") do
		set[tonumber(n)] = true
	end
	return set
end

local function refresh()
	local set = ownedSet()
	local equipped = player:GetAttribute("Hammer") or 1
	local aura = player:GetAttribute("Aura") or 0
	for id, tag in tags do
		local hammer = Config.HammerById[id]
		if id == equipped then
			tag.status.Text = "EQUIPPED"
			tag.status.TextColor3 = C.Good
			tag.stroke.Color = C.Good
		elseif set[id] then
			tag.status.Text = "OWNED"
			tag.status.TextColor3 = C.Sky
			tag.stroke.Color = C.Sky
		else
			tag.status.Text = "🏆 " .. Util.fmt(hammer.Price)
			local affordable = aura >= hammer.Price
			tag.status.TextColor3 = affordable and C.Yellow or C.Danger
			tag.stroke.Color = affordable and C.Gold or C.Stroke
		end
	end
end

local function makeTag(pedestal, hammer)
	local gui = UI.new("BillboardGui", {
		Name = "HammerTag" .. hammer.Id,
		Adornee = pedestal,
		Size = UDim2.fromOffset(130, 74),
		StudsOffset = Vector3.new(0, 11.5, 0),
		AlwaysOnTop = true,
		MaxDistance = 110,
		LightInfluence = 0,
		ResetOnSpawn = false,
	}, player:WaitForChild("PlayerGui"))
	local frame = UI.panel(gui, { Size = UDim2.fromScale(1, 1), Radius = 10 })
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	UI.label(frame, {
		Position = UDim2.fromOffset(4, 3),
		Size = UDim2.new(1, -8, 0, 14),
		Font = UI.Fonts.Bold,
		TextSize = 11,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = hammer.Name,
	})
	UI.label(frame, {
		Position = UDim2.fromOffset(4, 17),
		Size = UDim2.new(1, -8, 0, 30),
		Font = UI.Fonts.Title,
		TextSize = 26,
		TextColor3 = hammer.Head,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = "x" .. hammer.Mult,
	})
	local status = UI.label(frame, {
		Position = UDim2.fromOffset(4, 48),
		Size = UDim2.new(1, -8, 0, 20),
		Font = UI.Fonts.Title,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
	})
	tags[hammer.Id] = { frame = frame, status = status, stroke = stroke }
end

function HammerRow.init()
	task.spawn(function()
		local world = workspace:WaitForChild("GlowWorld", 30)
		local row = world and world:WaitForChild("HammerRow", 30)
		if not row then
			return
		end
		for _, child in row:GetChildren() do
			local id = child:GetAttribute("HammerId")
			if id and Config.HammerById[id] then
				makeTag(child, Config.HammerById[id])
			end
		end
		refresh()
		for _, attr in { "Hammer", "HammersOwned" } do
			player:GetAttributeChangedSignal(attr):Connect(refresh)
		end
		-- Aura changes constantly; re-check which hammers are affordable a few times a second.
		while true do
			task.wait(0.4)
			refresh()
		end
	end)
end

return HammerRow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="41">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the always-on screen.
--   Top centre: hint banner, then Aura / Rebirths / multiplier pills, then small status chips.
--   Left edge: big icon buttons (Shop, Rebirth with %, Rewards, PVP, MOG).
--   Right edge: smaller buttons (Hammers, Pets, Wardrobe, Crates, Battle, Settings).
--   Bottom centre: the big Aura counter and the wide LEVEL bar. Bottom left: the current quest.
-- Every button is a normal on-screen button, so it works the same from any camera angle.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local Hud = {}

local player = Players.LocalPlayer
local camera = workspace:WaitForChild("Camera")
local C = UI.Colors

local refs: { [string]: any } = {}
local fitScales = {} -- one UIScale per HUD block, resized together for small screens
local shownAura = 0
local pending, lastGain = 0, 0
local lastAura = 0

local function tint(panel, color)
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
end

local function pill(parent, name, size, color)
	local frame = UI.panel(parent, { Name = name, Size = size, Radius = 10 })
	tint(frame, color)
	return frame
end

local function addFit(frame)
	table.insert(fitScales, UI.new("UIScale", {}, frame))
end

-- Moves the character somewhere (the buttons that jump you to a place).
local function teleport(position, lookAt)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z))
	end
end

local TELEPORTS = {
	PVP = function()
		local ring = Config.StationPos("Ring")
		local front = Config.StationFront("Ring")
		teleport(ring + front * 32 + Vector3.new(0, 4, 0), ring)
	end,
	Battle = function()
		local pos, front = Config.BattlePos(), Config.BattleFront()
		teleport(pos + front * 40 + Vector3.new(0, 4, 0), pos)
	end,
	MOG = function()
		teleport(Vector3.new(0, 5, 12), Vector3.new(0, 5, -20))
	end,
	Hammers = function()
		teleport(Vector3.new(0, 4, Config.HammerRowZ + 10), Vector3.new(0, 4, Config.HammerRowZ - 30))
	end,
}

--------------------------------------------------------------------------------
-- Top: banner, pills, chips
--------------------------------------------------------------------------------
local function buildTop(gui)
	local stack = UI.new("Frame", {
		Name = "Top",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 6),
		Size = UDim2.fromOffset(460, 150),
		BackgroundTransparency = 1,
	}, gui)
	addFit(stack)
	UI.new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 5),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, stack)

	-- Hint banner
	local banner = pill(stack, "Banner", UDim2.fromOffset(440, 28), C.Orange)
	banner.LayoutOrder = 1
	refs.banner = UI.label(banner, {
		Size = UDim2.fromScale(1, 1),
		Font = UI.Fonts.Title,
		TextSize = 13,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
	})

	-- Pills row
	local row = UI.new("Frame", { Name = "Pills", Size = UDim2.fromOffset(440, 30), BackgroundTransparency = 1, LayoutOrder = 2 }, stack)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)
	local function counter(order, width, color, textColor)
		local frame = pill(row, "Counter", UDim2.fromOffset(width, 30), color)
		frame.LayoutOrder = order
		local label = UI.label(frame, {
			Size = UDim2.fromScale(1, 1),
			Font = UI.Fonts.Title,
			TextSize = 15,
			TextColor3 = textColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "",
		})
		return label
	end
	refs.auraPill = counter(1, 170, C.Gold, C.Yellow)
	refs.rebirthPill = counter(2, 110, C.Mint, C.Mint)
	refs.multPill = counter(3, 140, C.Pink, C.Pink)

	-- Chips (chain, event, competition), only visible while relevant
	local chips = UI.new("Frame", { Name = "Chips", Size = UDim2.fromOffset(440, 70), BackgroundTransparency = 1, LayoutOrder = 3 }, stack)
	UI.new("UIListLayout", {
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 4),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, chips)
	local function chip(order, color, width)
		local c = pill(chips, "Chip", UDim2.fromOffset(width, 22), color)
		c.LayoutOrder = order
		c.Visible = false
		local label = UI.label(c, {
			Size = UDim2.fromScale(1, 1),
			Font = UI.Fonts.Title,
			TextSize = 11,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "",
		})
		return c, label
	end
	refs.chain, refs.chainText = chip(1, C.Sky, 170)
	refs.chainScale = UI.new("UIScale", {}, refs.chain)
	refs.chainBar = UI.bar(refs.chain, { Position = UDim2.new(0, 10, 1, -5), Size = UDim2.new(1, -20, 0, 2) }, C.Sky)
	refs.streak, refs.streakText = chip(0, C.Orange, 200)
	refs.streakScale = UI.new("UIScale", {}, refs.streak)
	refs.streakBar = UI.bar(refs.streak, { Position = UDim2.new(0, 10, 1, -5), Size = UDim2.new(1, -20, 0, 2) }, C.Orange)
	refs.gift, refs.giftText = chip(4, C.Mint, 200)
	refs.comp, refs.compText = chip(2, C.Orange, 300)
	refs.event, refs.eventText = chip(3, C.Pink, 300)
end

--------------------------------------------------------------------------------
-- Side buttons
--------------------------------------------------------------------------------
-- A big icon button with its name underneath. Returns the button, its caption label and its badge dot.
local function sideButton(parent, order, size, color, icon, name, onClick)
	local button = UI.button(parent, {
		LayoutOrder = order,
		Size = UDim2.fromOffset(size, size),
		BackgroundColor3 = color,
		Text = "",
		Radius = 12,
	}, "card")
	UI.label(button, {
		Size = UDim2.new(1, 0, 0, size * 0.5),
		Position = UDim2.fromOffset(0, size * 0.08),
		Font = UI.Fonts.Bold,
		TextSize = math.floor(size * 0.42),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 1,
		Text = icon,
	})
	local caption = UI.label(button, {
		Size = UDim2.new(1, 0, 0, size * 0.28),
		Position = UDim2.new(0, 0, 1, -size * 0.34),
		Font = UI.Fonts.Title,
		TextSize = math.floor(size * 0.18),
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0.1,
		Text = name:upper(),
	})
	local badge = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -2, 0, 2),
		Size = UDim2.fromOffset(13, 13),
		BackgroundColor3 = C.Danger,
		Visible = false,
		ZIndex = 5,
	}, button)
	UI.corner(badge, 7)
	UI.stroke(badge, Color3.new(1, 1, 1), 1.5, 0)
	button.Activated:Connect(function()
		Audio.click()
		onClick()
	end)
	return button, caption, badge
end

local function buildSides(gui, Menu)
	refs.badges = {}
	local left = UI.new("Frame", {
		Name = "LeftButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 8, 0.5, -10),
		Size = UDim2.fromOffset(66, 5 * 66 + 4 * 8),
		BackgroundTransparency = 1,
	}, gui)
	addFit(left)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, left)

	local _, _, shopBadge = sideButton(left, 1, 66, C.Yellow, "🛒", "Shop", function()
		Menu.toggle("Upgrades")
	end)
	refs.badges.Upgrades = shopBadge
	local rebirthBtn, rebirthCaption = sideButton(left, 2, 66, C.Good, "🔄", "Rebirth", function()
		Hud.toggleRebirth()
	end)
	refs.rebirthCaption = rebirthCaption
	refs.rebirthBar = UI.bar(rebirthBtn, { Position = UDim2.new(0, 6, 1, -8), Size = UDim2.new(1, -12, 0, 4) }, Color3.new(1, 1, 1))
	local _, _, rewardsBadge = sideButton(left, 3, 66, C.Pink, "🎁", "Rewards", function()
		Menu.toggle("Rewards")
	end)
	refs.badges.Rewards = rewardsBadge
	sideButton(left, 4, 66, C.Danger, "🥊", "PVP", TELEPORTS.PVP)
	sideButton(left, 5, 66, C.Orange, "🏆", "MOG", TELEPORTS.MOG)

	local right = UI.new("Frame", {
		Name = "RightButtons",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, -10),
		Size = UDim2.fromOffset(52, 6 * 52 + 5 * 6),
		BackgroundTransparency = 1,
	}, gui)
	addFit(right)
	UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, right)
	sideButton(right, 1, 52, C.Mint, "🔨", "Hammers", TELEPORTS.Hammers)
	sideButton(right, 2, 52, C.Pink, "🐾", "Pets", function()
		Menu.toggle("Pets")
	end)
	local _, _, wardrobeBadge = sideButton(right, 3, 52, C.Purple, "👗", "Wardrobe", function()
		Menu.toggle("Wardrobe")
	end)
	refs.badges.Wardrobe = wardrobeBadge
	local _, _, crateBadge = sideButton(right, 4, 52, C.Sky, "📦", "Crates", function()
		Menu.toggle("Crates")
	end)
	refs.badges.Crates = crateBadge
	sideButton(right, 5, 52, C.Accent, "⚔️", "Battle", TELEPORTS.Battle)
	sideButton(right, 6, 52, C.Disabled, "⚙️", "Settings", function()
		Menu.toggle("Settings")
	end)
end

--------------------------------------------------------------------------------
-- Bottom: big Aura counter + wide LEVEL bar, and the quest
--------------------------------------------------------------------------------
local function buildBottom(gui)
	local box = UI.new("Frame", {
		Name = "Bottom",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -8),
		Size = UDim2.fromOffset(520, 84),
		BackgroundTransparency = 1,
	}, gui)
	addFit(box)

	refs.bigAura = UI.label(box, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.new(1, 0, 0, 44),
		Font = UI.Fonts.Title,
		TextSize = 36,
		TextColor3 = C.Yellow,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = "🏆 0",
	})
	refs.auraScale = UI.new("UIScale", {}, refs.bigAura)
	refs.ticker = UI.label(box, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0.5, 130, 0, 22),
		Size = UDim2.fromOffset(120, 20),
		Font = UI.Fonts.Title,
		TextSize = 16,
		TextColor3 = C.Mint,
		TextWrapped = false,
		TextTransparency = 1,
		Text = "",
	})

	local levelBar = UI.panel(box, {
		Name = "LevelBar",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, 0),
		Size = UDim2.fromOffset(520, 34),
		Radius = 12,
	})
	refs.levelFrame = levelBar
	refs.xpBar = UI.bar(levelBar, { Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 1, -12) }, C.Purple)
	refs.levelText = UI.label(levelBar, {
		Size = UDim2.fromScale(1, 1),
		Font = UI.Fonts.Title,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		ZIndex = 5,
		Text = "",
	})

	-- Quest, bottom-left
	local quest = pill(gui, "Quest", UDim2.fromOffset(200, 42), C.Mint)
	refs.quest = quest
	quest.AnchorPoint = Vector2.new(0, 1)
	quest.Position = UDim2.new(0, 8, 1, -8)
	refs.questScale = UI.new("UIScale", {}, quest)
	table.insert(fitScales, refs.questScale)
	refs.questText = UI.label(quest, {
		Position = UDim2.fromOffset(10, 3),
		Size = UDim2.new(1, -52, 0, 16),
		Font = UI.Fonts.Bold,
		TextSize = 11,
		TextWrapped = false,
		Text = "",
	})
	refs.questBar = UI.bar(quest, { Position = UDim2.new(0, 10, 1, -13), Size = UDim2.new(1, -20, 0, 6) }, C.Mint)
	refs.questCount = UI.label(quest, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 3),
		Size = UDim2.fromOffset(40, 16),
		Font = UI.Fonts.Title,
		TextSize = 10,
		TextColor3 = C.Mint,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		Text = "",
	})
end

--------------------------------------------------------------------------------
-- Rebirth window
--------------------------------------------------------------------------------
local function buildRebirth(gui, Action)
	local win = UI.panel(gui, {
		Name = "RebirthWindow",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(360, 250),
		Visible = false,
		ZIndex = 20,
	})
	addFit(win)
	tint(win, C.Good)
	refs.rebirthWin = win
	UI.label(win, {
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.new(1, -60, 0, 28),
		Font = UI.Fonts.Title,
		TextSize = 22,
		TextColor3 = C.Good,
		TextWrapped = false,
		Text = "🔄 REBIRTH",
		ZIndex = 21,
	})
	local close = UI.button(win, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(30, 30),
		BackgroundColor3 = C.Danger,
		Text = "X",
		TextSize = 16,
		ZIndex = 22,
		Radius = 8,
	}, "card")
	close.Activated:Connect(function()
		Audio.click()
		Hud.toggleRebirth(false)
	end)
	refs.rebirthInfo = UI.label(win, {
		Position = UDim2.fromOffset(16, 48),
		Size = UDim2.new(1, -32, 0, 96),
		Font = UI.Fonts.Bold,
		TextSize = 14,
		TextColor3 = C.Muted,
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 21,
		Text = "",
	})
	refs.rebirthProg = UI.bar(win, { Position = UDim2.fromOffset(16, 150), Size = UDim2.new(1, -32, 0, 14) }, C.Good)
	refs.rebirthProg.back.ZIndex = 21
	refs.rebirthProg.fill.ZIndex = 22
	refs.rebirthGo = UI.button(win, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.new(1, -32, 0, 44),
		Text = "REBIRTH NOW",
		TextSize = 20,
		ZIndex = 21,
	})
	refs.rebirthGo.Activated:Connect(function()
		local need = player:GetAttribute("RebirthNeed") or 20
		if (player:GetAttribute("Level") or 1) >= need then
			Action:FireServer("Rebirth")
			Hud.toggleRebirth(false)
		else
			Audio.error()
		end
	end)
end

function Hud.toggleRebirth(force)
	local win = refs.rebirthWin
	local show = force
	if show == nil then
		show = not win.Visible
	end
	win.Visible = show
	if show then
		Hud.refresh()
	end
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function Hud.init(gui, Menu, Action)
	buildTop(gui)
	buildSides(gui, Menu)
	buildBottom(gui)
	buildRebirth(gui, Action)

	-- Shrink the whole HUD on small screens (phones) so nothing crowds the view.
	local function fit()
		local v = camera.ViewportSize
		local s = math.clamp(math.min(v.X / 900, v.Y / 520), 0.6, 1)
		for _, scale in fitScales do
			scale.Scale = s
		end
	end
	fit()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			Menu.toggle()
		end
	end)

	player:GetAttributeChangedSignal("Aura"):Connect(function()
		local now = player:GetAttribute("Aura") or 0
		if now > lastAura then
			pending += now - lastAura
			lastGain = os.clock()
			UI.pop(refs.auraScale, 1.06)
		end
		lastAura = now
	end)

	local lastSlow = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()

		local aura = player:GetAttribute("Aura") or 0
		shownAura += (aura - shownAura) * math.min(1, dt * 9)
		if math.abs(aura - shownAura) < 0.5 then
			shownAura = aura
		end
		refs.bigAura.Text = "🏆 " .. Util.fmt(shownAura)
		refs.auraPill.Text = "🏆 " .. Util.fmt(shownAura)

		if pending > 0 then
			refs.ticker.Text = "+" .. Util.fmt(pending)
			if t - lastGain < 1.1 then
				refs.ticker.TextTransparency = 0
			else
				refs.ticker.TextTransparency = math.min(1, (t - lastGain - 1.1) / 0.4)
				if refs.ticker.TextTransparency >= 1 then
					pending = 0
				end
			end
		end

		local chain = player:GetAttribute("Chain") or 0
		local remaining = (player:GetAttribute("ChainExpire") or 0) - workspace:GetServerTimeNow()
		if chain >= 3 and remaining > 0 then
			refs.chain.Visible = true
			refs.chainText.Text = string.format("CHAIN x%d  ·  +%d%%", chain, math.floor((Config.ChainMult(chain) - 1) * 100 + 0.5))
			refs.chainText.TextColor3 = C.Sky:Lerp(C.Pink, math.clamp(chain / Config.ChainMax, 0, 1))
			refs.chainBar.set(remaining / Config.ChainWindow)
		else
			refs.chain.Visible = false
		end

		-- Mog Streak / Frenzy chip
		local now = workspace:GetServerTimeNow()
		local frenzyLeft = (player:GetAttribute("FrenzyEnd") or 0) - now
		local combo = player:GetAttribute("SwingCombo") or 0
		if frenzyLeft > 0 then
			refs.streak.Visible = true
			refs.streakText.Text = string.format("🔥 FRENZY x%d  ·  %.1fs", Config.Frenzy.Mult, frenzyLeft)
			refs.streakText.TextColor3 = C.Yellow
			refs.streakBar.set(frenzyLeft / Config.Frenzy.Duration)
			refs.streakBar.fill.BackgroundColor3 = C.Yellow
		elseif combo >= 5 and (t - lastGain) < 1.2 then
			refs.streak.Visible = true
			refs.streakText.Text = string.format("MOG STREAK  %d/%d", combo, Config.Frenzy.Combo)
			refs.streakText.TextColor3 = C.Orange
			refs.streakBar.set(combo / Config.Frenzy.Combo)
			refs.streakBar.fill.BackgroundColor3 = C.Orange
		else
			refs.streak.Visible = false
		end
		-- Next play-time gift
		local giftIn = (player:GetAttribute("GiftAt") or 0) - now
		if (player:GetAttribute("GiftAt") or 0) > 0 and giftIn > 0 then
			refs.gift.Visible = true
			refs.giftText.Text = "🎁 Gift in " .. Util.clock(giftIn)
			refs.giftText.TextColor3 = C.Mint
		else
			refs.gift.Visible = false
		end

		if t - lastSlow > 0.15 then
			lastSlow = t
			Hud.refresh()
		end
	end)
end

function Hud.pulseChain()
	UI.pop(refs.chainScale, 1.12)
end

function Hud.pulseQuest()
	UI.pop(refs.questScale, 1.15)
end

-- The total multiplier on every swing (hammer x pets x rebirth x boost x event).
function Hud.swingMult()
	local hammer = Config.HammerById[player:GetAttribute("Hammer") or 1] or Config.Hammers[1]
	local rebirths = player:GetAttribute("Rebirths") or 0
	local ev = workspace:GetAttribute("Event")
	local evDef = ev and ev ~= "" and Config.EventById[ev]
	local boost = Config.BoostMult(player:GetAttribute("Lv_Boost") or 0)
	return hammer.Mult * (1 + (player:GetAttribute("PetMult") or 0)) * Config.RebirthMult(rebirths) * boost * ((evDef and evDef.AuraMult) or 1)
end

function Hud.refresh()
	local level = player:GetAttribute("Level") or 1
	local rankIndex = player:GetAttribute("Rank") or 1
	local rank = Config.Ranks[rankIndex]
	local xp = player:GetAttribute("XP") or 0
	local needed = player:GetAttribute("XPNeeded") or 1
	local rebirths = player:GetAttribute("Rebirths") or 0
	local need = player:GetAttribute("RebirthNeed") or Config.RebirthRequirement(rebirths)

	-- Level bar
	refs.levelText.Text = string.format("LEVEL %s   %s/%s   ·   %s", Util.fmt(level), Util.fmt(xp), Util.fmt(needed), rank.Name:upper())
	refs.xpBar.fill.BackgroundColor3 = rank.Color
	refs.xpBar.set(xp / needed)
	tint(refs.levelFrame, rank.Color)

	-- Banner + pills
	local mult = Hud.swingMult()
	refs.banner.Text = string.format("Click / tap to train  •  ×%s Aura  •  Rebirth at Level %d", Util.fmt(mult), need)
	refs.rebirthPill.Text = "★ " .. rebirths
	refs.multPill.Text = "×" .. Util.fmt(mult) .. " per swing"

	-- Rebirth button percentage + window
	local pct = math.clamp(level / need, 0, 1)
	-- "Rebirth ready!" once, the moment you reach the level (and again after each rebirth)
	local ready = level >= need
	if ready and not refs.rebirthWasReady and refs.sawFirstRefresh then
		Audio.say("rebirth")
		Audio.rank()
		UI.pop(refs.questScale, 1.15)
	end
	refs.rebirthWasReady = ready
	refs.sawFirstRefresh = true
	refs.rebirthCaption.Text = math.floor(pct * 100) .. "%"
	refs.rebirthBar.set(pct)
	if refs.rebirthWin.Visible then
		refs.rebirthInfo.Text = string.format(
			"Reach level %d to be reborn.\nYou keep your level, hammers and outfits.\nAura, stats and upgrades reset.\nEvery rebirth adds +50%% Aura and XP forever and gives 2 free crates.",
			need
		)
		refs.rebirthProg.set(pct)
		refs.rebirthGo.Text = ready and "REBIRTH NOW" or string.format("LEVEL %d / %d", level, need)
		refs.rebirthGo.BackgroundColor3 = ready and C.Good or C.Disabled
	end

	-- Quest
	local kind = player:GetAttribute("QuestKind")
	refs.quest.Visible = kind ~= nil
	if kind then
		local goal = player:GetAttribute("QuestGoal") or 1
		local progress = player:GetAttribute("QuestProgress") or 0
		refs.questText.Text = Config.QuestText(kind, goal)
		refs.questCount.Text = progress .. "/" .. goal
		refs.questBar.set(progress / goal)
	end

	-- Event chip
	local id = workspace:GetAttribute("Event")
	local ev = id and id ~= "" and Config.EventById[id]
	local left = (workspace:GetAttribute("EventEnd") or 0) - workspace:GetServerTimeNow()
	if ev and left > 0 then
		refs.event.Visible = true
		refs.eventText.Text = string.format("%s %s  %s  ·  %s", ev.Icon, ev.Name, Util.clock(left), ev.Desc)
		refs.eventText.TextColor3 = C.Pink
	else
		refs.event.Visible = false
	end

	-- Mog Competition chip
	local compState = workspace:GetAttribute("CompState")
	local compLeft = (workspace:GetAttribute("CompEnd") or 0) - workspace:GetServerTimeNow()
	if compState == "open" and compLeft > 0 then
		refs.comp.Visible = true
		refs.compText.Text = string.format("🏆 MOG COMPETITION OPEN %s  ·  press MOG", Util.clock(compLeft))
		refs.compText.TextColor3 = C.Orange
	elseif compState == "idle" and compLeft > 0 then
		refs.comp.Visible = true
		refs.compText.Text = string.format("🏆 Mog Competition in %s", Util.clock(compLeft))
		refs.compText.TextColor3 = C.Muted
	else
		refs.comp.Visible = false
	end

	-- Badges: a dot means "something is waiting for you"
	local aura = player:GetAttribute("Aura") or 0
	local affordable = false
	for _, def in Config.Upgrades do
		local lvl = player:GetAttribute("Lv_" .. def.Id) or 0
		if lvl < def.Max and aura >= Config.UpgradeCost(def, lvl) then
			affordable = true
		end
	end
	refs.badges.Rewards.Visible = player:GetAttribute("DailyReady") == true
	refs.badges.Crates.Visible = (player:GetAttribute("FreeCrates") or 0) > 0
	refs.badges.Upgrades.Visible = affordable
	refs.badges.Wardrobe.Visible = refs.newItem == true
end

function Hud.setNewItem(flag)
	refs.newItem = flag
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="42">
            <Properties>
              <string name="Name">Interact</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: "use" button for every place and hammer. Stand near something and a big button
-- appears at the bottom of the screen (or press E). It looks at where your CHARACTER is, never at the camera,
-- so it works the same from any camera angle, zoom or screen size.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local Interact = {}

local player = Players.LocalPlayer
local camera = workspace:WaitForChild("Camera")
local C = UI.Colors

local button, label, scale
local current -- { id, text, color }
local actionFn
local menu

local function flat(a, b)
	local d = a - b
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

local function owned(id)
	for n in string.gmatch(player:GetAttribute("HammersOwned") or "1", "%d+") do
		if tonumber(n) == id then
			return true
		end
	end
	return false
end

local function hammerText(hammer)
	if (player:GetAttribute("Hammer") or 1) == hammer.Id then
		return hammer.Name .. " (equipped)", C.Disabled
	elseif owned(hammer.Id) then
		return "Equip " .. hammer.Name, C.Mint
	end
	local price = Util.fmt(hammer.Price)
	local canBuy = (player:GetAttribute("Aura") or 0) >= hammer.Price
	return string.format("Buy %s  ·  🏆 %s", hammer.Name, price), canBuy and C.Gold or C.Danger
end

-- Picks the closest thing in range of the character.
local function scan()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or menu.isOpen() or player:GetAttribute("Training") or player:GetAttribute("InDuel") then
		return nil
	end
	local best, bestScore
	local pos = root.Position
	for _, hammer in Config.Hammers do
		local d = flat(pos, Config.HammerPos(hammer.Id))
		if d <= Config.HammerRadius and (not bestScore or d / Config.HammerRadius < bestScore) then
			local text, color = hammerText(hammer)
			best, bestScore = { id = "Hammer:" .. hammer.Id, text = text, color = color }, d / Config.HammerRadius
		end
	end
	for _, entry in Config.Interactables do
		local d = flat(pos, Config.InteractPos(entry))
		if d <= entry.Radius and (not bestScore or d / entry.Radius < bestScore) then
			local text = entry.Action
			if entry.Id == "Battle" then
				local stage = math.min((player:GetAttribute("Stage") or 0) + 1, Config.Battle.Count)
				text = string.format("Stage %d battle: %s", stage, Config.Battle.Stages[stage].Name)
			end
			best, bestScore = { id = entry.Id, text = text, color = C.Good }, d / entry.Radius
		end
	end
	return best
end

local function trigger()
	if current then
		Audio.click()
		actionFn(current.id)
	end
end

function Interact.init(gui, Action, Menu)
	menu = Menu
	actionFn = function(id)
		Action:FireServer("Interact", id)
	end
	button = UI.button(gui, {
		Name = "InteractButton",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -112),
		Size = UDim2.fromOffset(320, 48),
		Visible = false,
		ZIndex = 30,
		Text = "",
	})
	scale = UI.new("UIScale", {}, button)
	label = UI.label(button, {
		Size = UDim2.fromScale(1, 1),
		Font = UI.Fonts.Title,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		ZIndex = 31,
		Text = "",
	})
	button.Activated:Connect(trigger)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.E then
			trigger()
		end
	end)

	local last = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - last < 0.1 then
			return
		end
		last = now
		local found = scan()
		local changed = (found == nil) ~= (current == nil) or (found and current and found.id ~= current.id)
		current = found
		if not found then
			button.Visible = false
			return
		end
		if changed then
			button.Visible = true
			UI.pop(scale, 1.08)
		end
		local keyHint = UserInputService.KeyboardEnabled and "[E]  " or ""
		label.Text = keyHint .. found.text
		button.BackgroundColor3 = found.color
		-- keep the button above the bottom bar on every screen size
		local v = camera.ViewportSize
		scale.Scale = math.clamp(math.min(v.X / 900, v.Y / 520), 0.7, 1)
	end)
end

return Interact
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="43">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the one main menu. A single window with a tab list so the screen never fills up with
-- competing panels. Tabs register themselves with Menu.addTab(name, icon, builder).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local Menu = {}

local camera = workspace:WaitForChild("Camera")
local backdrop, window, content, scale
local tabs = {} -- ordered { name, icon, builder, button, page, refresh }
local current
local open = false
local onChanged = {}

local WINDOW_W, WINDOW_H = 760, 460

function Menu.isOpen()
	return open
end

function Menu.current()
	return current
end

function Menu.onChanged(fn)
	table.insert(onChanged, fn)
end

local function fitScale()
	local v = camera.ViewportSize
	local s = math.min(v.X / (WINDOW_W + 40), v.Y / (WINDOW_H + 40), 1)
	return math.max(0.5, s)
end

local function select(name)
	for _, tab in tabs do
		local active = tab.name == name
		tab.page.Visible = active
		UI.tween(tab.button, 0.15, {
			BackgroundColor3 = active and UI.Colors.Accent or UI.Colors.Card,
			BackgroundTransparency = active and 0.1 or 0.35,
		})
		if active then
			current = name
			if tab.refresh then
				tab.refresh()
			end
		end
	end
	for _, fn in onChanged do
		fn(name)
	end
end

function Menu.init(gui)
	backdrop = UI.new("TextButton", {
		Name = "MenuBackdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(6, 4, 16),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 20,
	}, gui)
	backdrop.Activated:Connect(function()
		Menu.close()
	end)

	window = UI.panel(backdrop, {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		BackgroundTransparency = 0.04,
		ZIndex = 21,
		Radius = 20,
	})
	scale = UI.new("UIScale", { Scale = fitScale() }, window)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		scale.Scale = fitScale()
	end)
	-- Clicks inside the window must not fall through to the backdrop.
	UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 21, AutoButtonColor = false }, window)

	local header = UI.label(window, {
		Position = UDim2.fromOffset(24, 14),
		Size = UDim2.fromOffset(420, 30),
		Font = UI.Fonts.Title,
		TextSize = 24,
		TextColor3 = UI.Colors.Text,
		Text = Config.GameName:upper(),
		ZIndex = 22,
	})
	UI.gradient(header, UI.Colors.Cyan, UI.Colors.Accent2, 0)

	local closeButton = UI.button(window, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.fromOffset(34, 34),
		Text = "✕",
		TextSize = 16,
		ZIndex = 23,
		Radius = 17,
	}, "card")
	closeButton.Activated:Connect(function()
		Audio.click()
		Menu.close()
	end)

	local sidebar = UI.new("Frame", {
		Position = UDim2.fromOffset(16, 62),
		Size = UDim2.fromOffset(170, WINDOW_H - 78),
		BackgroundTransparency = 1,
		ZIndex = 22,
	}, window)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, sidebar)
	Menu.sidebar = sidebar

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(200, 62),
		Size = UDim2.fromOffset(WINDOW_W - 216, WINDOW_H - 78),
		BackgroundTransparency = 1,
		ZIndex = 22,
		ClipsDescendants = true,
	}, window)
end

function Menu.addTab(name, icon, builder)
	local index = #tabs + 1
	local button = UI.button(Menu.sidebar, {
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 0.35,
		Text = "",
		ZIndex = 23,
	}, "card")
	UI.label(button, {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Font = UI.Fonts.Bold,
		TextSize = 16,
		Text = icon .. "   " .. name,
		TextWrapped = false,
		ZIndex = 24,
	})
	local badge = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = UI.Colors.Accent2,
		Visible = false,
		ZIndex = 25,
	}, button)
	UI.corner(badge, 5)

	local page = UI.new("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 22,
	}, content)
	local api = builder(page) or {}
	local tab = { name = name, icon = icon, button = button, page = page, refresh = api.refresh, badge = badge }
	table.insert(tabs, tab)
	button.Activated:Connect(function()
		Audio.click()
		select(name)
	end)
	return tab
end

function Menu.setBadge(name, visible)
	for _, tab in tabs do
		if tab.name == name then
			tab.badge.Visible = visible
		end
	end
end

function Menu.open(name)
	if not backdrop then
		return
	end
	if not open then
		open = true
		backdrop.Visible = true
		backdrop.BackgroundTransparency = 1
		UI.tween(backdrop, 0.2, { BackgroundTransparency = 0.45 })
		local target = fitScale()
		scale.Scale = target * 0.9
		UI.tween(scale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
	end
	select(name or current or (tabs[1] and tabs[1].name))
end

function Menu.close()
	if not open then
		return
	end
	open = false
	UI.tween(backdrop, 0.15, { BackgroundTransparency = 1 })
	UI.tween(scale, 0.15, { Scale = fitScale() * 0.92 })
	task.delay(0.16, function()
		if not open then
			backdrop.Visible = false
		end
	end)
	for _, fn in onChanged do
		fn(nil)
	end
end

function Menu.toggle(name)
	if open and (name == nil or current == name) then
		Menu.close()
	else
		Menu.open(name)
	end
end

-- Refresh the visible tab (called a few times a second while open).
function Menu.refresh()
	if not open then
		return
	end
	for _, tab in tabs do
		if tab.name == current and tab.refresh then
			tab.refresh()
		end
	end
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="44">
            <Properties>
              <string name="Name">Orbs</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: pickups bob and spin locally so the server never has to animate them, and
-- when one is grabbed it flies into the player before it disappears.
local Players = game:GetService("Players")
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local Orbs = {}

local player = Players.LocalPlayer
local tracked = {} -- model -> { base = Vector3, takenAt = number? , from = Vector3? }

local function track(model)
	if model:IsA("Model") then
		tracked[model] = { base = model:GetAttribute("Pos") or model:GetPivot().Position }
	end
end

function Orbs.init()
	CollectionService:GetInstanceAddedSignal("Shard"):Connect(track)
	CollectionService:GetInstanceRemovedSignal("Shard"):Connect(function(model)
		tracked[model] = nil
	end)
	for _, model in CollectionService:GetTagged("Shard") do
		track(model)
	end

	RunService.RenderStepped:Connect(function()
		local t = os.clock()
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local here = root and root.Position
		for model, state in tracked do
			if model.Parent then
				local base = state.base
				if here and (base - here).Magnitude < 110 then
					if model:GetAttribute("Taken") then
						-- Fly into the player
						state.takenAt = state.takenAt or t
						local alpha = math.clamp((t - state.takenAt) / 0.2, 0, 1)
						local pos = base:Lerp(here + Vector3.new(0, 1.5, 0), alpha)
						model:PivotTo(CFrame.new(pos) * CFrame.Angles(0, t * 8, 0))
					else
						local bob = math.sin(t * 2 + base.X * 0.3) * 0.6
						model:PivotTo(CFrame.new(base + Vector3.new(0, bob, 0)) * CFrame.Angles(0, t + base.Z * 0.1, 0))
					end
				end
			end
		end
	end)
end

return Orbs
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="45">
            <Properties>
              <string name="Name">Swing</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: click / tap anywhere (or hold) to swing your hammer at your own face.
-- Every swing earns Aura (hammer x rebirth x boosts) and a little XP. The server does the maths; this
-- file only handles the input and the feel (arm swing, sound, floating number).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local Swing = {}

local player = Players.LocalPlayer
local holding = false
local lastSwing = 0
local swingCount = 0
local Action, Menu
local armBusy = false

local function blocked()
	return Menu.isOpen() or player:GetAttribute("Training") == true or player:GetAttribute("InDuel") == true
end

local function shoulder()
	local char = player.Character
	if not char then
		return nil
	end
	local arm = char:FindFirstChild("RightUpperArm")
	local motor = arm and arm:FindFirstChild("RightShoulder")
	if not motor then
		local torso = char:FindFirstChild("Torso")
		motor = torso and torso:FindFirstChild("Right Shoulder")
	end
	return motor
end

-- A quick overhead chop with the right arm (only you see this; the hammer in hand shows for everyone).
local function animateArm()
	local motor = shoulder()
	if not motor or armBusy then
		return
	end
	armBusy = true
	local rest = motor.C0
	local down = TweenService:Create(motor, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = rest * CFrame.Angles(math.rad(-120), 0, 0) })
	local up = TweenService:Create(motor, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { C0 = rest })
	down.Completed:Once(function()
		up:Play()
	end)
	up.Completed:Once(function()
		motor.C0 = rest
		armBusy = false
	end)
	down:Play()
end

local function doSwing()
	local now = os.clock()
	if now - lastSwing < Config.SwingInterval or blocked() then
		return
	end
	lastSwing = now
	animateArm()
	Action:FireServer("Swing")
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

function Swing.init(gui, action, menu)
	Action, Menu = action, menu

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not isPress(input) then
			return
		end
		holding = true
		doSwing()
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			holding = false
		end
	end)
	-- Holding the button keeps swinging.
	RunService.Heartbeat:Connect(function()
		if holding then
			doSwing()
		end
	end)
end

-- The server confirmed a swing and says how much it paid. tag is "crit" / "jackpot" / nil.
function Swing.result(gained, tag, frenzy)
	swingCount += 1
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not head or not root then
		return
	end
	local C = UI.Colors
	if tag == "jackpot" then
		Audio.reveal(5)
		Fx.shake(0.6, 0.6)
		Fx.flash(C.Gold, 0.4, 0.6)
		Fx.ring(root.Position, C.Gold, 40)
		Fx.pillar(root.Position, C.Gold, 90)
		Fx.burst(head.Position, C.Gold, 60)
		Fx.floatText(head.Position + Vector3.new(0, 3, 0), "JACKPOT!  +" .. Util.fmt(gained), C.Gold, 34)
		return
	elseif tag == "crit" then
		Audio.reveal(3)
		Fx.shake(0.3, 0.3)
		Fx.ring(root.Position, C.Orange, 22)
		Fx.burst(head.Position, C.Orange, 24)
		Fx.floatText(head.Position + Vector3.new(0, 3, 0), "CRIT!  +" .. Util.fmt(gained), C.Orange, 28)
		return
	end
	Audio.pickup(0, 1)
	Fx.punch(0.6)
	local color = frenzy and C.Orange or C.Yellow
	if swingCount % 3 == 1 then
		Fx.floatText(head.Position + Vector3.new(0, 2.5, 0), "+" .. Util.fmt(gained), color, frenzy and 24 or 20)
	end
	if swingCount % 4 == 1 or frenzy then
		Fx.burst(head.Position, color, frenzy and 10 or 5)
	end
end

return Swing
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">TabCrates</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: crates tab. The server rolls; this plays the reveal (a spinning reel that slows
-- down, then a rarity-coloured card) so every opening feels like an event.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local player = Players.LocalPlayer
local C = UI.Colors

local TabCrates = {}

local overlay, reel, reelName, reelSub, reelButtons, reelScale
local busy = false
local busyToken = 0
local pending -- last result waiting to be revealed
local equipAction

local function setBusy(flag)
	busy = flag
	busyToken += 1
	if flag then
		local token = busyToken
		task.delay(4, function()
			if busyToken == token then
				busy = false
			end
		end)
	end
end

function TabCrates.build(parent, Action)
	equipAction = Action

	local header = UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 24),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	local row = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)

	local cardRefs = {}
	for i, crate in Config.Crates do
		local card = UI.panel(row, {
			LayoutOrder = i,
			Size = UDim2.new(1 / #Config.Crates, -8, 1, -8),
			BackgroundColor3 = C.Card,
			Radius = 16,
		})
		local stroke = card:FindFirstChildOfClass("UIStroke")
		stroke.Color = crate.Color
		stroke.Transparency = 0.35

		UI.label(card, {
			Position = UDim2.fromOffset(0, 14),
			Size = UDim2.new(1, 0, 0, 70),
			Font = UI.Fonts.Bold,
			TextSize = 58,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = crate.Icon,
		})
		UI.label(card, {
			Position = UDim2.fromOffset(0, 90),
			Size = UDim2.new(1, 0, 0, 24),
			Font = UI.Fonts.Title,
			TextSize = 19,
			TextColor3 = crate.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = crate.Name,
		})
		-- Odds list, one rarity per line
		local lines = {}
		for _, rarity in Config.RarityOrder do
			local odds = crate.Odds[rarity]
			if odds then
				table.insert(lines, string.format("%s  %d%%", rarity, odds))
			end
		end
		UI.label(card, {
			Position = UDim2.fromOffset(10, 120),
			Size = UDim2.new(1, -20, 0, 60),
			Font = UI.Fonts.Body,
			TextSize = 13,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = table.concat(lines, "\n"),
		})
		local pity = UI.label(card, {
			Position = UDim2.fromOffset(10, 184),
			Size = UDim2.new(1, -20, 0, 34),
			Font = UI.Fonts.Bold,
			TextSize = 12,
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "",
		})
		local open = UI.button(card, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -14),
			Size = UDim2.new(1, -28, 0, 44),
			Text = "",
			TextSize = 17,
		}, "primary")
		open.Activated:Connect(function()
			if busy then
				return
			end
			Audio.click()
			setBusy(true)
			Action:FireServer("OpenCrate", crate.Id)
		end)
		cardRefs[crate.Id] = { open = open, pity = pity, crate = crate }
	end

	-- Reveal overlay (hidden until a result arrives)
	overlay = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(8, 6, 20),
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 40,
		Active = true,
	}, parent)
	UI.corner(overlay, 16)
	reel = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(200, 130),
		Font = UI.Fonts.Bold,
		TextSize = 100,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "🎁",
		ZIndex = 41,
	})
	reelScale = UI.new("UIScale", {}, reel)
	reelName = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.new(1, -40, 0, 44),
		Font = UI.Fonts.Title,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTransparency = 1,
		Text = "",
		ZIndex = 41,
	})
	reelSub = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.72),
		Size = UDim2.new(1, -40, 0, 30),
		Font = UI.Fonts.Bold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTransparency = 1,
		Text = "",
		ZIndex = 41,
	})
	reelButtons = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.fromOffset(360, 46),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 42,
	}, overlay)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
	}, reelButtons)
	local wear = UI.button(reelButtons, { Size = UDim2.fromOffset(170, 44), Text = "WEAR IT", ZIndex = 43 }, "primary")
	local done = UI.button(reelButtons, { Size = UDim2.fromOffset(170, 44), Text = "CONTINUE", ZIndex = 43 }, "card")
	wear.Activated:Connect(function()
		Audio.click()
		if pending then
			Action:FireServer("Equip", pending.cosmeticId)
		end
		overlay.Visible = false
	end)
	done.Activated:Connect(function()
		Audio.click()
		overlay.Visible = false
	end)

	local function refresh()
		local free = player:GetAttribute("FreeCrates") or 0
		local aura = player:GetAttribute("Aura") or 0
		header.Text = string.format("Free crates: %d   ·   Duplicates level an item up (max %d★)", free, Config.MaxStars)
		for id, ref in cardRefs do
			local crate = ref.crate
			if id == "street" and free > 0 then
				ref.open.Text = "OPEN FREE (" .. free .. ")"
			else
				ref.open.Text = "✦ " .. Util.fmt(crate.Cost)
			end
			local canOpen = (id == "street" and free > 0) or aura >= crate.Cost
			ref.open.BackgroundTransparency = canOpen and 0 or 0.45
			if crate.PityAfter then
				local left = crate.PityAfter - (player:GetAttribute("Pity_" .. id) or 0)
				ref.pity.Text = string.format("%s+ guaranteed in %d", crate.PityMin, math.max(1, left))
			else
				ref.pity.Text = "Great for starting your look"
			end
		end
	end
	return { refresh = refresh }
end

local function pickIcon()
	local list = Config.Cosmetics
	return list[math.random(1, #list)].Icon
end

-- Plays the reel, then shows the result.
function TabCrates.reveal(crateId, cosmeticId, status, stars, refund)
	if not overlay then
		return
	end
	local c = Config.CosmeticById[cosmeticId]
	if not c then
		setBusy(false)
		return
	end
	pending = { cosmeticId = cosmeticId }
	overlay.Visible = true
	reelButtons.Visible = false
	reelName.TextTransparency = 1
	reelSub.TextTransparency = 1
	reelScale.Scale = 1

	task.spawn(function()
		local delay = 0.05
		for i = 1, 22 do
			reel.Text = pickIcon()
			Audio.crateTick(i)
			task.wait(delay)
			delay += 0.011
		end
		local rarity = Config.Rarities[c.Rarity]
		reel.Text = c.Icon
		UI.pop(reelScale, 1.5)
		reelName.Text = c.Name
		reelName.TextColor3 = rarity.Color
		reelSub.Text = c.Rarity:upper() .. " " .. string.lower(Config.SlotIcons[c.Slot] and c.Slot or "")
		UI.tween(reelName, 0.3, { TextTransparency = 0 })
		UI.tween(reelSub, 0.3, { TextTransparency = 0 })

		local note
		if status == "new" then
			note = "NEW!"
		elseif status == "star" then
			note = "LEVEL UP!  " .. string.rep("★", stars)
		else
			note = "MAXED — refunded ✦" .. Util.fmt(refund or 0)
		end
		reelSub.Text = reelSub.Text .. "   ·   " .. note
		reelSub.TextColor3 = status == "max" and C.Muted or (status == "new" and C.Good or C.Gold)

		Audio.reveal(rarity.Order + 1)
		if rarity.Order >= 4 then
			Fx.flash(rarity.Color, 0.5, 0.9)
			Fx.shake(0.35, 0.5)
		end
		task.wait(0.4)
		reelButtons.Visible = true
		setBusy(false)
	end)
end

return TabCrates
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">TabPets</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the Pets tab. Hatch eggs at the top, manage your pets below.
-- Tap a pet to equip / unequip it (3 slots).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabPets = {}

local function owned()
	local map = {}
	for id, n in string.gmatch(player:GetAttribute("Pets") or "", "(%w+):(%d+)") do
		map[id] = tonumber(n)
	end
	return map
end

local function equipped()
	local set = {}
	for id in string.gmatch(player:GetAttribute("PetsEq") or "", "%w+") do
		set[id] = true
	end
	return set
end

function TabPets.build(parent, Action)
	UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Title,
		TextSize = 20,
		TextWrapped = false,
		Text = "🐾  Pets",
	})
	local summary = UI.label(parent, {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 20),
		Font = UI.Fonts.Bold,
		TextSize = 13,
		TextColor3 = C.Mint,
		TextWrapped = false,
		Text = "",
	})

	-- Eggs
	local eggRow = UI.new("Frame", { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, -8, 0, 92), BackgroundTransparency = 1 }, parent)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, eggRow)
	local eggButtons = {}
	for i, egg in Config.Eggs do
		local btn = UI.button(eggRow, {
			LayoutOrder = i,
			Size = UDim2.new(1 / #Config.Eggs, -7, 1, 0),
			BackgroundColor3 = egg.Color:Lerp(C.Card, 0.55),
			Text = "",
			Radius = 12,
		}, "card")
		UI.label(btn, {
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.new(1, -16, 0, 22),
			Font = UI.Fonts.Title,
			TextSize = 15,
			TextColor3 = egg.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "🥚 " .. egg.Name,
		})
		local odds = {}
		for _, rarity in Config.RarityOrder do
			if egg.Odds[rarity] then
				table.insert(odds, string.format("%s %d%%", rarity, egg.Odds[rarity]))
			end
		end
		UI.label(btn, {
			Position = UDim2.fromOffset(6, 26),
			Size = UDim2.new(1, -12, 0, 36),
			Font = UI.Fonts.Body,
			TextSize = 10,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = table.concat(odds, " · "),
		})
		local cost = UI.label(btn, {
			Position = UDim2.new(0, 0, 1, -26),
			Size = UDim2.new(1, 0, 0, 22),
			Font = UI.Fonts.Title,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "🏆 " .. Util.fmt(egg.Cost),
		})
		btn.Activated:Connect(function()
			Audio.click()
			Action:FireServer("Hatch", egg.Id)
		end)
		eggButtons[egg.Id] = cost
	end

	-- Pet grid
	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 154),
		Size = UDim2.new(1, -8, 1, -154),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(112, 96),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	local cards = {}
	for i, pet in Config.Pets do
		local color = Config.Rarities[pet.Rarity].Color
		local card = UI.button(scroll, {
			LayoutOrder = i,
			BackgroundColor3 = C.Card,
			Text = "",
			Radius = 10,
		}, "card")
		UI.label(card, {
			Position = UDim2.fromOffset(4, 4),
			Size = UDim2.new(1, -8, 0, 28),
			Font = UI.Fonts.Title,
			TextSize = 22,
			TextColor3 = pet.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "🐾",
		})
		UI.label(card, {
			Position = UDim2.fromOffset(4, 32),
			Size = UDim2.new(1, -8, 0, 28),
			Font = UI.Fonts.Bold,
			TextSize = 11,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = pet.Name,
		})
		local stat = UI.label(card, {
			Position = UDim2.fromOffset(4, 60),
			Size = UDim2.new(1, -8, 0, 30),
			Font = UI.Fonts.Body,
			TextSize = 10,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "",
		})
		card.Activated:Connect(function()
			Audio.click()
			local on = equipped()[pet.Id]
			Action:FireServer(on and "PetUnequip" or "PetEquip", pet.Id)
		end)
		cards[pet.Id] = { card = card, stat = stat, color = color }
	end

	local function refresh()
		local have, on = owned(), equipped()
		local aura = player:GetAttribute("Aura") or 0
		local count = 0
		for _ in on do
			count += 1
		end
		summary.Text = string.format("Equipped %d/%d   ·   Pet bonus +%d%% Aura   ·   click a pet to equip it", count, Config.PetSlots, math.floor((player:GetAttribute("PetMult") or 0) * 100 + 0.5))
		for id, cost in eggButtons do
			local egg = Config.EggById[id]
			cost.TextColor3 = aura >= egg.Cost and C.Yellow or C.Danger
		end
		for id, ref in cards do
			local pet = Config.PetById[id]
			local copies = have[id]
			local stroke = ref.card:FindFirstChildOfClass("UIStroke")
			if copies then
				ref.card.BackgroundTransparency = 0
				ref.stat.Text = string.format("+%d%% Aura  ·  %s Aura/s\n%s%s", math.floor(Config.PetMult(pet, copies) * 100 + 0.5), Util.fmt(Config.PetAps(pet, copies)), string.rep("★", Config.PetStars(copies)), on[id] and "  EQUIPPED" or "")
				stroke.Color = on[id] and C.Good or ref.color
			else
				ref.card.BackgroundTransparency = 0.6
				ref.stat.Text = "not found yet"
				stroke.Color = C.Stroke
			end
		end
	end
	return { refresh = refresh }
end

return TabPets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">TabProfile</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: your character sheet: rank, stats, duel record and the current quest.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabProfile = {}

function TabProfile.build(parent)
	local hero = UI.panel(parent, {
		Size = UDim2.new(1, -8, 0, 110),
		BackgroundColor3 = C.Card,
		Radius = 16,
	})
	local rankLabel = UI.label(hero, {
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 38),
		Font = UI.Fonts.Title,
		TextSize = 32,
		TextWrapped = false,
		Text = "",
	})
	local scoreLabel = UI.label(hero, {
		Position = UDim2.fromOffset(20, 52),
		Size = UDim2.new(1, -40, 0, 20),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})
	local rankBar = UI.bar(hero, { Position = UDim2.new(0, 20, 1, -26), Size = UDim2.new(1, -40, 0, 10) }, C.Accent)
	local rankHint = UI.label(hero, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 14),
		Size = UDim2.fromOffset(200, 18),
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		Text = "",
	})

	-- Stat cards
	local statRow = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 122),
		Size = UDim2.new(1, -8, 0, 110),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10) }, statRow)
	local statRefs = {}
	for _, id in Config.StatOrder do
		local def = Config.Stats[id]
		local card = UI.panel(statRow, { Size = UDim2.new(1 / 3, -7, 1, 0), BackgroundColor3 = C.Card, Radius = 14 })
		card:FindFirstChildOfClass("UIStroke").Color = def.Color
		UI.label(card, {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 34),
			Font = UI.Fonts.Bold,
			TextSize = 28,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = def.Icon,
		})
		statRefs[id] = UI.label(card, {
			Position = UDim2.fromOffset(0, 42),
			Size = UDim2.new(1, 0, 0, 30),
			Font = UI.Fonts.Title,
			TextSize = 24,
			TextColor3 = def.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "0",
		})
		UI.label(card, {
			Position = UDim2.fromOffset(0, 76),
			Size = UDim2.new(1, 0, 0, 20),
			Font = UI.Fonts.Bold,
			TextSize = 12,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = def.Name:upper() .. "  ·  " .. def.Station,
		})
	end

	local record = UI.label(parent, {
		Position = UDim2.fromOffset(0, 244),
		Size = UDim2.new(1, -8, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Text,
		TextWrapped = false,
		Text = "",
	})
	local questTitle = UI.label(parent, {
		Position = UDim2.fromOffset(0, 276),
		Size = UDim2.new(1, -8, 0, 20),
		Font = UI.Fonts.Title,
		TextSize = 14,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "CURRENT QUEST",
	})
	local questCard = UI.panel(parent, {
		Position = UDim2.fromOffset(0, 300),
		Size = UDim2.new(1, -8, 0, 70),
		BackgroundColor3 = C.Card,
		Radius = 14,
	})
	local questText = UI.label(questCard, {
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -32, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 16,
		TextWrapped = false,
		Text = "",
	})
	local questBar = UI.bar(questCard, { Position = UDim2.new(0, 16, 1, -22), Size = UDim2.new(1, -32, 0, 10) }, C.Good)
	local questReward = UI.label(questCard, {
		Position = UDim2.fromOffset(16, 32),
		Size = UDim2.new(1, -32, 0, 16),
		Font = UI.Fonts.Body,
		TextSize = 12,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	local function refresh()
		local rankIndex = player:GetAttribute("Rank") or 1
		local rank = Config.Ranks[rankIndex]
		local nextRank = Config.Ranks[rankIndex + 1]
		local score = player:GetAttribute("GlowScore") or 0
		local rebirths = player:GetAttribute("Rebirths") or 0
		rankLabel.Text = (rebirths > 0 and ("★" .. rebirths .. "  ") or "") .. rank.Full:upper()
		rankLabel.TextColor3 = rank.Color
		scoreLabel.Text = string.format("Level %s   ·   Mog Power %s   ·   Rebirths %d", Util.fmt(player:GetAttribute("Level") or 1), Util.fmt(score), rebirths)
		rankBar.fill.BackgroundColor3 = rank.Color
		rankBar.set((player:GetAttribute("XP") or 0) / (player:GetAttribute("XPNeeded") or 1))
		if nextRank then
			rankHint.Text = string.format("Next tier: %s at level %s", nextRank.Full, Util.fmt(nextRank.Level))
		else
			rankHint.Text = "Highest tier reached"
		end
		for id, label in statRefs do
			label.Text = Util.fmt(player:GetAttribute(id) or 0)
		end
		record.Text = string.format(
			"⚔️  Duel wins %d     🔥 Win streak %d",
			player:GetAttribute("Wins") or 0,
			player:GetAttribute("DuelStreak") or 0
		)
		local kind = player:GetAttribute("QuestKind")
		if kind then
			local goal = player:GetAttribute("QuestGoal") or 1
			local progress = player:GetAttribute("QuestProgress") or 0
			questText.Text = "🎯 " .. Config.QuestText(kind, goal)
			questBar.set(progress / goal)
			questReward.Text = string.format("%d / %d   ·   Reward ✦ %s", progress, goal, Util.fmt(player:GetAttribute("QuestReward") or 0))
		end
	end
	return { refresh = refresh }
end

return TabProfile
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">TabRewards</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: daily streak rewards and the current server event.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabRewards = {}

function TabRewards.build(parent, Action)
	UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Title,
		TextSize = 20,
		TextWrapped = false,
		Text = "📅  Daily Rewards",
	})
	local streakLabel = UI.label(parent, {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 20),
		Font = UI.Fonts.Body,
		TextSize = 13,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	local grid = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 58),
		Size = UDim2.new(1, -8, 0, 190),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(136, 90),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, grid)
	local cells = {}
	for day, reward in Config.Daily do
		local cell = UI.panel(grid, { LayoutOrder = day, BackgroundColor3 = C.Card, Radius = 12 })
		UI.label(cell, {
			Position = UDim2.fromOffset(0, 6),
			Size = UDim2.new(1, 0, 0, 18),
			Font = UI.Fonts.Title,
			TextSize = 12,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "DAY " .. day,
		})
		local text = "✦ " .. Util.fmt(reward.Aura)
		if reward.Crates then
			text ..= "\n🎁 x" .. reward.Crates
		end
		UI.label(cell, {
			Position = UDim2.fromOffset(0, 26),
			Size = UDim2.new(1, 0, 1, -30),
			Font = UI.Fonts.Bold,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top,
			Text = text,
		})
		cells[day] = cell
	end

	local claim = UI.button(parent, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, -56),
		Size = UDim2.new(1, -8, 0, 46),
		Text = "CLAIM",
		TextSize = 18,
	}, "primary")
	claim.Activated:Connect(function()
		Audio.click()
		Action:FireServer("Claim")
	end)

	local eventLabel = UI.label(parent, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, -8, 0, 44),
		Font = UI.Fonts.Bold,
		TextSize = 14,
		TextColor3 = C.Muted,
		Text = "",
	})

	local function refresh()
		local ready = player:GetAttribute("DailyReady") == true
		local day = player:GetAttribute("DailyDay") or 1
		streakLabel.Text = "Come back every day to keep your streak. Current streak: " .. (player:GetAttribute("DailyStreak") or 0)
		for d, cell in cells do
			local isNext = d == day
			cell.BackgroundColor3 = isNext and (ready and Color3.fromRGB(86, 62, 150) or C.CardHover) or C.Card
			cell:FindFirstChildOfClass("UIStroke").Color = isNext and C.Gold or C.Stroke
			cell:FindFirstChildOfClass("UIStroke").Transparency = isNext and 0.1 or 0.55
		end
		claim.Text = ready and ("CLAIM DAY " .. day) or "COME BACK TOMORROW"
		claim.BackgroundTransparency = ready and 0 or 0.55

		local id = workspace:GetAttribute("Event")
		local ev = id and id ~= "" and Config.EventById[id]
		local left = (workspace:GetAttribute("EventEnd") or 0) - workspace:GetServerTimeNow()
		if ev and left > 0 then
			eventLabel.Text = string.format("%s %s is live (%s left): %s", ev.Icon, ev.Name, Util.clock(left), ev.Desc)
		else
			eventLabel.Text = "No event right now. Golden Hour, Shard Storm, Duel Frenzy and Runway Night roll in every few minutes."
		end
	end
	return { refresh = refresh }
end

return TabRewards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">TabSettings</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: simple toggles. Settings are saved on the server so they follow the player.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabSettings = {}

local OPTIONS = {
	{ key = "Music", name = "Music", desc = "Ambient background music" },
	{ key = "Sfx", name = "Sound effects", desc = "Pickups, crates and fanfares" },
	{ key = "Fx", name = "Screen effects", desc = "Camera punch, shake, flashes and floating numbers" },
	{ key = "Duels", name = "Duels", desc = "Allow duel matchmaking (turn off to stay out of fights)" },
}

-- Apply the saved settings to the live game (audio mostly).
function TabSettings.apply()
	Audio.setMusic(player:GetAttribute("Set_Music") ~= false)
	Audio.setSfx(player:GetAttribute("Set_Sfx") ~= false)
end

function TabSettings.build(parent, Action)
	UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Title,
		TextSize = 20,
		TextWrapped = false,
		Text = "⚙️  Settings",
	})
	local list = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, -8, 1, -36),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local toggles = {}
	for i, opt in OPTIONS do
		local row = UI.panel(list, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.Card, Radius = 12 })
		UI.label(row, {
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -130, 0, 22),
			Font = UI.Fonts.Bold,
			TextSize = 16,
			TextWrapped = false,
			Text = opt.name,
		})
		UI.label(row, {
			Position = UDim2.fromOffset(16, 32),
			Size = UDim2.new(1, -130, 0, 22),
			Font = UI.Fonts.Body,
			TextSize = 12,
			TextColor3 = C.Muted,
			TextWrapped = false,
			Text = opt.desc,
		})
		local track = UI.button(row, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(64, 32),
			Text = "",
			Radius = 16,
		}, "card")
		local knob = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 4, 0.5, 0),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 3,
		}, track)
		UI.corner(knob, 12)
		track.Activated:Connect(function()
			Audio.click()
			local value = not (player:GetAttribute("Set_" .. opt.key) ~= false)
			player:SetAttribute("Set_" .. opt.key, value) -- instant local feedback; the server saves it
			Action:FireServer("Setting", opt.key, value)
			TabSettings.apply()
		end)
		toggles[opt.key] = { track = track, knob = knob }
	end

	local function refresh()
		for key, t in toggles do
			local on = player:GetAttribute("Set_" .. key) ~= false
			UI.tween(t.track, 0.15, { BackgroundColor3 = on and C.Good or C.Disabled })
			UI.tween(t.knob, 0.15, { Position = on and UDim2.new(1, -28, 0.5, 0) or UDim2.new(0, 4, 0.5, 0) })
		end
	end
	return { refresh = refresh }
end

return TabSettings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">TabUpgrades</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: upgrades (bought with Aura) and the rebirth button.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabUpgrades = {}

function TabUpgrades.build(parent, Action)
	local list = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	UI.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, list)

	local function row(order, height)
		local r = UI.panel(list, {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height or 68),
			BackgroundColor3 = C.Card,
			Radius = 14,
		})
		return r
	end

	local refs = {}
	for i, def in Config.Upgrades do
		local r = row(i)
		UI.label(r, {
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.fromOffset(46, 68),
			Font = UI.Fonts.Bold,
			TextSize = 34,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = def.Icon,
		})
		local name = UI.label(r, {
			Position = UDim2.fromOffset(70, 10),
			Size = UDim2.new(1, -210, 0, 22),
			Font = UI.Fonts.Bold,
			TextSize = 17,
			TextWrapped = false,
			Text = def.Name,
		})
		UI.label(r, {
			Position = UDim2.fromOffset(70, 34),
			Size = UDim2.new(1, -210, 0, 20),
			Font = UI.Fonts.Body,
			TextSize = 13,
			TextColor3 = C.Muted,
			TextWrapped = false,
			Text = def.Desc,
		})
		local levelBar = UI.bar(r, { Position = UDim2.fromOffset(70, 56), Size = UDim2.new(1, -210, 0, 5) }, C.Accent)
		local buy = UI.button(r, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(110, 46),
			Text = "",
			TextSize = 16,
		}, "primary")
		buy.Activated:Connect(function()
			Audio.click()
			Action:FireServer("Buy", def.Id)
		end)
		refs[def.Id] = { name = name, buy = buy, bar = levelBar, def = def }
	end

	-- Rebirth
	local reb = row(100, 96)
	local rebStroke = reb:FindFirstChildOfClass("UIStroke")
	rebStroke.Color = C.Gold
	rebStroke.Transparency = 0.3
	UI.label(reb, {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.fromOffset(46, 96),
		Font = UI.Fonts.Bold,
		TextSize = 38,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "🌟",
	})
	UI.label(reb, {
		Position = UDim2.fromOffset(70, 10),
		Size = UDim2.new(1, -210, 0, 24),
		Font = UI.Fonts.Title,
		TextSize = 19,
		TextColor3 = C.Gold,
		TextWrapped = false,
		Text = "REBIRTH",
	})
	local rebDesc = UI.label(reb, {
		Position = UDim2.fromOffset(70, 36),
		Size = UDim2.new(1, -210, 0, 50),
		Font = UI.Fonts.Body,
		TextSize = 13,
		TextColor3 = C.Muted,
		Text = "",
	})
	local rebButton = UI.button(reb, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(110, 46),
		Text = "REBIRTH",
		TextSize = 15,
	}, "primary")
	rebButton.Activated:Connect(function()
		Audio.click()
		Action:FireServer("Rebirth")
	end)

	local function refresh()
		local aura = player:GetAttribute("Aura") or 0
		for id, ref in refs do
			local lvl = player:GetAttribute("Lv_" .. id) or 0
			ref.name.Text = string.format("%s   Lv %d", ref.def.Name, lvl)
			ref.bar.set(lvl / ref.def.Max)
			if lvl >= ref.def.Max then
				ref.buy.Text = "MAX"
				ref.buy.BackgroundTransparency = 0.5
			else
				local cost = Config.UpgradeCost(ref.def, lvl)
				ref.buy.Text = "✦ " .. Util.fmt(cost)
				ref.buy.BackgroundTransparency = aura >= cost and 0 or 0.5
			end
		end
		local rebirths = player:GetAttribute("Rebirths") or 0
		local need = Config.RebirthRequirement(rebirths)
		local score = player:GetAttribute("Level") or 1
		rebDesc.Text = string.format(
			"Reset Aura, stats and upgrades (you keep your level, hammers and every cosmetic). Gain +50%% Aura and XP forever, plus 2 free crates.\nNeeds level %s  (you are level %s)",
			Util.fmt(need),
			Util.fmt(score)
		)
		rebButton.BackgroundTransparency = score >= need and 0 or 0.5
	end
	return { refresh = refresh }
end

return TabUpgrades
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">TabWardrobe</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the wardrobe. A collection grid: owned items can be worn, unowned ones show as locked
-- silhouettes so players can see what they're chasing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabWardrobe = {}

function TabWardrobe.build(parent, Action)
	local filter = "All"
	local cards = {} -- cosmetic id -> card refs

	-- Header: collection counter and totals
	local summary = UI.label(parent, {
		Size = UDim2.new(1, -4, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	-- Slot filter
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, bar)
	local filterButtons = {}
	local names = { "All" }
	for _, slot in Config.Slots do
		table.insert(names, slot)
	end

	local scroller = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 1, -70),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(136, 150),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroller)
	UI.new("UIPadding", { PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 8) }, scroller)

	local function applyFilter()
		for id, card in cards do
			local c = Config.CosmeticById[id]
			card.frame.Visible = filter == "All" or c.Slot == filter
		end
		for name, b in filterButtons do
			UI.tween(b, 0.12, { BackgroundColor3 = name == filter and C.Accent or C.Card })
		end
	end

	for i, name in names do
		local label = name == "All" and "All" or (Config.SlotIcons[name] .. " " .. name)
		local b = UI.button(bar, {
			LayoutOrder = i,
			Size = UDim2.fromOffset(name == "All" and 52 or 92, 30),
			Text = label,
			TextSize = 13,
			Radius = 15,
		}, "card")
		filterButtons[name] = b
		b.Activated:Connect(function()
			Audio.click()
			filter = name
			applyFilter()
		end)
	end

	-- Cards, ordered by slot then rarity
	local ordered = table.clone(Config.Cosmetics)
	table.sort(ordered, function(a, b)
		if a.Slot ~= b.Slot then
			return table.find(Config.Slots, a.Slot) < table.find(Config.Slots, b.Slot)
		end
		return Config.Rarities[a.Rarity].Order < Config.Rarities[b.Rarity].Order
	end)

	for i, c in ordered do
		local rarityColor = Config.Rarities[c.Rarity].Color
		local frame = UI.button(scroller, { LayoutOrder = i, Text = "" }, "card")
		local stroke = UI.stroke(frame, rarityColor, 2, 0.4)
		local icon = UI.label(frame, {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 52),
			Font = UI.Fonts.Bold,
			TextSize = 40,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = c.Icon,
		})
		local name = UI.label(frame, {
			Position = UDim2.fromOffset(6, 62),
			Size = UDim2.new(1, -12, 0, 18),
			Font = UI.Fonts.Bold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = c.Name,
		})
		local rarity = UI.label(frame, {
			Position = UDim2.fromOffset(6, 80),
			Size = UDim2.new(1, -12, 0, 14),
			Font = UI.Fonts.Bold,
			TextSize = 11,
			TextColor3 = rarityColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = c.Rarity:upper(),
		})
		local stars = UI.label(frame, {
			Position = UDim2.fromOffset(6, 96),
			Size = UDim2.new(1, -12, 0, 16),
			Font = UI.Fonts.Bold,
			TextSize = 13,
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "",
		})
		local stat = UI.label(frame, {
			Position = UDim2.fromOffset(6, 114),
			Size = UDim2.new(1, -12, 0, 14),
			Font = UI.Fonts.Body,
			TextSize = 11,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "",
		})
		local tag = UI.label(frame, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(70, 16),
			Font = UI.Fonts.Title,
			TextSize = 10,
			TextColor3 = C.Good,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextWrapped = false,
			Text = "",
		})
		frame.Activated:Connect(function()
			local inv = Util.parseInventory(player:GetAttribute("Inv"))
			if not inv[c.Id] then
				Audio.error()
				return
			end
			Audio.equip()
			if player:GetAttribute("Eq_" .. c.Slot) == c.Id then
				Action:FireServer("Unequip", c.Slot)
			else
				Action:FireServer("Equip", c.Id)
			end
		end)
		cards[c.Id] = { frame = frame, icon = icon, name = name, stars = stars, stat = stat, tag = tag, stroke = stroke, c = c }
	end

	local function refresh()
		local inv = Util.parseInventory(player:GetAttribute("Inv"))
		local owned = 0
		for id, card in cards do
			local c = card.c
			local stars = inv[id]
			if stars then
				owned += 1
				card.icon.TextTransparency = 0
				card.name.Text = c.Name
				card.name.TextColor3 = C.Text
				card.stars.Text = string.rep("★", stars) .. string.rep("☆", Config.MaxStars - stars)
				card.stat.Text = string.format("+%s Glow · %s/s", Util.fmt(Config.CosmeticPower(c, stars)), Util.fmt(Config.CosmeticAps(c, stars)))
				local equipped = player:GetAttribute("Eq_" .. c.Slot) == id
				card.tag.Text = equipped and "WORN" or ""
				card.stroke.Transparency = equipped and 0 or 0.4
				card.stroke.Thickness = equipped and 3 or 2
			else
				card.icon.TextTransparency = 0.82
				card.name.Text = "???"
				card.name.TextColor3 = C.Muted
				card.stars.Text = ""
				card.stat.Text = "Find in crates"
				card.tag.Text = ""
				card.stroke.Transparency = 0.8
				card.stroke.Thickness = 1
			end
		end
		summary.Text = string.format(
			"Collection %d/%d   ·   Mog Power %s   ·   +%s Aura/s",
			owned,
			#Config.Cosmetics,
			Util.fmt(player:GetAttribute("GlowScore") or 0),
			Util.fmt(player:GetAttribute("AuraRate") or 0)
		)
	end

	applyFilter()
	return { refresh = refresh }
end

return TabWardrobe
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: small, calm notifications. Max three at once, identical messages merge into "x2",
-- and they sit above the dock so they never cover the action.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"))

local Toasts = {}

local holder
local active = {} -- list of { frame, text, count, label, token }

local KIND_COLOR = {
	info = UI.Colors.Cyan,
	good = UI.Colors.Good,
	gold = UI.Colors.Gold,
	bad = UI.Colors.Danger,
}

function Toasts.init(gui)
	holder = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.fromOffset(420, 110),
		BackgroundTransparency = 1,
	}, gui)
	UI.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
	}, holder)
end

local order = 0

local function remove(entry)
	local i = table.find(active, entry)
	if i then
		table.remove(active, i)
	end
	UI.tween(entry.frame, 0.25, { BackgroundTransparency = 1 })
	UI.tween(entry.label, 0.25, { TextTransparency = 1 })
	task.delay(0.3, function()
		entry.frame:Destroy()
	end)
end

function Toasts.push(text, kind)
	if not holder then
		return
	end
	local color = KIND_COLOR[kind or "info"] or UI.Colors.Cyan

	for _, entry in active do
		if entry.text == text then
			entry.count += 1
			entry.label.Text = text .. "  x" .. entry.count
			entry.token += 1
			local token = entry.token
			task.delay(2.8, function()
				if entry.token == token and table.find(active, entry) then
					remove(entry)
				end
			end)
			return
		end
	end

	if #active >= 2 then
		remove(active[1])
	end

	order += 1
	local frame = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(10, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	}, holder)
	UI.corner(frame, 13)
	UI.stroke(frame, color, 2, 0)
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, frame)
	local label = UI.label(frame, {
		Size = UDim2.fromOffset(10, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextWrapped = false,
		TextColor3 = UI.Colors.Text,
		Text = text,
	})
	local entry = { frame = frame, text = text, count = 1, label = label, token = 0 }
	table.insert(active, entry)
	task.delay(2.8, function()
		if entry.token == 0 and table.find(active, entry) then
			remove(entry)
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">TrainingUI</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the training minigame overlay. A marker sweeps a bar; press Space (or tap) while it
-- is inside the zone. The server decides the zone and grades the press, so this only draws it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)
local Toasts = require(script.Parent.Toasts)

local TrainingUI = {}

local C = UI.Colors
local panel, title, dots, bar, goodZone, perfectZone, marker, message, hint, scale, msgScale
local Action
local cfg, stat
local pressed = false
local frozenPos = 0
local resultText, resultColor
local active = false

local GRADE = {
	perfect = { text = "PERFECT", color = Color3.fromRGB(255, 214, 90) },
	good = { text = "GOOD", color = Color3.fromRGB(90, 230, 150) },
	miss = { text = "MISS", color = Color3.fromRGB(255, 100, 120) },
}

local function layoutZones()
	if not cfg then
		return
	end
	goodZone.Position = UDim2.fromScale(cfg.center - cfg.goodWidth / 2, 0)
	goodZone.Size = UDim2.fromScale(cfg.goodWidth, 1)
	perfectZone.Position = UDim2.fromScale(cfg.center - cfg.perfectWidth / 2, 0)
	perfectZone.Size = UDim2.fromScale(cfg.perfectWidth, 1)
end

local function press()
	if not active or not cfg or pressed then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < cfg.startedAt then
		return
	end
	pressed = true
	frozenPos = Util.tri((now - cfg.startedAt) * cfg.speed)
	Audio.click()
	Action:FireServer("TrainHit", now)
end

function TrainingUI.init(gui, action)
	Action = action
	panel = UI.panel(gui, {
		Name = "Training",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -66),
		Size = UDim2.fromOffset(340, 104),
		Visible = false,
		ZIndex = 10,
	})
	scale = UI.new("UIScale", {}, panel)
	title = UI.label(panel, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.fromOffset(220, 18),
		Font = UI.Fonts.Title,
		TextSize = 12,
		TextWrapped = false,
		Text = "TRAINING",
		ZIndex = 11,
	})
	dots = {}
	for i = 1, Config.TrainReps do
		local dot = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14 - (Config.TrainReps - i) * 16, 0, 11),
			Size = UDim2.fromOffset(11, 11),
			BackgroundColor3 = C.Disabled,
			ZIndex = 11,
		}, panel)
		UI.corner(dot, 7)
		dots[i] = dot
	end

	local barButton = UI.new("TextButton", {
		Position = UDim2.fromOffset(14, 32),
		Size = UDim2.new(1, -28, 0, 26),
		BackgroundColor3 = Color3.fromRGB(14, 11, 32),
		AutoButtonColor = false,
		Text = "",
		ZIndex = 11,
		ClipsDescendants = true,
	}, panel)
	UI.corner(barButton, 12)
	UI.stroke(barButton, C.Stroke, 1.5, 0.5)
	bar = barButton
	goodZone = UI.new("Frame", { BackgroundColor3 = C.Good, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 12 }, bar)
	perfectZone = UI.new("Frame", { BackgroundColor3 = C.Gold, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 13 }, bar)
	marker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0, 6, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 14,
	}, bar)
	UI.corner(marker, 3)
	barButton.Activated:Connect(press)

	message = UI.label(panel, {
		Position = UDim2.fromOffset(14, 62),
		Size = UDim2.new(1, -28, 0, 22),
		Font = UI.Fonts.Title,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
		ZIndex = 11,
	})
	msgScale = UI.new("UIScale", {}, message)
	hint = UI.label(panel, {
		Position = UDim2.fromOffset(14, 84),
		Size = UDim2.new(1, -60, 0, 14),
		Font = UI.Fonts.Body,
		TextSize = 10,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "SPACE / tap when the marker is in the gold zone",
		ZIndex = 11,
	})
	local cancel = UI.button(panel, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(22, 22),
		Text = "✕",
		TextSize = 10,
		ZIndex = 12,
		Radius = 11,
	}, "card")
	cancel.Activated:Connect(function()
		Action:FireServer("TrainCancel")
	end)

	-- Space is "swallowed" while training so the character doesn't jump away.
	ContextActionService:BindActionAtPriority("GlowTrainPress", function(_, state)
		if active then
			if state == Enum.UserInputState.Begin then
				press()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)

	RunService.RenderStepped:Connect(function()
		if not active or not cfg then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < cfg.startedAt then
			marker.Position = UDim2.fromScale(0, 0)
			if resultText then
				message.Text = resultText
				message.TextColor3 = resultColor
			else
				message.Text = string.format("GET READY  %.1f", cfg.startedAt - now)
				message.TextColor3 = C.Muted
			end
			return
		end
		resultText = nil
		if pressed then
			marker.Position = UDim2.fromScale(frozenPos, 0)
		else
			message.Text = "NOW!"
			message.TextColor3 = C.Text
			marker.Position = UDim2.fromScale(Util.tri((now - cfg.startedAt) * cfg.speed), 0)
		end
	end)
end

local function setDots(upTo, grade)
	if grade then
		dots[upTo].BackgroundColor3 = GRADE[grade].color
	end
end

local function loadCfg(newCfg)
	cfg = newCfg
	pressed = false
	if cfg then
		layoutZones()
	end
end

function TrainingUI.start(statId, firstCfg)
	stat = statId
	local def = Config.Stats[statId]
	active = true
	resultText = nil
	title.Text = def.Icon .. "  " .. def.Station .. " TRAINING"
	title.TextColor3 = def.Color
	for _, dot in dots do
		dot.BackgroundColor3 = C.Disabled
	end
	loadCfg(firstCfg)
	panel.Visible = true
	UI.pop(scale, 0.92)
end

function TrainingUI.rep(repIndex, grade, gain, streak, nextCfg)
	local g = GRADE[grade]
	if not g then
		return
	end
	setDots(repIndex, grade)
	local def = Config.Stats[stat]
	if grade == "miss" then
		resultText = "MISS"
		Audio.error()
	else
		resultText = string.format("%s  +%.1f %s", g.text, gain, def and def.Name or "")
		if grade == "perfect" then
			Audio.pickup(8 + math.min(streak, 6), 3)
			Fx.punch(3)
		else
			Audio.pickup(3, 1)
		end
	end
	resultColor = g.color
	message.Text = resultText
	message.TextColor3 = resultColor
	UI.pop(msgScale, 1.2)
	if nextCfg then
		loadCfg(nextCfg)
	end
end

function TrainingUI.finish(statId, total)
	active = false
	cfg = nil
	if statId and total and total > 0 then
		local def = Config.Stats[statId]
		Toasts.push(string.format("%s +%.1f %s", def.Icon, total, def.Name), "good")
		Audio.quest()
	end
	task.delay(statId and 1.2 or 0, function()
		if not active then
			panel.Visible = false
		end
	end)
end

return TrainingUI
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="55">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
