	{ Id = "Stage", Object = "Mog Stage", Action = "Enter competition", Pos = "stage", Radius = 24, Building = "stage" },
}
-- Resolves an interactable's world position (shared by the client and the server).
function Config.InteractPos(entry)
	local kind, arg = string.match(entry.Pos, "^(%w+):(.*)$")
	if kind == "station" then
		return Config.StationPos(arg)
	elseif entry.Pos == "battle" then
		return Config.BattlePos()
	elseif entry.Pos == "bot" then
		-- the training dummy stands beside the duel ring
		local ring = Config.StationPos("Ring")
		return (CFrame.lookAt(ring, ring + Config.StationFront("Ring")) * CFrame.new(-26, 0.4, -8)).Position
	end
	return Vector3.new(0, 0, 0)
end

--------------------------------------------------------------------------------
-- Cosmetics: what you wear. Power adds to Glow Score, Aps = Aura per second.
--------------------------------------------------------------------------------
Config.Rarities = {
	Common = { Order = 1, Color = Color3.fromRGB(166, 176, 198), Power = 10, Aps = 1 },
	Rare = { Order = 2, Color = Color3.fromRGB(82, 172, 255), Power = 30, Aps = 4 },
	Epic = { Order = 3, Color = Color3.fromRGB(192, 106, 255), Power = 90, Aps = 15 },
	Legendary = { Order = 4, Color = Color3.fromRGB(255, 192, 62), Power = 300, Aps = 60 },
	Mythic = { Order = 5, Color = Color3.fromRGB(255, 84, 172), Power = 1000, Aps = 250 },
}
Config.RarityOrder = { "Common", "Rare", "Epic", "Legendary", "Mythic" }
Config.MaxStars = 5
Config.StarBonus = 0.25 -- each extra star adds this much to Power and Aps

Config.Slots = { "Head", "Back", "Face", "Aura", "Trail" }
Config.SlotIcons = { Head = "👑", Back = "🦋", Face = "🕶️", Aura = "✨", Trail = "💨" }

Config.Cosmetics = {
	-- Head
	{ Id = "head_cap", Name = "Street Cap", Slot = "Head", Rarity = "Common", Icon = "🧢", Build = { Kind = "cap", Color = C(70, 80, 120) } },
	{ Id = "head_halo", Name = "Halo", Slot = "Head", Rarity = "Rare", Icon = "😇", Build = { Kind = "halo", Color = C(110, 230, 255) } },
	{ Id = "head_crown", Name = "Neon Crown", Slot = "Head", Rarity = "Epic", Icon = "👑", Build = { Kind = "crown", Color = C(255, 110, 205) } },
	{ Id = "head_solar", Name = "Solar Crown", Slot = "Head", Rarity = "Legendary", Icon = "☀️", Build = { Kind = "crown", Color = C(255, 205, 80), Sparkle = true } },
	{ Id = "head_horns", Name = "Void Horns", Slot = "Head", Rarity = "Mythic", Icon = "😈", Build = { Kind = "horns", Color = C(255, 70, 170), Sparkle = true } },
	-- Back
	{ Id = "back_cape", Name = "Street Cape", Slot = "Back", Rarity = "Common", Icon = "🧥", Build = { Kind = "cape", Color = C(150, 50, 80) } },
	{ Id = "back_neon", Name = "Neon Cape", Slot = "Back", Rarity = "Rare", Icon = "🦸", Build = { Kind = "cape", Color = C(60, 190, 255), Glow = true } },
	{ Id = "back_angel", Name = "Angel Wings", Slot = "Back", Rarity = "Epic", Icon = "🕊️", Build = { Kind = "wings", Color = C(255, 244, 220) } },
	{ Id = "back_phoenix", Name = "Phoenix Wings", Slot = "Back", Rarity = "Legendary", Icon = "🔥", Build = { Kind = "wings", Color = C(255, 130, 50), Sparkle = true } },
	{ Id = "back_galaxy", Name = "Galaxy Wings", Slot = "Back", Rarity = "Mythic", Icon = "🌌", Build = { Kind = "wings", Color = C(150, 100, 255), Sparkle = true } },
	-- Face
	{ Id = "face_shades", Name = "Midnight Shades", Slot = "Face", Rarity = "Common", Icon = "🕶️", Build = { Kind = "visor", Color = C(25, 25, 35) } },
	{ Id = "face_visor", Name = "Neon Visor", Slot = "Face", Rarity = "Rare", Icon = "🥽", Build = { Kind = "visor", Color = C(80, 230, 255), Glow = true } },
	{ Id = "face_gold", Name = "Gold Mask", Slot = "Face", Rarity = "Epic", Icon = "🎭", Build = { Kind = "mask", Color = C(255, 205, 90) } },
	{ Id = "face_cyber", Name = "Cyber Mask", Slot = "Face", Rarity = "Legendary", Icon = "🤖", Build = { Kind = "mask", Color = C(90, 255, 160), Glow = true } },
	{ Id = "face_void", Name = "Void Gaze", Slot = "Face", Rarity = "Mythic", Icon = "👁️", Build = { Kind = "visor", Color = C(255, 70, 180), Glow = true, Sparkle = true } },
	-- Aura
	{ Id = "aura_spark", Name = "Cyan Sparks", Slot = "Aura", Rarity = "Common", Icon = "✨", Build = { Kind = "aura", Color = C(100, 220, 255) } },
	{ Id = "aura_haze", Name = "Pink Haze", Slot = "Aura", Rarity = "Rare", Icon = "🌸", Build = { Kind = "aura", Color = C(255, 120, 200) } },
	{ Id = "aura_flare", Name = "Gold Flare", Slot = "Aura", Rarity = "Epic", Icon = "🔆", Build = { Kind = "aura", Color = C(255, 205, 80) } },
	{ Id = "aura_storm", Name = "Emerald Storm", Slot = "Aura", Rarity = "Legendary", Icon = "🌪️", Build = { Kind = "aura", Color = C(90, 255, 160) } },
	{ Id = "aura_nova", Name = "Prismatic Nova", Slot = "Aura", Rarity = "Mythic", Icon = "🌈", Build = { Kind = "aura", Color = C(255, 255, 255), Rainbow = true } },
	-- Trail
	{ Id = "trail_spark", Name = "Spark Trail", Slot = "Trail", Rarity = "Common", Icon = "💨", Build = { Kind = "trail", Color = C(100, 220, 255) } },
	{ Id = "trail_pink", Name = "Rose Trail", Slot = "Trail", Rarity = "Rare", Icon = "💗", Build = { Kind = "trail", Color = C(255, 120, 200) } },
	{ Id = "trail_gold", Name = "Gold Trail", Slot = "Trail", Rarity = "Epic", Icon = "🟡", Build = { Kind = "trail", Color = C(255, 205, 80) } },
	{ Id = "trail_emerald", Name = "Emerald Trail", Slot = "Trail", Rarity = "Legendary", Icon = "💚", Build = { Kind = "trail", Color = C(90, 255, 160) } },
	{ Id = "trail_prism", Name = "Prism Trail", Slot = "Trail", Rarity = "Mythic", Icon = "🌈", Build = { Kind = "trail", Color = C(255, 255, 255), Rainbow = true } },
}

Config.CosmeticById = {}
Config.CosmeticsByRarity = {}
for _, rarity in Config.RarityOrder do
	Config.CosmeticsByRarity[rarity] = {}
end
for _, c in Config.Cosmetics do
	Config.CosmeticById[c.Id] = c
	table.insert(Config.CosmeticsByRarity[c.Rarity], c)
end

function Config.CosmeticPower(c, stars)
	return Config.Rarities[c.Rarity].Power * (1 + Config.StarBonus * (stars - 1))
end
function Config.CosmeticAps(c, stars)
	return Config.Rarities[c.Rarity].Aps * (1 + Config.StarBonus * (stars - 1))
end

--------------------------------------------------------------------------------
-- Crates
--------------------------------------------------------------------------------
Config.Crates = {
	{ Id = "street", Name = "Street Crate", Icon = "📦", Cost = 300, Color = C(110, 160, 255), Odds = { Common = 70, Rare = 26, Epic = 4 } },
	{
		Id = "neon",
		Name = "Neon Crate",
		Icon = "🎁",
		Cost = 4000,
		Color = C(255, 110, 205),
		Odds = { Rare = 60, Epic = 34, Legendary = 6 },
		PityAfter = 10,
		PityMin = "Epic",
	},
	{
		Id = "icon",
		Name = "Icon Crate",
		Icon = "💎",
		Cost = 60000,
		Color = C(255, 204, 84),
		Odds = { Epic = 62, Legendary = 34, Mythic = 4 },
		PityAfter = 8,
		PityMin = "Legendary",
	},
}
Config.CrateById = {}
for _, crate in Config.Crates do
	Config.CrateById[crate.Id] = crate
end

-- Training pays more as you rank up, so early crates stay exciting without trivialising late ones.
function Config.RankScaling(rankIndex)
	return 1 + (rankIndex - 1) * 0.6
end

--------------------------------------------------------------------------------
-- Duels
--------------------------------------------------------------------------------
Config.Duel = {
	Countdown = 3,
	Length = 7,
	MaxTapsPerSecond = 14,
	QueueBotAfter = 6,
	Cooldown = 4,
}

--------------------------------------------------------------------------------
-- Mog Competition: a group flex-off on the central stage every few minutes
--------------------------------------------------------------------------------
Config.Competition = {
	Gap = 150, -- seconds between competitions
	EntryTime = 30,
	Countdown = 3,
	Length = 8,
	MinFieldSize = 6, -- bots fill empty spots so it always feels like a crowd
	BotNames = { "Mogger Mike", "Sigma Sam", "Chad Chris", "Aura Alex", "Rizz Ron", "Gigachad Gus" },
}

--------------------------------------------------------------------------------
-- Runway: walking it earns a steady trickle scaled by your Glow Score
--------------------------------------------------------------------------------
Config.Runway = { MinZ = 26, MaxZ = 96, HalfWidth = 7, AuraPerScore = 0.04 }

--------------------------------------------------------------------------------
-- Quests (an endless chain of small goals)
--------------------------------------------------------------------------------
local QUEST_KINDS = { "swings", "train", "duel", "crate", "perfect" }
function Config.MakeQuest(done, rebirths)
	local kind = QUEST_KINDS[done % #QUEST_KINDS + 1]
	local step = done // #QUEST_KINDS
	local goal, per
	if kind == "swings" then
		goal, per = math.min(40 + step * 15, 400), 2
	elseif kind == "train" then
		goal, per = math.min(5 + step, 20), 40
	elseif kind == "duel" then
		goal, per = math.min(1 + step // 2, 6), 180
	elseif kind == "crate" then
		goal, per = math.min(1 + step // 3, 4), 250
	else
		goal, per = math.min(3 + step, 15), 70
	end
	return { Kind = kind, Goal = goal, Reward = math.floor(goal * per * (1 + rebirths)) }
end
function Config.QuestText(kind, goal)
	if kind == "swings" then
		return string.format("Swing your hammer %d times", goal)
	elseif kind == "train" then
		return string.format("Land %d training reps", goal)
	elseif kind == "duel" then
		return string.format("Win %d duel%s", goal, goal == 1 and "" or "s")
	elseif kind == "crate" then
		return string.format("Open %d crate%s", goal, goal == 1 and "" or "s")
	end
	return string.format("Hit %d PERFECT reps", goal)
end

--------------------------------------------------------------------------------
-- Daily rewards (7-day cycle). Aura is multiplied by (1 + rebirths).
--------------------------------------------------------------------------------
Config.Daily = {
	{ Aura = 150 },
	{ Aura = 300 },
	{ Aura = 500, Crates = 1 },
	{ Aura = 800 },
	{ Aura = 1500, Crates = 2 },
	{ Aura = 2500 },
	{ Aura = 5000, Crates = 3 },
}

--------------------------------------------------------------------------------
-- Server events
--------------------------------------------------------------------------------
Config.EventGap = { 150, 280 }
Config.Events = {
	{ Id = "Golden", Name = "GOLDEN HOUR", Icon = "🌟", Desc = "All Aura x2", Duration = 90, AuraMult = 2, Tint = C(255, 240, 200) },
	{ Id = "Frenzy", Name = "DUEL FRENZY", Icon = "⚔️", Desc = "Duel rewards x3", Duration = 90, DuelMult = 3, Tint = C(255, 215, 220) },
	{ Id = "Runway", Name = "RUNWAY NIGHT", Icon = "💃", Desc = "Runway Aura x4", Duration = 90, RunwayMult = 4, Tint = C(235, 215, 255) },
}
Config.EventById = {}
for _, e in Config.Events do
	Config.EventById[e.Id] = e
end

--------------------------------------------------------------------------------
-- Audio (sounds that ship with Roblox; swap any for an asset id from the Creator Store)
--------------------------------------------------------------------------------
Config.Sounds = {
	Tone = "rbxasset://sounds/electronicpingshort.wav",
	Bass = "rbxasset://sounds/bass.wav",
	Click = "rbxasset://sounds/button.wav",
	Flash = "rbxasset://sounds/flashbulb.wav",
}
Config.MusicTrackId = "" -- optional looping song id; empty = generative ambient music
Config.MusicVolume = 0.28
Config.SfxVolume = 0.8

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Face</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: builds a player's custom face (eyes, brows, nose, mouth, jaw, ears, marks, facial hair) on a
-- head part from their Genome. `w` is how goofy it still is (1 = full gag, 0 = chiselled). Used by Quirks.
local Face = {}

local function bit(props)
	local part = Instance.new("Part")
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Material = Enum.Material.SmoothPlastic
	for k, v in props do
		part[k] = v
	end
	return part
end

local function stick(part, base, offset, folder)
	part.CFrame = base.CFrame * offset
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function ball(size, color)
	local s = type(size) == "number" and Vector3.one * size or size
	return bit({ Shape = Enum.PartType.Ball, Size = s, Color = color })
end

local function wedge(size, color)
	local part = Instance.new("WedgePart")
	part.Anchored = false
	part.CanCollide, part.CanTouch, part.CanQuery, part.Massless, part.CastShadow = false, false, false, true, false
	part.Material = Enum.Material.SmoothPlastic
	part.Size = size
	part.Color = color
	return part
end

local function mix(a, b, t)
	return a + (b - a) * t
end

--------------------------------------------------------------------------------
-- The face
--------------------------------------------------------------------------------
function Face.build(head, folder, dims, g, w, skin)
	local W, H, D = dims.X, dims.Y, dims.Z
	local z = -D * 0.5
	local dark = skin:Lerp(Color3.new(0, 0, 0), 0.45)
	local brow = g.hairColor:Lerp(Color3.new(0, 0, 0), 0.25)
	local sharp = 1 - w -- 0 = goofy, 1 = chiselled

	-- Eyes. Goofy: one big, one small, one higher, pupils crossed. Chiselled: matched, hooded, hunter-like.
	local baseEye = W * 0.24 * g.eyeSize
	for _, side in { -1, 1 } do
		local big = side == -1
		local goofy = mix(1, big and 1.7 or 0.8, w)
		local eyeW = baseEye * goofy
		local x = side * W * 0.21 * g.eyeSpacing
		local y = H * 0.1 + (big and 0 or H * 0.1 * w) + side * g.eyeTilt * H * 0.1 * sharp
		stick(ball(Vector3.new(eyeW, eyeW * 0.78, eyeW * 0.5), Color3.new(1, 1, 1)), head, CFrame.new(x, y, z), folder)
		local cross = -side * W * 0.05 * w
		stick(ball(eyeW * 0.62, g.eyeColor), head, CFrame.new(x + cross, y, z - eyeW * 0.2), folder)
		stick(ball(eyeW * mix(0.3, 0.2, w), Color3.new(0, 0, 0)), head, CFrame.new(x + cross, y, z - eyeW * 0.3), folder)
		stick(ball(eyeW * 0.1, Color3.new(1, 1, 1)), head, CFrame.new(x + cross + eyeW * 0.12, y + eyeW * 0.14, z - eyeW * 0.36), folder)
		-- upper lid: covers more of the eye as the face gets sharper (hooded hunter eyes)
		stick(bit({ Size = Vector3.new(eyeW * 1.1, eyeW * (0.1 + 0.3 * sharp), eyeW * 0.55), Color = skin }), head, CFrame.new(x, y + eyeW * (0.34 - 0.04 * sharp), z - eyeW * 0.02) * CFrame.Angles(0, 0, side * g.eyeTilt), folder)
		if sharp > 0.5 then
			-- lower lid and a darker lash line: the intense "hunter eyes" look
			stick(bit({ Size = Vector3.new(eyeW * 1.05, eyeW * 0.1, eyeW * 0.5), Color = skin }), head, CFrame.new(x, y - eyeW * 0.4, z - eyeW * 0.02), folder)
			stick(bit({ Size = Vector3.new(eyeW * 1.12, eyeW * 0.06, eyeW * 0.5), Color = dark }), head, CFrame.new(x, y + eyeW * 0.2, z - eyeW * 0.06), folder)
		end
		-- brow
		local browAngle = g.browAngle * 1.4 * sharp * side * -1
		if not (w > 0.6) then
			stick(bit({ Size = Vector3.new(W * 0.3, H * 0.075 * g.browThick * (1 + 0.7 * w + 0.3 * sharp), D * 0.09), Color = brow }), head, CFrame.new(x, y + eyeW * (0.65 - 0.14 * sharp), z - D * 0.01) * CFrame.Angles(0, 0, browAngle), folder)
		end
	end
	if w > 0.6 then
		-- one big hairy unibrow
		stick(bit({ Size = Vector3.new(W * 0.8, H * 0.13 * (0.5 + 0.5 * w), D * 0.12), Color = brow }), head, CFrame.new(0, H * 0.34, z) * CFrame.Angles(0, 0, 0.12), folder)
	end

	-- Nose: bridge + tip + nostrils. Bigger and rounder when goofy.
	local noseTip = W * 0.15 * g.noseSize * (1 + 0.9 * w)
	stick(bit({ Size = Vector3.new(W * 0.09 * g.noseWidth * (1 - 0.15 * sharp), H * 0.3, D * 0.13), Color = skin }), head, CFrame.new(0, -H * 0.02, z - D * 0.02), folder)
	stick(ball(Vector3.new(noseTip * g.noseWidth, noseTip, noseTip), skin), head, CFrame.new(0, -H * 0.15, z - D * 0.1), folder)
	if w > 0.25 then
		for _, side in { -1, 1 } do
			stick(ball(W * 0.05, dark), head, CFrame.new(side * noseTip * 0.3, -H * 0.18, z - D * 0.2), folder)
		end
	end

	-- Mouth: upper lip, lower lip. Goofy: crooked with buck teeth. Chiselled: a confident, slight smile.
	local mouthW = W * 0.34 * g.mouthWidth
	local lipColor = skin:Lerp(Color3.fromRGB(176, 70, 76), 0.3 * g.lip)
	local crook = 0.16 * w
	stick(bit({ Size = Vector3.new(mouthW, H * 0.045 * g.lip, D * 0.06), Color = lipColor }), head, CFrame.new(W * 0.03 * w, -H * 0.31, z) * CFrame.Angles(0, 0, crook), folder)
	stick(bit({ Size = Vector3.new(mouthW * 0.85, H * 0.06 * g.lip, D * 0.06), Color = lipColor }), head, CFrame.new(W * 0.03 * w, -H * 0.36, z) * CFrame.Angles(0, 0, crook), folder)
	if w <= 0.5 then
		for _, side in { -1, 1 } do
			stick(bit({ Size = Vector3.new(W * 0.05, H * 0.04, D * 0.05), Color = lipColor }), head, CFrame.new(side * mouthW * 0.52, -H * 0.29, z) * CFrame.Angles(0, 0, side * 0.5), folder)
		end
	end
	if w > 0.45 then
		for _, side in { -1, 1 } do
			stick(bit({ Size = Vector3.new(W * 0.11, H * 0.17, D * 0.06), Color = Color3.fromRGB(250, 248, 235) }), head, CFrame.new(W * 0.04 * w + side * W * 0.065, -H * 0.41, z - D * 0.02), folder)
		end
	end

	-- Jaw and chin: the jawline gets squarer and the chin stronger with every level.
	local jaw = g.jaw * sharp
	if sharp > 0.15 then
		stick(bit({ Size = Vector3.new(W * (0.38 + 0.3 * jaw), H * 0.16, D * 0.14), Color = skin }), head, CFrame.new(0, -H * 0.46, z + D * 0.02), folder)
		stick(ball(Vector3.new(W * (0.2 + 0.16 * jaw), H * 0.14, D * 0.2), skin), head, CFrame.new(0, -H * 0.5, z - D * 0.02 * sharp), folder)
		for _, side in { -1, 1 } do
			-- the square corners of the jaw
			stick(bit({ Size = Vector3.new(D * 0.1, H * 0.26 * jaw, D * 0.46), Color = skin }), head, CFrame.new(side * W * 0.45, -H * 0.36, z + D * 0.3), folder)
		end
	end
	-- Cheekbones with a soft shadow under them
	if w < 0.6 then
		for _, side in { -1, 1 } do
			stick(ball(Vector3.new(W * 0.2 * g.cheek, H * 0.11, D * 0.12) * sharp, skin:Lerp(Color3.new(1, 1, 1), 0.1)), head, CFrame.new(side * W * 0.33, -H * 0.06, z + D * 0.04), folder)
			stick(ball(Vector3.new(W * 0.2 * g.cheek, H * 0.07, D * 0.1) * sharp, dark), head, CFrame.new(side * W * 0.31, -H * 0.17, z + D * 0.05), folder).Transparency = 0.72
		end
	end
	-- Ears
	for _, side in { -1, 1 } do
		stick(ball(Vector3.new(D * 0.12, W * 0.2 * g.ear, D * 0.2), skin), head, CFrame.new(side * W * 0.5, -H * 0.02, D * 0.02), folder)
	end

	-- Marks that make this face theirs
	if g.mole ~= 0 then
		stick(ball(W * 0.03, Color3.fromRGB(60, 36, 28)), head, CFrame.new(g.mole * W * 0.2, -H * 0.24, z - D * 0.02), folder)
	end
	if g.scar ~= 0 and sharp > 0.3 then
		stick(bit({ Size = Vector3.new(W * 0.02, H * 0.3, D * 0.03), Color = skin:Lerp(Color3.new(1, 1, 1), 0.3) }), head, CFrame.new(g.scar * W * 0.27, H * 0.08, z - D * 0.01) * CFrame.Angles(0, 0, 0.25 * g.scar), folder)
	end
	if g.freckles then
		local rng = Random.new(13)
		for _ = 1, 10 do
			stick(ball(W * 0.016, skin:Lerp(Color3.fromRGB(120, 70, 40), 0.5)), head, CFrame.new((rng:NextNumber() - 0.5) * W * 0.5, -H * (0.02 + rng:NextNumber() * 0.12), z - D * 0.03), folder)
		end
	end

	-- Facial hair (only once the face has sharpened; the gag mustache covers the early levels)
	local beard = g.beard
	if beard == "none" and w < 0.12 and g.chadStubble then
		beard = "stubble"
	end
	if w < 0.55 and beard ~= "none" then
		local hair = g.hairColor
		if beard == "stubble" then
			local rng = Random.new(29)
			for _ = 1, 26 do
				local x = (rng:NextNumber() - 0.5) * W * 0.8
				stick(ball(W * 0.025, hair), head, CFrame.new(x, -H * (0.3 + rng:NextNumber() * 0.2), z - D * 0.01 + (math.abs(x) / W) * D * 0.15), folder)
			end
		elseif beard == "goatee" then
			stick(bit({ Size = Vector3.new(W * 0.2, H * 0.2, D * 0.1), Color = hair }), head, CFrame.new(0, -H * 0.47, z - D * 0.02), folder)
			stick(bit({ Size = Vector3.new(W * 0.34, H * 0.05, D * 0.07), Color = hair }), head, CFrame.new(0, -H * 0.27, z - D * 0.03), folder)
		else
			stick(bit({ Size = Vector3.new(W * 0.74, H * 0.3, D * 0.14), Color = hair }), head, CFrame.new(0, -H * 0.42, z + D * 0.04), folder)
			stick(bit({ Size = Vector3.new(W * 0.36, H * 0.06, D * 0.08), Color = hair }), head, CFrame.new(0, -H * 0.27, z - D * 0.03), folder)
			for _, side in { -1, 1 } do
				stick(bit({ Size = Vector3.new(D * 0.1, H * 0.4, D * 0.4), Color = hair }), head, CFrame.new(side * W * 0.46, -H * 0.2, z + D * 0.3), folder)
			end
		end
	end

	-- Goofy mustache
	if w > 0.3 then
		for side = -1, 1, 2 do
			stick(bit({ Size = Vector3.new(W * 0.3, H * 0.12, D * 0.1), Color = brow }), head, CFrame.new(side * W * 0.16, -H * 0.24, z - D * 0.04) * CFrame.Angles(0, 0, -side * 0.18), folder)
		end
	end
end


-- Styled hair that replaces the avatar's own once you have levelled up a bit (see Quirks).
function Face.hair(head, folder, dims, g, level)
	local W, H, D = dims.X, dims.Y, dims.Z
	local color = g.hairColor
	local style = g.hairStyle
	local shade = color:Lerp(Color3.new(1, 1, 1), 0.1)
	local function hairBit(size, cf, c)
		local part = ball(size, c or color)
		part.Material = Enum.Material.Fabric
		return stick(part, head, cf, folder)
	end
	-- base: the top of the head and the back
	if style == "buzz" then
		hairBit(Vector3.new(W * 1.03, H * 0.42, D * 1.04), CFrame.new(0, H * 0.42, D * 0.03), color:Lerp(Color3.new(0, 0, 0), 0.1)).Transparency = 0.15
		return
	end
	hairBit(Vector3.new(W * 1.08, H * 0.52, D * 1.1), CFrame.new(0, H * 0.5, D * 0.04))
	hairBit(Vector3.new(W * 1.02, H * 0.78, D * 0.5), CFrame.new(0, H * 0.2, D * 0.42))
	-- sideburns
	for _, side in { -1, 1 } do
		stick(bit({ Size = Vector3.new(D * 0.1, H * 0.34, D * 0.3), Color = color }), head, CFrame.new(side * W * 0.52, H * 0.26, -D * 0.12), folder)
	end
	if style == "quiff" then
		hairBit(Vector3.new(W * 0.76, H * 0.3, D * 0.62), CFrame.new(0, H * 0.78, -D * 0.22) * CFrame.Angles(math.rad(14), 0, 0), shade)
		hairBit(Vector3.new(W * 0.9, H * 0.14, D * 0.2), CFrame.new(0, H * 0.52, -D * 0.5))
	elseif style == "swept" then
		hairBit(Vector3.new(W * 1.0, H * 0.16, D * 0.24), CFrame.new(W * 0.06, H * 0.5, -D * 0.5) * CFrame.Angles(0, 0, 0.16))
		hairBit(Vector3.new(W * 0.55, H * 0.22, D * 0.4), CFrame.new(-W * 0.2, H * 0.7, -D * 0.28), shade)
	elseif style == "slick" then
		hairBit(Vector3.new(W * 1.0, H * 0.12, D * 0.9), CFrame.new(0, H * 0.7, 0), shade)
	elseif style == "long" then
		hairBit(Vector3.new(W * 0.98, H * 1.3, D * 0.24), CFrame.new(0, -H * 0.2, D * 0.56))
		for _, side in { -1, 1 } do
			stick(bit({ Size = Vector3.new(D * 0.16, H * 0.9, D * 0.3), Color = color }), head, CFrame.new(side * W * 0.54, -H * 0.1, D * 0.1), folder)
		end
		hairBit(Vector3.new(W * 1.0, H * 0.14, D * 0.22), CFrame.new(0, H * 0.5, -D * 0.5) * CFrame.Angles(0, 0, -0.1))
	end
end

Face.bit, Face.ball, Face.wedge, Face.stick = bit, ball, wedge, stick

return Face
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Genome</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: every player gets their own face and body, decided by their user id (so it is always the same
-- for the same person, and different from everyone else). Level then decides how goofy or chiselled it looks.
local Genome = {}

local EYE_COLORS = {
	Color3.fromRGB(88, 56, 32), Color3.fromRGB(52, 34, 22), Color3.fromRGB(128, 100, 52), Color3.fromRGB(70, 130, 84),
	Color3.fromRGB(70, 120, 190), Color3.fromRGB(130, 144, 156), Color3.fromRGB(176, 120, 40), Color3.fromRGB(120, 180, 220),
}
local HAIR_COLORS = {
	Color3.fromRGB(24, 20, 18), Color3.fromRGB(48, 32, 22), Color3.fromRGB(88, 58, 34), Color3.fromRGB(150, 110, 60),
	Color3.fromRGB(200, 160, 80), Color3.fromRGB(150, 60, 34), Color3.fromRGB(110, 110, 112),
}
local HAIRSTYLES = { "swept", "quiff", "slick", "buzz", "long", "swept", "quiff" }
local BEARDS = { "none", "none", "none", "none", "stubble", "stubble", "stubble", "goatee", "goatee", "full", "full" }

local cache = {}

-- Returns the same table for the same user id every time.
function Genome.get(userId)
	if cache[userId] then
		return cache[userId]
	end
	local rng = Random.new((userId % 2147483647) * 7919 + 13)
	local function range(a, b)
		return a + (b - a) * rng:NextNumber()
	end
	local g = {
		eyeColor = EYE_COLORS[rng:NextInteger(1, #EYE_COLORS)],
		eyeSize = range(0.85, 1.2),
		eyeSpacing = range(0.88, 1.18),
		eyeTilt = range(-0.12, 0.14),
		browThick = range(0.8, 1.35),
		browAngle = range(-0.12, 0.28),
		noseSize = range(0.8, 1.25),
		noseWidth = range(0.85, 1.25),
		mouthWidth = range(0.85, 1.2),
		lip = range(0.6, 1.4),
		jaw = range(0.8, 1.3),
		cheek = range(0.8, 1.25),
		ear = range(0.85, 1.25),
		hairColor = HAIR_COLORS[rng:NextInteger(1, #HAIR_COLORS)],
		beard = BEARDS[rng:NextInteger(1, #BEARDS)],
		mole = rng:NextNumber() < 0.3 and (rng:NextNumber() < 0.5 and -1 or 1) or 0,
		scar = rng:NextNumber() < 0.12 and (rng:NextNumber() < 0.5 and -1 or 1) or 0,
		freckles = rng:NextNumber() < 0.25,
		hairStyle = HAIRSTYLES[rng:NextInteger(1, #HAIRSTYLES)],
		chadStubble = rng:NextNumber() < 0.55, -- a light stubble once the face is fully chiselled
		skinShift = range(-0.3, 0.5), -- negative = lighter, positive = darker
		height = range(0.95, 1.06),
		width = range(0.94, 1.07),
		depth = range(0.95, 1.06),
		head = range(0.94, 1.07),
	}
	cache[userId] = g
	return g
end

-- Skin colour for a level, adjusted for this person.
function Genome.skin(base, g)
	if g.skinShift >= 0 then
		return base:Lerp(Color3.fromRGB(86, 56, 38), g.skinShift)
	end
	return base:Lerp(Color3.fromRGB(246, 224, 206), -g.skinShift * 0.8)
end

return Genome
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">HammerModel</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: builds the 3D model of a hammer from simple parts (nothing to import).
-- Used for the pedestals in the shop and for the hammer in your hand.
local HammerModel = {}

-- opts.scale shrinks/grows it; opts.anchored for display pieces; the handle is the PrimaryPart.
function HammerModel.build(hammer, cf, parent, opts)
	opts = opts or {}
	local s = opts.scale or 1
	local model = Instance.new("Model")
	model.Name = "Hammer_" .. hammer.Id
	local mat = Enum.Material[hammer.Material] or Enum.Material.Metal
	local function piece(name, size, at, color, material, shape)
		local p = Instance.new("Part")
		p.Name = name
		p.Size = size * s
		p.CFrame = cf * CFrame.new(at.Position * s) * (at - at.Position)
		p.Color = color
		p.Material = material
		if shape then
			p.Shape = shape
		end
		p.Anchored = opts.anchored == true
		p.CanCollide = false
		p.CanQuery = false
		p.CanTouch = false
		p.Massless = true
		p.TopSurface = Enum.SurfaceType.Smooth
		p.BottomSurface = Enum.SurfaceType.Smooth
		p.Parent = model
		return p
	end
	local handle = piece("Handle", Vector3.new(0.7, 6, 0.7), CFrame.new(), hammer.Handle, Enum.Material.Wood)
	local top = CFrame.new(0, 3, 0)
	if hammer.Style == "mallet" then
		piece("Head", Vector3.new(4, 2.4, 2.4), top * CFrame.Angles(0, 0, math.pi / 2), hammer.Head, mat, Enum.PartType.Cylinder)
	elseif hammer.Style == "chisel" then
		piece("Head", Vector3.new(0.9, 3.4, 2.2), top * CFrame.new(0, 1, 0), hammer.Head, mat)
		piece("Tip", Vector3.new(0.9, 1.4, 1.4), top * CFrame.new(0, 3, 0) * CFrame.Angles(0, 0, math.pi / 4), hammer.Head, mat)
	elseif hammer.Style == "spiked" then
		piece("Head", Vector3.new(3.6, 2.4, 2.4), top, hammer.Head, mat)
		for side = -1, 1, 2 do
			piece("Spike", Vector3.new(1.2, 1.2, 1.2), top * CFrame.new(side * 2.2, 0, 0) * CFrame.Angles(0, 0, math.pi / 4), hammer.Head, mat)
		end
	else
		piece("Head", Vector3.new(3.4, 2.2, 2.2), top, hammer.Head, mat)
		piece("Band", Vector3.new(3.6, 0.5, 2.4), top * CFrame.new(0, -0.9, 0), hammer.Handle, Enum.Material.SmoothPlastic)
	end
	model.PrimaryPart = handle
	model.Parent = parent
	return model
end

return HammerModel
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">UI</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the client design system. One place for colours, fonts and reusable components
-- so every screen looks like it belongs to the same game.
local TweenService = game:GetService("TweenService")

local Config = require(script.Parent:WaitForChild("Config"))
local Util = require(script.Parent:WaitForChild("Util"))

local UI = {}

UI.Colors = {
	Bg = Color3.fromRGB(20, 28, 54),
	Panel = Color3.fromRGB(34, 48, 88),
	Card = Color3.fromRGB(54, 72, 128),
	CardHover = Color3.fromRGB(72, 94, 160),
	Stroke = Color3.fromRGB(10, 14, 30),
	Text = Color3.fromRGB(255, 255, 255),
	Muted = Color3.fromRGB(186, 200, 232),
	Accent = Color3.fromRGB(62, 140, 255),
	Accent2 = Color3.fromRGB(255, 170, 40),
	Good = Color3.fromRGB(62, 200, 92),
	Gold = Color3.fromRGB(255, 200, 40),
	Cyan = Color3.fromRGB(90, 200, 255),
	Danger = Color3.fromRGB(232, 72, 72),
	Disabled = Color3.fromRGB(96, 104, 134),
	-- Aesthetic accents, one per kind of information so each part of the screen is recognisable
	Pink = Color3.fromRGB(255, 112, 176),
	Orange = Color3.fromRGB(255, 150, 60),
	Mint = Color3.fromRGB(84, 224, 176),
	Purple = Color3.fromRGB(162, 112, 255),
	Sky = Color3.fromRGB(88, 186, 255),
	Yellow = Color3.fromRGB(255, 218, 70),
}

UI.Fonts = {
	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
}

UI.fmt = Util.fmt

function UI.new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in props do
		inst[k] = v
	end
	inst.Parent = parent
	return inst
end

function UI.corner(inst, radius)
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) }, inst)
end

function UI.stroke(inst, color, thickness, transparency)
	return UI.new("UIStroke", {
		Color = color or UI.Colors.Stroke,
		Thickness = thickness or 2.5,
		Transparency = transparency or 0,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	}, inst)
end

function UI.gradient(inst, c1, c2, rotation)
	return UI.new("UIGradient", {
		Color = ColorSequence.new(c1, c2),
		Rotation = rotation or 90,
	}, inst)
end

function UI.padding(inst, all)
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, all),
		PaddingRight = UDim.new(0, all),
	}, inst)
end

function UI.tween(inst, seconds, props, style, direction)
	local t = TweenService:Create(
		inst,
		TweenInfo.new(seconds, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		props
	)
	t:Play()
	return t
end

-- Squash-and-stretch on a UIScale.
function UI.pop(scaleObj, amount)
	scaleObj.Scale = amount or 1.12
	UI.tween(scaleObj, 0.28, { Scale = 1 }, Enum.EasingStyle.Back)
end

function UI.label(parent, props)
	local base = {
		BackgroundTransparency = 1,
		Font = UI.Fonts.Body,
		TextSize = 16,
		TextColor3 = UI.Colors.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextWrapped = true,
		RichText = false,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.6,
	}
	for k, v in props do
		base[k] = v
	end
	return UI.new("TextLabel", base, parent)
end

-- A rounded glass panel.
function UI.panel(parent, props)
	local base = {
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0,
		BorderSizePixel = 0,
	}
	local radius = props.Radius or 14
	for k, v in props do
		if k ~= "Radius" then
			base[k] = v
		end
	end
	local frame = UI.new("Frame", base, parent)
	UI.corner(frame, radius)
	UI.stroke(frame)
	UI.gradient(frame, Color3.new(1, 1, 1), Color3.fromRGB(196, 200, 214), 90)
	return frame
end

-- Button with hover/press feedback. style: "primary" (gradient) | "card" | "ghost".
function UI.button(parent, props, style)
	style = style or "primary"
	local base = {
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Font = UI.Fonts.Title,
		TextSize = 16,
		TextColor3 = UI.Colors.Text,
		Text = "",
		BackgroundColor3 = style == "card" and UI.Colors.Card or UI.Colors.Good,
		TextStrokeColor3 = Color3.new(0, 0, 0),
		TextStrokeTransparency = 0.3,
	}
	local radius = props.Radius or 12
	for k, v in props do
		if k ~= "Radius" then
			base[k] = v
		end
	end
	local btn = UI.new("TextButton", base, parent)
	UI.corner(btn, radius)
	local scale = UI.new("UIScale", {}, btn)
	UI.stroke(btn, UI.Colors.Stroke, 2.5, 0)
	local grad = UI.gradient(btn, Color3.new(1, 1, 1), Color3.fromRGB(190, 196, 210), 90)
	local baseColor = base.BackgroundColor3
	btn.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.04 })
		if style == "card" then
			UI.tween(btn, 0.12, { BackgroundColor3 = UI.Colors.CardHover })
		end
	end)
	btn.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
		if style == "card" then
			UI.tween(btn, 0.12, { BackgroundColor3 = baseColor })
		end
	end)
	btn.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.06, { Scale = 0.95 })
	end)
	btn.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.1, { Scale = 1.04 })
	end)
	return btn, scale, grad
end

-- Horizontal progress bar. Returns an object with :set(alpha) and .fill / .back.
function UI.bar(parent, props, fillColor)
	local back = UI.new("Frame", {
		BackgroundColor3 = Color3.fromRGB(14, 11, 32),
		BorderSizePixel = 0,
		Size = props.Size or UDim2.new(1, 0, 0, 10),
		Position = props.Position or UDim2.new(),
		AnchorPoint = props.AnchorPoint or Vector2.zero,
	}, parent)
	UI.corner(back, 99)
	UI.stroke(back, UI.Colors.Stroke, 2, 0)
	local fill = UI.new("Frame", {
		BackgroundColor3 = fillColor or UI.Colors.Accent,
		BorderSizePixel = 0,
		Size = UDim2.fromScale(0, 1),
	}, back)
	UI.corner(fill, 99)
	UI.gradient(fill, Color3.new(1, 1, 1), Color3.fromRGB(170, 176, 190), 90)
	local self = { back = back, fill = fill }
	function self.set(alpha)
		fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
	end
	return self
end

function UI.rarityColor(rarity)
	return Config.Rarities[rarity].Color
end

return UI
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Util</string>
          <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: small shared helpers.
local Util = {}

-- 1234 -> "1,234", 15300 -> "15.3K", 4.2e6 -> "4.20M" ...
function Util.fmt(n)
	n = math.floor(n + 0.5)
	if n >= 1e15 then
		return string.format("%.2fQ", n / 1e15)
	elseif n >= 1e12 then
		return string.format("%.2fT", n / 1e12)
	elseif n >= 1e9 then
		return string.format("%.2fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.2fM", n / 1e6)
	elseif n >= 1e4 then
		return string.format("%.1fK", n / 1e3)
	elseif n >= 1000 then
		local s = tostring(n)
		return s:sub(1, #s - 3) .. "," .. s:sub(-3)
	end
	return tostring(n)
end

-- Triangle wave 0..1..0 with period 2 (used for the training bar so client and server agree).
function Util.tri(x)
	return 1 - math.abs(x % 2 - 1)
end

function Util.lerp(a, b, t)
	return a + (b - a) * t
end

-- Seconds -> "1:05"
function Util.clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return string.format("%d:%02d", seconds // 60, seconds % 60)
end

-- Parses "id:stars,id:stars" (the replicated inventory string).
function Util.parseInventory(text)
	local inv = {}
	for id, stars in string.gmatch(text or "", "([%w_]+):(%d+)") do
		inv[id] = tonumber(stars)
	end
	return inv
end

return Util
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="11">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="12">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: server entry point. Creates the network channels, builds the world, wires every
-- system together, and routes client requests.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))

-- Network channels: Action = client asks the server, Notify = server tells the client.
local net = Instance.new("Folder")
net.Name = "Net"
net.Parent = ReplicatedStorage
local Action = Instance.new("RemoteEvent")
Action.Name = "Action"
Action.Parent = net
local Notify = Instance.new("RemoteEvent")
Notify.Name = "Notify"
Notify.Parent = net

local Modules = script:WaitForChild("Modules")
local Data = require(Modules.Data)
local Stats = require(Modules.Stats)
local Appearance = require(Modules.Appearance)
local Quirks = require(Modules.Quirks)
local Cosmetics = require(Modules.Cosmetics)
local Nameplate = require(Modules.Nameplate)
local Quests = require(Modules.Quests)
local Daily = require(Modules.Daily)
local Training = require(Modules.Training)
local Crates = require(Modules.Crates)
local Duels = require(Modules.Duels)
local Competition = require(Modules.Competition)
local Shop = require(Modules.Shop)
local Events = require(Modules.Events)
local Runway = require(Modules.Runway)
local Board = require(Modules.Board)
local Hammers = require(Modules.Hammers)
local Pets = require(Modules.Pets)
local Aura = require(Modules.Aura)
local Playtime = require(Modules.Playtime)
local Tutorial = require(Modules.Tutorial)
local Buildings = require(Modules.Buildings)
local Treadmill = require(Modules.Treadmill)
local Store = require(Modules.Store)
local World = require(Modules.World)

--------------------------------------------------------------------------------
-- World + systems
--------------------------------------------------------------------------------
print("[TrueAdam] server starting")
local okWorld, info = pcall(World.build)
if okWorld then
	Duels.setArena(info.arena, info.battle)
	Competition.setStage(info.stage, info.compBoard)
	Board.init(info.board)
	print("[TrueAdam] world built")
else
	warn("[TrueAdam] World.build FAILED:", info)
end
-- Rebuild the face/hair/belly and any worn items whenever the body changes.
Appearance.setHook(function(p)
	Quirks.apply(p)
	Cosmetics.apply(p)
	Aura.apply(p)
end)
Competition.init()
Training.init()
Pets.init()
Store.start()
Treadmill.init()
Runway.init()
Events.init()
Data.init()

--------------------------------------------------------------------------------
-- Player lifecycle
--------------------------------------------------------------------------------
-- Runs one setup step; a failure in one system never stops the others (or the player from joining).
local function safe(label, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then
		warn("[TrueAdam] " .. label .. " failed:", err)
	end
end

local function onCharacter(p)
	local char = p.Character
	if not char then
		return
	end
	char:WaitForChild("HumanoidRootPart")
	char:WaitForChild("Humanoid")
	-- A new body is never frozen, running or training.
	Treadmill.release(p)
	p:SetAttribute("Running", 0)
	p:SetAttribute("RunHeat", 0)
	safe("movement", Stats.applyMovement, p)
	safe("appearance", Appearance.onCharacter, p)
	safe("cosmetics", Cosmetics.onCharacter, p)
	safe("nameplate", Nameplate.onCharacter, p)
	safe("hammer", Hammers.attach, p)
	safe("pets", Pets.refresh, p)
end

local function onPlayer(p)
	local profile = Data.load(p)
	safe("stats", Stats.init, p)
	safe("quests", Quests.init, p)
	safe("daily", Daily.refresh, p)
	safe("playtime", Playtime.init, p)
	safe("tutorial", Tutorial.init, p)
	safe("store", Store.init, p)
	safe("nameplate", Nameplate.init, p)
	safe("cosmetics", Cosmetics.sync, p)
	p:SetAttribute("GuideSeen", profile.GuideSeen == true)
	p:SetAttribute("Ready", true) -- even if a system above failed, let the player in

	-- Your look keeps earning while you're away.
	if profile.LastSeen then
		local away = math.clamp(os.time() - profile.LastSeen, 0, 2 * 3600)
		local gain = math.floor((p:GetAttribute("AuraRate") or 0) * away * 0.5)
		if gain > 0 then
			Stats.addAura(p, gain, { raw = true })
			p:SetAttribute("OfflineGain", gain)
		end
	end

	p.CharacterAdded:Connect(function()
		onCharacter(p)
	end)
	p.CharacterRemoving:Connect(function()
		-- dying or resetting mid-activity must never leave a stuck state behind
		safe("leave training", Training.cancel, p)
		Treadmill.release(p)
		p:SetAttribute("Running", 0)
	end)
	if p.Character then
		task.spawn(onCharacter, p)
	end
end

Players.PlayerAdded:Connect(onPlayer)
for _, p in Players:GetPlayers() do
	task.spawn(onPlayer, p)
end

Players.PlayerRemoving:Connect(function(p)
	Training.release(p)
	Hammers.release(p)
	Pets.release(p)
	Playtime.release(p)
	Tutorial.release(p)
	Treadmill.release(p)
	Duels.release(p)
	Competition.release(p)
	Stats.forget(p)
end)

--------------------------------------------------------------------------------
-- Idle income + daily refresh
--------------------------------------------------------------------------------
task.spawn(function()
	local tick = 0
	while true do
		task.wait(1)
		tick += 1
		for _, p in Players:GetPlayers() do
			if p:GetAttribute("Ready") then
				local rate = p:GetAttribute("AuraRate") or 0
				if rate > 0 then
					Stats.addAuraFractional(p, rate * Stats.eventMult("AuraMult"), { raw = true })
				end
				Playtime.tick(p)
				Tutorial.tick(p)
				Treadmill.tick(p)
				if tick % 30 == 0 then
					Daily.refresh(p)
				end
			end
		end
	end
end)

--------------------------------------------------------------------------------
-- Client requests (rate limited)
--------------------------------------------------------------------------------
-- Everything you can use is activated by a button on screen (or E). The server checks how close your
-- character is, so it works the same from any camera angle.
local INTERACT_SLACK = 8
local interactions = {
	Gym = function(p)
		Training.start(p, "Power")
	end,
	Studio = function(p)
		Training.start(p, "Style")
	end,
	Lounge = function(p)
		Training.start(p, "Charm")
	end,
	Crates = function(p)
		Stats.send(p, "openMenu", "Crates")
	end,
	Ring = Duels.joinQueue,
	Battle = Duels.stageFight,
	Bot = Duels.duelBot,
	Stage = Competition.enter,
}

local function nearTo(p, pos, radius)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	local d = root.Position - pos
	return Vector3.new(d.X, 0, d.Z).Magnitude <= radius + INTERACT_SLACK
end

local function interact(p, id)
	local treadId = string.match(id, "^Tread:(%d+)$")
	if treadId then
		local n = tonumber(treadId)
		if Config.Treadmills[n] and nearTo(p, Config.TreadPos(n), Config.TreadRadius) then
			Treadmill.use(p, n)
		end
		return
	end
	local hammerId = string.match(id, "^Hammer:(%d+)$")
	if hammerId then
		local n = tonumber(hammerId)
		if Config.HammerById[n] and nearTo(p, Config.HammerPos(n), Config.HammerRadius) then
			Hammers.use(p, n)
		end
		return
	end
	local handler = interactions[id]
	for _, entry in Config.Interactables do
		if entry.Id == id and handler and nearTo(p, Config.InteractPos(entry), entry.Radius) then
			-- Buildings must be unlocked first; the press that buys it does not also use it.
			if entry.Building and not Buildings.owned(p, entry.Building) then
				Buildings.unlock(p, entry.Building)
				return
			end
			if Treadmill.isRunning(p) then
				return
			end
			handler(p)
			return
		end
	end
end

local SETTING_KEYS = { Music = true, Sfx = true, Duels = true, Fx = true, Voice = true }
local budget = {}

local function handleAction(p, kind, a, b)
	if type(kind) ~= "string" or not p:GetAttribute("Ready") then
		return
	end
	local now = os.clock()
	local state = budget[p]
	if not state or now - state.t > 1 then
		state = { t = now, n = 0 }
		budget[p] = state
	end
	state.n += 1
	if state.n > 60 then
		return
	end

	if kind == "Equip" or kind == "Unequip" then
		Cosmetics.handle(p, kind, a)
	elseif kind == "Buy" or kind == "Rebirth" then
		Shop.handle(p, kind, a)
	elseif kind == "OpenCrate" and type(a) == "string" then
		Crates.open(p, a)
	elseif kind == "Hatch" or kind == "PetEquip" or kind == "PetUnequip" or kind == "PetBest" then
		Pets.handle(p, kind, a)
	elseif kind == "TreadStop" then
		Treadmill.stop(p)
	elseif kind == "TutorialSkip" then
		Tutorial.skip(p)
	elseif kind == "Swing" then
		Hammers.swing(p)
	elseif kind == "Interact" and type(a) == "string" then
		interact(p, a)
	elseif kind == "Claim" then
		Daily.claim(p)
	elseif kind == "TrainHit" or kind == "TrainCancel" then
		Training.handle(p, kind, a)
	elseif kind == "DuelTaps" then
		Duels.handle(p, kind, a)
	elseif kind == "CompTaps" then
		Competition.handle(p, kind, a)
	elseif kind == "Setting" and type(a) == "string" and SETTING_KEYS[a] then
		Stats.setSetting(p, a, b)
	elseif kind == "GuideSeen" then
		local profile = Data.get(p)
		if profile then
			profile.GuideSeen = true
			p:SetAttribute("GuideSeen", true)
		end
	end
end

-- One bad request (or one bug) must never break the next one.
Action.OnServerEvent:Connect(function(p, kind, a, b)
	local ok, err = pcall(handleAction, p, kind, a, b)
	if not ok then
		warn("[TrueAdam] action '" .. tostring(kind) .. "' failed:", err)
	end
end)

Players.PlayerRemoving:Connect(function(p)
	budget[p] = nil
end)

print("[TrueAdam] ready")
]]></string>
      </Properties>
      <Item class="Folder" referent="13">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Appearance</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: your character's body changes as you level. Level 1 is a short, wide,
-- big-headed gag character; by level 1000 you're tall and athletic. It's all cartoon-style
-- body scaling, no skin or face changes.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Genome = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Genome"))

local Appearance = {}

local onChanged -- set by Main so accessories can be rebuilt at the new size

-- The scale numbers for this player: the level's look, nudged by their personal body genome.
function Appearance.scalesFor(p)
	local profile = Data.get(p)
	local level = profile and profile.Level or 1
	local s = Config.AppearanceScales(level)
	local g = Genome.get(p.UserId)
	return {
		BodyHeightScale = s.BodyHeightScale * g.height,
		BodyWidthScale = s.BodyWidthScale * g.width,
		BodyDepthScale = s.BodyDepthScale * g.depth,
		HeadScale = s.HeadScale * g.head,
		BodyTypeScale = s.BodyTypeScale,
		BodyProportionScale = s.BodyProportionScale,
	}
end

function Appearance.setHook(fn)
	onChanged = fn
end

local SCALE_VALUES = { "BodyHeightScale", "BodyWidthScale", "BodyDepthScale", "HeadScale", "BodyTypeScale", "BodyProportionScale" }

-- The head's unscaled ("nominal") size, so accessories fit no matter how big the head currently is.
local function nominalHead(char)
	local head = char and char:FindFirstChild("Head")
	if not head then
		return Vector3.new(2, 1, 1)
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local scaleValue = hum and hum:FindFirstChild("HeadScale")
	local current = (scaleValue and scaleValue:IsA("NumberValue") and scaleValue.Value) or 1
	if current <= 0 then
		current = 1
	end
	return head.Size / current
end

-- Target head size (after the level's scaling). Used to place face features.
function Appearance.headDims(p)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		return nominalHead(p.Character) * Appearance.scalesFor(p).HeadScale
	end
	local head = p.Character and p.Character:FindFirstChild("Head")
	return head and head.Size or Vector3.new(2, 1, 1)
end

-- Target torso size (R15 upper torso is about 2 x 1.6 x 1 before scaling).
function Appearance.torsoDims(p)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		local s = Appearance.scalesFor(p)
		return Vector3.new(2 * s.BodyWidthScale, 1.6 * s.BodyHeightScale, 1 * s.BodyDepthScale)
	end
	local torso = p.Character and p.Character:FindFirstChild("Torso")
	return torso and torso.Size or Vector3.new(2, 2, 1)
end

-- Scale numbers accessories should use for this player (so hats and wings fit the body).
-- Accessories are designed for a head about 2 studs wide.
function Appearance.accessoryScales(p)
	local s = Appearance.scalesFor(p)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		local nominal = nominalHead(p.Character)
		return s.HeadScale * nominal.X / 2, (s.BodyHeightScale + s.BodyWidthScale) / 2
	end
	local scale = p.Character and p.Character:GetScale() or 1
	return scale, scale
end

function Appearance.update(p, instant)
	local profile = Data.get(p)
	local char = p.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not profile or not hum then
		return
	end
	local target = Appearance.scalesFor(p)

	-- Skin tone also improves with every level.
	local colors = char:FindFirstChildOfClass("BodyColors")
	if colors then
		local tone = Genome.skin(Config.SkinTone(profile.Level), Genome.get(p.UserId))
		colors.HeadColor3 = tone
		colors.TorsoColor3 = tone
		colors.LeftArmColor3 = tone
		colors.RightArmColor3 = tone
	end

	if hum.RigType == Enum.HumanoidRigType.R15 then
		for _, name in SCALE_VALUES do
			local value = hum:FindFirstChild(name)
			if value and value:IsA("NumberValue") then
				if instant then
					value.Value = target[name]
				else
					TweenService:Create(value, TweenInfo.new(0.9, Enum.EasingStyle.Quad), { Value = target[name] }):Play()
				end
			end
		end
	else
		-- R6 characters can only be scaled evenly.
		local uniform = (target.BodyHeightScale + target.BodyWidthScale) / 2
		pcall(function()
			char:ScaleTo(uniform)
		end)
	end
	if onChanged then
		onChanged(p)
	end
end

function Appearance.onCharacter(p)
	local char = p.Character
	local hum = char and char:WaitForChild("Humanoid", 5)
	if hum and hum.RigType == Enum.HumanoidRigType.R15 then
		-- Wait for the scale values to exist before setting them.
		for _, name in SCALE_VALUES do
			hum:WaitForChild(name, 3)
		end
	end
	Appearance.update(p, true)
end

return Appearance
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Architecture</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: real-looking buildings. A proper shell with a foundation and entrance step, a tiled floor, walls with
-- real windows (frame, mullions, glass, sill, lintel), a framed doorway with fluted columns and a keystone arch, corner
-- quoins, a stepped cornice with dentils, a parapet, and a ceiling with exposed beams and recessed lights.
local Architecture = {}

local M = Enum.Material
local C3 = Color3.fromRGB
local STONE = C3(196, 192, 184)
local DARKSTONE = C3(150, 146, 140)
local FRAME = C3(52, 54, 62)

local function block(parent, name, size, cf, color, material, extra)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or M.SmoothPlastic
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function cylinder(parent, name, length, diameter, cf, color, material)
	-- an upright cylinder centred at cf
	return block(parent, name, Vector3.new(length, diameter, diameter), cf * CFrame.Angles(0, 0, math.pi / 2), color, material, { Shape = Enum.PartType.Cylinder })
end

-- A window set into a wall: frame, mullion cross, glass, sill and lintel. cf is the window centre, looking out of the wall.
local function window(parent, cf, ww, wh, thick, pal)
	local bar = 0.28
	block(parent, "WindowFrameL", Vector3.new(bar, wh, thick * 0.9), cf * CFrame.new(-ww / 2 + bar / 2, 0, 0), FRAME, M.Metal)
	block(parent, "WindowFrameR", Vector3.new(bar, wh, thick * 0.9), cf * CFrame.new(ww / 2 - bar / 2, 0, 0), FRAME, M.Metal)
	block(parent, "WindowFrameT", Vector3.new(ww, bar, thick * 0.9), cf * CFrame.new(0, wh / 2 - bar / 2, 0), FRAME, M.Metal)
	block(parent, "WindowFrameB", Vector3.new(ww, bar, thick * 0.9), cf * CFrame.new(0, -wh / 2 + bar / 2, 0), FRAME, M.Metal)
	block(parent, "MullionV", Vector3.new(0.16, wh - bar, thick * 0.5), cf, FRAME, M.Metal)
	block(parent, "MullionH", Vector3.new(ww - bar, 0.16, thick * 0.5), cf * CFrame.new(0, wh * 0.12, 0), FRAME, M.Metal)
	block(parent, "Glass", Vector3.new(ww - bar, wh - bar, 0.12), cf, C3(170, 210, 235), M.Glass, { Transparency = 0.5, CanCollide = false })
	block(parent, "Sill", Vector3.new(ww + 0.9, 0.34, thick + 0.8), cf * CFrame.new(0, -wh / 2 - 0.1, -0.35), STONE, M.Concrete)
	block(parent, "Lintel", Vector3.new(ww + 0.9, 0.55, thick + 0.4), cf * CFrame.new(0, wh / 2 + 0.28, -0.2), STONE, M.Concrete)
	block(parent, "Keystone", Vector3.new(0.7, 0.8, thick + 0.55), cf * CFrame.new(0, wh / 2 + 0.34, -0.25), DARKSTONE, M.Concrete)
	-- shutters in the building's accent colour
	for side = -1, 1, 2 do
		block(parent, "Shutter", Vector3.new(0.9, wh, 0.2), cf * CFrame.new(side * (ww / 2 + 0.7), 0, -thick * 0.45), pal.accent, M.Wood, { CanCollide = false })
	end
end

-- A wall along local X with a row of windows. cf is the wall's bottom centre, the outside faces local -Z.
local function wall(parent, cf, length, height, thick, pal, windows, ww, sill, wh)
	local lowH = windows and sill or height
	block(parent, "WallLow", Vector3.new(length, lowH, thick), cf * CFrame.new(0, lowH / 2, 0), pal.wall, pal.wallMat)
	-- a stone base course
	block(parent, "BaseCourse", Vector3.new(length + 0.4, 1.1, thick + 0.4), cf * CFrame.new(0, 0.55, -0.1), DARKSTONE, M.Concrete)
	if not windows then
		return
	end
	local highH = height - sill - wh
	block(parent, "WallHigh", Vector3.new(length, highH, thick), cf * CFrame.new(0, sill + wh + highH / 2, 0), pal.wall, pal.wallMat)
	local edge = -length / 2
	for _, x in windows do
		local pier = (x - ww / 2) - edge
		if pier > 0.05 then
			block(parent, "Pier", Vector3.new(pier, wh, thick), cf * CFrame.new(edge + pier / 2, sill + wh / 2, 0), pal.wall, pal.wallMat)
		end
		edge = x + ww / 2
		window(parent, cf * CFrame.new(x, sill + wh / 2, 0), ww, wh, thick, pal)
	end
	local last = length / 2 - edge
	if last > 0.05 then
		block(parent, "Pier", Vector3.new(last, wh, thick), cf * CFrame.new(edge + last / 2, sill + wh / 2, 0), pal.wall, pal.wallMat)
	end
end

local function column(parent, cf, height, pal)
	block(parent, "ColumnPlinth", Vector3.new(2.6, 0.7, 2.6), cf * CFrame.new(0, 0.35, 0), STONE, M.Concrete)
	block(parent, "ColumnBase", Vector3.new(2.2, 0.5, 2.2), cf * CFrame.new(0, 0.95, 0), DARKSTONE, M.Concrete)
	cylinder(parent, "ColumnShaft", height - 2.2, 1.6, cf * CFrame.new(0, 1.2 + (height - 2.2) / 2, 0), C3(236, 234, 228), M.Marble)
	-- flutes: thin ribs around the shaft
	for i = 1, 8 do
		local a = (i / 8) * math.pi * 2
		block(parent, "Flute", Vector3.new(0.12, height - 2.6, 0.12), cf * CFrame.new(math.cos(a) * 0.82, 1.2 + (height - 2.2) / 2, math.sin(a) * 0.82), C3(214, 212, 206), M.Marble, { CanCollide = false })
	end
	block(parent, "CapitalNeck", Vector3.new(1.9, 0.4, 1.9), cf * CFrame.new(0, height - 0.95, 0), DARKSTONE, M.Concrete)
	block(parent, "Capital", Vector3.new(2.7, 0.5, 2.7), cf * CFrame.new(0, height - 0.55, 0), STONE, M.Concrete)
	block(parent, "CapitalTop", Vector3.new(3.1, 0.35, 3.1), cf * CFrame.new(0, height - 0.15, 0), pal.accent, M.SmoothPlastic)
	for side = -1, 1, 2 do
		local scroll = block(parent, "Scroll", Vector3.new(0.7, 0.7, 0.7), cf * CFrame.new(side * 1.25, height - 0.7, 0), STONE, M.Concrete, { Shape = Enum.PartType.Ball })
		scroll.CanCollide = false
	end
end

-- cf: the building frame (floor top at y = 0.9, entrance toward local -Z). pal: wall, wallMat, accent, floorA, floorB, floorMat, roof.
function Architecture.pavilion(parent, cf, pal)
	local W, D = 32, 30 -- footprint
	local H = 12.3 -- wall height above the floor
	local folder = Instance.new("Folder")
	folder.Name = "Shell"
	folder.Parent = parent
	local floorY = 0.9

	-- foundation, floor slab, tiled floor, entrance step
	block(folder, "Foundation", Vector3.new(W + 3, 0.6, D + 3), cf * CFrame.new(0, 0.1, 0), DARKSTONE, M.Concrete)
	block(folder, "Floor", Vector3.new(W, 0.8, D), cf * CFrame.new(0, 0.5, 0), pal.floorB, pal.floorMat)
	for ix = 0, 7 do
		for iz = 0, 6 do
			if (ix + iz) % 2 == 0 then
				block(folder, "Tile", Vector3.new(W / 8 - 0.05, 0.05, D / 7 - 0.05), cf * CFrame.new(-W / 2 + (ix + 0.5) * W / 8, floorY + 0.03, -D / 2 + (iz + 0.5) * D / 7), pal.floorA, pal.floorMat, { CanCollide = false })
			end
		end
	end
	block(folder, "EntryStep", Vector3.new(15, 0.3, 2.4), cf * CFrame.new(0, 0.6, -D / 2 - 1.6), STONE, M.Concrete)

	-- walls: back (plain), sides (3 windows each), front (two shop windows either side of a wide doorway)
	local backCF = cf * CFrame.new(0, floorY, D / 2 + 0.4) * CFrame.Angles(0, math.pi, 0)
	wall(folder, backCF, W + 1.6, H, 0.9, pal, nil)
	for side = -1, 1, 2 do
		local sideCF = cf * CFrame.new(side * (W / 2 + 0.4), floorY, 0) * CFrame.Angles(0, -side * math.pi / 2, 0)
		wall(folder, sideCF, D, H, 0.9, pal, { -9, 0, 9 }, 5.2, 3.4, 5.2)
	end
	local frontZ = -D / 2 - 0.4
	for side = -1, 1, 2 do
		-- front wall segment beside the doorway, with a big shop window
		local segCF = cf * CFrame.new(side * 11.6, floorY, frontZ)
		wall(folder, segCF, 8.8, H, 0.9, pal, { 0 }, 5.4, 3.0, 5.6)
	end
	-- header above the doorway
	block(folder, "DoorHeader", Vector3.new(14.4, H - 8.6, 0.9), cf * CFrame.new(0, floorY + 8.6 + (H - 8.6) / 2, frontZ), pal.wall, pal.wallMat)
	block(folder, "DoorLintel", Vector3.new(15.2, 0.7, 1.3), cf * CFrame.new(0, floorY + 8.6, frontZ - 0.15), STONE, M.Concrete)
	block(folder, "DoorKeystone", Vector3.new(1.4, 1.3, 1.5), cf * CFrame.new(0, floorY + 8.9, frontZ - 0.2), DARKSTONE, M.Concrete)
	-- door posts and the two fluted columns that frame the entrance
	for side = -1, 1, 2 do
		column(folder, cf * CFrame.new(side * 7.6, floorY, frontZ - 1.2), 11.2, pal)
	end

	-- corner quoins (alternating stone blocks up each outside corner)
	for sx = -1, 1, 2 do
		for _, sz in { -1, 1 } do
			for i = 0, 7 do
				local long = i % 2 == 0
				block(folder, "Quoin", Vector3.new(long and 2.2 or 1.6, 1.4, long and 1.6 or 2.2), cf * CFrame.new(sx * (W / 2 + 0.55), floorY + 1.6 + i * 1.45, sz * (D / 2 + 0.55)), STONE, M.Concrete)
			end
		end
	end

	-- stepped cornice with dentils, then the roof, parapet and ceiling
	block(folder, "CorniceLow", Vector3.new(W + 3.4, 0.45, D + 3.4), cf * CFrame.new(0, floorY + H - 0.1, 0), STONE, M.Concrete)
	block(folder, "CorniceHigh", Vector3.new(W + 4.4, 0.4, D + 4.4), cf * CFrame.new(0, floorY + H + 0.3, 0), DARKSTONE, M.Concrete)
	for i = 0, 15 do
		local t = -W / 2 + (i + 0.5) * W / 16
		block(folder, "Dentil", Vector3.new(0.7, 0.45, 0.7), cf * CFrame.new(t, floorY + H - 0.55, -D / 2 - 1.5), STONE, M.Concrete, { CanCollide = false })
		block(folder, "Dentil", Vector3.new(0.7, 0.45, 0.7), cf * CFrame.new(t, floorY + H - 0.55, D / 2 + 1.5), STONE, M.Concrete, { CanCollide = false })
	end
	-- the roof must not make the camera zoom in: it is not collidable (nobody can reach it anyway)
	block(folder, "Roof", Vector3.new(W + 4.6, 1.4, D + 4.6), cf * CFrame.new(0, floorY + H + 1.2, 0), pal.roof, M.Metal, { CanCollide = false })
	for _, edge in { { 0, -(D + 4.6) / 2, W + 4.6, 0.7 }, { 0, (D + 4.6) / 2, W + 4.6, 0.7 } } do
		block(folder, "Parapet", Vector3.new(edge[3], 0.9, edge[4]), cf * CFrame.new(edge[1], floorY + H + 2.3, edge[2]), STONE, M.Concrete, { CanCollide = false })
	end
	for side = -1, 1, 2 do
		block(folder, "Parapet", Vector3.new(0.7, 0.9, D + 4.6), cf * CFrame.new(side * (W + 4.6) / 2, floorY + H + 2.3, 0), STONE, M.Concrete, { CanCollide = false })
	end
	-- ceiling with exposed beams and recessed lights
	block(folder, "Ceiling", Vector3.new(W, 0.4, D), cf * CFrame.new(0, floorY + H - 0.7, 0), C3(236, 232, 224), M.SmoothPlastic, { CanCollide = false })
	for i = -2, 2 do
		block(folder, "Beam", Vector3.new(0.9, 0.9, D), cf * CFrame.new(i * 7, floorY + H - 1.4, 0), C3(98, 70, 50), M.Wood, { CanCollide = false })
	end
	for _, z in { -8, 0, 8 } do
		for _, x in { -10.5, 0, 10.5 } do
			local panel = block(folder, "CeilingLight", Vector3.new(3.2, 0.12, 3.2), cf * CFrame.new(x, floorY + H - 0.95, z), C3(255, 248, 226), M.SmoothPlastic, { CanCollide = false })
			if (x == 0) or (z == 0) then
				local light = Instance.new("PointLight")
				light.Range = 26
				light.Brightness = 0.7
				light.Color = C3(255, 238, 205)
				light.Parent = panel
			end
		end
	end
	return folder
end

return Architecture
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Aura</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the aura around your character grows with every level. More sparks, then flames, a glowing
-- ring on the ground, a light and finally a halo. Colour follows your looks tier. Everyone can see it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)

local Aura = {}

local TAG = "GlowAuraFx"
local SPARKS = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function clear(char)
	for _, child in char:GetDescendants() do
		if child.Name == TAG then
			child:Destroy()
		end
	end
end

local function emitter(parent, props)
	local e = Instance.new("ParticleEmitter")
	e.Name = TAG
	e.Speed = NumberRange.new(1, 3)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	for k, v in props do
		e[k] = v
	end
	e.Parent = parent
	return e
end

function Aura.apply(p)
	local char = p.Character
	local profile = Data.get(p)
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not profile or not root then
		return
	end
	clear(char)
	local level = profile.Level
	local tier = Config.RankFor(level)
	local color = Config.Ranks[tier].Color
	local bright = color:Lerp(Color3.new(1, 1, 1), 0.35)

	-- Layer 1: sparks that rise around you (always on, denser every level)
	emitter(root, {
		Texture = SPARKS,
		Color = ColorSequence.new(bright, color),
		LightEmission = 0.5,
		Rate = math.min(3 + level * 0.1, 70),
		Lifetime = NumberRange.new(1, 1.6),
		Acceleration = Vector3.new(0, 3, 0),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5 + math.min(level / 100, 2)), NumberSequenceKeypoint.new(1, 0) }),
	})
	-- Layer 2: flames from tier 6 up
	if tier >= 6 then
		emitter(root, {
			Texture = FIRE,
			Color = ColorSequence.new(color, color:Lerp(Color3.new(0, 0, 0), 0.4)),
			LightEmission = 0.7,
			Rate = math.min(4 + (tier - 5) * 2.5, 50),
			Lifetime = NumberRange.new(0.6, 1),
			Speed = NumberRange.new(2, 5),
			SpreadAngle = Vector2.new(25, 25),
			Acceleration = Vector3.new(0, 6, 0),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.5 + tier * 0.1), NumberSequenceKeypoint.new(1, 0) }),
		})
	end
	-- Light that gets brighter with the tier
	local light = Instance.new("PointLight")
	light.Name = TAG
	light.Color = color
	light.Brightness = 0.3 + tier * 0.06
	light.Range = 10 + tier * 0.8
	light.Parent = root
	-- Layer 3: a glowing ring on the ground from tier 10 up
	if tier >= 10 then
		local ring = Instance.new("Part")
		ring.Name = TAG
		ring.Shape = Enum.PartType.Cylinder
		ring.Size = Vector3.new(0.2, 5 + tier * 0.25, 5 + tier * 0.25)
		ring.Color = color
		ring.Material = Enum.Material.SmoothPlastic
		ring.Transparency = 0.55
		ring.CanCollide, ring.CanQuery, ring.CanTouch, ring.Massless = false, false, false, true
		ring.CFrame = root.CFrame * CFrame.new(0, -2.9, 0) * CFrame.Angles(0, 0, math.pi / 2)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = ring
		weld.Parent = ring
		ring.Parent = char
	end
	-- Layer 4: a halo above the head from tier 20 up
	local head = char:FindFirstChild("Head")
	if tier >= 20 and head then
		local halo = Instance.new("Part")
		halo.Name = TAG
		halo.Shape = Enum.PartType.Cylinder
		halo.Size = Vector3.new(0.25, 3.2, 3.2)
		halo.Color = Color3.fromRGB(255, 236, 140)
		halo.Material = Enum.Material.SmoothPlastic
		halo.Transparency = 0.15
		halo.CanCollide, halo.CanQuery, halo.CanTouch, halo.Massless = false, false, false, true
		halo.CFrame = head.CFrame * CFrame.new(0, head.Size.Y * 0.5 + 1.4, 0) * CFrame.Angles(0, 0, math.pi / 2)
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = head
		weld.Part1 = halo
		weld.Parent = halo
		halo.Parent = char
	end
end

return Aura
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">Board</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the "Top Moggers" screen: the highest levels on this server.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local Board = {}

function Board.init(label)
	if not label then
		return
	end
	task.spawn(function()
		while true do
			local list = Players:GetPlayers()
			table.sort(list, function(x, y)
				local lx, ly = x:GetAttribute("Level") or 1, y:GetAttribute("Level") or 1
				if lx ~= ly then
					return lx > ly
				end
				return (x:GetAttribute("GlowScore") or 0) > (y:GetAttribute("GlowScore") or 0)
			end)
			local lines = {}
			for i = 1, math.min(8, #list) do
				local p = list[i]
				local rank = Config.Ranks[p:GetAttribute("Rank") or 1]
				table.insert(lines, string.format("%d.  %s   —   Lv %s   (%s)", i, p.DisplayName, Util.fmt(p:GetAttribute("Level") or 1), rank.Name))
			end
			label.Text = #lines > 0 and table.concat(lines, "\n") or "Nobody here yet."
			task.wait(8)
		end
	end)
end

return Board
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Buildings</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: building unlocks. Every building costs Aura; the price tells you how strong you need to be.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Buildings = {}

function Buildings.owned(p, id)
	local profile = Data.get(p)
	return profile ~= nil and Config.BuildingOwned(profile.Buildings, id)
end

-- Returns true when the player already owns the building (or has just bought it, which uses their press).
function Buildings.unlock(p, id)
	local profile = Data.get(p)
	local def = Config.Buildings[id]
	if not profile or not def or Config.BuildingOwned(profile.Buildings, id) then
		return false
	end
	if not Stats.spend(p, def.Cost) then
		Stats.toast(p, string.format("%s costs %s Aura", def.Name, require(ReplicatedStorage.Shared.Util).fmt(def.Cost)), "bad")
		return false
	end
	profile.Buildings[id] = true
	Stats.recompute(p)
	Stats.send(p, "building", id)
	return true
end

return Buildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">Competition</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the Mog Competition. Every few minutes entries open at the central stage.
-- Everyone who entered flexes (taps) for 8 seconds; the higher your Mog Power and the faster you
-- tap, the higher you place. Bots fill the field so it always feels like a crowd.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Competition = {}

local cfg = Config.Competition
local rng = Random.new()
local stage -- { center = Vector3 }
local board -- TextLabel on the stage screen
local entrants = {} -- Player -> true
local battle -- active battle table
local state = "idle"

function Competition.setStage(info, boardLabel)
	stage = info
	board = boardLabel
end

local function setState(newState, endsAt)
	state = newState
	workspace:SetAttribute("CompState", newState)
	workspace:SetAttribute("CompEnd", endsAt or 0)
end

local function setBoard(text)
	if board then
		board.Text = text
	end
end

local function sayAll(...)
	for _, p in Players:GetPlayers() do
		if p:GetAttribute("Ready") then
			Stats.send(p, ...)
		end
	end
end

local function validEntrant(p)
	return p.Parent ~= nil and p:GetAttribute("Ready") and not p:GetAttribute("InDuel")
end

function Competition.enter(p)
	if state ~= "open" then
		local left = math.max(0, (workspace:GetAttribute("CompEnd") or 0) - workspace:GetServerTimeNow())
		Stats.toast(p, "Entries are closed. Next competition in " .. Util.clock(left), "info")
		return
	end
	if entrants[p] then
		Stats.toast(p, "You're already entered. Stay near the stage!", "info")
		return
	end
	if p:GetAttribute("InDuel") or p:GetAttribute("Training") then
		Stats.toast(p, "Finish what you're doing first", "bad")
		return
	end
	entrants[p] = true
	Stats.toast(p, "You're in the Mog Competition! Stay near the stage", "good")
end

function Competition.taps(p, n)
	if not battle or battle.over or type(n) ~= "number" then
		return
	end
	local entry = battle.byPlayer[p]
	if not entry then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < battle.tStart - 0.1 or now > battle.tEnd + 0.2 then
		return
	end
	local allowed = Config.Duel.MaxTapsPerSecond * math.max(0, now - battle.tStart) + 4
	entry.taps = math.min(entry.taps + math.clamp(math.floor(n), 0, 20), allowed)
end

--------------------------------------------------------------------------------
-- Battle
--------------------------------------------------------------------------------
local function setFrozen(p, frozen)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if frozen then
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
	else
		Stats.applyMovement(p)
	end
end

local function placeOnStage(p, index, count)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if root and stage then
		local x = (index - (count + 1) / 2) * 6
		local pos = stage.center + Vector3.new(x, 3.5, 4)
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(pos, pos + Vector3.new(0, 0, 1))
	end
end

local function ranking(entries, forPlayer)
	local sorted = table.clone(entries)
	table.sort(sorted, function(a, b)
		return a.taps > b.taps
	end)
	local out = {}
	for i = 1, math.min(6, #sorted) do
		out[i] = { n = sorted[i].name, t = sorted[i].taps, m = sorted[i].player == forPlayer }
	end
	return out
end

local function finish(b)
	b.over = true
	local maxTaps = Config.Duel.MaxTapsPerSecond * cfg.Length
	local topScore = 1
	for _, e in b.entries do
		topScore = math.max(topScore, e.score)
	end
	for _, e in b.entries do
		e.points = (math.min(e.taps, maxTaps) / maxTaps) * 40 + (e.score / topScore) * 60
		e.points *= 0.95 + rng:NextNumber() * 0.1
	end
	table.sort(b.entries, function(x, y)
		return x.points > y.points
	end)

	local summary = {}
	for i = 1, math.min(5, #b.entries) do
		summary[i] = { n = b.entries[i].name, p = math.floor(b.entries[i].points + 0.5) }
	end

	for place, e in b.entries do
		local p = e.player
		if p then
			setFrozen(p, false)
			p:SetAttribute("InDuel", false)
			if p.Parent then
				local profile = Data.get(p)
				if profile then
					local multiplier = place == 1 and 3 or place == 2 and 2 or place == 3 and 1.4 or 0.6
					local aura = Stats.addAura(p, (200 + topScore * 0.5) * multiplier)
					local xp = (place == 1 and 400) or (place == 2 and 250) or (place == 3 and 150) or 80
					if place == 1 then
						Stats.addFreeCrates(p, 1)
						profile.Wins += 1
						p:SetAttribute("Wins", profile.Wins)
					end
					Stats.addXP(p, xp)
					Stats.send(p, "compEnd", place, #b.entries, aura, place == 1, summary)
				end
			end
		end
	end
	battle = nil
end

local function runBattle()
	local humans = {}
	for p in entrants do
		if validEntrant(p) then
			table.insert(humans, p)
		end
	end
	entrants = {}
	if #humans == 0 then
		setBoard("No entrants this time.\nNext competition soon!")
		return
	end

	local avgScore = 0
	for _, p in humans do
		avgScore += Stats.score(p)
	end
	avgScore /= #humans

	local entries = {}
	local byPlayer = {}
	for _, p in humans do
		local entry = { player = p, name = p.DisplayName, score = Stats.score(p), taps = 0 }
		table.insert(entries, entry)
		byPlayer[p] = entry
	end
	local botIndex = 0
	while #entries < cfg.MinFieldSize do
		botIndex += 1
		table.insert(entries, {
			name = cfg.BotNames[(botIndex - 1) % #cfg.BotNames + 1],
			score = math.max(20, avgScore * (0.6 + rng:NextNumber() * 0.8)),
			taps = 0,
			rate = 5 + rng:NextNumber() * 5,
		})
	end

	local now = workspace:GetServerTimeNow()
	local b = {
		entries = entries,
		byPlayer = byPlayer,
		tStart = now + cfg.Countdown,
		tEnd = now + cfg.Countdown + cfg.Length,
		over = false,
	}
	battle = b
	setState("battle", b.tEnd)

	for i, p in humans do
		p:SetAttribute("InDuel", true)
		placeOnStage(p, i, #humans)
		setFrozen(p, true)
		local roster = {}
		for _, e in entries do
			table.insert(roster, { n = e.name, s = math.floor(e.score), m = e.player == p })
		end
		Stats.send(p, "compStart", b.tStart, cfg.Length, roster)
	end
	setBoard("MOG COMPETITION\nIN PROGRESS!")

	while workspace:GetServerTimeNow() < b.tEnd + 0.4 do
		task.wait(0.4)
		local t = workspace:GetServerTimeNow()
		for _, e in entries do
			if e.rate and t > b.tStart then
				e.taps = math.floor((math.min(t, b.tEnd) - b.tStart) * e.rate)
			end
		end
		for _, p in humans do
			if p.Parent then
				Stats.send(p, "compProgress", ranking(entries, p))
			end
		end
	end
	finish(b)
	local top = b.entries[1]
	setBoard(string.format("WINNER: %s\n(%d points)", top.name, math.floor(top.points + 0.5)))
	task.wait(8)
end

--------------------------------------------------------------------------------
-- Schedule
--------------------------------------------------------------------------------
function Competition.init()
	task.spawn(function()
		task.wait(20)
		while true do
			-- Waiting for the next one
			local nextAt = workspace:GetServerTimeNow() + cfg.Gap
			setState("idle", nextAt)
			while workspace:GetServerTimeNow() < nextAt do
				setBoard("MOG COMPETITION\nnext in " .. Util.clock(nextAt - workspace:GetServerTimeNow()))
				task.wait(1)
			end

			-- Entries open
			entrants = {}
			local closeAt = workspace:GetServerTimeNow() + cfg.EntryTime
			setState("open", closeAt)
			sayAll("toast", "🏆 MOG COMPETITION is open! Press E at the stage to enter", "gold")
			while workspace:GetServerTimeNow() < closeAt do
				local count = 0
				for _ in entrants do
					count += 1
				end
				setBoard(string.format("ENTRIES OPEN\n%s left  ·  %d entered", Util.clock(closeAt - workspace:GetServerTimeNow()), count))
				task.wait(1)
			end

			runBattle()
		end
	end)
end

function Competition.release(p)
	entrants[p] = nil
	if battle and battle.byPlayer[p] then
		battle.byPlayer[p].player = nil
	end
end

function Competition.handle(p, kind, a)
	if kind == "CompTaps" then
		Competition.taps(p, a)
	end
end

return Competition
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Cosmetics</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the wardrobe. Owns the inventory (with star levels) and builds the glowing
-- accessories players wear. Everything is made from parts and effects, so nothing needs uploading.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Appearance = require(script.Parent.Appearance)

local Cosmetics = {}

local FOLDER = "GlowCosmetics"

--------------------------------------------------------------------------------
-- Inventory
--------------------------------------------------------------------------------
local function writeInventory(p, profile)
	local parts = {}
	for id, stars in profile.Inv do
		table.insert(parts, id .. ":" .. stars)
	end
	table.sort(parts)
	p:SetAttribute("Inv", table.concat(parts, ","))
	for _, slot in Config.Slots do
		p:SetAttribute("Eq_" .. slot, profile.Eq[slot] or "")
	end
end

function Cosmetics.sync(p)
	local profile = Data.get(p)
	if profile then
		writeInventory(p, profile)
	end
end

-- Returns "new", "star" (duplicate levelled up) or "max" (duplicate of a max-star item), plus the stars.
function Cosmetics.grant(p, id)
	local profile = Data.get(p)
	local c = Config.CosmeticById[id]
	if not profile or not c then
		return nil
	end
	local stars = profile.Inv[id]
	local status
	if not stars then
		profile.Inv[id] = 1
		status = "new"
	elseif stars < Config.MaxStars then
		profile.Inv[id] = stars + 1
		status = "star"
	else
		status = "max"
	end
	writeInventory(p, profile)
	Stats.recompute(p)
	return status, profile.Inv[id]
end

function Cosmetics.equip(p, id)
	local profile = Data.get(p)
	local c = Config.CosmeticById[id]
	if not profile or not c or not profile.Inv[id] then
		return
	end
	profile.Eq[c.Slot] = id
	writeInventory(p, profile)
	Stats.recompute(p)
	Cosmetics.apply(p)
end

function Cosmetics.unequip(p, slot)
	local profile = Data.get(p)
	if not profile or not table.find(Config.Slots, slot) then
		return
	end
	profile.Eq[slot] = nil
	writeInventory(p, profile)
	Stats.recompute(p)
	Cosmetics.apply(p)
end

--------------------------------------------------------------------------------
-- Visuals
--------------------------------------------------------------------------------
local function accessoryPart(props)
	local part = Instance.new("Part")
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		part[k] = v
	end
	return part
end

local ctxNow -- the build context currently being used (for size scaling)

-- Positions `part` relative to `base` and welds it there. Accessories scale with the body so
-- a hat still fits a big head and wings still fit a wide back.
local function attach(part, base, offset, folder)
	local s = (ctxNow and base == ctxNow.head) and ctxNow.hs or (ctxNow and ctxNow.bs or 1)
	part.Size = part.Size * s
	local rotation = offset - offset.Position
	part.CFrame = base.CFrame * (CFrame.new(offset.Position * s) * rotation)
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = base
	weld.Part1 = part
	weld.Parent = part
	part.Parent = folder
	return part
end

local function glowMaterial(spec)
	return spec.Glow and Enum.Material.Metal or Enum.Material.SmoothPlastic
end

local function sparkle(parent, color, rate)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(color)
	e.LightEmission = 1
	e.Rate = rate or 12
	e.Lifetime = NumberRange.new(0.6, 1.2)
	e.Speed = NumberRange.new(0.5, 2)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = parent
	return e
end

local function rainbow()
	return ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 140)),
		ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 90)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 255, 160)),
		ColorSequenceKeypoint.new(0.75, Color3.fromRGB(90, 190, 255)),
		ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
	})
end

local builders = {}

function builders.cap(spec, ctx)
	local band = accessoryPart({ Size = Vector3.new(2.15, 0.55, 2.15), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
	attach(band, ctx.head, CFrame.new(0, 0.7, 0), ctx.folder)
	local brim = accessoryPart({ Size = Vector3.new(1.7, 0.15, 1.0), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
	attach(brim, ctx.head, CFrame.new(0, 0.5, -1.2), ctx.folder)
end

function builders.halo(spec, ctx)
	local ring = accessoryPart({
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.14, 2.7, 2.7),
		Color = spec.Color,
		Material = Enum.Material.SmoothPlastic,
	})
	attach(ring, ctx.head, CFrame.new(0, 1.5, 0) * CFrame.Angles(0, 0, math.pi / 2), ctx.folder)
	local light = Instance.new("PointLight")
	light.Color = spec.Color
	light.Range = 10
	light.Brightness = 1.5
	light.Parent = ring
end

function builders.crown(spec, ctx)
	local base = accessoryPart({ Size = Vector3.new(2.1, 0.45, 2.1), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
	attach(base, ctx.head, CFrame.new(0, 0.85, 0), ctx.folder)
	for i = 1, 5 do
		local angle = (i / 5) * math.pi * 2
		local spike = accessoryPart({
			Size = Vector3.new(0.38, 1.0, 0.38),
			Color = spec.Color,
			Material = Enum.Material.SmoothPlastic,
		})
		attach(spike, ctx.head, CFrame.new(math.cos(angle) * 0.85, 1.4, math.sin(angle) * 0.85), ctx.folder)
		if spec.Sparkle and i == 1 then
			sparkle(spike, spec.Color, 14)
		end
	end
end

function builders.horns(spec, ctx)
	for side = -1, 1, 2 do
		local horn = accessoryPart({ Size = Vector3.new(0.4, 1.5, 0.4), Color = spec.Color, Material = Enum.Material.SmoothPlastic })
		attach(horn, ctx.head, CFrame.new(side * 0.75, 1.15, 0) * CFrame.Angles(0, 0, -side * 0.45), ctx.folder)
		if spec.Sparkle then
			sparkle(horn, spec.Color, 16)
		end
	end
end

function builders.cape(spec, ctx)
	local body = accessoryPart({
		Size = Vector3.new(2.0, 3.1, 0.15),
		Color = spec.Color,
		Material = glowMaterial(spec),
	})
	attach(body, ctx.torso, CFrame.new(0, -0.35, 0.78) * CFrame.Angles(0.12, 0, 0), ctx.folder)
	if spec.Glow then
		local edge = accessoryPart({ Size = Vector3.new(2.1, 0.12, 0.2), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic })
		attach(edge, ctx.torso, CFrame.new(0, -1.9, 0.9) * CFrame.Angles(0.12, 0, 0), ctx.folder)
	end
end

function builders.wings(spec, ctx)
	for side = -1, 1, 2 do
		for i = 1, 3 do
			local feather = accessoryPart({
				Size = Vector3.new(0.18, 2.8 - i * 0.55, 1.1),
				Color = spec.Color,
				Material = Enum.Material.SmoothPlastic,
				Transparency = 0.12 * i,
			})
			attach(
				feather,
				ctx.torso,
				CFrame.new(side * (0.9 + i * 0.7), 1.0 - i * 0.35, 0.8)
					* CFrame.Angles(0.15, side * 0.7, side * (0.35 + i * 0.12)),
				ctx.folder
			)
			if spec.Sparkle and i == 3 then
				sparkle(feather, spec.Color, 10)
			end
		end
	end
end

function builders.visor(spec, ctx)
	local bar = accessoryPart({
		Size = Vector3.new(2.05, 0.5, 0.25),
		Color = spec.Color,
		Material = glowMaterial(spec),
		Transparency = spec.Glow and 0.15 or 0,
	})
	attach(bar, ctx.head, CFrame.new(0, 0.15, -0.62), ctx.folder)
	if spec.Sparkle then
		sparkle(bar, spec.Color, 8)
	end
end

function builders.mask(spec, ctx)
	local plate = accessoryPart({ Size = Vector3.new(1.95, 1.1, 0.2), Color = spec.Color, Material = glowMaterial(spec) })
	attach(plate, ctx.head, CFrame.new(0, 0, -0.62), ctx.folder)
	local slit = accessoryPart({ Size = Vector3.new(1.5, 0.18, 0.22), Color = Color3.new(0.05, 0.05, 0.1), Material = Enum.Material.SmoothPlastic })
	attach(slit, ctx.head, CFrame.new(0, 0.15, -0.72), ctx.folder)
end

function builders.aura(spec, ctx)
	local e = Instance.new("ParticleEmitter")
	e.Name = "GlowAura"
	e.Color = spec.Rainbow and rainbow() or ColorSequence.new(spec.Color)
	e.LightEmission = 1
	e.Rate = 28
	e.Lifetime = NumberRange.new(1.2, 2.2)
	e.Speed = NumberRange.new(1, 4)
	e.SpreadAngle = Vector2.new(180, 180)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = ctx.root
	local light = Instance.new("PointLight")
	light.Name = "GlowAuraLight"
	light.Color = spec.Rainbow and Color3.fromRGB(255, 200, 255) or spec.Color
	light.Range = 14
	light.Brightness = 1.2
	light.Parent = ctx.root
end

function builders.trail(spec, ctx)
	local a0 = Instance.new("Attachment")
	a0.Name = "GlowTrailA0"
	a0.Position = Vector3.new(0, 0.9, 0)
	a0.Parent = ctx.root
	local a1 = Instance.new("Attachment")
	a1.Name = "GlowTrailA1"
	a1.Position = Vector3.new(0, -0.9, 0)
	a1.Parent = ctx.root
	local trail = Instance.new("Trail")
	trail.Name = "GlowTrail"
	trail.Attachment0 = a0
	trail.Attachment1 = a1
	trail.Lifetime = 0.8
	trail.LightEmission = 1
	trail.Color = spec.Rainbow and rainbow() or ColorSequence.new(spec.Color, Color3.new(1, 1, 1))
	trail.Transparency = NumberSequence.new(0.1, 1)
	trail.Parent = ctx.root
end

local function clear(char)
	local old = char:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end
	local root = char:FindFirstChild("HumanoidRootPart")
	if root then
		for _, child in root:GetChildren() do
			if string.sub(child.Name, 1, 4) == "Glow" then
				child:Destroy()
			end
		end
	end
end

-- Rebuilds everything the player is wearing.
function Cosmetics.apply(p)
	local char = p.Character
	local profile = Data.get(p)
	if not char or not profile then
		return
	end
	local head = char:FindFirstChild("Head")
	local root = char:FindFirstChild("HumanoidRootPart")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not head or not root or not torso then
		return
	end
	clear(char)
	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	folder.Parent = char
	local hs, bs = Appearance.accessoryScales(p)
	local ctx = { head = head, root = root, torso = torso, folder = folder, hs = hs, bs = bs }
	ctxNow = ctx
	for _, slot in Config.Slots do
		local id = profile.Eq[slot]
		local c = id and Config.CosmeticById[id]
		if c then
			local build = builders[c.Build.Kind]
			if build then
				local ok, err = pcall(build, c.Build, ctx)
				if not ok then
					warn("[TrueAdam] cosmetic failed:", id, err)
				end
			end
		end
	end
end

function Cosmetics.onCharacter(p)
	Cosmetics.sync(p)
	Cosmetics.apply(p)
end

function Cosmetics.handle(p, kind, a, b)
	if kind == "Equip" and type(a) == "string" then
		Cosmetics.equip(p, a)
	elseif kind == "Unequip" and type(a) == "string" then
		Cosmetics.unequip(p, a)
	end
end

return Cosmetics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Crates</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: crate opening. The server decides every roll; the client only plays the reveal.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Cosmetics = require(script.Parent.Cosmetics)
local Quests = require(script.Parent.Quests)

local Crates = {}

local rng = Random.new()

local function rollRarity(crate, luck, onlyAtLeast)
	local minOrder = onlyAtLeast and Config.Rarities[onlyAtLeast].Order or 0
	local lowest = math.huge
	for name in crate.Odds do
		lowest = math.min(lowest, Config.Rarities[name].Order)
	end

	local total, weights = 0, {}
	for _, name in Config.RarityOrder do
		local base = crate.Odds[name]
		local order = Config.Rarities[name].Order
		if base and order >= minOrder then
			-- Luck boosts every drop above the crate's lowest tier.
			local w = order == lowest and base or base * luck
			weights[name] = w
			total += w
		end
	end

	local roll = rng:NextNumber() * total
	for _, name in Config.RarityOrder do
		local w = weights[name]
		if w then
			roll -= w
			if roll <= 0 then
				return name
			end
		end
	end
	return onlyAtLeast or Config.RarityOrder[1]
end

function Crates.open(p, crateId)
	local crate = Config.CrateById[crateId]
	local profile = Data.get(p)
	if not crate or not profile then
		return
	end

	if crateId == "street" and profile.FreeCrates > 0 then
		profile.FreeCrates -= 1
		p:SetAttribute("FreeCrates", profile.FreeCrates)
	elseif not Config.BuildingOwned(profile.Buildings, "crates") then
		Stats.toast(p, "Unlock the Crate Shop (walk up to it) to buy crates", "bad")
		return
	elseif not Stats.spend(p, crate.Cost) then
		Stats.toast(p, "Not enough Aura for a " .. crate.Name, "bad")
		return
	end

	local luck = Config.LuckMult(profile.Levels.Luck or 0)
	local pity = profile.Pity[crateId] or 0
	local forced = crate.PityAfter and pity + 1 >= crate.PityAfter
	local rarity = rollRarity(crate, luck, forced and crate.PityMin or nil)

	if crate.PityMin then
		if Config.Rarities[rarity].Order >= Config.Rarities[crate.PityMin].Order then
			profile.Pity[crateId] = 0
		else
			profile.Pity[crateId] = pity + 1
		end
	end

	if crate.PityAfter then
		p:SetAttribute("Pity_" .. crateId, profile.Pity[crateId] or 0)
	end

	local pool = Config.CosmeticsByRarity[rarity]
	local pick = pool[rng:NextInteger(1, #pool)]
	local status, stars = Cosmetics.grant(p, pick.Id)

	local refund = 0
	if status == "max" then
		refund = math.floor(crate.Cost * 0.3)
		Stats.addAura(p, refund, { raw = true })
	end

	profile.CratesOpened += 1
	Stats.addXP(p, 8)
	Quests.progress(p, "crate", 1)
	Stats.send(p, "crate", crateId, pick.Id, status, stars, refund)
end

return Crates
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Daily</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: 7-day login streak. Missing a day restarts the cycle.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Daily = {}

local function today()
	return os.time() // 86400
end

local function nextDay(profile)
	local d = profile.Daily
	if d.Last >= today() - 1 then
		return d.Streak % #Config.Daily + 1
	end
	return 1
end

function Daily.refresh(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	p:SetAttribute("DailyReady", profile.Daily.Last < today())
	p:SetAttribute("DailyDay", nextDay(profile))
	p:SetAttribute("DailyStreak", profile.Daily.Streak)
end

function Daily.claim(p)
	local profile = Data.get(p)
	if not profile or profile.Daily.Last >= today() then
		return
	end
	local day = nextDay(profile)
	local reward = Config.Daily[day]
	local aura = reward.Aura * (1 + profile.Rebirths)
	profile.Daily.Streak = profile.Daily.Last == today() - 1 and profile.Daily.Streak + 1 or 1
	profile.Daily.Last = today()
	Stats.addAura(p, aura, { raw = true })
	if reward.Crates then
		Stats.addFreeCrates(p, reward.Crates)
	end
	Daily.refresh(p)
	Stats.send(p, "daily", day, aura, reward.Crates or 0)
end

return Daily
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Data</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: player save data. Loads/saves with DataStores when available; the game also runs
-- fine in unpublished places (progress just isn't kept).
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local RunService = game:GetService("RunService")

local Data = {}

local profiles = {}
local savable = {}

local storeOk, store = pcall(function()
	return DataStoreService:GetDataStore("SubFiveToTrueAdamV1")
end)
if not storeOk then
	warn("[TrueAdam] Saving disabled (publish the place to enable it).")
	store = nil
end

local function defaults()
	return {
		Aura = 0,
		Level = 1,
		XP = 0,
		Power = 0,
		Style = 0,
		Charm = 0,
		Rebirths = 0,
		Levels = {},
		Inv = {}, -- cosmetic id -> stars
		Eq = {}, -- slot -> cosmetic id
		FreeCrates = 0,
		Wins = 0,
		Duels = 0,
		BestStreak = 0,
		Reps = 0,
		Swings = 0,
		GuideSeen = false, -- the welcome guide has been shown
		Buildings = {}, -- building id -> true once unlocked
		Treads = { ["1"] = true }, -- treadmills unlocked
		Passes = {}, -- game pass id -> true
		Tut = 1, -- tutorial step (7 = finished or skipped)
		Stage = 0, -- stage battles cleared
		Pets = {}, -- pet id -> copies owned
		PetsEq = {}, -- list of equipped pet ids
		Hatched = 0,
		Hammer = 1,
		HammersOwned = { ["1"] = true },
		Perfects = 0,
		CratesOpened = 0,
		Pity = { neon = 0, icon = 0 },
		QuestsDone = 0,
		Quest = nil,
		Daily = { Last = 0, Streak = 0 },
		Settings = { Music = true, Sfx = true, Duels = true, Fx = true, Voice = true },
		LastSeen = nil,
	}
end

-- Fills in anything missing so old saves keep working after updates.
local function reconcile(target, template)
	for k, v in template do
		if target[k] == nil then
			target[k] = type(v) == "table" and table.clone(v) or v
		elseif type(v) == "table" and type(target[k]) == "table" then
			reconcile(target[k], v)
		end
	end
end

function Data.load(p)
	local data
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("u" .. p.UserId)
		end)
		if ok then
			savable[p] = true
			data = result
		else
			warn("[TrueAdam] load failed (saving off for this session):", result)
		end
	end
	data = type(data) == "table" and data or {}
	reconcile(data, defaults())
	profiles[p] = data
	return data
end

function Data.get(p)
	return profiles[p]
end

function Data.save(p)
	local profile = profiles[p]
	if not store or not profile or not savable[p] then
		return
	end
	profile.LastSeen = os.time()
	local ok, err = pcall(function()
		store:SetAsync("u" .. p.UserId, profile)
	end)
	if not ok then
		warn("[TrueAdam] save failed:", err)
	end
end

function Data.release(p)
	Data.save(p)
	profiles[p] = nil
	savable[p] = nil
end

function Data.init()
	Players.PlayerRemoving:Connect(Data.release)
	game:BindToClose(function()
		if RunService:IsStudio() then
			return
		end
		for _, p in Players:GetPlayers() do
			task.spawn(Data.save, p)
		end
		task.wait(3)
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, p in Players:GetPlayers() do
				task.spawn(Data.save, p)
			end
		end
	end)
end

return Data
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Decor</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: makes every building feel rich. Each one gets its own colour theme, chimneys that puff coloured
-- smoke, a ground aura ring, accent lights, a chandelier, a patterned floor and hanging banners.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Decor = {}

local M = Enum.Material
local C3 = Color3.fromRGB
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARKS = "rbxasset://textures/particles/sparkles_main.dds"
local DARK = Color3.fromRGB(46, 48, 58)

local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = M.SmoothPlastic
	p.CanCollide = false -- decoration never blocks players (or the camera)
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function block(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or M.SmoothPlastic }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return part(parent, props)
end

local function rainbow()
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)))
	end
	return ColorSequence.new(keys)
end

-- Coloured smoke (and a few sparks) rising from a point. scale 1 = a chimney, 0.4 = a small vent.
-- Pass the string "rainbow" as the colour for a smoke that cycles through every hue.
function Decor.smoke(parent, position, color, scale)
	scale = scale or 1
	local isRainbow = color == "rainbow"
	if isRainbow then
		color = Color3.fromRGB(255, 255, 255)
	end
	local anchor = part(parent, { Name = "SmokeSource", Size = Vector3.one * 0.5, Position = position, Transparency = 1, CanCollide = false, CanQuery = false, CanTouch = false })
	local e = Instance.new("ParticleEmitter")
	e.Name = "Smoke"
	e.Texture = SMOKE
	e.Color = isRainbow and rainbow() or ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.25), color)
	e.LightEmission = 0.35
	e.Rate = 7 + 6 * scale
	e.Lifetime = NumberRange.new(3, 5)
	e.Speed = NumberRange.new(3, 6)
	e.SpreadAngle = Vector2.new(14, 14)
	e.Acceleration = Vector3.new(0, 2, 0)
	e.Rotation = NumberRange.new(0, 360)
	e.RotSpeed = NumberRange.new(-20, 20)
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2 * scale), NumberSequenceKeypoint.new(1, 9 * scale) })
	e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(0.7, 0.75), NumberSequenceKeypoint.new(1, 1) })
	e.Parent = anchor
	local sparks = Instance.new("ParticleEmitter")
	sparks.Name = "Sparks"
	sparks.Texture = SPARKS
	sparks.Color = isRainbow and rainbow() or ColorSequence.new(Color3.new(1, 1, 1), color)
	sparks.LightEmission = 0.7
	sparks.Rate = 3 + 3 * scale
	sparks.Lifetime = NumberRange.new(1.5, 2.5)
	sparks.Speed = NumberRange.new(4, 9)
	sparks.SpreadAngle = Vector2.new(25, 25)
	sparks.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7 * scale), NumberSequenceKeypoint.new(1, 0) })
	sparks.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
	sparks.Parent = anchor
	return anchor
end

local function glowLight(parent, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = parent
end

-- A big flat ring on the ground that tints the area around a building with its aura colour.
function Decor.groundAura(parent, centerPos, radius, color)
	local ring = part(parent, {
		Name = "AuraRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.12, radius * 2, radius * 2),
		CFrame = CFrame.new(centerPos.X, 0.36, centerPos.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Transparency = 0.8,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	})
	return ring
end

-- Two chimneys on the roof, each puffing smoke in the building's colour.
function Decor.chimneys(parent, cf, y, spread, color, z)
	for side = -1, 1, 2 do
		local base = cf * CFrame.new(side * spread, y, z or 4)
		part(parent, { Name = "Chimney", Shape = Enum.PartType.Cylinder, Size = Vector3.new(7, 3.4, 3.4), CFrame = base * CFrame.new(0, 3.5, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = DARK, Material = M.Metal })
		part(parent, { Name = "ChimneyRim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.8, 4, 4), CFrame = base * CFrame.new(0, 7.2, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = color, Material = M.SmoothPlastic })
		Decor.smoke(parent, (base * CFrame.new(0, 8, 0)).Position, color, 1)
	end
end


--------------------------------------------------------------------------------
-- Interior props that make each building feel like what it is
--------------------------------------------------------------------------------
local WOODC = C3(120, 84, 58)

local function gymProps(parent, cf)
	-- rubber floor mat, squat rack, kettlebells, a plate tree and a pull-up frame
	block(parent, "RubberMat", Vector3.new(12, 0.07, 9), cf * CFrame.new(9, 0.95, 5), C3(36, 36, 40), M.Rubber)
	for side = -1, 1, 2 do
		block(parent, "RackUpright", Vector3.new(0.5, 8, 0.5), cf * CFrame.new(9 + side * 2.2, 4.9, 5), C3(50, 52, 60), M.Metal, { CanCollide = true })
		block(parent, "RackFoot", Vector3.new(0.6, 0.4, 4), cf * CFrame.new(9 + side * 2.2, 1.1, 5), C3(50, 52, 60), M.Metal)
	end
	block(parent, "RackTop", Vector3.new(5.2, 0.5, 0.5), cf * CFrame.new(9, 8.9, 5), C3(50, 52, 60), M.Metal)
	block(parent, "SquatBar", Vector3.new(7, 0.3, 0.3), cf * CFrame.new(9, 6.4, 5), C3(210, 214, 222), M.Metal)
	for side = -1, 1, 2 do
		part(parent, { Name = "BarPlate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.4, 2.4), CFrame = cf * CFrame.new(9 + side * 3.1, 6.4, 5) * CFrame.Angles(0, 0, math.pi / 2), Color = C3(30, 30, 34), Material = M.Metal })
	end
	for i = 1, 5 do
		local x, z = -13, -4 + i * 2.2
		part(parent, { Name = "Kettlebell", Shape = Enum.PartType.Ball, Size = Vector3.one * (1.1 + i * 0.12), CFrame = cf * CFrame.new(x, 1.7 + i * 0.05, z), Color = i % 2 == 0 and C3(210, 60, 50) or C3(40, 40, 46), Material = M.Metal })
		part(parent, { Name = "KettlebellHandle", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.18, 0.9, 0.9), CFrame = cf * CFrame.new(x, 2.5 + i * 0.1, z) * CFrame.Angles(0, 0, math.pi / 2), Color = C3(40, 40, 46), Material = M.Metal })
	end
	for i = 1, 4 do
		part(parent, { Name = "WallPlate", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.6 - i * 0.25, 2.6 - i * 0.25), CFrame = cf * CFrame.new(14.6, 3 + i * 1.5, -5) * CFrame.Angles(0, 0, 0), Color = i % 2 == 0 and C3(210, 60, 50) or C3(30, 30, 34), Material = M.Metal })
	end
end

local function studioProps(parent, cf)
	-- wash basins along the side wall, pendant lamps over the barber chairs, a waiting bench
	for i = 1, 2 do
		local z = -3 + i * 5
		block(parent, "BasinCabinet", Vector3.new(2.6, 2.6, 3), cf * CFrame.new(-14.2, 2.2, z), C3(246, 242, 238), M.SmoothPlastic, { CanCollide = true })
		part(parent, { Name = "Basin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.5, 2.2, 2.2), CFrame = cf * CFrame.new(-14.2, 3.6, z) * CFrame.Angles(0, 0, math.pi / 2), Color = C3(236, 240, 246), Material = M.Marble })
		block(parent, "Faucet", Vector3.new(0.2, 1.2, 0.2), cf * CFrame.new(-14.9, 4.4, z), C3(210, 214, 222), M.Metal)
		block(parent, "FaucetSpout", Vector3.new(0.9, 0.18, 0.18), cf * CFrame.new(-14.5, 5, z), C3(210, 214, 222), M.Metal)
	end
	for _, x in { -7, 7 } do
		block(parent, "PendantCord", Vector3.new(0.1, 3.5, 0.1), cf * CFrame.new(x, 10.7, 2), DARK, M.Metal)
		local lamp = part(parent, { Name = "PendantLamp", Shape = Enum.PartType.Ball, Size = Vector3.new(2.4, 1.8, 2.4), CFrame = cf * CFrame.new(x, 8.8, 2), Color = C3(255, 236, 214), Transparency = 0.1 })
		glowLight(lamp, C3(255, 226, 190), 24, 1)
	end
	block(parent, "WaitingBench", Vector3.new(7, 0.6, 2), cf * CFrame.new(11, 1.8, -3), C3(60, 50, 56), M.Leather, { CanCollide = true })
	block(parent, "WaitingBenchBack", Vector3.new(7, 2.2, 0.5), cf * CFrame.new(11, 3, -2.2), C3(60, 50, 56), M.Leather)
	for sx = -1, 1, 2 do
		block(parent, "WaitingBenchLeg", Vector3.new(0.4, 1.4, 1.6), cf * CFrame.new(11 + sx * 3.2, 1.2, -3), DARK, M.Metal)
	end
	-- a rack of products on the back wall
	for row = 1, 3 do
		block(parent, "ProductShelf", Vector3.new(7, 0.25, 1), cf * CFrame.new(-11, 3 + row * 2.2, 13.4), C3(236, 230, 224), M.Marble)
		for i = 1, 6 do
			part(parent, { Name = "Product", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 0.55, 0.55), CFrame = cf * CFrame.new(-13.2 + i * 0.85, 3.7 + row * 2.2, 13.4) * CFrame.Angles(0, 0, math.pi / 2), Color = Color3.fromHSV((i * 0.17 + row * 0.1) % 1, 0.5, 0.95), Material = M.Glass })
		end
	end
end

local function loungeProps(parent, cf)
	-- a stone fireplace with a real fire and a full bookshelf on the back wall, and two armchairs
	local fp = cf * CFrame.new(-10.5, 0.9, 13.5)
	block(parent, "FireplaceStone", Vector3.new(8, 8, 1.8), fp * CFrame.new(0, 4, 0), C3(150, 144, 136), M.Brick, { CanCollide = true })
	block(parent, "FireplaceHole", Vector3.new(4.4, 3.4, 1.9), fp * CFrame.new(0, 2.4, -0.15), C3(24, 20, 20), M.SmoothPlastic)
	block(parent, "Mantel", Vector3.new(9, 0.5, 2.6), fp * CFrame.new(0, 5.6, -0.3), WOODC, M.Wood)
	for i = -1, 1 do
		part(parent, { Name = "Log", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3.4, 0.7, 0.7), CFrame = fp * CFrame.new(i * 0.9, 1.2 + (i == 0 and 0.5 or 0), -0.6) * CFrame.Angles(0, math.pi / 2, 0), Color = C3(80, 52, 34), Material = M.Wood })
	end
	local base = block(parent, "FireBase", Vector3.new(3, 0.4, 1), fp * CFrame.new(0, 1.5, -0.6), C3(255, 140, 40), M.SmoothPlastic, { Transparency = 1 })
	local flame = Instance.new("Fire")
	flame.Color = C3(255, 140, 40)
	flame.SecondaryColor = C3(255, 70, 20)
	flame.Size = 6
	flame.Heat = 8
	flame.Parent = base
	glowLight(base, C3(255, 150, 70), 28, 1.4)
	local shelf = cf * CFrame.new(10.8, 0.9, 13.8)
	block(parent, "BookshelfFrame", Vector3.new(8, 10, 1.4), shelf * CFrame.new(0, 5, 0), WOODC, M.Wood, { CanCollide = true })
	for row = 1, 4 do
		block(parent, "Shelf", Vector3.new(7.6, 0.3, 1.5), shelf * CFrame.new(0, row * 2.1, -0.1), C3(98, 68, 46), M.Wood)
		local rng = Random.new(row * 31)
		local xpos = -3.6
		while xpos < 3.4 do
			local bw = 0.3 + rng:NextNumber() * 0.4
			local bh = 1.2 + rng:NextNumber() * 0.7
			block(parent, "Book", Vector3.new(bw, bh, 0.9), shelf * CFrame.new(xpos + bw / 2, row * 2.1 - 2.1 + 0.15 + bh / 2 + 0.0, -0.35), Color3.fromHSV(rng:NextNumber(), 0.55, 0.8), M.SmoothPlastic)
			xpos += bw + 0.05
		end
	end
	for _, x in { -7, 7 } do
		local chair = cf * CFrame.new(x, 0.9, 1.5) * CFrame.Angles(0, x < 0 and math.rad(40) or math.rad(-40), 0)
		block(parent, "ArmchairSeat", Vector3.new(3.4, 1.2, 3.4), chair * CFrame.new(0, 1.2, 0), C3(176, 76, 84), M.Fabric, { CanCollide = true })
		block(parent, "ArmchairBack", Vector3.new(3.4, 3.2, 0.9), chair * CFrame.new(0, 3, 1.4), C3(160, 66, 74), M.Fabric)
		for side = -1, 1, 2 do
			block(parent, "ArmchairArm", Vector3.new(0.7, 2.2, 3.4), chair * CFrame.new(side * 1.9, 1.9, 0), C3(160, 66, 74), M.Fabric)
		end
	end
end



-- Full interior + exterior treatment for the open pavilions (Gym, Studio, Lounge, Crate Shop).
-- cf is the pavilion frame (floor top at y = 0.9, entrance toward local -Z, roof at y = 14.4).
function Decor.pavilion(parent, id, cf)
	local def = Config.Buildings[id]
	local main, glow = def.Main, def.Glow
	-- chimneys with smoke + aura light on the roof
	Decor.chimneys(parent, cf, 15, 10, glow)
	local lamp = part(parent, { Name = "AuraBeacon", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.6, CFrame = cf * CFrame.new(0, 17, 0), Color = glow, Transparency = 0.15, CanCollide = false })
	glowLight(lamp, glow, 60, 1.4)
	Decor.groundAura(parent, cf.Position, 30, glow)
	-- a floor medallion in the building colours under the chandelier
	for i, r in { 4.4, 3.8, 2.2 } do
		part(parent, { Name = "FloorMedallion", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.06, r * 2, r * 2), CFrame = cf * CFrame.new(0, 0.95 + i * 0.01, 2) * CFrame.Angles(0, 0, math.pi / 2), Color = (i % 2 == 1) and main or main:Lerp(Color3.new(1, 1, 1), 0.7) })
	end
	-- chandelier: a hanging ring of glowing glass balls
	local chand = cf * CFrame.new(0, 10.5, 2)
	block(parent, "ChandelierChain", Vector3.new(0.3, 3.4, 0.3), chand * CFrame.new(0, 2.2, 0), DARK, M.Metal, { CanCollide = false })
	block(parent, "ChandelierRing", Vector3.new(5, 0.4, 5), chand, main, M.Metal, { CanCollide = false, Shape = Enum.PartType.Cylinder })
	for i = 1, 8 do
		local a = (i / 8) * math.pi * 2
		local bulb = part(parent, { Name = "Crystal", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, CFrame = chand * CFrame.new(math.cos(a) * 2.3, -0.7, math.sin(a) * 2.3), Color = glow, Transparency = 0.1, CanCollide = false })
		if i % 4 == 0 then
			glowLight(bulb, glow, 26, 1.1)
		end
	end
	-- hanging banners on the back wall
	for _, x in { -11, 11 } do
		block(parent, "Banner", Vector3.new(3.6, 8, 0.3), cf * CFrame.new(x, 8, 13.2), main, M.Fabric, { CanCollide = false })
		block(parent, "BannerTrim", Vector3.new(3.9, 0.5, 0.4), cf * CFrame.new(x, 12.1, 13.2), glow, M.SmoothPlastic, { CanCollide = false })
		block(parent, "BannerEmblem", Vector3.new(1.8, 1.8, 0.35), cf * CFrame.new(x, 8.5, 13.0) * CFrame.Angles(0, 0, math.pi / 4), glow, M.SmoothPlastic, { CanCollide = false })
	end
	-- a welcome carpet leading in
	block(parent, "Carpet", Vector3.new(6, 0.08, 14), cf * CFrame.new(0, 0.95, -9), main, M.Fabric, { CanCollide = false })
	block(parent, "CarpetTrim", Vector3.new(6.6, 0.07, 14.6), cf * CFrame.new(0, 0.94, -9), glow, M.Fabric, { CanCollide = false })
	Decor.exterior(parent, id, cf)
	if id == "gym" then
		gymProps(parent, cf)
	elseif id == "studio" then
		studioProps(parent, cf)
	elseif id == "lounge" then
		loungeProps(parent, cf)
	end
end

-- Extra exterior detail for the pavilions: roof tiles, gutters, lanterns, flower boxes, a stone path, floor trim.
function Decor.exterior(parent, id, cf)
	local def = Config.Buildings[id]
	local main, glow = def.Main, def.Glow
	local dark = main:Lerp(Color3.new(0, 0, 0), 0.35)
	local rng = Random.new(#id * 977)
	-- roof tiles: rows of alternating shades across the top, with a ridge cap and gutters
	for i = 1, 6 do
		block(parent, "RoofTile", Vector3.new(36, 0.3, 5.2), cf * CFrame.new(0, 15.25, -15 + (i - 1) * 6), i % 2 == 0 and main or dark, M.SmoothPlastic)
	end
	block(parent, "RoofRidge", Vector3.new(37, 0.8, 1.2), cf * CFrame.new(0, 15.7, 0), glow, M.SmoothPlastic, { CanCollide = false })
	-- lanterns hanging from the front pillars
	for side = -1, 1, 2 do
		block(parent, "LanternChain", Vector3.new(0.12, 1.4, 0.12), cf * CFrame.new(side * 7.6, 11.4, -17.0), DARK, M.Metal, { CanCollide = false })
		local lantern = block(parent, "Lantern", Vector3.new(1.1, 1.6, 1.1), cf * CFrame.new(side * 7.6, 9.9, -17.0), glow, M.Glass, { Transparency = 0.25, CanCollide = false })
		glowLight(lantern, glow, 22, 1)
		block(parent, "LanternCap", Vector3.new(1.4, 0.3, 1.4), cf * CFrame.new(side * 7.6, 10.9, -17.0), DARK, M.Metal, { CanCollide = false })
	end
	-- flower boxes beside the entrance
	for side = -1, 1, 2 do
		local box = cf * CFrame.new(side * 12.8, 0.9, -17.2)
		block(parent, "FlowerBox", Vector3.new(5.2, 1.3, 1.8), box * CFrame.new(0, 0.65, 0), C3(120, 82, 56), M.Wood)
		part(parent, { Name = "Bush", Shape = Enum.PartType.Ball, Size = Vector3.new(4.8, 1.2, 1.5), CFrame = box * CFrame.new(0, 1.5, 0), Color = C3(60, 140, 62), Material = M.Grass, CanCollide = false })
		for i = 1, 8 do
			local color = ({ main, glow, Color3.new(1, 1, 1), C3(255, 220, 90) })[rng:NextInteger(1, 4)]
			part(parent, { Name = "Flower", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, CFrame = box * CFrame.new(-2.3 + (i - 1) * 0.65, 2.1 + rng:NextNumber() * 0.2, (rng:NextNumber() - 0.5) * 0.8), Color = color, CanCollide = false })
		end
	end
	-- a stone path leading out from the entrance
	for i = 1, 8 do
		block(parent, "PathStone", Vector3.new(5 + (i % 2), 0.16, 2.8), cf * CFrame.new(((i % 3) - 1) * 0.5, 0.26, -19.5 - i * 3.4), i % 2 == 0 and C3(196, 194, 188) or C3(170, 168, 162), M.Slate, { CanCollide = false })
	end
	-- potted plants in the back corners
	for side = -1, 1, 2 do
		local pot = cf * CFrame.new(side * 12.6, 0.9, 12)
		part(parent, { Name = "Pot", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.8, 2.2, 2.2), CFrame = pot * CFrame.new(0, 0.9, 0) * CFrame.Angles(0, 0, math.pi / 2), Color = C3(176, 104, 72), Material = M.Concrete })
		for i = 1, 5 do
			local a = (i / 5) * math.pi * 2
			part(parent, { Name = "Leaf", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 2.6, 1.4), CFrame = pot * CFrame.new(math.cos(a) * 0.7, 3, math.sin(a) * 0.7) * CFrame.Angles(math.sin(a) * 0.4, 0, math.cos(a) * 0.4), Color = C3(54, 142 + i * 6, 70), Material = M.Grass, CanCollide = false })
		end
	end
end

return Decor
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Duels</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: "mog" duels. Two players (or a player and a bot) face off in a 7-second tap battle.
-- Your Glow Score gives you an edge, but a fast tapper can upset a higher-ranked rival.
-- Losing never costs you anything: you still get a consolation reward.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)

local Duels = {}

local rng = Random.new()
local arena -- { padA = CFrame, padB = CFrame, center = Vector3 }
local battleArena -- same, for the stage-battle lane
local queue = {} -- ordered list of waiting players
local duelOf = {} -- Player -> duel
local lastEnd = {} -- Player -> os.clock() of last duel end

function Duels.setArena(info, battle)
	arena = info
	battleArena = battle
end

local function removeFromQueue(p)
	local i = table.find(queue, p)
	if i then
		table.remove(queue, i)
	end
end

local function canDuel(p, forBattle)
	local profile = Data.get(p)
	if not profile or not (forBattle and battleArena or arena) then
		return false, "Duels aren't ready yet"
	end
	if not forBattle and not profile.Settings.Duels then
		return false, "Turn Duels on in Settings first"
	end
	if duelOf[p] or p:GetAttribute("InDuel") then
		return false, "You're already in a duel"
	end
	if p:GetAttribute("Training") then
		return false, "Finish training first"
	end
	if lastEnd[p] and os.clock() - lastEnd[p] < Config.Duel.Cooldown then
		return false, "Catch your breath for a second"
	end
	return true
end

local function setFrozen(p, frozen)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if frozen then
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
	else
		Stats.applyMovement(p)
	end
end

local function place(p, cf, where)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(cf.Position + Vector3.new(0, 3, 0), where.center + Vector3.new(0, 3, 0))
	end
end

local function effort(taps, myScore, oppScore)
	local maxTaps = Config.Duel.MaxTapsPerSecond * Config.Duel.Length
	local share = myScore / math.max(1, myScore + oppScore)
	return (math.min(taps, maxTaps) / maxTaps) * 50 + share * 50
end

local function finish(duel)
	if duel.over then
		return
	end
	duel.over = true
	local a, b = duel.a, duel.b
	local ta, tb = duel.tapsA, duel.tapsB

	local ea = effort(ta, duel.scoreA, duel.scoreB) * (0.94 + rng:NextNumber() * 0.12)
	local eb = effort(tb, duel.scoreB, duel.scoreA) * (0.94 + rng:NextNumber() * 0.12)
	local aWins = ea >= eb

	local function settle(p, wins, oppScore, myTaps, oppTaps, myEff, oppEff)
		if not p or p.Parent == nil then
			return
		end
		local profile = Data.get(p)
		if not profile then
			return
		end
		duelOf[p] = nil
		lastEnd[p] = os.clock()
		p:SetAttribute("InDuel", false)
		setFrozen(p, false)

		local reward = 60 + oppScore * 0.35
		local stage = duel.stage
		if stage then
			local def = Config.Battle.Stages[stage]
			reward = def.Reward
			local first = wins and stage > (profile.Stage or 0)
			if first then
				profile.Stage = stage
				p:SetAttribute("Stage", stage)
				Stats.addFreeCrates(p, stage % 5 == 0 and 2 or 0)
			else
				reward *= 0.4
			end
			Stats.send(p, "stageResult", stage, wins, first, profile.Stage or 0)
		end
		if wins then
			local streak = (p:GetAttribute("DuelStreak") or 0) + 1
			p:SetAttribute("DuelStreak", streak)
			profile.Wins += 1
			profile.BestStreak = math.max(profile.BestStreak, streak)
			p:SetAttribute("Wins", profile.Wins)
			reward *= 1 + math.min(streak - 1, 10) * 0.1
			Quests.progress(p, "duel", 1)
		else
			p:SetAttribute("DuelStreak", 0)
			reward *= 0.25
		end
		profile.Duels += 1
		Stats.addXP(p, wins and (40 + oppScore * 0.05) or 15)
		reward *= Stats.eventMult("DuelMult")
		local given = Stats.addAura(p, math.max(10, reward))
		Stats.send(p, "duelEnd", wins, given, myTaps, oppTaps, myEff, oppEff, p:GetAttribute("DuelStreak") or 0)
	end

	settle(a, aWins, duel.scoreB, ta, tb, ea, eb)
	settle(b, not aWins, duel.scoreA, tb, ta, eb, ea)
end

local function startDuel(a, b, opts)
	opts = opts or {}
	local where = opts.arena or arena
	removeFromQueue(a)
	if b then
		removeFromQueue(b)
	end
	local cfg = Config.Duel
	local now = workspace:GetServerTimeNow()
	local scoreA = Stats.score(a)
	local scoreB = opts.score or (b and Stats.score(b))
	if not scoreB then
		local streak = a:GetAttribute("DuelStreak") or 0
		scoreB = math.max(20, math.floor(scoreA * (0.75 + rng:NextNumber() * 0.5) * (1 + math.min(streak, 6) * 0.04)))
	end

	local duel = {
		a = a,
		b = b,
		scoreA = scoreA,
		scoreB = scoreB,
		tapsA = 0,
		tapsB = 0,
		tStart = now + cfg.Countdown,
		tEnd = now + cfg.Countdown + cfg.Length,
		botRate = opts.rate or (6 + rng:NextNumber() * 4),
		stage = opts.stage,
		over = false,
	}
	duelOf[a] = duel
	a:SetAttribute("InDuel", true)
	place(a, where.padA, where)
	setFrozen(a, true)
	if b then
		duelOf[b] = duel
		b:SetAttribute("InDuel", true)
		place(b, where.padB, where)
		setFrozen(b, true)
	end

	local function info(p)
		return p and { p.DisplayName, p:GetAttribute("Rank") or 1 } or { opts.name or "Mogger Bot", opts.rank or Config.RankFor(math.max(1, math.floor(scoreB / 10))) }
	end
	local ia, ib = info(a), info(b)
	Stats.send(a, "duelStart", ib[1], ib[2], scoreB, scoreA, duel.tStart, cfg.Length)
	if b then
		Stats.send(b, "duelStart", ia[1], ia[2], scoreA, scoreB, duel.tStart, cfg.Length)
	end

	-- Live progress for both sides (and the bot's simulated taps).
	task.spawn(function()
		while not duel.over do
			task.wait(0.25)
			local t = workspace:GetServerTimeNow()
			if not b and t > duel.tStart then
				local elapsed = math.min(t, duel.tEnd) - duel.tStart
				duel.tapsB = math.floor(elapsed * duel.botRate)
			end
			if a.Parent then
				Stats.send(a, "duelProgress", duel.tapsB)
			end
			if b and b.Parent then
				Stats.send(b, "duelProgress", duel.tapsA)
			end
		end
	end)
	task.delay(cfg.Countdown + cfg.Length + 0.5, function()
		finish(duel)
	end)
end

function Duels.joinQueue(p)
	local ok, why = canDuel(p)
	if not ok then
		if table.find(queue, p) then
			removeFromQueue(p)
			Stats.toast(p, "Left the duel queue", "info")
		else
			Stats.toast(p, why, "bad")
		end
		return
	end
	if table.find(queue, p) then
		removeFromQueue(p)
		Stats.toast(p, "Left the duel queue", "info")
		return
	end
	for _, other in queue do
		if other ~= p and other.Parent and canDuel(other) then
			startDuel(other, p)
			return
		end
	end
	table.insert(queue, p)
	Stats.toast(p, "Searching for a rival... a bot steps in after " .. Config.Duel.QueueBotAfter .. "s", "info")
	task.delay(Config.Duel.QueueBotAfter, function()
		if table.find(queue, p) and p.Parent and canDuel(p) then
			startDuel(p, nil)
		end
	end)
end

-- One of the 15 stage battles. Only the next unbeaten stage (or any earlier one) can be fought.
function Duels.stageFight(p)
	local ok, why = canDuel(p, true)
	if not ok then
		Stats.toast(p, why, "bad")
		return
	end
	local profile = Data.get(p)
	local cleared = profile.Stage or 0
	local stage = math.min(cleared + 1, Config.Battle.Count)
	local def = Config.Battle.Stages[stage]
	startDuel(p, nil, {
		arena = battleArena,
		stage = stage,
		name = "Stage " .. stage .. ": " .. def.Name,
		rank = def.Rank,
		score = def.Power,
		rate = def.Rate,
	})
	if battleArena.setOpponent then
		battleArena.setOpponent(def)
	end
end

function Duels.duelBot(p)
	local ok, why = canDuel(p)
	if not ok then
		Stats.toast(p, why, "bad")
		return
	end
	startDuel(p, nil)
end

function Duels.taps(p, n)
	local duel = duelOf[p]
	if not duel or duel.over or type(n) ~= "number" then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < duel.tStart - 0.1 or now > duel.tEnd + 0.2 then
		return
	end
	local elapsed = math.max(0, now - duel.tStart)
	local allowed = Config.Duel.MaxTapsPerSecond * elapsed + 4
	n = math.clamp(math.floor(n), 0, 20)
	if duel.a == p then
		duel.tapsA = math.min(duel.tapsA + n, allowed)
	else
		duel.tapsB = math.min(duel.tapsB + n, allowed)
	end
end

function Duels.release(p)
	removeFromQueue(p)
	local duel = duelOf[p]
	duelOf[p] = nil
	lastEnd[p] = nil
	if duel and not duel.over then
		-- A player who leaves forfeits; the other side is paid out immediately.
		if duel.a == p then
			duel.tapsA = 0
		else
			duel.tapsB = 0
		end
		finish(duel)
	end
end

function Duels.handle(p, kind, a)
	if kind == "DuelTaps" then
		Duels.taps(p, a)
	end
end

return Duels
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Events</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: a server-wide event every few minutes. Clients read the "Event" attributes on workspace.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Events = {}

local rng = Random.new()

local function tint(color)
	local effect = Lighting:FindFirstChild("GlowTint")
	if effect then
		TweenService:Create(effect, TweenInfo.new(2), { TintColor = color }):Play()
	end
end

local function start(ev)
	workspace:SetAttribute("Event", ev.Id)
	workspace:SetAttribute("EventEnd", workspace:GetServerTimeNow() + ev.Duration)
	tint(ev.Tint)
end

local function finish()
	workspace:SetAttribute("Event", "")
	tint(Color3.new(1, 1, 1))
end

function Events.init()
	workspace:SetAttribute("Event", "")
	task.spawn(function()
		task.wait(45)
		while true do
			local ev = Config.Events[rng:NextInteger(1, #Config.Events)]
			start(ev)
			task.wait(ev.Duration)
			finish()
			task.wait(rng:NextInteger(Config.EventGap[1], Config.EventGap[2]))
		end
	end)
end

return Events
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Hammers</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: click / tap to swing a hammer, plus buying and equipping hammers.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)
local HammerModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HammerModel"))

local Hammers = {}

local lastSwing = {}
local combo = {} -- player -> swings in a row
local frenzyUntil = {} -- player -> os.clock when frenzy ends
local rng = Random.new()

local function setFrenzyEffect(p, on)
	local head = p.Character and p.Character:FindFirstChild("Head")
	if not head then
		return
	end
	local old = head:FindFirstChild("FrenzyFx")
	if old then
		old:Destroy()
	end
	if on then
		local e = Instance.new("ParticleEmitter")
		e.Name = "FrenzyFx"
		e.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		e.Color = ColorSequence.new(Color3.fromRGB(255, 190, 40), Color3.fromRGB(255, 80, 60))
		e.LightEmission = 0.6
		e.Rate = 40
		e.Lifetime = NumberRange.new(0.6, 1.1)
		e.Speed = NumberRange.new(3, 8)
		e.SpreadAngle = Vector2.new(180, 180)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) })
		e.Parent = head
	end
end

function Hammers.current(p)
	local profile = Data.get(p)
	return profile and Config.HammerById[profile.Hammer] or Config.Hammers[1]
end

function Hammers.swing(p)
	local profile = Data.get(p)
	if not profile or p:GetAttribute("Training") or p:GetAttribute("InDuel") then
		return
	end
	local now = os.clock()
	if now - (lastSwing[p] or 0) < Config.SwingInterval * 0.8 then
		return
	end
	local hammer = Hammers.current(p)
	-- Mog Streak: keep swinging without pausing to build up to FRENZY (double Aura).
	local f = Config.Frenzy
	if now - (lastSwing[p] or 0) <= f.Window + Config.SwingInterval then
		combo[p] = (combo[p] or 0) + 1
	else
		combo[p] = 1
	end
	lastSwing[p] = now
	local frenzy = (frenzyUntil[p] or 0) > now
	if not frenzy and combo[p] >= f.Combo then
		frenzy = true
		combo[p] = 0
		frenzyUntil[p] = now + f.Duration
		p:SetAttribute("FrenzyEnd", workspace:GetServerTimeNow() + f.Duration)
		setFrenzyEffect(p, true)
		Stats.send(p, "frenzy", f.Duration)
		task.delay(f.Duration + 0.1, function()
			if (frenzyUntil[p] or 0) <= os.clock() then
				setFrenzyEffect(p, false)
			end
		end)
	end
	p:SetAttribute("SwingCombo", combo[p] or 0)

	-- Variable reward: any swing can crit.
	local c = Config.Crit
	local roll = rng:NextNumber()
	local tag, critMult = nil, 1
	if roll < c.JackpotChance then
		tag, critMult = "jackpot", c.JackpotMult
	elseif roll < c.JackpotChance + c.Chance then
		tag, critMult = "crit", c.Mult
	end
	local gained = Stats.addAura(p, Config.SwingBase(profile.Level) * hammer.Mult * critMult * (frenzy and f.Mult or 1))
	profile.Swings += 1
	p:SetAttribute("Swings", profile.Swings)
	Stats.addXP(p, 0.6)
	Quests.progress(p, "swings", 1)
	Stats.send(p, "swing", gained, tag, frenzy)
end

-- Step on a pedestal and press the button: buys the hammer, or equips it if you own it.
function Hammers.use(p, id)
	local profile = Data.get(p)
	local hammer = Config.HammerById[id]
	if not profile or not hammer then
		return
	end
	local key = tostring(id)
	if not profile.HammersOwned[key] then
		if not Stats.spend(p, hammer.Price) then
			Stats.toast(p, "Not enough Aura for the " .. hammer.Name, "bad")
			return
		end
		profile.HammersOwned[key] = true
		Stats.send(p, "hammer", id, "bought")
	else
		if profile.Hammer == id then
			return
		end
		Stats.send(p, "hammer", id, "equipped")
	end
	profile.Hammer = id
	Stats.recompute(p)
	Hammers.attach(p)
end

-- Puts the equipped hammer in your right hand so everyone can see it.
function Hammers.attach(p)
	local char = p.Character
	local hand = char and (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm") or char:WaitForChild("RightHand", 3))
	if not hand then
		return
	end
	local old = char:FindFirstChild("GlowHammer")
	if old then
		old:Destroy()
	end
	local hammer = Hammers.current(p)
	local model = HammerModel.build(hammer, hand.CFrame, char, { scale = 0.6 })
	model.Name = "GlowHammer"
	local weld = Instance.new("Weld")
	weld.Part0 = hand
	weld.Part1 = model.PrimaryPart
	weld.C0 = CFrame.new(0, -0.35, -0.2) * CFrame.Angles(math.rad(-80), 0, 0)
	weld.Parent = model.PrimaryPart
	for _, child in model:GetChildren() do
		if child ~= model.PrimaryPart and child:IsA("BasePart") then
			local w = Instance.new("WeldConstraint")
			w.Part0 = model.PrimaryPart
			w.Part1 = child
			w.Parent = child
		end
	end
end

function Hammers.release(p)
	lastSwing[p] = nil
	combo[p] = nil
	frenzyUntil[p] = nil
end

return Hammers
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">Island</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the island. A bright voxel (LEGO-style) world: studded green lawns, tan brick paths with gold
-- trim, blocky trees, flowers, bushes and rocks, gold-and-black lamp posts, stone statue busts, and a ring of stepped
-- green-topped cliffs around the whole map with water and small islands beyond. Everything is plain parts, and
-- the studs are the real Roblox stud surface.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))

local Island = {}

local M = Enum.Material
local C3 = Color3.fromRGB

local HALF = 273 -- the flat island is this big in every direction (a multiple of 14 plus half a cell)
local CELL = 14

local GRASS_A, GRASS_B = C3(94, 178, 74), C3(80, 160, 62)
local LEAF_A, LEAF_B = C3(70, 172, 66), C3(52, 140, 56)
local DIRT_A, DIRT_B = C3(158, 96, 58), C3(134, 80, 48)
local TAN_A, TAN_B = C3(238, 216, 164), C3(224, 200, 144)
local GOLD, BLACK = C3(240, 192, 56), C3(30, 32, 40)
local STONE, STONE_D = C3(238, 238, 242), C3(176, 178, 186)
local WOOD = C3(124, 88, 62)

local rng = Random.new(20240)

--------------------------------------------------------------------------------
-- Parts
--------------------------------------------------------------------------------
-- A LEGO-style block: Plastic with real studs on top.
local function brick(parent, name, size, cf, color, studs, extra)
	local p = Instance.new("Part")
	p.Name = name
	p.Anchored = true
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = M.Plastic
	p.TopSurface = studs == false and Enum.SurfaceType.Smooth or Enum.SurfaceType.Studs
	p.BottomSurface = Enum.SurfaceType.Smooth
	if extra then
		for k, v in extra do
			p[k] = v
		end
	end
	p.Parent = parent
	return p
end

local function glass(parent, name, size, cf, color)
	local p = brick(parent, name, size, cf, color, false, { Material = M.Glass, Transparency = 0.25, CanCollide = false })
	return p
end

local function light(part, color, range, brightness)
	local l = Instance.new("PointLight")
	l.Color = color
	l.Range = range
	l.Brightness = brightness
	l.Parent = part
end

--------------------------------------------------------------------------------
-- Where things may NOT be scattered (buildings, paths, stage, spawn, catwalk)
--------------------------------------------------------------------------------
local strips = {} -- radial path segments { a, b } so scenery stays off them

local function distToSegment(px, pz, a, b)
	local dx, dz = b.X - a.X, b.Z - a.Z
	local len2 = dx * dx + dz * dz
	local t = len2 > 0 and math.clamp(((px - a.X) * dx + (pz - a.Z) * dz) / len2, 0, 1) or 0
	local cx, cz = a.X + dx * t, a.Z + dz * t
	return math.sqrt((px - cx) ^ 2 + (pz - cz) ^ 2)
end

local BUSTS = { Vector3.new(-73, 0, -61), Vector3.new(36, 0, -88) }

-- Anything big that is already standing there (everything except the paths).
local function occupied(x: number, z: number, margin: number?)
	local m: number = margin or 0
	if math.abs(x) < 58 + m and math.abs(z) < 58 + m then
		return true -- centre plaza and the stage
	end
	if math.abs(x) < 70 + m and math.abs(z) < 24 + m then
		return true -- stage bleachers
	end
	if math.abs(x) < 70 + m and z > 96 and z < 152 + m then
		return true -- hammer shop and spawn
	end
	local here = Vector3.new(x, 0, z)
	for name in Config.Stations do
		if (Config.StationPos(name) - here).Magnitude < 34 + m then
			return true
		end
	end
	if (Config.BattlePos() - here).Magnitude < 54 + m then
		return true
	end
	if (Config.TreadHallPos() - here).Magnitude < 64 + m then
		return true
	end
	if (Vector3.new(-112, 0, 70) - here).Magnitude < 26 + m then
		return true -- the Top Moggers board
	end
	for _, spot in BUSTS do
		if (spot - here).Magnitude < 14 + m then
			return true
		end
	end
	return false
end

-- Scenery also stays off the paths.
local function blocked(x: number, z: number, margin: number?)
	local m: number = margin or 0
	if math.abs(x) < 17 + m or math.abs(z) < 17 + m then
		return true -- the main cross of paths
	end
	if occupied(x, z, margin) then
		return true
	end
	for _, seg in strips do
		if distToSegment(x, z, seg[1], seg[2]) < 9 + m then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- Scenery pieces
--------------------------------------------------------------------------------
local function voxelTree(parent, pos, scale)
	local s = scale or (0.9 + rng:NextNumber() * 0.7)
	local trunkH = 5 * s
	brick(parent, "Trunk", Vector3.new(1.8 * s, trunkH, 1.8 * s), CFrame.new(pos.X, pos.Y + trunkH / 2, pos.Z), C3(112, 74, 46), false)
	local y = pos.Y + trunkH
	local layers = { { 8.4, 3 }, { 6.2, 3 }, { 3.8, 3 } }
	for i, layer in layers do
		local w, h = layer[1] * s, layer[2] * s
		local color = (i % 2 == 1) and LEAF_A or LEAF_B
		brick(parent, "Leaves", Vector3.new(w, h, w), CFrame.new(pos.X, y + h / 2 - 0.4 * s, pos.Z), color, true, { CanCollide = false })
		y += h - 0.4 * s
	end
	-- a couple of loose cubes make the crown look less perfect
	for _ = 1, 2 do
		local ox, oz = (rng:NextNumber() - 0.5) * 7 * s, (rng:NextNumber() - 0.5) * 7 * s
		brick(parent, "Leaves", Vector3.new(2.4 * s, 2.4 * s, 2.4 * s), CFrame.new(pos.X + ox, pos.Y + trunkH + 1.2 * s, pos.Z + oz), LEAF_B, true, { CanCollide = false })
	end
end

local FLOWER_COLORS = { C3(255, 255, 255), C3(255, 226, 90), C3(255, 150, 190), C3(150, 200, 255) }

local function flowers(parent, pos)
	local n = rng:NextInteger(4, 8)
	for _ = 1, n do
		local ox, oz = (rng:NextNumber() - 0.5) * 6, (rng:NextNumber() - 0.5) * 6
		local h = 1 + rng:NextNumber() * 0.8
		brick(parent, "Stem", Vector3.new(0.25, h, 0.25), CFrame.new(pos.X + ox, pos.Y + h / 2, pos.Z + oz), C3(60, 140, 60), false, { CanCollide = false })
		local petal = FLOWER_COLORS[rng:NextInteger(1, #FLOWER_COLORS)]
		brick(parent, "Petals", Vector3.new(1, 0.45, 1), CFrame.new(pos.X + ox, pos.Y + h + 0.2, pos.Z + oz), petal, false, { CanCollide = false })
		brick(parent, "FlowerHeart", Vector3.new(0.4, 0.3, 0.4), CFrame.new(pos.X + ox, pos.Y + h + 0.5, pos.Z + oz), C3(255, 190, 40), false, { CanCollide = false })
	end
end

local function bush(parent, pos)
	local w = 2.6 + rng:NextNumber() * 1.4
	brick(parent, "Bush", Vector3.new(w, w * 0.8, w), CFrame.new(pos.X, pos.Y + w * 0.4, pos.Z), LEAF_B, true)
	brick(parent, "Bush", Vector3.new(w * 0.7, w * 0.6, w * 0.7), CFrame.new(pos.X + w * 0.6, pos.Y + w * 0.3, pos.Z + w * 0.2), LEAF_A, true, { CanCollide = false })
	for _ = 1, 3 do
		brick(parent, "BushFlower", Vector3.new(0.6, 0.4, 0.6), CFrame.new(pos.X + (rng:NextNumber() - 0.5) * w * 0.7, pos.Y + w * 0.82, pos.Z + (rng:NextNumber() - 0.5) * w * 0.7), C3(255, 255, 255), false, { CanCollide = false })
	end
end

local function rock(parent, pos)
	local w = 2.4 + rng:NextNumber() * 1.6
	brick(parent, "Rock", Vector3.new(w, w * 0.7, w * 1.1), CFrame.new(pos.X, pos.Y + w * 0.35, pos.Z), C3(150, 152, 160), true)
	brick(parent, "Rock", Vector3.new(w * 0.65, w * 0.6, w * 0.65), CFrame.new(pos.X + w * 0.2, pos.Y + w * 0.95, pos.Z), C3(170, 172, 180), true, { CanCollide = false })
	brick(parent, "Rock", Vector3.new(w * 0.5, w * 0.5, w * 0.5), CFrame.new(pos.X - w * 0.7, pos.Y + w * 0.25, pos.Z + w * 0.4), C3(130, 132, 140), true, { CanCollide = false })
end

-- A tall gold-and-black lamp post with a glowing lantern.
local function lamp(parent, pos, lit)
	brick(parent, "LampBase", Vector3.new(2.4, 1.4, 2.4), CFrame.new(pos.X, pos.Y + 0.7, pos.Z), GOLD, true)
	brick(parent, "LampBaseTop", Vector3.new(1.6, 0.6, 1.6), CFrame.new(pos.X, pos.Y + 1.7, pos.Z), BLACK, false)
	brick(parent, "LampPole", Vector3.new(0.55, 9, 0.55), CFrame.new(pos.X, pos.Y + 6.2, pos.Z), BLACK, false)
	brick(parent, "LampCollar", Vector3.new(1.2, 0.5, 1.2), CFrame.new(pos.X, pos.Y + 10.5, pos.Z), GOLD, false)
	local lantern = glass(parent, "Lantern", Vector3.new(1.7, 2.4, 1.7), CFrame.new(pos.X, pos.Y + 12, pos.Z), C3(255, 236, 170))
	brick(parent, "LampCap", Vector3.new(2.3, 0.6, 2.3), CFrame.new(pos.X, pos.Y + 13.5, pos.Z), BLACK, false)
	brick(parent, "LampFinial", Vector3.new(0.8, 0.8, 0.8), CFrame.new(pos.X, pos.Y + 14.2, pos.Z), GOLD, false)
	if lit then
		light(lantern, C3(255, 226, 160), 30, 0.9)
	end
end

local function bench(parent, cf)
	brick(parent, "BenchSeat", Vector3.new(6, 0.5, 1.8), cf * CFrame.new(0, 1.8, 0), WOOD, true)
	brick(parent, "BenchBack", Vector3.new(6, 1.6, 0.4), cf * CFrame.new(0, 2.8, 0.8), WOOD, false)
	for side = -1, 1, 2 do
		brick(parent, "BenchLeg", Vector3.new(0.5, 1.8, 1.7), cf * CFrame.new(side * 2.5, 0.9, 0), BLACK, false)
	end
end

--------------------------------------------------------------------------------
-- Paths: tan brick with gold edge trim
--------------------------------------------------------------------------------
local function pathBlock(parent, center, length, width, yawCF)
	local cf = yawCF
	brick(parent, "Path", Vector3.new(width, 0.3, length), cf, TAN_A, true)
	-- darker tile bands so the path reads as paving
	local bands = math.floor(length / 10)
	for i = 1, bands do
		if i % 2 == 0 then
			brick(parent, "PathTile", Vector3.new(width - 0.4, 0.34, 4.8), cf * CFrame.new(0, 0, -length / 2 + (i - 0.5) * 10), TAN_B, true, { CanCollide = false })
		end
	end
	for side = -1, 1, 2 do
		brick(parent, "PathTrim", Vector3.new(0.7, 0.4, length), cf * CFrame.new(side * (width / 2 + 0.2), 0.02, 0), GOLD, false, { CanCollide = false })
	end
end

local function strip(parent, a, b, width)
	local mid = (a + b) / 2
	local len = (b - a).Magnitude
	if len < 1 then
		return
	end
	table.insert(strips, { a, b })
	pathBlock(parent, mid, len, width, CFrame.lookAt(Vector3.new(mid.X, 0.15, mid.Z), Vector3.new(b.X, 0.15, b.Z)))
end

--------------------------------------------------------------------------------
-- Statue bust on a black-and-gold pedestal
--------------------------------------------------------------------------------
local function bust(parent, pos, label)
	local cf = CFrame.lookAt(Vector3.new(pos.X, 0, pos.Z), Vector3.new(0, 0, 0))
	brick(parent, "BustPedestal", Vector3.new(16, 5.5, 14), cf * CFrame.new(0, 2.75, 0), BLACK, true)
	for _, y in { 0.35, 5.5 } do
		brick(parent, "BustTrim", Vector3.new(16.8, 0.7, 14.8), cf * CFrame.new(0, y, 0), GOLD, false)
	end
	local top = 5.9
	brick(parent, "BustShoulders", Vector3.new(14, 4.4, 6.6), cf * CFrame.new(0, top + 2.2, 0.4), STONE, true)
	brick(parent, "BustChest", Vector3.new(10, 3, 6.8), cf * CFrame.new(0, top + 5.2, 0.4), STONE_D, true)
	brick(parent, "BustNeck", Vector3.new(4.4, 3, 4.4), cf * CFrame.new(0, top + 7.6, 0), STONE, true)
	brick(parent, "BustHead", Vector3.new(7.4, 8.4, 7), cf * CFrame.new(0, top + 12.2, 0), STONE, true)
	brick(parent, "BustJaw", Vector3.new(6.2, 2.4, 6.6), cf * CFrame.new(0, top + 8.2, -0.5), STONE, false)
	brick(parent, "BustChin", Vector3.new(3.4, 1.6, 1.6), cf * CFrame.new(0, top + 8.4, -3.9), STONE, false)
	brick(parent, "BustNose", Vector3.new(1.4, 3, 1.6), cf * CFrame.new(0, top + 11.8, -4.4), STONE, false)
	brick(parent, "BustBrow", Vector3.new(6.6, 0.9, 1.5), cf * CFrame.new(0, top + 13.7, -3.9), STONE_D, false)
	for side = -1, 1, 2 do
		brick(parent, "BustEye", Vector3.new(1.3, 0.8, 0.4), cf * CFrame.new(side * 1.9, top + 12.8, -3.7), BLACK, false)
		brick(parent, "BustEar", Vector3.new(0.9, 2.2, 1.6), cf * CFrame.new(side * 4.1, top + 12, 0.2), STONE_D, false)
		brick(parent, "BustCheek", Vector3.new(1.6, 1.4, 0.8), cf * CFrame.new(side * 2.4, top + 10.6, -3.7), STONE_D, false)
	end
	brick(parent, "BustMouth", Vector3.new(2.4, 0.4, 0.4), cf * CFrame.new(0, top + 9.6, -3.6), STONE_D, false)
	brick(parent, "BustHair", Vector3.new(7.8, 2.6, 7.4), cf * CFrame.new(0, top + 16.7, 0.1), C3(214, 214, 220), true)
	brick(parent, "BustHairFront", Vector3.new(6.2, 1.2, 1.6), cf * CFrame.new(0, top + 15.6, -3.5), C3(206, 206, 212), true)
	-- gold name plate on the front of the pedestal
	local plate = brick(parent, "BustPlate", Vector3.new(11, 2.4, 0.4), cf * CFrame.new(0, 2.8, -7.1), GOLD, false, { CanCollide = false })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(440, 96)
	gui.Parent = plate
	local text = Instance.new("TextLabel")
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBlack
	text.TextScaled = true
	text.TextColor3 = BLACK
	text.Text = label
	text.Parent = gui
end

--------------------------------------------------------------------------------
-- Stepped green cliffs all around the island, with trees on top
--------------------------------------------------------------------------------
local function cliffs(parent)
	local N = 23 -- cell index of the outermost ring (19 = last cell inside the flat island)
	local count = 0
	for kx = -N, N do
		for kz = -N, N do
			local ring = math.max(math.abs(kx), math.abs(kz)) - 19
			if ring >= 1 then
				local level = ring + (rng:NextNumber() < 0.3 and 1 or 0)
				level = math.min(level, 5)
				local h = level * 8
				local cx, cz = kx * CELL, kz * CELL
				local dirt = ((kx + kz) % 2 == 0) and DIRT_A or DIRT_B
				-- dirt column from below the water up to the cap
				brick(parent, "CliffDirt", Vector3.new(CELL, h + 21, CELL), CFrame.new(cx, (h - 21) / 2, cz), dirt, false)
				-- darker strata bands so the wall reads as layered earth
				for band = 1, level - 1 do
					brick(parent, "CliffStrata", Vector3.new(CELL + 0.1, 0.9, CELL + 0.1), CFrame.new(cx, band * 8 - 0.4, cz), DIRT_B:Lerp(Color3.new(0, 0, 0), 0.15), false, { CanCollide = false })
				end
				-- the green studded cap, slightly wider than the dirt like a lawn lip
				brick(parent, "CliffGrass", Vector3.new(CELL + 0.5, 1.4, CELL + 0.5), CFrame.new(cx, h + 0.7, cz), ((kx * 3 + kz) % 3 == 0) and GRASS_B or GRASS_A, true)
				count += 1
				if ring >= 2 and rng:NextNumber() < 0.28 then
					voxelTree(parent, Vector3.new(cx + (rng:NextNumber() - 0.5) * 6, h + 1.4, cz + (rng:NextNumber() - 0.5) * 6), 0.9 + rng:NextNumber() * 0.6)
				end
			end
		end
	end
	return count
end

-- Small floating islands out in the water, each with a few trees.
local function farIslands(parent)
	for i = 1, 8 do
		local a = (i / 8) * math.pi * 2 + rng:NextNumber() * 0.4
		local r = 470 + rng:NextNumber() * 130
		local x, z = math.cos(a) * r, math.sin(a) * r
		local w = 40 + rng:NextNumber() * 40
		brick(parent, "FarIslandDirt", Vector3.new(w, 12, w), CFrame.new(x, -8, z), DIRT_A, false)
		brick(parent, "FarIslandGrass", Vector3.new(w + 1, 2.5, w + 1), CFrame.new(x, 0.4, z), GRASS_A, true)
		for _ = 1, 3 do
			voxelTree(parent, Vector3.new(x + (rng:NextNumber() - 0.5) * w * 0.6, 1.6, z + (rng:NextNumber() - 0.5) * w * 0.6))
		end
	end
end

--------------------------------------------------------------------------------
-- Build everything
--------------------------------------------------------------------------------
function Island.build(parent)
	local folder = Instance.new("Folder")
	folder.Name = "Island"
	folder.Parent = parent

	-- the lawn and the earth under it
	brick(folder, "IslandDirt", Vector3.new(HALF * 2, 20, HALF * 2), CFrame.new(0, -11, 0), DIRT_A, false)
	brick(folder, "Lawn", Vector3.new(HALF * 2, 1, HALF * 2), CFrame.new(0, -0.5, 0), GRASS_A, true)
	-- lighter and darker squares of lawn, like mown stripes
	for ix = -9, 9 do
		for iz = -9, 9 do
			if (ix + iz) % 2 == 0 and (math.abs(ix) > 1 and math.abs(iz) > 1) then
				brick(folder, "LawnPatch", Vector3.new(28, 0.06, 28), CFrame.new(ix * 28, 0.03, iz * 28), GRASS_B, true, { CanCollide = false })
			end
		end
	end

	-- the main cross of paths and the paths to each building
	local reach = HALF - 4
	pathBlock(folder, Vector3.zero, reach * 2, 20, CFrame.new(0, 0.15, 0))
	pathBlock(folder, Vector3.zero, reach * 2, 20, CFrame.new(0, 0.15, 0) * CFrame.Angles(0, math.pi / 2, 0))
	table.insert(strips, { Vector3.new(-reach, 0, 0), Vector3.new(reach, 0, 0) })
	table.insert(strips, { Vector3.new(0, 0, -reach), Vector3.new(0, 0, reach) })
	for name in Config.Stations do
		local pos, front = Config.StationPos(name), Config.StationFront(name)
		strip(folder, pos.Unit * 56, pos + front * 22, 9)
	end
	strip(folder, Config.BattlePos().Unit * 56, Config.BattlePos() + Config.BattleFront() * 36, 9)
	strip(folder, Config.TreadHallPos().Unit * 56, (Config.TreadHallCF() * CFrame.new(0, 0, -30)).Position, 9)

	-- the central plaza: a big tan square with a gold border and corner pillars
	brick(folder, "Plaza", Vector3.new(104, 0.4, 104), CFrame.new(0, 0.2, 0), TAN_A, true)
	for ix = -3, 3 do
		for iz = -3, 3 do
			if (ix + iz) % 2 == 0 then
				brick(folder, "PlazaTile", Vector3.new(14, 0.45, 14), CFrame.new(ix * 14, 0.22, iz * 14), TAN_B, true, { CanCollide = false })
			end
		end
	end
	for side = -1, 1, 2 do
		brick(folder, "PlazaTrim", Vector3.new(105, 0.5, 1), CFrame.new(0, 0.25, side * 52.5), GOLD, false, { CanCollide = false })
		brick(folder, "PlazaTrim", Vector3.new(1, 0.5, 105), CFrame.new(side * 52.5, 0.25, 0), GOLD, false, { CanCollide = false })
	end
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			brick(folder, "PlazaCorner", Vector3.new(4, 5, 4), CFrame.new(sx * 52.5, 2.5, sz * 52.5), BLACK, true)
			brick(folder, "PlazaCornerCap", Vector3.new(4.8, 0.8, 4.8), CFrame.new(sx * 52.5, 5.4, sz * 52.5), GOLD, false)
			brick(folder, "PlazaCornerCrown", Vector3.new(2, 1.4, 2), CFrame.new(sx * 52.5, 6.5, sz * 52.5), GOLD, true)
		end
	end

	-- lamps and benches along the paths
	for _, dir in { Vector3.new(1, 0, 0), Vector3.new(-1, 0, 0), Vector3.new(0, 0, 1), Vector3.new(0, 0, -1) } do
		local side = Vector3.new(-dir.Z, 0, dir.X)
		for i = 0, 6 do
			local d = 66 + i * 28
			for s = -1, 1, 2 do
				local p = dir * d + side * (13 * s)
				if not occupied(p.X, p.Z, 4) then
					lamp(folder, p + Vector3.new(0, 0.3, 0), i % 2 == 0)
				end
			end
			local bp = dir * (d + 14) + side * 15
			if i % 2 == 1 and not occupied(bp.X, bp.Z, 4) then
				bench(folder, CFrame.lookAt(bp, dir * (d + 14)) + Vector3.new(0, 0.3, 0))
			end
		end
	end

	-- two stone statue busts guarding the plaza
	bust(folder, BUSTS[1], "TRUE ADAM")
	bust(folder, BUSTS[2], "TRUE ADAM+")

	-- scenery on the lawns
	local function place(count, builder, margin, attempts)
		local placed, tries = 0, 0
		while placed < count and tries < attempts do
			tries += 1
			local x = (rng:NextNumber() * 2 - 1) * (HALF - 14)
			local z = (rng:NextNumber() * 2 - 1) * (HALF - 14)
			if not blocked(x, z, margin) then
				placed += 1
				builder(folder, Vector3.new(x, 0, z))
			end
		end
		return placed
	end
	local trees = place(150, voxelTree, 6, 3000)
	place(110, bush, 4, 2000)
	place(170, flowers, 3, 2500)
	place(46, rock, 4, 1500)

	-- stepped green cliffs around everything, water and small islands beyond
	local cells = cliffs(folder)
	farIslands(folder)
	pcall(function()
		workspace.Terrain:FillBlock(CFrame.new(0, -14, 0), Vector3.new(3200, 24, 3200), Enum.Material.Water)
	end)
	-- invisible walls at the edge of the flat island
	for _, w in {
		{ Vector3.new(HALF * 2 + 8, 90, 2), Vector3.new(0, 44, HALF + 1) },
		{ Vector3.new(HALF * 2 + 8, 90, 2), Vector3.new(0, 44, -HALF - 1) },
		{ Vector3.new(2, 90, HALF * 2 + 8), Vector3.new(HALF + 1, 44, 0) },
		{ Vector3.new(2, 90, HALF * 2 + 8), Vector3.new(-HALF - 1, 44, 0) },
	} do
		local wall = brick(folder, "EdgeWall", w[1], CFrame.new(w[2]), C3(255, 255, 255), false, { Transparency = 1, CanQuery = false })
		wall.CanTouch = false
	end
	return { trees = trees, cliffCells = cells }
end

return Island
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Nameplate</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the tag above every player. It says what they are (their looks tier)
-- and their level, so everyone can see who's a Sub 5 and who's a True Adam.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))

local Nameplate = {}

local function build(p, head)
	local old = head:FindFirstChild("GlowPlate")
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "GlowPlate"
	gui.Size = UDim2.fromOffset(320, 66)
	gui.StudsOffset = Vector3.new(0, 3.4, 0)
	gui.AlwaysOnTop = false
	gui.MaxDistance = 110
	gui.LightInfluence = 0
	gui.Parent = head

	local tier = Instance.new("TextLabel")
	tier.Name = "Rank"
	tier.Size = UDim2.new(1, 0, 0, 36)
	tier.BackgroundTransparency = 1
	tier.Font = Enum.Font.GothamBlack
	tier.TextScaled = true
	tier.TextStrokeTransparency = 0
	tier.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	tier.Parent = gui

	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.Position = UDim2.fromOffset(0, 36)
	name.Size = UDim2.new(1, 0, 0, 22)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextSize = 17
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.2
	name.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
	name.Parent = gui
end

local function refresh(p)
	local head = p.Character and p.Character:FindFirstChild("Head")
	local gui = head and head:FindFirstChild("GlowPlate")
	if not gui then
		return
	end
	local rank = Config.Ranks[p:GetAttribute("Rank") or 1]
	local stars = p:GetAttribute("Rebirths") or 0
	gui.Rank.Text = (stars > 0 and ("★" .. stars .. " ") or "") .. rank.Full:upper()
	gui.Rank.TextColor3 = rank.Color
	gui.Name.Text = string.format("%s  ·  Lv %s", p.DisplayName, Util.fmt(p:GetAttribute("Level") or 1))
end

function Nameplate.onCharacter(p)
	local char = p.Character
	local head = char and char:WaitForChild("Head", 5)
	if not head then
		return
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if hum then
		hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
	build(p, head)
	refresh(p)
end

function Nameplate.init(p)
	for _, attr in { "Rank", "Level", "Rebirths" } do
		p:GetAttributeChangedSignal(attr):Connect(function()
			refresh(p)
		end)
	end
end

return Nameplate
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">Pets</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: pets. Hatch eggs, equip up to 3; they follow you around (everyone sees them),
-- add to your Aura multiplier and earn Aura per second. The server decides every roll.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Pets = {}

local rng = Random.new()

--------------------------------------------------------------------------------
-- Rolling
--------------------------------------------------------------------------------
local function rollPet(egg, luck)
	local lowest = math.huge
	for name in egg.Odds do
		lowest = math.min(lowest, Config.Rarities[name].Order)
	end
	local total, weights = 0, {}
	for _, name in Config.RarityOrder do
		local base = egg.Odds[name]
		if base then
			local w = Config.Rarities[name].Order == lowest and base or base * luck
			weights[name] = w
			total += w
		end
	end
	local roll = rng:NextNumber() * total
	local rarity = Config.RarityOrder[1]
	for _, name in Config.RarityOrder do
		local w = weights[name]
		if w then
			roll -= w
			rarity = name
			if roll <= 0 then
				break
			end
		end
	end
	local pool = {}
	for _, pet in Config.Pets do
		if pet.Rarity == rarity then
			table.insert(pool, pet)
		end
	end
	return pool[rng:NextInteger(1, #pool)]
end

function Pets.hatch(p, eggId)
	local egg = Config.EggById[eggId]
	local profile = Data.get(p)
	if not egg or not profile then
		return
	end
	if not Stats.spend(p, egg.Cost) then
		Stats.toast(p, "Not enough Aura for a " .. egg.Name, "bad")
		return
	end
	local pet = rollPet(egg, Config.LuckMult(profile.Levels.Luck or 0))
	local copies = (profile.Pets[pet.Id] or 0) + 1
	profile.Pets[pet.Id] = copies
	profile.Hatched += 1
	-- A new pet goes straight into an empty slot.
	if #profile.PetsEq < Config.PetSlots and not table.find(profile.PetsEq, pet.Id) then
		table.insert(profile.PetsEq, pet.Id)
	end
	Stats.recompute(p)
	Stats.addXP(p, 5)
	Pets.refresh(p)
	Stats.send(p, "hatch", egg.Id, pet.Id, copies)
end

function Pets.equip(p, id)
	local profile = Data.get(p)
	if not profile or not profile.Pets[id] or not Config.PetById[id] then
		return
	end
	if table.find(profile.PetsEq, id) then
		return
	end
	if #profile.PetsEq >= Config.PetSlots then
		Stats.toast(p, "All " .. Config.PetSlots .. " pet slots are full. Unequip one first.", "bad")
		return
	end
	table.insert(profile.PetsEq, id)
	Stats.recompute(p)
	Pets.refresh(p)
end

function Pets.unequip(p, id)
	local profile = Data.get(p)
	local at = profile and table.find(profile.PetsEq, id)
	if not at then
		return
	end
	table.remove(profile.PetsEq, at)
	Stats.recompute(p)
	Pets.refresh(p)
end

-- Equips the strongest pets you own.
function Pets.best(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	local owned = {}
	for id, copies in profile.Pets do
		local pet = Config.PetById[id]
		if pet then
			table.insert(owned, { id = id, power = Config.PetMult(pet, copies) })
		end
	end
	table.sort(owned, function(a, b)
		return a.power > b.power
	end)
	profile.PetsEq = {}
	for i = 1, math.min(Config.PetSlots, #owned) do
		table.insert(profile.PetsEq, owned[i].id)
	end
	Stats.recompute(p)
end

function Pets.handle(p, kind, id)
	if kind == "PetBest" then
		Pets.best(p)
	elseif kind == "Hatch" and type(id) == "string" then
		Pets.hatch(p, id)
	elseif kind == "PetEquip" and type(id) == "string" then
		Pets.equip(p, id)
	elseif kind == "PetUnequip" and type(id) == "string" then
		Pets.unequip(p, id)
	end
end

--------------------------------------------------------------------------------
-- Followers are drawn on every player's own screen (see PetsView on the client), so the server has nothing to build.
--------------------------------------------------------------------------------
function Pets.refresh() end
function Pets.release() end
function Pets.init() end

return Pets
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">Playtime</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: play-time gifts. Stay in the server and gifts arrive on their own (Aura + crates),
-- each one bigger than the last. The HUD shows a countdown to the next one.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Playtime = {}

local sessions = {} -- player -> { joined = os.clock(), claimed = number }

function Playtime.init(p)
	sessions[p] = { joined = os.clock(), claimed = 0 }
	p:SetAttribute("GiftAt", workspace:GetServerTimeNow() + Config.Gifts[1].Time)
	p:SetAttribute("GiftsClaimed", 0)
end

function Playtime.release(p)
	sessions[p] = nil
end

-- Called once a second for every player.
function Playtime.tick(p)
	local session = sessions[p]
	local profile = Data.get(p)
	if not session or not profile then
		return
	end
	local elapsed = os.clock() - session.joined
	local nextGift = Config.Gifts[session.claimed + 1]
	if nextGift and elapsed >= nextGift.Time then
		session.claimed += 1
		p:SetAttribute("GiftsClaimed", session.claimed)
		local aura = Config.GiftAura(profile.Level, nextGift.Size)
		Stats.addAura(p, aura, { raw = true })
		if nextGift.Crates > 0 then
			Stats.addFreeCrates(p, nextGift.Crates)
		end
		local following = Config.Gifts[session.claimed + 1]
		p:SetAttribute("GiftAt", following and (workspace:GetServerTimeNow() + following.Time - elapsed) or 0)
		Stats.send(p, "gift", aura, nextGift.Crates, session.claimed, #Config.Gifts)
	end
end

return Playtime
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: an endless chain of small goals. There is always exactly one active quest.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Quests = {}

local function writeQuest(p, quest)
	p:SetAttribute("QuestKind", quest.Kind)
	p:SetAttribute("QuestGoal", quest.Goal)
	p:SetAttribute("QuestReward", quest.Reward)
	p:SetAttribute("QuestProgress", quest.Progress or 0)
end

local function newQuest(p)
	local profile = Data.get(p)
	local q = Config.MakeQuest(profile.QuestsDone, profile.Rebirths)
	q.Progress = 0
	profile.Quest = q
	writeQuest(p, q)
end

function Quests.init(p)
	local profile = Data.get(p)
	local q = profile.Quest
	if type(q) == "table" and q.Kind and q.Goal and q.Reward then
		writeQuest(p, q)
	else
		newQuest(p)
	end
end

-- absolute = true means "progress is the max value reached" (not used by current quests, kept for flexibility).
function Quests.progress(p, kind, amount, absolute)
	local profile = Data.get(p)
	local q = profile and profile.Quest
	if not q or q.Kind ~= kind then
		return
	end
	q.Progress = absolute and math.max(q.Progress, amount) or q.Progress + amount
	if q.Progress < q.Goal then
		p:SetAttribute("QuestProgress", q.Progress)
		return
	end

	profile.QuestsDone += 1
	Stats.addAura(p, q.Reward, { raw = true })
	Stats.addXP(p, 25 + profile.QuestsDone * 5)
	local bonus = ""
	if profile.QuestsDone % 5 == 0 then
		Stats.addFreeCrates(p, 1)
		bonus = " + free crate"
	end
	Stats.send(p, "quest", Config.QuestText(q.Kind, q.Goal), q.Reward, bonus)
	newQuest(p)
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Quirks</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: faces, hair and muscles. Every player has their own face (see Genome) that starts goofy
-- (cross-eyed, buck teeth, unibrow, hair everywhere, big belly) and sharpens with every level: eyes straighten, brows
-- angle, the jaw and cheekbones appear, hair fades, and muscles grow. Everything is built from simple parts.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Genome = require(ReplicatedStorage.Shared.Genome)
local Face = require(ReplicatedStorage.Shared.Face)
local bit, ball, stick = Face.bit, Face.ball, Face.stick
local Data = require(script.Parent.Data)
local Appearance = require(script.Parent.Appearance)

local Quirks = {}

local FOLDER = "GlowQuirks"

local function setFace(head, visible)
	for _, child in head:GetChildren() do
		if child:IsA("Decal") then
			child.Transparency = visible and 0 or 1
		end
	end
end

-- Finds a body part by its R15 or R6 name.
local function limb(char, r15, r6)
	return char:FindFirstChild(r15) or char:FindFirstChild(r6)
end

--------------------------------------------------------------------------------
-- Muscles: traps, lats (the V-taper), pecs, abs, delts, biceps, forearms, thighs and calves grow with level
--------------------------------------------------------------------------------
local function buildPhysique(char, torso, folder, T, level, w, skin)
	local m = math.clamp((level - 8) / 300, 0, 1)
	if m <= 0.02 then
		return
	end
	local line = skin:Lerp(Color3.new(0, 0, 0), 0.2)
	local light = skin:Lerp(Color3.new(1, 1, 1), 0.06)
	for _, side in { -1, 1 } do
		-- pecs
		stick(ball(Vector3.new(T.X * (0.22 + 0.2 * m), T.Y * (0.14 + 0.12 * m), T.Z * (0.18 + 0.2 * m)), skin), torso, CFrame.new(side * T.X * 0.2, T.Y * 0.2, -T.Z * 0.5), folder)
		-- traps rising to the neck, lats flaring out under the arms (the V-taper)
		stick(ball(Vector3.new(T.X * (0.18 + 0.12 * m), T.Y * (0.14 + 0.12 * m), T.Z * 0.5), skin), torso, CFrame.new(side * T.X * 0.2, T.Y * 0.5, T.Z * 0.05), folder)
		stick(ball(Vector3.new(T.X * (0.12 + 0.2 * m), T.Y * 0.62, T.Z * (0.28 + 0.2 * m)), skin), torso, CFrame.new(side * T.X * 0.5, T.Y * 0.02, T.Z * 0.18), folder)
	end
	stick(bit({ Size = Vector3.new(T.X * 0.03, T.Y * 0.16, T.Z * 0.03), Color = line }), torso, CFrame.new(0, T.Y * 0.2, -T.Z * 0.5), folder)
	-- abs (a six-pack once the belly is gone)
	if w < 0.35 and m > 0.12 then
		for row = 0, 3 do
			for _, side in { -1, 1 } do
				stick(bit({ Size = Vector3.new(T.X * 0.18, T.Y * 0.1, T.Z * 0.06), Color = light }), torso, CFrame.new(side * T.X * 0.105, T.Y * (0.0 - row * 0.115), -T.Z * 0.5), folder)
			end
		end
		stick(bit({ Size = Vector3.new(T.X * 0.025, T.Y * 0.5, T.Z * 0.03), Color = line }), torso, CFrame.new(0, -T.Y * 0.1, -T.Z * 0.5), folder)
	end
	-- arms: delts, biceps, triceps, forearms
	for _, name in { { "LeftUpperArm", "Left Arm", "LeftLowerArm" }, { "RightUpperArm", "Right Arm", "RightLowerArm" } } do
		local arm = limb(char, name[1], name[2])
		if arm then
			stick(ball(arm.Size.X * (1.15 + 1.1 * m), skin), arm, CFrame.new(0, arm.Size.Y * 0.32, 0), folder)
			stick(ball(Vector3.new(arm.Size.X * (0.9 + 0.8 * m), arm.Size.Y * 0.42, arm.Size.Z * (0.9 + 0.9 * m)), skin), arm, CFrame.new(0, -arm.Size.Y * 0.02, -arm.Size.Z * 0.15), folder)
			stick(ball(Vector3.new(arm.Size.X * (0.8 + 0.6 * m), arm.Size.Y * 0.4, arm.Size.Z * (0.8 + 0.6 * m)), skin), arm, CFrame.new(0, -arm.Size.Y * 0.02, arm.Size.Z * 0.2), folder)
		end
		local fore = char:FindFirstChild(name[3])
		if fore then
			stick(ball(Vector3.new(fore.Size.X * (0.95 + 0.5 * m), fore.Size.Y * 0.5, fore.Size.Z * (0.95 + 0.5 * m)), skin), fore, CFrame.new(0, fore.Size.Y * 0.2, 0), folder)
		end
	end
	-- thighs and calves
	for _, name in { { "LeftUpperLeg", "Left Leg", "LeftLowerLeg" }, { "RightUpperLeg", "Right Leg", "RightLowerLeg" } } do
		local leg = limb(char, name[1], name[2])
		if leg and m > 0.2 then
			stick(ball(Vector3.new(leg.Size.X * (0.95 + 0.55 * m), leg.Size.Y * 0.5, leg.Size.Z * (0.95 + 0.55 * m)), skin), leg, CFrame.new(0, leg.Size.Y * 0.1, -leg.Size.Z * 0.05), folder)
		end
		local calf = char:FindFirstChild(name[3])
		if calf and m > 0.25 then
			stick(ball(Vector3.new(calf.Size.X * (0.9 + 0.5 * m), calf.Size.Y * 0.5, calf.Size.Z * (0.9 + 0.5 * m)), skin), calf, CFrame.new(0, calf.Size.Y * 0.15, calf.Size.Z * 0.1), folder)
		end
	end
end

-- Hides the avatar's own hair while our styled hair is on (and brings it back at low levels).
local function setAvatarHair(char, hidden)
	for _, acc in char:GetChildren() do
		if acc:IsA("Accessory") and acc.AccessoryType == Enum.AccessoryType.Hair then
			local handle = acc:FindFirstChild("Handle")
			if handle then
				if hidden then
					if handle:GetAttribute("GlowOrigT") == nil then
						handle:SetAttribute("GlowOrigT", handle.Transparency)
					end
					handle.Transparency = 1
				else
					handle.Transparency = handle:GetAttribute("GlowOrigT") or 0
					handle:SetAttribute("GlowOrigT", nil)
				end
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Entry point: rebuilds everything for the player's current level
--------------------------------------------------------------------------------
function Quirks.apply(p)
	local char = p.Character
	local profile = Data.get(p)
	if not char or not profile then
		return
	end
	local head = char:FindFirstChild("Head")
	local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
	if not head or not torso then
		return
	end
	local old = char:FindFirstChild(FOLDER)
	if old then
		old:Destroy()
	end

	local folder = Instance.new("Folder")
	folder.Name = FOLDER
	folder.Parent = char

	local g = Genome.get(p.UserId)
	local w = Config.Weirdness(profile.Level)
	local T = Appearance.torsoDims(p)
	local dims = Appearance.headDims(p)
	local W, H, D = dims.X, dims.Y, dims.Z
	local skin = head.Color
	local fur = g.hairColor:Lerp(Color3.new(0, 0, 0), 0.35)
	local rng = Random.new(p.UserId) -- same layout every time, so hair doesn't "jump" between levels

	-- Every player gets their own custom face (the default sticker face is hidden).
	setFace(head, false)
	Face.build(head, folder, dims, g, w, skin)
	local styled = profile.Level >= 40
	setAvatarHair(char, styled)
	if styled then
		Face.hair(head, folder, dims, g, profile.Level)
	end

	if w > 0.02 then
		-- Hair all over the face
		for _ = 1, math.ceil(34 * w) do
			local x = (rng:NextNumber() - 0.5) * W * 0.95
			local y = -H * (0.12 + rng:NextNumber() * 0.4)
			local zFront = rng:NextNumber() < 0.7
			local z = zFront and (-D * 0.5) or (-D * 0.3 + rng:NextNumber() * D * 0.4)
			local xSide = zFront and x or ((rng:NextNumber() < 0.5 and -1 or 1) * W * 0.5)
			stick(ball(W * (0.1 + rng:NextNumber() * 0.12), fur), head, CFrame.new(xSide, y, z), folder)
		end
		-- Messy hair on top
		for _ = 1, math.ceil(16 * w) do
			local x = (rng:NextNumber() - 0.5) * W * 0.8
			local z = (rng:NextNumber() - 0.5) * D * 0.8
			local tuft = bit({ Size = Vector3.new(W * 0.08, H * (0.25 + rng:NextNumber() * 0.25), W * 0.08), Color = fur })
			stick(tuft, head, CFrame.new(x, H * 0.55, z) * CFrame.Angles((rng:NextNumber() - 0.5) * 0.9, 0, (rng:NextNumber() - 0.5) * 0.9), folder)
		end
		-- Belly
		local bellySize = math.max(T.X, 2) * 0.85 * (0.3 + 0.7 * w)
		stick(ball(bellySize, skin), torso, CFrame.new(0, -T.Y * 0.35, -T.Z * 0.5 - bellySize * 0.05), folder)
		stick(ball(bellySize * 0.1, Color3.fromRGB(80, 50, 40)), torso, CFrame.new(0, -T.Y * 0.3, -T.Z * 0.5 - bellySize * 0.5), folder)
		-- Hair on the body
		local arms = { limb(char, "LeftUpperArm", "Left Arm"), limb(char, "RightUpperArm", "Right Arm") }
		for i = 1, math.ceil(60 * w) do
			local base, offset
			if i % 3 == 0 and arms[1] then
				base = arms[(i % 2) + 1] or arms[1]
				offset = CFrame.new((rng:NextNumber() < 0.5 and -1 or 1) * 0.55, (rng:NextNumber() - 0.5) * 0.9, (rng:NextNumber() - 0.5) * 0.5)
			else
				base = torso
				local face = rng:NextInteger(1, 3)
				if face == 1 then
					offset = CFrame.new((rng:NextNumber() - 0.5) * T.X * 0.8, T.Y * (0.05 + rng:NextNumber() * 0.4), -T.Z * 0.5)
				elseif face == 2 then
					offset = CFrame.new((rng:NextNumber() - 0.5) * T.X * 0.8, (rng:NextNumber() - 0.5) * T.Y * 0.8, T.Z * 0.5)
				else
					offset = CFrame.new((rng:NextNumber() < 0.5 and -1 or 1) * T.X * 0.5, (rng:NextNumber() - 0.5) * T.Y * 0.8, (rng:NextNumber() - 0.5) * T.Z * 0.7)
				end
			end
			local tuft = bit({ Size = Vector3.new(0.14, 0.5 + rng:NextNumber() * 0.4, 0.14), Color = fur })
			stick(tuft, base, offset * CFrame.Angles((rng:NextNumber() - 0.5) * 1.2, 0, (rng:NextNumber() - 0.5) * 1.2), folder)
		end
	end

	buildPhysique(char, torso, folder, T, profile.Level, w, skin)
end

return Quirks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">Runway</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the runway in the middle of the district. Walk it for a steady Aura trickle that
-- scales with your Glow Score, so a great look pays you just for strutting.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Stats = require(script.Parent.Stats)

local Runway = {}

function Runway.init()
	local halfWidth = Config.Runway.HalfWidth
	task.spawn(function()
		while true do
			task.wait(1)
			for _, p in Players:GetPlayers() do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				local profileReady = p:GetAttribute("Ready")
				if root and profileReady and not p:GetAttribute("InDuel") then
					local pos = root.Position
					local onRunway = math.abs(pos.X) <= halfWidth and pos.Z >= Config.Runway.MinZ and pos.Z <= Config.Runway.MaxZ and pos.Y < 8
					local walking = root.AssemblyLinearVelocity.Magnitude > 4
					p:SetAttribute("OnRunway", onRunway)
					if onRunway and walking then
						local perSecond = math.max(2, Stats.score(p) * Config.Runway.AuraPerScore)
						Stats.addAuraFractional(p, perSecond * Stats.eventMult("RunwayMult"))
						Stats.addXP(p, math.max(0.5, Stats.score(p) * 0.004))
					end
				end
			end
		end
	end)
end

return Runway
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">Shop</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: upgrades and rebirth.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Shop = {}

local upgradeById = {}
for _, def in Config.Upgrades do
	upgradeById[def.Id] = def
end

function Shop.buy(p, id)
	local def = upgradeById[id]
	local profile = Data.get(p)
	if not def or not profile then
		return
	end
	local level = profile.Levels[id] or 0
	if level >= def.Max then
		return
	end
	if not Stats.spend(p, Config.UpgradeCost(def, level)) then
		Stats.toast(p, "Not enough Aura", "bad")
		return
	end
	profile.Levels[id] = level + 1
	p:SetAttribute("Lv_" .. id, level + 1)
	Stats.applyMovement(p)
	Stats.recompute(p)
	Stats.send(p, "upgrade", id, level + 1)
end

function Shop.rebirth(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	if profile.Level < Config.RebirthRequirement(profile.Rebirths) then
		Stats.toast(p, "Reach level " .. Config.RebirthRequirement(profile.Rebirths) .. " to rebirth", "bad")
		return
	end
	profile.Rebirths += 1
	profile.Power, profile.Style, profile.Charm = 0, 0, 0
	profile.Levels = {}
	for _, def in Config.Upgrades do
		p:SetAttribute("Lv_" .. def.Id, 0)
	end
	Stats.setAura(p, 0)
	Stats.addFreeCrates(p, 2)
	Stats.applyMovement(p)
	Stats.recompute(p)
	Stats.send(p, "rebirth", profile.Rebirths)
end

function Shop.handle(p, kind, a)
	if kind == "Buy" and type(a) == "string" then
		Shop.buy(p, a)
	elseif kind == "Rebirth" then
		Shop.rebirth(p)
	end
end

return Shop
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">Stats</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the heart of progression. Owns Aura, stats, Glow Score, rank and the
-- attributes the client reads. Every other system goes through here.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Appearance = require(script.Parent.Appearance)

local Stats = {}

local function notify()
	return ReplicatedStorage:WaitForChild("Net"):WaitForChild("Notify")
end

--------------------------------------------------------------------------------
-- Small helpers
--------------------------------------------------------------------------------
function Stats.toast(p, text, kind)
	notify():FireClient(p, "toast", text, kind or "info")
end

function Stats.send(p, ...)
	notify():FireClient(p, ...)
end

local function currentEvent()
	local id = workspace:GetAttribute("Event")
	return id and id ~= "" and Config.EventById[id] or nil
end

function Stats.eventMult(kind)
	local ev = currentEvent()
	return ev and ev[kind] or 1
end

--------------------------------------------------------------------------------
-- Derived values
--------------------------------------------------------------------------------
function Stats.level(p, id)
	local profile = Data.get(p)
	return profile and profile.Levels[id] or 0
end

-- "Mog Power": what duels and competitions compare. Level, stats and gear all count.
function Stats.computeScore(profile)
	local statTotal = profile.Power + profile.Style + profile.Charm
	local total = statTotal * Config.StatScore + profile.Level * 8
	for slot, id in profile.Eq do
		local c = Config.CosmeticById[id]
		local stars = profile.Inv[id]
		if c and stars then
			total += Config.CosmeticPower(c, stars)
		end
	end
	return math.floor(total * Config.RebirthMult(profile.Rebirths))
end

-- Extra Aura multiplier and Aura/second from equipped pets.
function Stats.petBonus(profile)
	local mult, aps = 0, 0
	for _, id in profile.PetsEq do
		local pet = Config.PetById[id]
		local copies = profile.Pets[id]
		if pet and copies then
			mult += Config.PetMult(pet, copies)
			aps += Config.PetAps(pet, copies)
		end
	end
	return mult, aps
end

-- Game-pass multipliers (2x Aura, 2x XP, VIP bonus).
function Stats.passMult(profile, kind)
	local m = 1
	if kind == "aura" then
		if profile.Passes.x2aura then
			m *= 2
		end
		if profile.Passes.vip then
			m *= 1.25
		end
	elseif kind == "xp" and profile.Passes.x2xp then
		m *= 2
	end
	return m
end

function Stats.computeRate(profile)
	local total = 0
	for slot, id in profile.Eq do
		local c = Config.CosmeticById[id]
		local stars = profile.Inv[id]
		if c and stars then
			total += Config.CosmeticAps(c, stars)
		end
	end
	local _, petAps = Stats.petBonus(profile)
	return (total + petAps) * Config.RebirthMult(profile.Rebirths) * Config.BoostMult(profile.Levels.Boost or 0)
end

function Stats.score(p)
	return p:GetAttribute("GlowScore") or 0
end

--------------------------------------------------------------------------------
-- Attribute mirror (what the client sees)
--------------------------------------------------------------------------------
local function setLeaderstat(p, name, value)
	local ls = p:FindFirstChild("leaderstats")
	local v = ls and ls:FindFirstChild(name)
	if v then
		v.Value = value
	end
end

function Stats.ownedString(profile)
	local ids = {}
	for k in profile.HammersOwned do
		table.insert(ids, tonumber(k))
	end
	table.sort(ids)
	return table.concat(ids, ",")
end

function Stats.recompute(p)
	local profile = Data.get(p)
	if not profile then
		return
	end
	local oldRank = p:GetAttribute("Rank") or 1
	local score = Stats.computeScore(profile)
	local rank = Config.RankFor(profile.Level)

	p:SetAttribute("GlowScore", score)
	p:SetAttribute("AuraRate", Stats.computeRate(profile))
	p:SetAttribute("Rank", rank)
	p:SetAttribute("Level", profile.Level)
	p:SetAttribute("XP", math.floor(profile.XP))
	p:SetAttribute("XPNeeded", Config.XPForLevel(profile.Level))
	p:SetAttribute("Power", math.floor(profile.Power * 10) / 10)
	p:SetAttribute("Style", math.floor(profile.Style * 10) / 10)
	p:SetAttribute("Charm", math.floor(profile.Charm * 10) / 10)
	p:SetAttribute("Rebirths", profile.Rebirths)
	p:SetAttribute("RebirthNeed", Config.RebirthRequirement(profile.Rebirths))
	p:SetAttribute("Hammer", profile.Hammer)
	p:SetAttribute("HammersOwned", Stats.ownedString(profile))
	p:SetAttribute("Swings", profile.Swings)
	local own = {}
	for _, id in Config.BuildingOrder do
		if Config.BuildingOwned(profile.Buildings, id) then
			table.insert(own, id)
		end
	end
	p:SetAttribute("Own", table.concat(own, ","))
	local treads = {}
	for k in profile.Treads do
		table.insert(treads, tonumber(k))
	end
	table.sort(treads)
	p:SetAttribute("Treads", table.concat(treads, ","))
	p:SetAttribute("Stage", profile.Stage)
	local petMult = Stats.petBonus(profile)
	p:SetAttribute("PetMult", petMult)
	p:SetAttribute("PetsEq", table.concat(profile.PetsEq, ","))
	local owned = {}
	for id, n in profile.Pets do
		table.insert(owned, id .. ":" .. n)
	end
	table.sort(owned)
	p:SetAttribute("Pets", table.concat(owned, ","))
	setLeaderstat(p, "Level", profile.Level)
	setLeaderstat(p, "Rebirths", profile.Rebirths)

	if rank > oldRank and p:GetAttribute("Ready") then
		Stats.send(p, "rank", rank)
	end
end

--------------------------------------------------------------------------------
-- XP and levels
--------------------------------------------------------------------------------
-- Your look speeds up levelling: more stats and better gear means more XP from everything.
function Stats.xpMult(p)
	local profile = Data.get(p)
	if not profile then
		return 1
	end
	local power = (profile.Power + profile.Style + profile.Charm) * Config.StatScore
	for _, id in profile.Eq do
		local c = Config.CosmeticById[id]
		local stars = profile.Inv[id]
		if c and stars then
			power += Config.CosmeticPower(c, stars)
		end
	end
	return (1 + power / 120) * Config.RebirthMult(profile.Rebirths) * Stats.passMult(profile, "xp")
end

function Stats.addXP(p, base)
	local profile = Data.get(p)
	if not profile or profile.Level >= Config.MaxLevel then
		return
	end
	profile.XP += base * Stats.xpMult(p)
	local leveled = false
	local needed = Config.XPForLevel(profile.Level)
	while profile.XP >= needed and profile.Level < Config.MaxLevel do
		profile.XP -= needed
		profile.Level += 1
		needed = Config.XPForLevel(profile.Level)
		leveled = true
		local aura = profile.Level * 15 * (1 + profile.Rebirths)
		Stats.addAura(p, aura, { raw = true })
		local crates = profile.Level % 10 == 0 and 1 or 0
		if crates > 0 then
			Stats.addFreeCrates(p, crates)
		end
		if p:GetAttribute("Ready") then
			Stats.send(p, "level", profile.Level, aura, crates)
		end
	end
	if profile.Level >= Config.MaxLevel then
		profile.XP = 0
	end
	Stats.recompute(p)
	if leveled then
		Appearance.update(p)
	end
end

function Stats.init(p)
	local profile = Data.get(p)

	local ls = Instance.new("Folder")
	ls.Name = "leaderstats"
	for _, name in { "Aura", "Level", "Rebirths" } do
		local v = Instance.new("IntValue")
		v.Name = name
		v.Parent = ls
	end
	ls.Parent = p

	p:SetAttribute("Aura", math.floor(profile.Aura))
	setLeaderstat(p, "Aura", math.floor(profile.Aura))
	for _, def in Config.Upgrades do
		p:SetAttribute("Lv_" .. def.Id, profile.Levels[def.Id] or 0)
	end
	p:SetAttribute("FreeCrates", profile.FreeCrates)
	for _, crate in Config.Crates do
		if crate.PityAfter then
			p:SetAttribute("Pity_" .. crate.Id, profile.Pity[crate.Id] or 0)
		end
	end
	p:SetAttribute("Wins", profile.Wins)
	p:SetAttribute("DuelStreak", 0)
	for key, value in profile.Settings do
		p:SetAttribute("Set_" .. key, value)
	end
	Stats.recompute(p)
	p:SetAttribute("Ready", true)
end

--------------------------------------------------------------------------------
-- Aura
--------------------------------------------------------------------------------
function Stats.getAura(p)
	local profile = Data.get(p)
	return profile and profile.Aura or 0
end

local function writeAura(p, profile)
	profile.Aura = math.max(0, profile.Aura)
	local shown = math.floor(profile.Aura)
	p:SetAttribute("Aura", shown)
	setLeaderstat(p, "Aura", shown)
end

-- Adds Aura including every multiplier. opts.raw skips multipliers. Returns the amount given.
function Stats.addAura(p, base, opts)
	local profile = Data.get(p)
	if not profile then
		return 0
	end
	local amount = base
	if not (opts and opts.raw) then
		amount = base
			* Config.RebirthMult(profile.Rebirths)
			* Config.BoostMult(profile.Levels.Boost or 0)
			* Stats.eventMult("AuraMult")
			* (1 + (Stats.petBonus(profile)))
			* Stats.passMult(profile, "aura")
	end
	amount = math.max(0, math.floor(amount + 0.5))
	profile.Aura += amount
	writeAura(p, profile)
	return amount
end

-- Fractional income (runway, idle rate) accumulates here so small amounts aren't lost.
local fractions = {}
function Stats.addAuraFractional(p, base, opts)
	local profile = Data.get(p)
	if not profile then
		return 0
	end
	local amount = base
	if not (opts and opts.raw) then
		amount = base * Config.RebirthMult(profile.Rebirths) * Stats.eventMult("AuraMult")
	end
	local acc = (fractions[p] or 0) + amount
	local whole = math.floor(acc)
	fractions[p] = acc - whole
	if whole > 0 then
		profile.Aura += whole
		writeAura(p, profile)
	end
	return whole
end

function Stats.spend(p, cost)
	local profile = Data.get(p)
	if not profile or profile.Aura < cost then
		return false
	end
	profile.Aura -= cost
	writeAura(p, profile)
	return true
end

function Stats.setAura(p, value)
	local profile = Data.get(p)
	if profile then
		profile.Aura = value
		writeAura(p, profile)
	end
end

function Stats.addStat(p, stat, amount)
	local profile = Data.get(p)
	if not profile or profile[stat] == nil then
		return
	end
	profile[stat] += amount
	Stats.recompute(p)
end

function Stats.addFreeCrates(p, n)
	local profile = Data.get(p)
	profile.FreeCrates += n
	p:SetAttribute("FreeCrates", profile.FreeCrates)
end

function Stats.setSetting(p, key, value)
	local profile = Data.get(p)
	if profile and profile.Settings[key] ~= nil then
		profile.Settings[key] = value and true or false
		p:SetAttribute("Set_" .. key, profile.Settings[key])
	end
end

--------------------------------------------------------------------------------
-- Movement
--------------------------------------------------------------------------------
function Stats.applyMovement(p)
	local profile = Data.get(p)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not profile or not hum then
		return
	end
	hum.WalkSpeed = Config.WalkSpeed(profile.Levels.Boots or 0)
	hum.UseJumpPower = false
	hum.JumpHeight = 7.5
end

function Stats.forget(p)
	fractions[p] = nil
end

return Stats
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">Store</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: real-money store (game passes + Aura packs). Nothing is charged until you paste real ids into
-- Config.Store; offers with id 0 are shown as "coming soon". The server grants everything, never the client.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Store = {}

local passById = {}
for _, pass in Config.Store.Passes do
	passById[pass.PassId] = pass
end
local productById = {}
for _, product in Config.Store.Products do
	productById[product.ProductId] = product
end

local function grantPass(p, pass)
	local profile = Data.get(p)
	if not profile then
		return
	end
	profile.Passes[pass.Id] = true
	p:SetAttribute("Pass_" .. pass.Id, true)
	Stats.recompute(p)
	Stats.toast(p, pass.Name .. " unlocked. Thank you!", "gold")
end

-- Checks which passes the player already owns (call after the profile is loaded).
function Store.init(p)
	local profile = Data.get(p)
	for _, pass in Config.Store.Passes do
		p:SetAttribute("Pass_" .. pass.Id, profile.Passes[pass.Id] == true)
		if pass.PassId ~= 0 then
			task.spawn(function()
				local ok, owns = pcall(function()
					return MarketplaceService:UserOwnsGamePassAsync(p.UserId, pass.PassId)
				end)
				if ok and owns and Data.get(p) then
					grantPass(p, pass)
				end
			end)
		end
	end
end

function Store.start()
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p, passId, purchased)
		local pass = passById[passId]
		if purchased and pass and p.Parent then
			grantPass(p, pass)
		end
	end)
	MarketplaceService.ProcessReceipt = function(info)
		local p = Players:GetPlayerByUserId(info.PlayerId)
		local product = productById[info.ProductId]
		local profile = p and Data.get(p)
		if not p or not product or not profile then
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		Stats.addAura(p, Config.ProductAura(profile.Level, product.Size), { raw = true })
		if product.Crates and product.Crates > 0 then
			Stats.addFreeCrates(p, product.Crates)
		end
		Stats.toast(p, product.Name .. " received!", "gold")
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end
end

return Store
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">Training</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the training minigame. A marker sweeps a bar; hit the zone for stat gains.
-- The server picks the zone, computes where the marker was when you pressed, and grades it,
-- so the result can't be faked from the client.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)
local Quests = require(script.Parent.Quests)

local Training = {}

local rng = Random.new()
local sessions = {} -- Player -> session

local GOOD_WIDTH = 0.26
local PERFECT_WIDTH = 0.09
local REP_TIMEOUT = 5

local function newRep(session)
	session.rep += 1
	session.token += 1
	session.resolved = false
	session.speed = 0.9 + 0.15 * session.rep
	session.center = 0.3 + rng:NextNumber() * 0.4
	session.startedAt = workspace:GetServerTimeNow() + 1.1
	return {
		rep = session.rep,
		reps = Config.TrainReps,
		startedAt = session.startedAt,
		speed = session.speed,
		center = session.center,
		goodWidth = GOOD_WIDTH,
		perfectWidth = PERFECT_WIDTH,
	}
end

local resolve

local function armTimeout(p, session)
	local token = session.token
	task.delay(REP_TIMEOUT + 1.1, function()
		if sessions[p] == session and session.token == token and not session.resolved then
			resolve(p, session, "miss")
		end
	end)
end

resolve = function(p, session, grade)
	if session.resolved then
		return
	end
	session.resolved = true
	local profile = Data.get(p)
	local gain = 0

	if grade == "perfect" then
		session.streak += 1
	elseif grade == "miss" then
		session.streak = 0
	end

	if grade ~= "miss" and profile then
		local base = grade == "perfect" and 2 or 1
		local streakMult = 1 + math.min(session.streak, 5) * 0.1
		gain = base * Config.TrainMult(profile.Levels.Training or 0) * streakMult
		Stats.addStat(p, session.stat, gain)
		Stats.addAura(p, gain * 4 * Config.RankScaling(p:GetAttribute("Rank") or 1))
		Stats.addXP(p, gain * 10)
		profile.Reps += 1
		Quests.progress(p, "train", 1)
		if grade == "perfect" then
			profile.Perfects += 1
			Quests.progress(p, "perfect", 1)
		end
		session.total += gain
	end

	local nextRep
	local done = session.rep >= Config.TrainReps
	if not done then
		nextRep = newRep(session)
		armTimeout(p, session)
	end
	Stats.send(p, "trainRep", session.rep - (done and 0 or 1), grade, gain, session.streak, nextRep)
	if done then
		Stats.send(p, "trainEnd", session.stat, session.total)
		sessions[p] = nil
		p:SetAttribute("Training", false)
	end
end

function Training.start(p, stat)
	if sessions[p] or p:GetAttribute("InDuel") or not Config.Stats[stat] then
		return
	end
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	local session = {
		stat = stat,
		rep = 0,
		token = 0,
		streak = 0,
		total = 0,
		resolved = true,
		origin = root and root.Position,
	}
	sessions[p] = session
	p:SetAttribute("Training", true)
	local cfg = newRep(session)
	armTimeout(p, session)
	Stats.send(p, "trainStart", stat, cfg)
end

function Training.cancel(p)
	if sessions[p] then
		sessions[p] = nil
		p:SetAttribute("Training", false)
		Stats.send(p, "trainEnd", nil, 0)
	end
end

function Training.hit(p, clientTime)
	local session = sessions[p]
	if not session or session.resolved then
		return
	end
	local now = workspace:GetServerTimeNow()
	local t = type(clientTime) == "number" and clientTime or now
	t = math.clamp(t, now - 0.6, now)
	if t < session.startedAt then
		return
	end
	local marker = Util.tri((t - session.startedAt) * session.speed)
	local dist = math.abs(marker - session.center)
	local grade = "miss"
	if dist <= PERFECT_WIDTH / 2 then
		grade = "perfect"
	elseif dist <= GOOD_WIDTH / 2 then
		grade = "good"
	end
	resolve(p, session, grade)
end

function Training.init()
	-- Walking away from the station cancels the session.
	task.spawn(function()
		while true do
			task.wait(1)
			for p, session in sessions do
				local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
				if not root or (session.origin and (root.Position - session.origin).Magnitude > 22) then
					Training.cancel(p)
				end
			end
		end
	end)
end

function Training.release(p)
	sessions[p] = nil
end

function Training.handle(p, kind, a)
	if kind == "TrainHit" then
		Training.hit(p, a)
	elseif kind == "TrainCancel" then
		Training.cancel(p)
	end
end

return Training
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">Treadmill</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: treadmills. Buy one with Aura, press the use button to hop on and run. You earn Aura (and a little
-- XP) every second for as long as you keep running; press the button again to step off.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Util = require(ReplicatedStorage.Shared.Util)
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Treadmill = {}

local running = {} -- player -> treadmill id
local heat = {} -- player -> seconds run in a row
local FX = "TreadFx"
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local SPARKS = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local function rainbow()
	local keys = {}
	for i = 0, 6 do
		table.insert(keys, ColorSequenceKeypoint.new(i / 6, Color3.fromHSV(i / 6, 0.75, 1)))
	end
	return ColorSequence.new(keys)
end

-- Effects on the runner that everyone can see; they get wilder with the treadmill's tier.
local function attachFx(p, def)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local feet = Instance.new("Attachment")
	feet.Name = FX
	feet.Position = Vector3.new(0, -2.8, 0)
	feet.Parent = root
	local color = def.Color
	local seq = def.Rainbow and rainbow() or ColorSequence.new(color:Lerp(Color3.new(1, 1, 1), 0.3), color)
	local function emitter(props)
		local e = Instance.new("ParticleEmitter")
		e.Name = FX
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.1), NumberSequenceKeypoint.new(1, 1) })
		e.SpreadAngle = Vector2.new(30, 30)
		for k, v in props do
			e[k] = v
		end
		e.Parent = feet
	end
	emitter({ Texture = SMOKE, Color = seq, Rate = 18, Lifetime = NumberRange.new(0.8, 1.4), Speed = NumberRange.new(4, 8), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 4) }), LightEmission = 0.3 })
	if def.Effect ~= "dust" then
		emitter({ Texture = SPARKS, Color = seq, Rate = 40, Lifetime = NumberRange.new(0.5, 1), Speed = NumberRange.new(10, 20), SpreadAngle = Vector2.new(60, 60), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.9), NumberSequenceKeypoint.new(1, 0) }), LightEmission = 0.8 })
	end
	if def.Effect == "flames" or def.Effect == "storm" then
		emitter({ Texture = FIRE, Color = seq, Rate = 36, Lifetime = NumberRange.new(0.5, 0.9), Speed = NumberRange.new(3, 7), SpreadAngle = Vector2.new(20, 20), Acceleration = Vector3.new(0, 14, 0), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.2), NumberSequenceKeypoint.new(1, 0) }), LightEmission = 0.9 })
	end
	if def.Effect == "storm" then
		-- lightning-like streaks shooting out sideways + a bright light
		emitter({ Texture = SPARKS, Color = seq, Rate = 70, Lifetime = NumberRange.new(0.25, 0.5), Speed = NumberRange.new(30, 50), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.4), NumberSequenceKeypoint.new(1, 0) }), LightEmission = 1 })
		local light = Instance.new("PointLight")
		light.Name = FX
		light.Color = color
		light.Range = 28
		light.Brightness = 2
		light.Parent = root
	end
end

local function clearFx(p)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, child in root:GetChildren() do
		if child.Name == FX then
			child:Destroy()
		end
	end
end

-- Slides the stripes along the belt of every treadmill someone is running on.
local function animateBelts(now)
	local hall = workspace:FindFirstChild("GlowWorld") and workspace.GlowWorld:FindFirstChild("TreadHall")
	if not hall then
		return
	end
	local seen = {}
	for _, id in running do
		if not seen[id] then
			seen[id] = true
			local model = hall:FindFirstChild("Tread_" .. id)
			if model then
				local at = Config.TreadCF(id)
				local speed = 7 + id * 1.2
				for _, stripe in model:GetChildren() do
					local z0 = stripe.Name == "BeltStripe" and stripe:GetAttribute("Z0")
					if z0 then
						local z = ((z0 + 5.2 - now * speed) % 10.4) - 5.2
						stripe.CFrame = at * CFrame.new(0, 1.22, z)
					end
				end
			end
		end
	end
end

function Treadmill.init()
	local last = 0
	game:GetService("RunService").Heartbeat:Connect(function()
		local now = os.clock()
		if now - last >= 0.05 then
			last = now
			animateBelts(now)
		end
	end)
end

function Treadmill.isRunning(p)
	return running[p]
end

local function freeze(p, frozen)
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not hum then
		return
	end
	if frozen then
		hum.WalkSpeed = 0
		hum.JumpHeight = 0
	else
		Stats.applyMovement(p)
	end
end

function Treadmill.stop(p)
	local id = running[p]
	if not id then
		return
	end
	running[p] = nil
	heat[p] = nil
	p:SetAttribute("Running", 0)
	p:SetAttribute("RunHeat", 0)
	clearFx(p)
	freeze(p, false)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if root then
		-- step off onto the aisle in front of the treadmill
		local front = Config.TreadCF(id) * CFrame.new(0, 2.7, -8.5)
		root.CFrame = CFrame.lookAt(front.Position, front.Position + front.LookVector * 20)
	end
	Stats.send(p, "runStop")
end

function Treadmill.start(p, id)
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	if not root or p:GetAttribute("Training") or p:GetAttribute("InDuel") then
		return
	end
	local belt = Config.TreadCF(id) * CFrame.new(0, 0.8, 0)
	root.AssemblyLinearVelocity = Vector3.zero
	-- the runner faces the back wall of the hall
	root.CFrame = CFrame.lookAt(belt.Position + Vector3.new(0, 3, 0), belt.Position - belt.LookVector * 20 + Vector3.new(0, 3, 0))
	freeze(p, true)
	running[p] = id
	heat[p] = 0
	p:SetAttribute("Running", id)
	p:SetAttribute("RunHeat", 0)
	attachFx(p, Config.Treadmills[id])
	Stats.send(p, "run", id)
end

-- Use: buy it if locked, hop on if owned, step off if you are already on it.
function Treadmill.use(p, id)
	local profile = Data.get(p)
	local def = Config.Treadmills[id]
	if not profile or not def then
		return
	end
	if running[p] == id then
		Treadmill.stop(p)
		return
	end
	local key = tostring(id)
	if not profile.Treads[key] then
		if not Stats.spend(p, def.Price) then
			Stats.toast(p, string.format("%s needs %s Aura", def.Name, Util.fmt(def.Price)), "bad")
			return
		end
		profile.Treads[key] = true
		Stats.recompute(p)
		Stats.send(p, "treadBought", id)
	end
	if running[p] then
		Treadmill.stop(p)
	end
	Treadmill.start(p, id)
end

-- Called once a second for every player.
function Treadmill.tick(p)
	local id = running[p]
	if not id then
		return
	end
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart")
	local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 then
		running[p] = nil
		heat[p] = nil
		p:SetAttribute("Running", 0)
		return
	end
	local def = Config.Treadmills[id]
	heat[p] = (heat[p] or 0) + 1
	p:SetAttribute("RunHeat", heat[p])
	local gained = Stats.addAura(p, def.Rate * Config.RunHeatMult(heat[p]))
	Stats.addXP(p, 0.4 + id * 0.25)
	Stats.send(p, "runTick", gained, heat[p], id)
end

function Treadmill.release(p)
	running[p] = nil
	heat[p] = nil
end

return Treadmill
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">Tutorial</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the first-time tutorial. Five short steps that teach the core loop (swing, hammer, train, pet,
-- battle), each with a small gift so the next step is possible. The step number is saved; players can skip it.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Data = require(script.Parent.Data)
local Stats = require(script.Parent.Stats)

local Tutorial = {}

local DONE = #Config.Tutorial + 1
local base = {} -- player -> { step, value } counter value when the step began
local gifted = {} -- player -> highest step already gifted

local function counter(profile, step)
	if step == 1 then
		return profile.Swings
	elseif step == 3 then
		return profile.Reps
	elseif step == 4 then
		return profile.Hatched or 0
	elseif step == 5 then
		return profile.Duels
	end
	return 0
end

local function enter(p, profile, step)
	base[p] = { step = step, value = counter(profile, step) }
	p:SetAttribute("TutStep", step)
	p:SetAttribute("TutGoal", Config.Tutorial[step] and Config.Tutorial[step].Goal or 0)
	p:SetAttribute("TutProgress", 0)
	local def = Config.Tutorial[step]
	if def and def.Gift and (gifted[p] or 0) < step then
		gifted[p] = step
		if profile.Aura < def.Gift then
			Stats.addAura(p, def.Gift - math.floor(profile.Aura), { raw = true })
		end
	end
end

function Tutorial.init(p)
	local profile = Data.get(p)
	local step = math.clamp(profile.Tut or 1, 1, DONE)
	profile.Tut = step
	enter(p, profile, step)
end

function Tutorial.skip(p)
	local profile = Data.get(p)
	if profile and profile.Tut < DONE then
		profile.Tut = DONE
		p:SetAttribute("TutStep", DONE)
	end
end

local function advance(p, profile)
	local step = profile.Tut + 1
	profile.Tut = step
	if step >= DONE then
		p:SetAttribute("TutStep", DONE)
		Stats.addAura(p, Config.TutorialReward.Aura, { raw = true })
		Stats.addFreeCrates(p, Config.TutorialReward.Crates)
		Stats.send(p, "tutorialDone", Config.TutorialReward.Aura, Config.TutorialReward.Crates)
	else
		Stats.send(p, "tutorialStep", step)
		enter(p, profile, step)
	end
end

-- Called once a second.
function Tutorial.tick(p)
	local profile = Data.get(p)
	if not profile or profile.Tut >= DONE then
		return
	end
	local step = profile.Tut
	if not base[p] or base[p].step ~= step then
		enter(p, profile, step)
	end
	local def = Config.Tutorial[step]
	local done
	if step == 2 then
		done = profile.HammersOwned["2"] ~= nil
	else
		local progress = counter(profile, step) - base[p].value
		local goal = def.Goal or 1
		p:SetAttribute("TutProgress", math.min(progress, goal))
		done = progress >= goal
	end
	if done then
		advance(p, profile)
	end
end

function Tutorial.release(p)
	base[p] = nil
	gifted[p] = nil
end

return Tutorial
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: builds the whole town from code (nothing to import).
-- A bright daytime plaza with grass, concrete, brick and wood: three training pavilions, a crate
-- shop, a boxing ring for duels, a catwalk, and the big Mog Competition stage in the middle.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local Config = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Config"))
local Decor = require(script.Parent.Decor)
local Architecture = require(script.Parent.Architecture)
local Island = require(script.Parent.Island)
local Util = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("Util"))
local HammerModel = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("HammerModel"))

local World = {}

local rng = Random.new(77)
local PLAZA = Config.PlazaRadius
local C3 = Color3.fromRGB
local M = Enum.Material

-- A classic Roblox palette.
local RED, BLUE, YELLOW, GREEN = C3(196, 40, 28), C3(13, 105, 172), C3(245, 205, 48), C3(75, 151, 75)
local WHITE, CONCRETE, DARK, WOOD = C3(242, 243, 243), C3(176, 176, 180), C3(60, 62, 70), C3(124, 92, 70)
local BRICK, ASPHALT, GRASS = C3(166, 106, 70), C3(58, 60, 66), C3(91, 154, 76)

--------------------------------------------------------------------------------
-- Building helpers
--------------------------------------------------------------------------------
local function part(parent, props)
	local p = Instance.new("Part")
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in props do
		p[k] = v
	end
	p.Parent = parent
	return p
end

local function block(parent, name, size, cf, color, material, extra)
	local props = { Name = name, Size = size, CFrame = cf, Color = color, Material = material or M.SmoothPlastic }
	if extra then
		for k, v in extra do
			props[k] = v
		end
	end
	return part(parent, props)
end

-- Flat cylinder whose top face is at center.Y.
local function disk(parent, name, center, radius, thickness, color, material)
	return part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(thickness, radius * 2, radius * 2),
		CFrame = CFrame.new(center.X, center.Y - thickness / 2, center.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = material or M.SmoothPlastic,
	})
end

-- Upright cylinder centred at `center`.
local function post(parent, name, center, radius, height, color, material)
	return part(parent, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(height, radius * 2, radius * 2),
		CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = material or M.SmoothPlastic,
	})
end

-- A painted sign board whose front faces `facing`.
local function sign(parent, position, facing, size, text, boardColor, textColor)
	local cf = CFrame.lookAt(position, position + facing)
	block(parent, "SignFrame", size + Vector3.new(1, 1, 0), cf * CFrame.new(0, 0, 0.3), WHITE, M.SmoothPlastic, { CanCollide = false })
	local face = block(parent, "Sign", size, cf, boardColor, M.SmoothPlastic, { CanCollide = false })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(size.X * 50, size.Y * 50)
	gui.LightInfluence = 0.2
	gui.Parent = face
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor or WHITE
	label.TextStrokeTransparency = 0
	label.TextStrokeColor3 = C3(0, 0, 0)
	label.Text = text
	label.Parent = gui
	return face, label
end

--------------------------------------------------------------------------------
-- Lighting: a bright, clear day
--------------------------------------------------------------------------------
local function setupLighting()
	Lighting.ClockTime = 14.2
	Lighting.Brightness = 2.4
	Lighting.Ambient = C3(110, 112, 120)
	Lighting.OutdoorAmbient = C3(125, 128, 140)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.4

	for _, child in Lighting:GetChildren() do
		if
			child:IsA("Atmosphere")
			or child:IsA("BloomEffect")
			or child:IsA("ColorCorrectionEffect")
			or child:IsA("SunRaysEffect")
			or child:IsA("DepthOfFieldEffect")
			or child:IsA("BlurEffect")
			or child:IsA("Sky")
		then
			child:Destroy()
		end
	end

	Instance.new("Sky").Parent = Lighting

	local atmo = Instance.new("Atmosphere")
	atmo.Density = 0.22
	atmo.Offset = 0.25
	atmo.Color = C3(199, 214, 235)
	atmo.Decay = C3(160, 185, 215)
	atmo.Glare = 0.2
	atmo.Haze = 0.6
	atmo.Parent = Lighting

	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.25
	bloom.Size = 20
	bloom.Threshold = 1.8
	bloom.Parent = Lighting

	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Spread = 0.6
	rays.Parent = Lighting

	local tint = Instance.new("ColorCorrectionEffect")
	tint.Name = "GlowTint"
	tint.Saturation = 0.1
	tint.Contrast = 0.04
	tint.Parent = Lighting
end

--------------------------------------------------------------------------------
-- Pavilions (training stations)
--------------------------------------------------------------------------------
local function pavilion(parent, pos, inward, roofColor, signText, signColor, floorColor, floorMaterial, wallColor, wallMaterial)
	local cf = CFrame.lookAt(pos, pos + inward)
	local floor = floorColor or C3(160, 160, 166)
	Architecture.pavilion(parent, cf, {
		wall = wallColor or C3(214, 208, 196),
		wallMat = wallMaterial or M.Concrete,
		accent = signColor or RED,
		floorA = floor:Lerp(WHITE, 0.35),
		floorB = floor:Lerp(DARK, 0.2),
		floorMat = floorMaterial or M.Concrete,
		roof = roofColor,
	})
	sign(parent, (cf * CFrame.new(0, 19.2, -16)).Position, inward, Vector3.new(26, 5, 0.6), signText, signColor)
	return cf
end

local function stationAt(name)
	local pos = Config.StationPos(name)
	local inward = Config.StationFront(name)
	return pos, inward, Vector3.new(-inward.Z, 0, inward.X)
end

--------------------------------------------------------------------------------
-- Hammer shop: a row of LEGO-stud pedestals right where you spawn. The client adds the OWNED /
-- EQUIPPED / price labels (they differ per player).
--------------------------------------------------------------------------------
local function buildHammerRow(parent)
	local row = Instance.new("Folder")
	row.Name = "HammerRow"
	row.Parent = parent
	for _, hammer in Config.Hammers do
		local pos = Config.HammerPos(hammer.Id)
		local color = hammer.Head
		local pedestal = block(row, "Pedestal", Vector3.new(8, 1.4, 8), CFrame.new(pos + Vector3.new(0, 0.7, 0)), C3(60, 66, 90), M.SmoothPlastic)
		pedestal:SetAttribute("HammerId", hammer.Id)
		block(row, "PedestalTop", Vector3.new(8.4, 0.5, 8.4), CFrame.new(pos + Vector3.new(0, 1.65, 0)), color, M.SmoothPlastic)
		for sx = -1, 1, 2 do
			for sz = -1, 1, 2 do
				part(row, {
					Name = "Stud",
					Shape = Enum.PartType.Cylinder,
					Size = Vector3.new(0.5, 1.8, 1.8),
					CFrame = CFrame.new(pos + Vector3.new(sx * 2.2, 2.15, sz * 2.2)) * CFrame.Angles(0, 0, math.pi / 2),
					Color = color,
					Material = M.SmoothPlastic,
					CanCollide = false,
				})
			end
		end
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 16
		light.Brightness = 1.2
		light.Parent = pedestal
		Decor.smoke(row, pos + Vector3.new(0, 2.2, 0), color, 0.35 + hammer.Id * 0.04)
		local display = HammerModel.build(hammer, CFrame.new(pos + Vector3.new(0, 6.6, 0)) * CFrame.Angles(0, math.rad(30), math.rad(-18)), row, { anchored = true })
		display.Name = "HammerDisplay"
		local face = sign(row, pos + Vector3.new(0, 3.3, 3.6), Vector3.new(0, 0, 1), Vector3.new(7.4, 1.6, 0.4), hammer.Name .. "  x" .. hammer.Mult, C3(30, 34, 52), color)
		face.Orientation = face.Orientation + Vector3.new(-25, 0, 0)
	end
	sign(row, Vector3.new(0, 16, Config.HammerRowZ + 14), Vector3.new(0, 0, 1), Vector3.new(34, 5, 0.6), "🔨  HAMMER SHOP  🔨", C3(200, 120, 20))
	for side = -1, 1, 2 do
		block(row, "SignPost", Vector3.new(1.2, 16, 1.2), CFrame.new(side * 18, 8, Config.HammerRowZ + 14.4), DARK, M.Metal)
	end
end


--------------------------------------------------------------------------------
-- Platforms: raised, studded round platforms where training and battles happen
--------------------------------------------------------------------------------
-- `cf` sits on the surface the platform stands on. Returns the CFrame of the platform's top.
local function platform(parent, cf, radius, color, text)
	local h = 1.2
	local origin = cf.Position
	disk(parent, "PlatformBase", origin + Vector3.new(0, h, 0), radius + 1.2, h, C3(70, 74, 92), M.Concrete)
	local top = disk(parent, "PlatformTop", origin + Vector3.new(0, h + 0.3, 0), radius, 0.3, color, M.SmoothPlastic)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = radius * 3
	light.Brightness = 0.9
	light.Parent = top
	for i = 1, 14 do
		local a = (i / 14) * math.pi * 2
		part(parent, {
			Name = "Stud",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.4, 1.7, 1.7),
			CFrame = CFrame.new(origin + Vector3.new(math.cos(a) * radius * 0.78, h + 0.65, math.sin(a) * radius * 0.78)) * CFrame.Angles(0, 0, math.pi / 2),
			Color = color:Lerp(WHITE, 0.35),
			Material = M.SmoothPlastic,
			CanCollide = false,
		})
	end
	for i = 1, 16 do
		local a = (i / 16) * math.pi * 2
		local at = origin + Vector3.new(math.cos(a) * (radius + 0.9), h + 1.1, math.sin(a) * (radius + 0.9))
		-- leave a gap in front (local -Z) for the steps
		local local_ = cf:PointToObjectSpace(at)
		if not (local_.Z < -radius * 0.55 and math.abs(local_.X) < 4.2) then
			post(parent, "Bollard", at, 0.35, 2.2, DARK, M.Metal)
			part(parent, { Name = "BollardCap", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.9, Position = at + Vector3.new(0, 1.3, 0), Color = color, Material = M.SmoothPlastic, CanCollide = false })
		end
	end
	block(parent, "StepLow", Vector3.new(8, h * 0.45, 2.6), cf * CFrame.new(0, h * 0.225, -(radius + 2.5)), C3(150, 150, 158), M.Concrete)
	block(parent, "StepHigh", Vector3.new(8, h * 0.9, 2.6), cf * CFrame.new(0, h * 0.45, -(radius + 0.9)), C3(165, 165, 172), M.Concrete)
	local label = block(parent, "PlatformLabel", Vector3.new(radius * 1.3, 0.1, radius * 1.3), cf * CFrame.new(0, h + 0.5, 0), color, M.SmoothPlastic, { CanCollide = false, Transparency = 1 })
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	gui.CanvasSize = Vector2.new(300, 300)
	gui.Parent = label
	local tx = Instance.new("TextLabel")
	tx.Size = UDim2.fromScale(1, 1)
	tx.BackgroundTransparency = 1
	tx.Font = Enum.Font.GothamBlack
	tx.TextScaled = true
	tx.TextColor3 = WHITE
	tx.TextStrokeTransparency = 0
	tx.Text = text
	tx.Parent = gui
	return cf * CFrame.new(0, h + 0.45, 0)
end

local function trainingPlatforms(parent)
	for name, info in { Gym = { RED, "💪 TRAIN" }, Studio = { C3(150, 70, 190), "💈 STYLE" }, Lounge = { C3(40, 130, 150), "🛋️ CHARM" } } do
		local pos, inward = stationAt(name)
		local cf = CFrame.lookAt(pos, pos + inward) * CFrame.new(0, 0.9, -7)
		platform(parent, cf, 6, info[1], info[2])
	end
end

--------------------------------------------------------------------------------
-- Stage battle arena: a long studded lane, opaque side walls, a glass back wall, and an NPC opponent
--------------------------------------------------------------------------------
local function studded(parent, name, size, cf, color, extra)
	local p = block(parent, name, size, cf, color, M.Plastic, extra)
	p.TopSurface = Enum.SurfaceType.Studs
	return p
end

local function buildBattle(parent)
	local pos, inward = Config.BattlePos(), Config.BattleFront()
	local cf = CFrame.lookAt(pos, pos + inward)
	local LANE = 64
	studded(parent, "BattleFloor", Vector3.new(30, 1, LANE), cf * CFrame.new(0, 0.5, 0), C3(176, 190, 214))
	for side = -1, 1, 2 do
		studded(parent, "BattleWall", Vector3.new(2, 18, LANE), cf * CFrame.new(side * 16, 9.5, 0), C3(70, 92, 180))
	end
	block(parent, "BattleGlass", Vector3.new(30, 18, 1.2), cf * CFrame.new(0, 9.5, LANE / 2), C3(150, 200, 235), M.SmoothPlastic, { Transparency = 0.4 })
	-- entry arch + sign (faces the plaza)
	for side = -1, 1, 2 do
		block(parent, "BattlePillar", Vector3.new(2, 20, 2), cf * CFrame.new(side * 15, 10.5, -LANE / 2), DARK, M.Metal)
	end
	block(parent, "BattleBeam", Vector3.new(32, 2, 2), cf * CFrame.new(0, 21, -LANE / 2), DARK, M.Metal)
	sign(parent, (cf * CFrame.new(0, 25, -LANE / 2)).Position, cf.LookVector, Vector3.new(28, 5, 0.6), "⚔️  STAGE BATTLE", C3(40, 70, 170))
	block(parent, "BattleRamp", Vector3.new(16, 0.5, 4), cf * CFrame.new(0, 0.25, -LANE / 2 - 2), C3(150, 150, 158), M.Concrete)

	local battleGlow = Config.Buildings.battle.Glow
	for side = -1, 1, 2 do
		Decor.smoke(parent, (cf * CFrame.new(side * 15, 22, -LANE / 2)).Position, battleGlow, 1)
		Decor.smoke(parent, (cf * CFrame.new(side * 15, 19, LANE / 2 - 2)).Position, battleGlow, 0.8)
	end
	Decor.groundAura(parent, pos, 36, battleGlow)
	local padA = platform(parent, cf * CFrame.new(0, 1, -14), 5.5, C3(250, 205, 50), "YOU")
	local padB = platform(parent, cf * CFrame.new(0, 1, 14), 5.5, C3(150, 60, 220), "VS")

	-- The opponent: a blocky NPC whose look changes with the stage.
	local npc = Instance.new("Model")
	npc.Name = "StageOpponent"
	npc.Parent = parent
	local standCF = padB * CFrame.Angles(0, math.pi, 0)
	local skin = C3(214, 190, 150)
	local torso = block(npc, "NpcTorso", Vector3.new(4, 4.4, 2.2), standCF * CFrame.new(0, 4.8, 0), BLUE, M.SmoothPlastic)
	local head = part(npc, { Name = "NpcHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 3, Position = (standCF * CFrame.new(0, 8.4, 0)).Position, Color = skin, Material = M.SmoothPlastic })
	local belly = part(npc, { Name = "NpcBelly", Shape = Enum.PartType.Ball, Size = Vector3.one * 4.4, Position = (standCF * CFrame.new(0, 3.9, -0.7)).Position, Color = skin, Material = M.SmoothPlastic })
	for _, d in { { -0.6, 0.3 }, { 0.6, 0.3 } } do
		part(npc, { Name = "NpcEye", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.6, Position = (standCF * CFrame.new(d[1], 8.7, -1.35)).Position, Color = WHITE, Material = M.SmoothPlastic, CanCollide = false })
		part(npc, { Name = "NpcPupil", Shape = Enum.PartType.Ball, Size = Vector3.one * 0.3, Position = (standCF * CFrame.new(d[1], 8.7, -1.65)).Position, Color = C3(0, 0, 0), Material = M.SmoothPlastic, CanCollide = false })
	end
	block(npc, "NpcMouth", Vector3.new(1.2, 0.25, 0.2), standCF * CFrame.new(0, 7.9, -1.45), C3(110, 30, 40), M.SmoothPlastic, { CanCollide = false })
	for side = -1, 1, 2 do
		block(npc, "NpcArm", Vector3.new(1.4, 4.2, 1.4), standCF * CFrame.new(side * 3, 4.9, 0) * CFrame.Angles(0, 0, side * 0.2), skin, M.SmoothPlastic)
		block(npc, "NpcLeg", Vector3.new(1.8, 3.2, 1.8), standCF * CFrame.new(side * 1, 1.6, 0), DARK, M.SmoothPlastic)
	end
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(280, 54)
	tag.StudsOffset = Vector3.new(0, 4.2, 0)
	tag.MaxDistance = 120
	tag.AlwaysOnTop = true
	tag.Adornee = head
	tag.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 20
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0
	label.TextWrapped = true
	label.Text = "STAGE 1\n" .. Config.Battle.Stages[1].Name
	label.Parent = tag

	local function setOpponent(def)
		label.Text = string.format("STAGE %d / %d\n%s", def.Index, Config.Battle.Count, def.Name)
		label.TextColor3 = Config.Ranks[def.Rank].Color
		torso.Color = def.Color
		local fat = math.max(0, 1 - (def.Index - 1) / 8)
		belly.Transparency = fat > 0.05 and 0 or 1
		belly.Size = Vector3.one * (2 + 2.4 * fat)
		torso.Size = Vector3.new(3.2 + 1.2 * fat, 4.4, 2.2)
	end
	setOpponent(Config.Battle.Stages[1])
	return { padA = padA, padB = padB, center = (cf * CFrame.new(0, 2.5, 0)).Position, setOpponent = setOpponent }
end


--------------------------------------------------------------------------------
-- Treadmill Hall: ten treadmills, each a different colour, each puffing its own coloured smoke
--------------------------------------------------------------------------------
local function buildTreadHall(parent)
	local def = Config.Buildings.treadmills
	local cf = Config.TreadHallCF()
	local W, D = 62, 50
	local hall = Instance.new("Folder")
	hall.Name = "TreadHall"
	hall.Parent = parent
	block(hall, "HallFloor", Vector3.new(W, 0.8, D), cf * CFrame.new(0, 0.4, 0), C3(44, 50, 46), M.Slate)
	block(hall, "HallAisle", Vector3.new(W - 4, 0.1, 6), cf * CFrame.new(0, 0.85, 3), def.Main, M.SmoothPlastic, { CanCollide = false })
	block(hall, "HallEntry", Vector3.new(10, 0.1, 14), cf * CFrame.new(0, 0.85, -18), def.Glow, M.SmoothPlastic, { CanCollide = false })
	block(hall, "HallBackWall", Vector3.new(W, 20, 1), cf * CFrame.new(0, 10.4, D / 2), C3(30, 38, 34), M.Concrete)
	for side = -1, 1, 2 do
		block(hall, "HallSideWall", Vector3.new(1, 20, D), cf * CFrame.new(side * W / 2, 10.4, 0), C3(36, 46, 40), M.Concrete)
		for i = 1, 6 do
			block(hall, "HallWindow", Vector3.new(0.4, 7, 5), cf * CFrame.new(side * (W / 2 - 0.2), 11, -20 + i * 6.5), C3(140, 255, 160), M.Glass, { Transparency = 0.5, CanCollide = false })
		end
	end
	block(hall, "HallRoof", Vector3.new(W + 2, 1.4, D + 2), cf * CFrame.new(0, 21, 0), C3(24, 30, 28), M.Metal)
	block(hall, "HallRoofTrim", Vector3.new(W + 3, 0.7, D + 3), cf * CFrame.new(0, 20, 0), def.Main, M.SmoothPlastic)
	for _, x in { -W / 2, W / 2 } do
		for _, z in { -D / 2, D / 2 } do
			block(hall, "HallPillar", Vector3.new(2.2, 20, 2.2), cf * CFrame.new(x, 10.4, z), WHITE, M.Concrete)
		end
	end
	sign(hall, (cf * CFrame.new(0, 26, -D / 2 - 1)).Position, cf.LookVector, Vector3.new(34, 6, 0.6), "🏃  TREADMILL HALL", C3(30, 110, 40), C3(210, 255, 190))
	for _, z in { -14, -2, 8, 18 } do
		local strip = block(hall, "HallLightStrip", Vector3.new(W - 6, 0.5, 0.6), cf * CFrame.new(0, 19.4, z), def.Glow, M.SmoothPlastic, { CanCollide = false })
		local l = Instance.new("PointLight")
		l.Color = def.Glow
		l.Range = 40
		l.Brightness = 0.8
		l.Parent = strip
	end
	for _, x in { -W / 3, 0, W / 3 } do
		Decor.smoke(hall, (cf * CFrame.new(x, 23, 8)).Position, def.Glow, 1.2)
	end
	Decor.groundAura(hall, cf.Position, 56, def.Glow)

	for _, t in Config.Treadmills do
		local at = Config.TreadCF(t.Id)
		local color = t.Color
		local model = Instance.new("Model")
		model.Name = "Tread_" .. t.Id
		model.Parent = hall
		block(model, "TreadBase", Vector3.new(4.8, 0.9, 11.4), at * CFrame.new(0, 0.45, 0), C3(30, 32, 40), M.Metal)
		local belt = block(model, "TreadBelt", Vector3.new(3.8, 0.3, 10.4), at * CFrame.new(0, 1.05, 0), C3(24, 24, 28), M.Rubber)
		belt:SetAttribute("TreadId", t.Id)
		-- stripes that slide along the belt while someone is running (see Treadmill.luau)
		for i = 1, 7 do
			local z0 = -4.6 + (i - 1) * 1.55
			local stripe = block(model, "BeltStripe", Vector3.new(3.8, 0.06, 0.45), at * CFrame.new(0, 1.22, z0), color, M.SmoothPlastic, { CanCollide = false })
			stripe:SetAttribute("Z0", z0)
		end
		for side = -1, 1, 2 do
			block(model, "TreadRail", Vector3.new(0.5, 0.7, 10.6), at * CFrame.new(side * 2.2, 1.2, 0), color, M.SmoothPlastic)
			block(model, "TreadHandle", Vector3.new(0.4, 0.4, 5), at * CFrame.new(side * 2.2, 4.2, 4.2), color, M.Metal)
			block(model, "TreadHandlePost", Vector3.new(0.4, 3, 0.4), at * CFrame.new(side * 2.2, 2.7, 6.4), color, M.Metal)
			if t.Id > 3 then
				Decor.smoke(model, (at * CFrame.new(side * 2.2, 1.8, -4)).Position, t.Rainbow and "rainbow" or color, 0.25)
			end
		end
		block(model, "ConsolePost", Vector3.new(0.7, 6, 0.7), at * CFrame.new(0, 3.9, 6.6), C3(40, 42, 52), M.Metal)
		sign(model, (at * CFrame.new(0, 7.4, 6.6)).Position, cf.LookVector, Vector3.new(4.6, 2.4, 0.4), string.format("%s\n+%s/s", (t.Name:gsub(" Treadmill", "")), Util.fmt(t.Rate)), C3(18, 20, 28), color)
		local top = part(model, { Name = "ConsoleGem", Shape = Enum.PartType.Ball, Size = Vector3.one * 1.1, CFrame = at * CFrame.new(0, 9.2, 6.6), Color = color, Transparency = 0.1, CanCollide = false })
		local light = Instance.new("PointLight")
		light.Color = color
		light.Range = 22
		light.Brightness = 1.1
		light.Parent = top
		Decor.smoke(model, (at * CFrame.new(0, 9.8, 6.6)).Position, t.Rainbow and "rainbow" or color, 0.45 + t.Id * 0.03)
		-- a thin beam of light above each treadmill; taller for better ones
		local height = 14 + t.Id * 1.6
		part(model, { Name = "LightBeam", Size = Vector3.new(0.7, height, 0.7), CFrame = at * CFrame.new(0, 10 + height / 2, 6.6), Color = color, Transparency = 0.82, CanCollide = false, CanQuery = false })
	end
end

local function buildGym(parent)
	local pos, inward = stationAt("Gym")
	local cf = pavilion(parent, pos, inward, RED, "💪  GYM", C3(150, 30, 20), C3(48, 50, 56), M.Slate, C3(150, 64, 56), M.Brick)
	Decor.pavilion(parent, "gym", cf)
	-- Bench press
	block(parent, "Bench", Vector3.new(2.4, 1.2, 6.5), cf * CFrame.new(0, 1.9, 2), C3(40, 40, 46), M.SmoothPlastic)
	for side = -1, 1, 2 do
		block(parent, "BenchStand", Vector3.new(0.6, 3, 0.6), cf * CFrame.new(side * 2.4, 2.3, 1), DARK, M.Metal)
	end
	local bar = cf * CFrame.new(0, 4.6, 1)
	block(parent, "Bar", Vector3.new(11, 0.5, 0.5), bar, C3(200, 205, 215), M.Metal, { Shape = Enum.PartType.Cylinder })
	for side = -1, 1, 2 do
		block(parent, "Plate", Vector3.new(0.8, 3.4, 3.4), bar * CFrame.new(side * 4.6, 0, 0), C3(30, 30, 36), M.Metal, { Shape = Enum.PartType.Cylinder })
		block(parent, "Plate", Vector3.new(0.7, 2.4, 2.4), bar * CFrame.new(side * 5.3, 0, 0), RED, M.Metal, { Shape = Enum.PartType.Cylinder })
	end
	-- Dumbbell rack along the back wall
	block(parent, "Rack", Vector3.new(14, 2.4, 2.6), cf * CFrame.new(-8, 2, 12.6), DARK, M.Metal)
	for i = 1, 6 do
		local d = cf * CFrame.new(-13.5 + i * 1.9, 3.7, 12.6)
		block(parent, "Dumbbell", Vector3.new(1.8, 0.4, 0.4), d, C3(200, 205, 215), M.Metal, { Shape = Enum.PartType.Cylinder })
		for side = -1, 1, 2 do
			block(parent, "DumbbellHead", Vector3.new(0.5, 1, 1), d * CFrame.new(side * 0.8, 0, 0), C3(30, 30, 36), M.Metal, { Shape = Enum.PartType.Cylinder })
		end
	end
	block(parent, "Mirror", Vector3.new(14, 7, 0.3), cf * CFrame.new(7, 6, 14), C3(190, 215, 235), M.Glass, { Transparency = 0.35, Reflectance = 0.3 })
end

local function buildStudio(parent)
	local pos, inward = stationAt("Studio")
	local cf = pavilion(parent, pos, inward, C3(190, 70, 140), "💈  STYLE STUDIO", C3(130, 40, 100), C3(242, 190, 214), M.Marble, C3(238, 196, 214), M.Marble)
	Decor.pavilion(parent, "studio", cf)
	for i, x in { -7, 7 } do
		local c = cf * CFrame.new(x, 0, 2)
		post(parent, "ChairBase", (c * CFrame.new(0, 1, 0)).Position, 1.3, 0.6, DARK, M.Metal)
		post(parent, "ChairPost", (c * CFrame.new(0, 1.8, 0)).Position, 0.35, 1.4, C3(200, 205, 215), M.Metal)
		block(parent, "ChairSeat", Vector3.new(3.2, 0.9, 3.2), c * CFrame.new(0, 2.8, 0), RED, M.Leather)
		block(parent, "ChairBack", Vector3.new(3.2, 3.6, 0.9), c * CFrame.new(0, 4.4, -1.5), RED, M.Leather)
		block(parent, "ChairHead", Vector3.new(1.8, 1.2, 0.8), c * CFrame.new(0, 6.7, -1.5), RED, M.Leather)
		for side = -1, 1, 2 do
			block(parent, "ChairArm", Vector3.new(0.5, 0.5, 2.6), c * CFrame.new(side * 1.8, 3.9, 0), DARK, M.Metal)
		end
	end
	for i = 1, 3 do
		local x = (i - 2) * 9.5
		block(parent, "MirrorFrame", Vector3.new(7.6, 8.6, 0.5), cf * CFrame.new(x, 6.2, 13.9), DARK, M.Wood)
		block(parent, "Mirror", Vector3.new(6.8, 7.8, 0.3), cf * CFrame.new(x, 6.2, 13.6), C3(195, 220, 240), M.Glass, { Transparency = 0.3, Reflectance = 0.35 })
	end
	block(parent, "Counter", Vector3.new(26, 2.6, 1.8), cf * CFrame.new(0, 2, 12.4), WOOD, M.Wood)
	for i = 1, 7 do
		post(parent, "Bottle", (cf * CFrame.new(-10 + i * 2.7, 4, 12.4)).Position, 0.4, 1.4, ({ BLUE, GREEN, YELLOW, RED })[i % 4 + 1], M.Glass)
	end
end

local function buildLounge(parent)
	local pos, inward = stationAt("Lounge")
	local cf = pavilion(parent, pos, inward, C3(60, 140, 190), "🛋️  CHARM LOUNGE", C3(30, 90, 140), C3(170, 122, 84), M.WoodPlanks, C3(90, 168, 188), M.Concrete)
	Decor.pavilion(parent, "lounge", cf)
	disk(parent, "Rug", (cf * CFrame.new(0, 0.9, 1)).Position, 9, 0.1, C3(190, 70, 90), M.Fabric)
	block(parent, "SofaSeat", Vector3.new(11, 1.6, 4), cf * CFrame.new(0, 2, 11), C3(120, 80, 150), M.Fabric)
	block(parent, "SofaBack", Vector3.new(11, 3.6, 1), cf * CFrame.new(0, 4, 12.6), C3(100, 64, 130), M.Fabric)
	for side = -1, 1, 2 do
		block(parent, "SofaArm", Vector3.new(1, 3, 4), cf * CFrame.new(side * 5.8, 2.6, 11), C3(100, 64, 130), M.Fabric)
	end
	block(parent, "TableTop", Vector3.new(6, 0.5, 3), cf * CFrame.new(0, 2.5, 5), WOOD, M.Wood)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			block(parent, "TableLeg", Vector3.new(0.4, 1.6, 0.4), cf * CFrame.new(sx * 2.4, 1.6, 5 + sz * 1.1), WOOD, M.Wood)
		end
	end
	for _, x in { -13, 13 } do
		post(parent, "Pot", (cf * CFrame.new(x, 1.8, 11)).Position, 1.2, 2, C3(170, 100, 70), M.Concrete)
		part(parent, { Name = "Plant", Shape = Enum.PartType.Ball, Size = Vector3.one * 4, Position = (cf * CFrame.new(x, 4.4, 11)).Position, Color = GREEN, Material = M.Grass, CanCollide = false })
	end
end

local function buildCrateShop(parent)
	local pos, inward = stationAt("Crates")
	local cf = CFrame.lookAt(pos, pos + inward)
	block(parent, "Base", Vector3.new(26, 0.8, 20), cf * CFrame.new(0, 0.5, 0), C3(150, 120, 90), M.Wood)
	block(parent, "BackWall", Vector3.new(24, 11, 1), cf * CFrame.new(0, 6.3, 9), C3(214, 190, 150), M.Wood)
	block(parent, "Counter", Vector3.new(16, 3.4, 3.4), cf * CFrame.new(0, 2.5, 1.5), WOOD, M.Wood)
	block(parent, "CounterTop", Vector3.new(17, 0.5, 4), cf * CFrame.new(0, 4.4, 1.5), C3(80, 58, 44), M.Wood)
	for side = -1, 1, 2 do
		block(parent, "Post", Vector3.new(1.2, 12.5, 1.2), cf * CFrame.new(side * 12, 6.8, -6), WHITE, M.Wood)
	end
	-- Striped awning
	for i = 1, 10 do
		local x = -11.25 + (i - 1) * 2.5
		block(parent, "Awning", Vector3.new(2.5, 0.4, 15), cf * CFrame.new(x, 12.4, -1) * CFrame.Angles(math.rad(-9), 0, 0), i % 2 == 0 and WHITE or RED, M.Fabric)
	end
	sign(parent, (cf * CFrame.new(0, 17, -8.8)).Position, inward, Vector3.new(22, 4.4, 0.6), "🎁  CRATE SHOP", C3(30, 90, 140))
	Decor.chimneys(parent, cf, 11.8, 8, Config.Buildings.crates.Glow, 10.5)
	Decor.groundAura(parent, pos, 26, Config.Buildings.crates.Glow)
	for side = -1, 1, 2 do
		block(parent, "GoldPost", Vector3.new(1.6, 0.8, 1.6), cf * CFrame.new(side * 12, 13.4, -6), Config.Buildings.crates.Main, M.SmoothPlastic)
	end
	local gem = part(parent, { Name = "AuraBeacon", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.6, CFrame = cf * CFrame.new(0, 20, 4), Color = Config.Buildings.crates.Glow, Transparency = 0.15, CanCollide = false })
	local gl = Instance.new("PointLight")
	gl.Color = Config.Buildings.crates.Glow
	gl.Range = 50
	gl.Brightness = 1.4
	gl.Parent = gem
	for i, crate in Config.Crates do
		local box = cf * CFrame.new((i - 2) * 4.4, 5.8, 1.5)
		block(parent, "CrateDisplay", Vector3.new(2.6, 2.6, 2.6), box, WOOD, M.Wood)
		block(parent, "CrateLid", Vector3.new(2.8, 0.4, 2.8), box * CFrame.new(0, 1.4, 0), crate.Color, M.SmoothPlastic)
		block(parent, "CrateRibbon", Vector3.new(0.5, 2.7, 2.9), box, crate.Color, M.SmoothPlastic)
	end
	for i = 1, 3 do
		block(parent, "StackedCrate", Vector3.new(3, 3, 3), cf * CFrame.new(-10.5 + (i % 2) * 0.4, 2.4 + (i - 1) * 3, 7), WOOD, M.Wood)
		block(parent, "StackedCrate", Vector3.new(3, 3, 3), cf * CFrame.new(10.5 - (i % 2) * 0.4, 2.4 + (i - 1) * 3, 7), WOOD, M.Wood)
	end
end

local function buildDummy(parent, at, facing)
	local cf = CFrame.lookAt(at, at + facing)
	post(parent, "DummyBase", (cf * CFrame.new(0, 0.5, 0)).Position, 2.2, 0.8, DARK, M.Metal)
	post(parent, "DummyPole", (cf * CFrame.new(0, 3, 0)).Position, 0.4, 5, C3(200, 205, 215), M.Metal)
	local body = block(parent, "Dummy", Vector3.new(3, 5, 2.4), cf * CFrame.new(0, 6.2, 0), C3(214, 190, 150), M.Fabric)
	part(parent, { Name = "DummyHead", Shape = Enum.PartType.Ball, Size = Vector3.one * 2.4, Position = (cf * CFrame.new(0, 10, 0)).Position, Color = C3(214, 190, 150), Material = M.Fabric })
	for side = -1, 1, 2 do
		block(parent, "DummyArm", Vector3.new(1, 4, 1), cf * CFrame.new(side * 2.2, 6.4, 0) * CFrame.Angles(0, 0, side * 0.25), C3(214, 190, 150), M.Fabric)
	end
	block(parent, "Target", Vector3.new(2.2, 2.2, 0.3), cf * CFrame.new(0, 6.6, -1.25), RED, M.SmoothPlastic, { CanCollide = false })
	local tag = Instance.new("BillboardGui")
	tag.Size = UDim2.fromOffset(220, 40)
	tag.StudsOffset = Vector3.new(0, 4.5, 0)
	tag.MaxDistance = 90
	tag.Adornee = body
	tag.Parent = body
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 22
	label.TextColor3 = WHITE
	label.TextStrokeTransparency = 0
	label.Text = "MOGGER BOT"
	label.Parent = tag
end

local function buildRing(parent)
	local pos, inward, tangent = stationAt("Ring")
	local cf = CFrame.lookAt(pos, pos + inward)
	-- Platform with steps toward the plaza
	block(parent, "RingStepLow", Vector3.new(14, 0.9, 5), cf * CFrame.new(0, 0.45, -26.5), C3(150, 150, 156), M.Concrete)
	block(parent, "RingStepHigh", Vector3.new(14, 1.8, 5), cf * CFrame.new(0, 0.9, -23), C3(160, 160, 166), M.Concrete)
	block(parent, "RingBase", Vector3.new(40, 2.6, 40), cf * CFrame.new(0, 1.3, 0), C3(120, 120, 126), M.Concrete)
	block(parent, "Canvas", Vector3.new(36, 0.2, 36), cf * CFrame.new(0, 2.7, 0), C3(228, 224, 214), M.Fabric)
	-- Corner posts + ropes
	local top = Vector3.new(0, 2.8, 0)
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			block(parent, "CornerPost", Vector3.new(1.2, 7, 1.2), cf * CFrame.new(sx * 17.4, 6.2, sz * 17.4), (sx * sz > 0) and RED or BLUE, M.SmoothPlastic)
			block(parent, "CornerPad", Vector3.new(1.8, 2.2, 1.8), cf * CFrame.new(sx * 17.4, 4.8, sz * 17.4), (sx * sz > 0) and RED or BLUE, M.Fabric)
		end
	end
	for i, y in { 4.2, 5.8, 7.4 } do
		local color = i == 2 and WHITE or (i == 1 and RED or BLUE)
		for side = -1, 1, 2 do
			block(parent, "RopeX", Vector3.new(34.8, 0.35, 0.35), cf * CFrame.new(0, y, side * 17.4), color, M.SmoothPlastic, { CanCollide = false })
			block(parent, "RopeZ", Vector3.new(0.35, 0.35, 34.8), cf * CFrame.new(side * 17.4, y, 0), color, M.SmoothPlastic, { CanCollide = false })
		end
	end
	-- Corner markers where duelists stand
	local padA = cf * CFrame.new(-10, 2.9, 0)
	local padB = cf * CFrame.new(10, 2.9, 0)
	disk(parent, "CornerA", padA.Position, 3.5, 0.15, BLUE, M.SmoothPlastic).CanCollide = false
	disk(parent, "CornerB", padB.Position, 3.5, 0.15, RED, M.SmoothPlastic).CanCollide = false
	sign(parent, (cf * CFrame.new(0, 15, 20)).Position, inward, Vector3.new(26, 5, 0.6), "🥊  DUEL RING", C3(150, 30, 20))
	for side = -1, 1, 2 do
		block(parent, "SignPost", Vector3.new(1.2, 15, 1.2), cf * CFrame.new(side * 15, 7.5, 20), DARK, M.Metal)
	end
	buildDummy(parent, (cf * CFrame.new(-26, 0.4, -8)).Position, inward)
	local ringGlow = Config.Buildings.ring.Glow
	for sx = -1, 1, 2 do
		for sz = -1, 1, 2 do
			Decor.smoke(parent, (cf * CFrame.new(sx * 17.4, 9.8, sz * 17.4)).Position, ringGlow, 0.8)
		end
	end
	Decor.groundAura(parent, pos, 32, ringGlow)
	return { padA = padA, padB = padB, center = pos + Vector3.new(0, 2.8, 0) }
end

--------------------------------------------------------------------------------
-- The Mog Competition stage (centre of the plaza)
--------------------------------------------------------------------------------
local function buildStage(parent)
	disk(parent, "StageStep", Vector3.new(0, 0.9, 0), 28, 0.9, C3(150, 150, 156), M.Concrete)
	disk(parent, "Stage", Vector3.new(0, 1.8, 0), 24, 0.9, C3(196, 196, 202), M.Concrete)
	disk(parent, "StageEmblem", Vector3.new(0, 1.85, 0), 15, 0.1, YELLOW, M.SmoothPlastic)
	disk(parent, "StageEmblemInner", Vector3.new(0, 1.9, 0), 13.5, 0.1, C3(196, 196, 202), M.Concrete)
	Decor.groundAura(parent, Vector3.zero, 40, Config.Buildings.stage.Glow)
	-- A low status board behind the stage (kept short so it never blocks the view)
	local _, boardLabel = sign(parent, Vector3.new(0, 4.4, 31), Vector3.new(0, 0, 1), Vector3.new(22, 5, 0.8), "MOG COMPETITION\nsoon...", C3(30, 30, 38), WHITE)
	boardLabel.TextScaled = true
	for side = -1, 1, 2 do
		block(parent, "BannerPost", Vector3.new(1, 3, 1), CFrame.new(side * 9, 1.5, 31), DARK, M.Metal)
	end
	-- Podium
	local function podium(x, h, color, number)
		block(parent, "Podium", Vector3.new(8, h, 6), CFrame.new(x, 1.8 + h / 2, -14), color, M.Metal)
		local face, label = sign(parent, Vector3.new(x, 1.8 + h / 2, -10.9), Vector3.new(0, 0, 1), Vector3.new(5, math.max(1.6, h - 0.6), 0.2), number, color, WHITE)
		return face
	end
	podium(0, 3.6, C3(230, 190, 50), "1")
	podium(-9, 2.5, C3(190, 195, 205), "2")
	podium(9, 1.6, C3(190, 120, 60), "3")
	-- Bleachers on both sides
	for side = -1, 1, 2 do
		for tier = 1, 3 do
			block(parent, "Bleacher", Vector3.new(6, tier * 2, 22), CFrame.new(side * (42 + tier * 6), tier, 0), C3(110, 90, 70), M.Wood)
		end
	end
	return boardLabel
end

--------------------------------------------------------------------------------
-- Catwalk, Top Moggers board, ground and town
--------------------------------------------------------------------------------
local function buildCatwalk(parent)
	local z1, z2, hw = Config.Runway.MinZ, Config.Runway.MaxZ, Config.Runway.HalfWidth
	local length = z2 - z1
	block(parent, "Catwalk", Vector3.new(hw * 2, 0.6, length), CFrame.new(0, 0.5, (z1 + z2) / 2), WHITE, M.SmoothPlastic)
	for side = -1, 1, 2 do
		block(parent, "CatwalkEdge", Vector3.new(0.6, 0.3, length), CFrame.new(side * (hw - 0.4), 0.9, (z1 + z2) / 2), YELLOW, M.SmoothPlastic, { CanCollide = false })
	end
	for z = z1 + 5, z2 - 5, 10 do
		block(parent, "CatwalkLine", Vector3.new(hw * 2 - 1.5, 0.1, 0.5), CFrame.new(0, 0.85, z), C3(210, 210, 215), M.SmoothPlastic, { CanCollide = false })
	end
	sign(parent, Vector3.new(0, 11, z2 + 4), Vector3.new(0, 0, 1), Vector3.new(24, 5, 0.6), "💃  CATWALK  ·  walk it for Aura", C3(130, 40, 100))
	for side = -1, 1, 2 do
		block(parent, "CatwalkSignPost", Vector3.new(1.2, 12, 1.2), CFrame.new(side * 11, 6, z2 + 4), DARK, M.Metal)
	end
end

local function buildBoard(parent)
	local a = math.rad(148)
	local pos = Vector3.new(math.cos(a) * 132, 11, math.sin(a) * 132)
	local facing = Vector3.new(-math.cos(a), 0, -math.sin(a))
	local face = sign(parent, pos, facing, Vector3.new(34, 18, 0.8), "", C3(30, 40, 70))
	local gui = face:FindFirstChildOfClass("SurfaceGui")
	local title = gui:FindFirstChildOfClass("TextLabel")
	title.Size = UDim2.new(1, 0, 0.2, 0)
	title.Text = "🏆  TOP MOGGERS"
	title.TextColor3 = YELLOW
	local list = Instance.new("TextLabel")
	list.Position = UDim2.fromScale(0.04, 0.22)
	list.Size = UDim2.fromScale(0.92, 0.74)
	list.BackgroundTransparency = 1
	list.Font = Enum.Font.GothamBold
	list.TextSize = 36
	list.TextXAlignment = Enum.TextXAlignment.Left
	list.TextYAlignment = Enum.TextYAlignment.Top
	list.TextColor3 = WHITE
	list.TextStrokeTransparency = 0.3
	list.Text = "Nobody here yet."
	list.Parent = gui
	local tangent = Vector3.new(-math.sin(a), 0, math.cos(a))
	for side = -1, 1, 2 do
		block(parent, "BoardPost", Vector3.new(1.4, 11, 1.4), CFrame.new(pos + tangent * (side * 14) - Vector3.new(0, 5.5, 0)), DARK, M.Metal)
	end
	return list
end

--------------------------------------------------------------------------------
-- Entry point
--------------------------------------------------------------------------------
function World.build()
	for _, child in workspace:GetChildren() do
		if child.Name == "Baseplate" or child.Name == "SpawnLocation" or child.Name == "GlowWorld" then
			child:Destroy()
		end
	end
	setupLighting()

	local world = Instance.new("Folder")
	world.Name = "GlowWorld"
	world.Parent = workspace

	Island.build(world)
	buildCatwalk(world)
	local boardLabel = buildBoard(world)
	local compBoard = buildStage(world)

	local spawn = Instance.new("SpawnLocation")
	spawn.Anchored = true
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 0.6, 138)
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = world

	buildHammerRow(world)
	buildGym(world)
	buildStudio(world)
	buildLounge(world)
	buildCrateShop(world)
	local arena = buildRing(world)
	trainingPlatforms(world)
	buildTreadHall(world)
	local battle = buildBattle(world)

	return {
		arena = arena,
		battle = battle,
		board = boardLabel,
		compBoard = compBoard,
		stage = { center = Vector3.new(0, 1.8, 0) },
	}
end

return World
]]></string>
          </Properties>
        </Item>
