function Hud.toggleRebirth(force)
	local win = refs.rebirthWin
	local show = force
	if show == nil then
		show = not win.Visible
	end
	win.Visible = show
	if show then
		Hud.refresh()
	end
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------
function Hud.init(gui, Menu, Action)
	buildTop(gui, Menu)
	buildSides(gui, Menu)
	buildBottom(gui)
	buildRebirth(gui, Action)
	buildPlaces(gui)

	-- Shrink the whole HUD on small screens (phones) so nothing crowds the view.
	local function fit()
		local v = camera.ViewportSize
		local s = math.clamp(math.min(v.X / 900, v.Y / 520), 0.6, 1)
		for _, scale in fitScales do
			scale.Scale = s
		end
	end
	fit()
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(fit)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.M then
			Menu.toggle()
		end
	end)

	player:GetAttributeChangedSignal("Aura"):Connect(function()
		local now = player:GetAttribute("Aura") or 0
		if now > lastAura then
			pending += now - lastAura
			lastGain = os.clock()
			UI.pop(refs.auraScale, 1.06)
		end
		lastAura = now
	end)

	local lastSlow = 0
	RunService.RenderStepped:Connect(function(dt)
		local t = os.clock()

		local aura = player:GetAttribute("Aura") or 0
		shownAura += (aura - shownAura) * math.min(1, dt * 9)
		if math.abs(aura - shownAura) < 0.5 then
			shownAura = aura
		end
		refs.bigAura.Text = "🏆 " .. Util.fmt(shownAura)

		if pending > 0 then
			refs.ticker.Text = "+" .. Util.fmt(pending)
			if t - lastGain < 1.1 then
				refs.ticker.TextTransparency = 0
			else
				refs.ticker.TextTransparency = math.min(1, (t - lastGain - 1.1) / 0.4)
				if refs.ticker.TextTransparency >= 1 then
					pending = 0
				end
			end
		end

		-- Mog Streak / Frenzy chip
		local now = workspace:GetServerTimeNow()
		local frenzyLeft = (player:GetAttribute("FrenzyEnd") or 0) - now
		if frenzyLeft > 0 then
			refs.streak.Visible = true
			refs.streakText.Text = string.format("🔥 FRENZY x%d  ·  %.1fs", Config.Frenzy.Mult, frenzyLeft)
			refs.streakText.TextColor3 = C.Yellow
			refs.streakBar.set(frenzyLeft / Config.Frenzy.Duration)
			refs.streakBar.fill.BackgroundColor3 = C.Yellow
		else
			refs.streak.Visible = false
		end
		-- Treadmill heat
		local heat = player:GetAttribute("RunHeat") or 0
		if (player:GetAttribute("Running") or 0) > 0 then
			refs.run.Visible = true
			refs.runText.Text = string.format("🏃 HEAT x%.2f  ·  %ds", Config.RunHeatMult(heat), heat)
			refs.runBar.set(heat / Config.RunHeatMax)
		else
			refs.run.Visible = false
		end
		if t - lastSlow > 0.15 then
			lastSlow = t
			Hud.refresh()
		end
	end)
end

function Hud.pulseQuest()
	UI.pop(refs.questScale, 1.15)
end

-- The total multiplier on every swing (hammer x pets x rebirth x boost x event).
function Hud.swingMult()
	local hammer = Config.HammerById[player:GetAttribute("Hammer") or 1] or Config.Hammers[1]
	local rebirths = player:GetAttribute("Rebirths") or 0
	local ev = workspace:GetAttribute("Event")
	local evDef = ev and ev ~= "" and Config.EventById[ev]
	local boost = Config.BoostMult(player:GetAttribute("Lv_Boost") or 0)
	return hammer.Mult * (1 + (player:GetAttribute("PetMult") or 0)) * Config.RebirthMult(rebirths) * boost * ((evDef and evDef.AuraMult) or 1)
end

function Hud.refresh()
	local level = player:GetAttribute("Level") or 1
	local rankIndex = player:GetAttribute("Rank") or 1
	local rank = Config.Ranks[rankIndex]
	local xp = player:GetAttribute("XP") or 0
	local needed = player:GetAttribute("XPNeeded") or 1
	local rebirths = player:GetAttribute("Rebirths") or 0
	local need = player:GetAttribute("RebirthNeed") or Config.RebirthRequirement(rebirths)

	-- Level bar
	refs.levelText.Text = string.format("LEVEL %s   %s/%s   ·   %s", Util.fmt(level), Util.fmt(xp), Util.fmt(needed), rank.Name:upper())
	refs.xpBar.fill.BackgroundColor3 = rank.Color
	refs.xpBar.set(xp / needed)
	tint(refs.levelFrame, rank.Color)

	-- Banner + pills
	local mult = Hud.swingMult()
	refs.banner.Text = string.format("Click to swing  •  ×%s  •  Rebirth at Lv %d", Util.fmt(mult), need)
	refs.rebirthPill.Text = "★ " .. rebirths

	-- Rebirth button percentage + window
	local pct = math.clamp(level / need, 0, 1)
	-- "Rebirth ready!" once, the moment you reach the level (and again after each rebirth)
	local ready = level >= need
	if ready and not refs.rebirthWasReady and refs.sawFirstRefresh then
		Audio.say("rebirth")
		Audio.rank()
		UI.pop(refs.questScale, 1.15)
	end
	refs.rebirthWasReady = ready
	refs.sawFirstRefresh = true
	refs.rebirthCaption.Text = math.floor(pct * 100) .. "%"
	refs.rebirthBar.set(pct)
	if refs.rebirthWin.Visible then
		refs.rebirthInfo.Text = string.format(
			"Reach level %d to be reborn.\nYou keep your level, hammers and outfits.\nAura, stats and upgrades reset.\nEvery rebirth adds +50%% Aura and XP forever and gives 2 free crates.",
			need
		)
		refs.rebirthProg.set(pct)
		refs.rebirthGo.Text = ready and "REBIRTH NOW" or string.format("LEVEL %d / %d", level, need)
		refs.rebirthGo.BackgroundColor3 = ready and C.Good or C.Disabled
	end

	if refs.placesWin.Visible then
		local own = {}
		for b in string.gmatch(player:GetAttribute("Own") or "gym", "%w+") do
			own[b] = true
		end
		for i, place in PLACES do
			local label = refs.placeStatus[i]
			if not place.building or own[place.building] then
				label.Text, label.TextColor3 = "OPEN", C.Good
			else
				local cost = Config.Buildings[place.building].Cost
				label.Text = "🔒 " .. Util.fmt(cost)
				label.TextColor3 = (player:GetAttribute("Aura") or 0) >= cost and C.Yellow or C.Danger
			end
		end
	end

	-- Quest
	local kind = player:GetAttribute("QuestKind")
	refs.quest.Visible = kind ~= nil and (player:GetAttribute("TutStep") or 99) > #Config.Tutorial
	if kind then
		local goal = player:GetAttribute("QuestGoal") or 1
		local progress = player:GetAttribute("QuestProgress") or 0
		refs.questText.Text = Config.QuestText(kind, goal)
		refs.questCount.Text = progress .. "/" .. goal
		refs.questBar.set(progress / goal)
	end

	-- Event chip
	local id = workspace:GetAttribute("Event")
	local ev = id and id ~= "" and Config.EventById[id]
	local left = (workspace:GetAttribute("EventEnd") or 0) - workspace:GetServerTimeNow()
	if ev and left > 0 then
		refs.event.Visible = true
		refs.eventText.Text = string.format("%s %s  %s", ev.Icon, ev.Name, Util.clock(left))
		refs.eventText.TextColor3 = C.Pink
	else
		refs.event.Visible = false
	end

	-- Mog Competition chip
	local compState = workspace:GetAttribute("CompState")
	local compLeft = (workspace:GetAttribute("CompEnd") or 0) - workspace:GetServerTimeNow()
	if compState == "open" and compLeft > 0 then
		refs.comp.Visible = true
		refs.compText.Text = string.format("🏆 Mog Competition OPEN  %s", Util.clock(compLeft))
		refs.compText.TextColor3 = C.Orange
	else
		refs.comp.Visible = false
	end

	-- Badges: a dot means "something is waiting for you"
	local aura = player:GetAttribute("Aura") or 0
	local affordable = false
	for _, def in Config.Upgrades do
		local lvl = player:GetAttribute("Lv_" .. def.Id) or 0
		if lvl < def.Max and aura >= Config.UpgradeCost(def, lvl) then
			affordable = true
		end
	end
	refs.badges.Rewards.Visible = player:GetAttribute("DailyReady") == true
	refs.badges.Crates.Visible = (player:GetAttribute("FreeCrates") or 0) > 0
	refs.badges.Upgrades.Visible = affordable
	refs.badges.Wardrobe.Visible = refs.newItem == true
end

function Hud.setNewItem(flag)
	refs.newItem = flag
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Interact</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: "use" button for every place and hammer. Stand near something and a big button
-- appears at the bottom of the screen (or press E). It looks at where your CHARACTER is, never at the camera,
-- so it works the same from any camera angle, zoom or screen size.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local Interact = {}

local player = Players.LocalPlayer
local camera = workspace:WaitForChild("Camera")
local C = UI.Colors

local button, label, scale
local current -- { id, text, color }
local actionFn
local menu

local function flat(a, b)
	local d = a - b
	return Vector3.new(d.X, 0, d.Z).Magnitude
end

local function owned(id)
	for n in string.gmatch(player:GetAttribute("HammersOwned") or "1", "%d+") do
		if tonumber(n) == id then
			return true
		end
	end
	return false
end

local function ownedBuilding(id)
	for b in string.gmatch(player:GetAttribute("Own") or "gym", "%w+") do
		if b == id then
			return true
		end
	end
	return false
end

local function ownedTread(id)
	for n in string.gmatch(player:GetAttribute("Treads") or "1", "%d+") do
		if tonumber(n) == id then
			return true
		end
	end
	return false
end

local function treadText(t)
	local running = player:GetAttribute("Running") or 0
	if running == t.Id then
		return "Stop running", C.Danger
	elseif ownedTread(t.Id) then
		return string.format("Run on %s  ·  +%s/s", t.Name, Util.fmt(t.Rate)), C.Good
	end
	local canBuy = (player:GetAttribute("Aura") or 0) >= t.Price
	return string.format("Buy %s  ·  🏆 %s", t.Name, Util.fmt(t.Price)), canBuy and C.Gold or C.Danger
end

local function hammerText(hammer)
	if (player:GetAttribute("Hammer") or 1) == hammer.Id then
		return hammer.Name .. " (equipped)", C.Disabled
	elseif owned(hammer.Id) then
		return "Equip " .. hammer.Name, C.Mint
	end
	local price = Util.fmt(hammer.Price)
	local canBuy = (player:GetAttribute("Aura") or 0) >= hammer.Price
	return string.format("Buy %s  ·  🏆 %s", hammer.Name, price), canBuy and C.Gold or C.Danger
end

-- Picks the closest thing in range of the character.
local function scan()
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not root or menu.isOpen() or player:GetAttribute("Training") or player:GetAttribute("InDuel") then
		return nil
	end
	-- While running on a treadmill the only thing you can do is step off.
	if (player:GetAttribute("Running") or 0) > 0 then
		return { id = "TreadStop", text = "Stop running", color = C.Danger }
	end
	local best, bestScore
	local pos = root.Position
	for _, hammer in Config.Hammers do
		local d = flat(pos, Config.HammerPos(hammer.Id))
		if d <= Config.HammerRadius and (not bestScore or d / Config.HammerRadius < bestScore) then
			local text, color = hammerText(hammer)
			best, bestScore = { id = "Hammer:" .. hammer.Id, text = text, color = color }, d / Config.HammerRadius
		end
	end
	for _, t in Config.Treadmills do
		local d = flat(pos, Config.TreadPos(t.Id))
		local r = Config.TreadRadius
		if d <= r and (not bestScore or d / r < bestScore) then
			local text, color = treadText(t)
			best, bestScore = { id = "Tread:" .. t.Id, text = text, color = color }, d / r
		end
	end
	for _, entry in Config.Interactables do
		local d = flat(pos, Config.InteractPos(entry))
		if d <= entry.Radius and (not bestScore or d / entry.Radius < bestScore) then
			local text = entry.Action
			if entry.Id == "Battle" then
				local stage = math.min((player:GetAttribute("Stage") or 0) + 1, Config.Battle.Count)
				text = string.format("Stage %d battle: %s", stage, Config.Battle.Stages[stage].Name)
			end
			local color = C.Good
			if entry.Building and not ownedBuilding(entry.Building) then
				local def = Config.Buildings[entry.Building]
				text = string.format("🔒 Unlock %s  ·  🏆 %s", def.Name, Util.fmt(def.Cost))
				color = (player:GetAttribute("Aura") or 0) >= def.Cost and C.Gold or C.Danger
			end
			best, bestScore = { id = entry.Id, text = text, color = color }, d / entry.Radius
		end
	end
	return best
end

local function trigger()
	if current then
		Audio.click()
		actionFn(current.id)
	end
end

function Interact.init(gui, Action, Menu)
	menu = Menu
	actionFn = function(id)
		if id == "TreadStop" then
			Action:FireServer("TreadStop")
		else
			Action:FireServer("Interact", id)
		end
	end
	button = UI.button(gui, {
		Name = "InteractButton",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -112),
		Size = UDim2.fromOffset(320, 48),
		Visible = false,
		ZIndex = 30,
		Text = "",
	})
	scale = UI.new("UIScale", {}, button)
	label = UI.label(button, {
		Size = UDim2.fromScale(1, 1),
		Font = UI.Fonts.Title,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		ZIndex = 31,
		Text = "",
	})
	button.Activated:Connect(trigger)

	UserInputService.InputBegan:Connect(function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.E then
			trigger()
		end
	end)

	local last = 0
	RunService.Heartbeat:Connect(function()
		local now = os.clock()
		if now - last < 0.1 then
			return
		end
		last = now
		local found = scan()
		local changed = (found == nil) ~= (current == nil) or (found and current and found.id ~= current.id)
		current = found
		if not found then
			button.Visible = false
			return
		end
		if changed then
			button.Visible = true
			UI.pop(scale, 1.08)
		end
		local keyHint = UserInputService.KeyboardEnabled and "[E]  " or ""
		label.Text = keyHint .. found.text
		button.BackgroundColor3 = found.color
		-- keep the button above the bottom bar on every screen size
		local v = camera.ViewportSize
		scale.Scale = math.clamp(math.min(v.X / 900, v.Y / 520), 0.7, 1)
	end)
end

return Interact
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Menu</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the one main menu. A single window with a tab list so the screen never fills up with
-- competing panels. Tabs register themselves with Menu.addTab(name, icon, builder).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local Menu = {}

local camera = workspace:WaitForChild("Camera")
local backdrop, window, content, scale
local tabs = {} -- ordered { name, icon, builder, button, page, refresh }
local current
local open = false
local onChanged = {}

local WINDOW_W, WINDOW_H = 760, 460

function Menu.isOpen()
	return open
end

function Menu.current()
	return current
end

function Menu.onChanged(fn)
	table.insert(onChanged, fn)
end

local function fitScale()
	local v = camera.ViewportSize
	local s = math.min(v.X / (WINDOW_W + 40), v.Y / (WINDOW_H + 40), 1)
	return math.max(0.5, s)
end

local function select(name)
	for _, tab in tabs do
		local active = tab.name == name
		tab.page.Visible = active
		if active and Menu.sidebar then
			-- "bare" tabs (Store, Rewards) draw their own header, so the shared title, X and sidebar step aside
			Menu.sidebar.Visible = not tab.bare
			Menu.chrome.Visible = not tab.bare
		end
		UI.tween(tab.button, 0.15, {
			BackgroundColor3 = active and UI.Colors.Accent or UI.Colors.Card,
			BackgroundTransparency = active and 0.1 or 0.35,
		})
		if active then
			current = name
			if tab.refresh then
				tab.refresh()
			end
		end
	end
	for _, fn in onChanged do
		fn(name)
	end
end

function Menu.init(gui)
	backdrop = UI.new("TextButton", {
		Name = "MenuBackdrop",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(6, 4, 16),
		BackgroundTransparency = 1,
		AutoButtonColor = false,
		Text = "",
		Visible = false,
		ZIndex = 20,
	}, gui)
	backdrop.Activated:Connect(function()
		Menu.close()
	end)

	window = UI.panel(backdrop, {
		Name = "Window",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(WINDOW_W, WINDOW_H),
		BackgroundTransparency = 0.04,
		ZIndex = 21,
		Radius = 20,
	})
	scale = UI.new("UIScale", { Scale = fitScale() }, window)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		scale.Scale = fitScale()
	end)
	-- Clicks inside the window must not fall through to the backdrop.
	UI.new("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 21, AutoButtonColor = false }, window)

	local chrome = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 22 }, window)
	Menu.chrome = chrome
	local header = UI.label(chrome, {
		Position = UDim2.fromOffset(24, 14),
		Size = UDim2.fromOffset(420, 30),
		Font = UI.Fonts.Title,
		TextSize = 24,
		TextColor3 = UI.Colors.Text,
		Text = Config.GameName:upper(),
		ZIndex = 22,
	})
	UI.gradient(header, UI.Colors.Cyan, UI.Colors.Accent2, 0)

	local closeButton = UI.button(chrome, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 14),
		Size = UDim2.fromOffset(34, 34),
		Text = "✕",
		TextSize = 16,
		ZIndex = 23,
		Radius = 17,
	}, "card")
	closeButton.Activated:Connect(function()
		Audio.click()
		Menu.close()
	end)

	local sidebar = UI.new("Frame", {
		Position = UDim2.fromOffset(16, 62),
		Size = UDim2.fromOffset(170, WINDOW_H - 78),
		BackgroundTransparency = 1,
		ZIndex = 22,
	}, window)
	UI.new("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, sidebar)
	Menu.sidebar = sidebar

	content = UI.new("Frame", {
		Position = UDim2.fromOffset(200, 62),
		Size = UDim2.fromOffset(WINDOW_W - 216, WINDOW_H - 78),
		BackgroundTransparency = 1,
		ZIndex = 22,
		ClipsDescendants = true,
	}, window)
end

function Menu.addTab(name, icon, builder, bare)
	local index = #tabs + 1
	local button = UI.button(Menu.sidebar, {
		LayoutOrder = index,
		Visible = not bare,
		Size = UDim2.new(1, 0, 0, 38),
		BackgroundTransparency = 0.35,
		Text = "",
		ZIndex = 23,
	}, "card")
	UI.label(button, {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.new(1, -20, 1, 0),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		Text = icon .. "   " .. name,
		TextWrapped = false,
		ZIndex = 24,
	})
	local badge = UI.new("Frame", {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Size = UDim2.fromOffset(10, 10),
		BackgroundColor3 = UI.Colors.Accent2,
		Visible = false,
		ZIndex = 25,
	}, button)
	UI.corner(badge, 5)

	local page = UI.new("Frame", {
		Name = name,
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 22,
	}, bare and window or content)
	local api = builder(page) or {}
	local tab = { name = name, icon = icon, button = button, page = page, refresh = api.refresh, badge = badge, bare = bare }
	table.insert(tabs, tab)
	button.Activated:Connect(function()
		Audio.click()
		select(name)
	end)
	return tab
end

function Menu.setBadge(name, visible)
	for _, tab in tabs do
		if tab.name == name then
			tab.badge.Visible = visible
		end
	end
end

function Menu.open(name)
	if not backdrop then
		return
	end
	if not open then
		open = true
		backdrop.Visible = true
		backdrop.BackgroundTransparency = 1
		UI.tween(backdrop, 0.2, { BackgroundTransparency = 0.45 })
		local target = fitScale()
		scale.Scale = target * 0.9
		UI.tween(scale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
	end
	select(name or current or (tabs[1] and tabs[1].name))
end

function Menu.close()
	if not open then
		return
	end
	open = false
	UI.tween(backdrop, 0.15, { BackgroundTransparency = 1 })
	UI.tween(scale, 0.15, { Scale = fitScale() * 0.92 })
	task.delay(0.16, function()
		if not open then
			backdrop.Visible = false
		end
	end)
	for _, fn in onChanged do
		fn(nil)
	end
end

function Menu.toggle(name)
	if open and (name == nil or current == name) then
		Menu.close()
	else
		Menu.open(name)
	end
end

-- Refresh the visible tab (called a few times a second while open).
function Menu.refresh()
	if not open then
		return
	end
	for _, tab in tabs do
		if tab.name == current and tab.refresh then
			tab.refresh()
		end
	end
end

return Menu
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">PetsView</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: draws every player's equipped pets on your own screen. They trot after their owner with real
-- animal animation (walk cycle, tail sway, wing flaps...), turn to face where they are going, and hover or swim for
-- the flying ones. Doing this on each client keeps it smooth and costs the server nothing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local Animals = require(Shared:WaitForChild("Animals"))

local PetsView = {}

local camera = workspace:WaitForChild("Camera")
local folder
local views = {} -- Player -> { eq = string, pets = { { rig, pos, yaw } } }

-- Where each pet walks, relative to its owner (x = right, z = behind).
local SLOTS = { Vector3.new(-4.2, 0, 5), Vector3.new(0, 0, 8.2), Vector3.new(4.2, 0, 5) }
local NEAR = 120 -- animate pets closer than this to the camera

local function destroyView(view)
	for _, pet in view.pets do
		pet.rig.model:Destroy()
	end
	view.pets = {}
end

local function rebuild(view, eq)
	destroyView(view)
	view.eq = eq
	for id in string.gmatch(eq, "%w+") do
		local def = Config.PetById[id]
		local rig = def and Animals.build(def.Species)
		if rig then
			rig.model.Parent = folder
			table.insert(view.pets, { rig = rig, pos = nil, yaw = 0, groundY = nil, lastRay = 0, shown = true })
		end
	end
end

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function groundAt(x, y, z, fallback)
	local hit = workspace:Raycast(Vector3.new(x, y + 6, z), Vector3.new(0, -40, 0), rayParams)
	return hit and hit.Position.Y or fallback
end

local function step(player, view, dt, now)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		return
	end
	local eq = player:GetAttribute("PetsEq") or ""
	if eq ~= view.eq then
		rebuild(view, eq)
	end
	local cf = root.CFrame
	local fallbackGround = root.Position.Y - (hum.HipHeight + root.Size.Y / 2) - (hum.RigType == Enum.HumanoidRigType.R6 and 2 or 0)
	local scaleUp = math.clamp(root.Size.Y / 2, 0.8, 1.6)
	for i, pet in view.pets do
		local rig = pet.rig
		local slot = SLOTS[i] or SLOTS[2]
		local want = cf:PointToWorldSpace(Vector3.new(slot.X * scaleUp, 0, slot.Z * scaleUp))
		if not pet.pos then
			pet.pos = Vector3.new(want.X, fallbackGround, want.Z)
			pet.groundY = fallbackGround
		end
		-- ground height (a ray a few times a second, not every frame)
		if now - pet.lastRay > 0.25 then
			pet.lastRay = now
			pet.groundY = groundAt(pet.pos.X, root.Position.Y, pet.pos.Z, fallbackGround)
		end
		local old = pet.pos
		local flat = Vector3.new(want.X - old.X, 0, want.Z - old.Z)
		local dist = flat.Magnitude
		-- follow: speed grows with the gap so pets keep up with a sprinting owner
		local move = flat * math.min(1, dt * (2 + dist * 0.6))
		local nx, nz = old.X + move.X, old.Z + move.Z
		if dist > 40 then
			nx, nz = want.X, want.Z -- fell far behind (teleport): snap
		end
		pet.pos = Vector3.new(nx, pet.groundY, nz)
		local speed = dt > 0 and math.sqrt((nx - old.X) ^ 2 + (nz - old.Z) ^ 2) / dt or 0
		-- face the way we are walking, or the way the owner faces when standing still
		local targetYaw
		if speed > 1 then
			targetYaw = math.atan2(-(nx - old.X), -(nz - old.Z))
		else
			local look = cf.LookVector
			targetYaw = math.atan2(-look.X, -look.Z)
		end
		local diff = (targetYaw - pet.yaw + math.pi) % (math.pi * 2) - math.pi
		pet.yaw += diff * math.min(1, dt * 8)
		local near = (camera.CFrame.Position - pet.pos).Magnitude < NEAR
		-- far-away pets are taken out of the world entirely (they have 100+ parts each)
		if near ~= pet.shown then
			pet.shown = near
			rig.model.Parent = near and folder or nil
		end
		local breath = near and Animals.animate(rig, dt, speed) or 0
		local bob = 0
		if rig.def.float and rig.def.float > 0 then
			bob = math.sin(now * 2 + i) * 0.35
		end
		rig.root.CFrame = CFrame.new(pet.pos.X, pet.pos.Y + rig.groundDrop + breath + bob, pet.pos.Z) * CFrame.Angles(0, pet.yaw, 0)
	end
end

function PetsView.init()
	folder = Instance.new("Folder")
	folder.Name = "GlowPetsLocal"
	folder.Parent = workspace
	rayParams.FilterDescendantsInstances = { folder }
	Players.PlayerRemoving:Connect(function(player)
		local view = views[player]
		if view then
			destroyView(view)
			views[player] = nil
		end
	end)
	RunService.RenderStepped:Connect(function(dt)
		local now = os.clock()
		dt = math.min(dt, 0.1)
		for _, player in Players:GetPlayers() do
			local view = views[player]
			if not view then
				view = { eq = "", pets = {} }
				views[player] = view
			end
			local ok, err = pcall(step, player, view, dt, now)
			if not ok then
				warn("[TrueAdam] pet update failed:", err)
				destroyView(view)
				view.eq = ""
				task.wait(1)
			end
		end
	end)
end

return PetsView
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Runner</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: everything you see and feel while running on a treadmill: the run animation, a wider field of
-- view, speed lines rushing past, and (from init.client) a shockwave and number every second. The server does the
-- freezing, the Aura and the flames around you.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Fx = require(script.Parent.Fx)

local Runner = {}

local player = Players.LocalPlayer
local RUN_R15, RUN_R6 = "rbxassetid://913376220", "rbxassetid://180426354"
local track
local lines -- container for the speed lines
local activeId = 0
local acc = 0

function Runner.init(gui)
	lines = UI.new("Frame", {
		Name = "SpeedLines",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 0,
		Visible = false,
	}, gui)
	RunService.RenderStepped:Connect(function(dt)
		if activeId == 0 then
			return
		end
		acc += dt
		local interval = math.max(0.02, 0.07 - activeId * 0.002)
		while acc >= interval do
			acc -= interval
			local def = Config.Treadmills[activeId]
			local angle = math.random() * math.pi * 2
			local line = UI.new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(3, 40 + math.random() * 70),
				Position = UDim2.fromScale(0.5 + math.cos(angle) * 0.18, 0.5 + math.sin(angle) * 0.18),
				Rotation = math.deg(angle) + 90,
				BackgroundColor3 = def.Rainbow and Color3.fromHSV(math.random(), 0.7, 1) or def.Color:Lerp(Color3.new(1, 1, 1), 0.4),
				BackgroundTransparency = 0.35,
				BorderSizePixel = 0,
			}, lines)
			UI.tween(line, 0.45, {
				Position = UDim2.fromScale(0.5 + math.cos(angle) * 0.75, 0.5 + math.sin(angle) * 0.75),
				BackgroundTransparency = 1,
			}, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(0.5, function()
				line:Destroy()
			end)
		end
	end)
end

function Runner.stop()
	activeId = 0
	if lines then
		lines.Visible = false
	end
	Fx.setBaseFov(70)
	if track then
		pcall(function()
			track:Stop(0.2)
			track:Destroy()
		end)
		track = nil
	end
end

function Runner.start(treadmillId)
	Runner.stop()
	activeId = treadmillId
	if lines then
		lines.Visible = true
	end
	Fx.setBaseFov(78 + math.min(treadmillId, 20) * 0.8)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local animator = hum and hum:FindFirstChildOfClass("Animator")
	if not animator then
		return
	end
	pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = hum.RigType == Enum.HumanoidRigType.R15 and RUN_R15 or RUN_R6
		track = animator:LoadAnimation(anim)
		track.Looped = true
		track.Priority = Enum.AnimationPriority.Action
		track:Play(0.2)
		track:AdjustSpeed(1 + treadmillId * 0.08)
	end)
end

-- Once a second: a shockwave under your feet, a number over your head, and a punch of camera.
function Runner.tick(gained, heat, id)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	local head = char and char:FindFirstChild("Head")
	if not root or not head then
		return
	end
	local def = Config.Treadmills[id]
	local color = def.Rainbow and Color3.fromHSV((os.clock() * 0.6) % 1, 0.7, 1) or def.Color
	Fx.ring(root.Position, color, 10 + id * 1.2)
	Fx.floatText(head.Position + Vector3.new(0, 2.5, 0), "+" .. Util.fmt(gained), color, 20 + math.min(id, 12))
	Fx.punch(0.8 + id * 0.1)
	if heat % 5 == 0 then
		Fx.pillar(root.Position, color, 40 + id * 3)
		Fx.burst(root.Position, color, 20 + id * 2)
		Fx.shake(0.15 + id * 0.01, 0.25)
	end
end

return Runner
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Swing</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: click / tap anywhere (or hold) to swing your hammer at your own face.
-- Every swing earns Aura (hammer x rebirth x boosts) and a little XP. The server does the maths; this
-- file only handles the input and the feel (arm swing, sound, floating number).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local Swing = {}

local player = Players.LocalPlayer
local holding = false
local lastSwing = 0
local swingCount = 0
local Action, Menu
local armBusy = false

local function blocked()
	return Menu.isOpen() or player:GetAttribute("Training") == true or player:GetAttribute("InDuel") == true
end

local function shoulder()
	local char = player.Character
	if not char then
		return nil
	end
	local arm = char:FindFirstChild("RightUpperArm")
	local motor = arm and arm:FindFirstChild("RightShoulder")
	if not motor then
		local torso = char:FindFirstChild("Torso")
		motor = torso and torso:FindFirstChild("Right Shoulder")
	end
	return motor
end

-- A quick overhead chop with the right arm (only you see this; the hammer in hand shows for everyone).
local function animateArm()
	local motor = shoulder()
	if not motor or armBusy then
		return
	end
	armBusy = true
	local rest = motor.C0
	local down = TweenService:Create(motor, TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { C0 = rest * CFrame.Angles(math.rad(-120), 0, 0) })
	local up = TweenService:Create(motor, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { C0 = rest })
	down.Completed:Once(function()
		up:Play()
	end)
	up.Completed:Once(function()
		motor.C0 = rest
		armBusy = false
	end)
	down:Play()
end

local function doSwing()
	local now = os.clock()
	if now - lastSwing < Config.SwingInterval or blocked() then
		return
	end
	lastSwing = now
	animateArm()
	Action:FireServer("Swing")
end

local function isPress(input)
	return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
end

function Swing.init(gui, action, menu)
	Action, Menu = action, menu

	UserInputService.InputBegan:Connect(function(input, processed)
		if processed or not isPress(input) then
			return
		end
		holding = true
		doSwing()
	end)
	UserInputService.InputEnded:Connect(function(input)
		if isPress(input) then
			holding = false
		end
	end)
	-- Holding the button keeps swinging.
	RunService.Heartbeat:Connect(function()
		if holding then
			doSwing()
		end
	end)
end

-- The server confirmed a swing and says how much it paid. tag is "crit" / "jackpot" / nil.
function Swing.result(gained, tag, frenzy)
	swingCount += 1
	local char = player.Character
	local head = char and char:FindFirstChild("Head")
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not head or not root then
		return
	end
	local C = UI.Colors
	if tag == "jackpot" then
		Audio.reveal(5)
		Fx.shake(0.6, 0.6)
		Fx.flash(C.Gold, 0.4, 0.6)
		Fx.ring(root.Position, C.Gold, 40)
		Fx.pillar(root.Position, C.Gold, 90)
		Fx.burst(head.Position, C.Gold, 60)
		Fx.floatText(head.Position + Vector3.new(0, 3, 0), "JACKPOT!  +" .. Util.fmt(gained), C.Gold, 34)
		return
	elseif tag == "crit" then
		Audio.reveal(3)
		Fx.shake(0.3, 0.3)
		Fx.ring(root.Position, C.Orange, 22)
		Fx.burst(head.Position, C.Orange, 24)
		Fx.floatText(head.Position + Vector3.new(0, 3, 0), "CRIT!  +" .. Util.fmt(gained), C.Orange, 28)
		return
	end
	Audio.pickup(0, 1)
	Fx.punch(0.6)
	local color = frenzy and C.Orange or C.Yellow
	if swingCount % 3 == 1 then
		Fx.floatText(head.Position + Vector3.new(0, 2.5, 0), "+" .. Util.fmt(gained), color, frenzy and 24 or 20)
	end
	if swingCount % 4 == 1 or frenzy then
		Fx.burst(head.Position, color, frenzy and 10 or 5)
	end
end

return Swing
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">TabCrates</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: crates tab. The server rolls; this plays the reveal (a spinning reel that slows
-- down, then a rarity-coloured card) so every opening feels like an event.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local player = Players.LocalPlayer
local C = UI.Colors

local TabCrates = {}

local overlay, reel, reelName, reelSub, reelButtons, reelScale
local busy = false
local busyToken = 0
local pending -- last result waiting to be revealed
local equipAction

local function setBusy(flag)
	busy = flag
	busyToken += 1
	if flag then
		local token = busyToken
		task.delay(4, function()
			if busyToken == token then
				busy = false
			end
		end)
	end
end

function TabCrates.build(parent, Action)
	equipAction = Action

	local header = UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 24),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	local row = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 34),
		Size = UDim2.new(1, 0, 1, -34),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, row)

	local cardRefs = {}
	for i, crate in Config.Crates do
		local card = UI.panel(row, {
			LayoutOrder = i,
			Size = UDim2.new(1 / #Config.Crates, -8, 1, -8),
			BackgroundColor3 = C.Card,
			Radius = 16,
		})
		local stroke = card:FindFirstChildOfClass("UIStroke")
		stroke.Color = crate.Color
		stroke.Transparency = 0.35

		UI.label(card, {
			Position = UDim2.fromOffset(0, 14),
			Size = UDim2.new(1, 0, 0, 70),
			Font = UI.Fonts.Bold,
			TextSize = 58,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = crate.Icon,
		})
		UI.label(card, {
			Position = UDim2.fromOffset(0, 90),
			Size = UDim2.new(1, 0, 0, 24),
			Font = UI.Fonts.Title,
			TextSize = 19,
			TextColor3 = crate.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = crate.Name,
		})
		-- Odds list, one rarity per line
		local lines = {}
		for _, rarity in Config.RarityOrder do
			local odds = crate.Odds[rarity]
			if odds then
				table.insert(lines, string.format("%s  %d%%", rarity, odds))
			end
		end
		UI.label(card, {
			Position = UDim2.fromOffset(10, 120),
			Size = UDim2.new(1, -20, 0, 60),
			Font = UI.Fonts.Body,
			TextSize = 13,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = table.concat(lines, "\n"),
		})
		local pity = UI.label(card, {
			Position = UDim2.fromOffset(10, 184),
			Size = UDim2.new(1, -20, 0, 34),
			Font = UI.Fonts.Bold,
			TextSize = 12,
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "",
		})
		local open = UI.button(card, {
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -14),
			Size = UDim2.new(1, -28, 0, 44),
			Text = "",
			TextSize = 17,
		}, "primary")
		open.Activated:Connect(function()
			if busy then
				return
			end
			Audio.click()
			setBusy(true)
			Action:FireServer("OpenCrate", crate.Id)
		end)
		cardRefs[crate.Id] = { open = open, pity = pity, crate = crate }
	end

	-- Reveal overlay (hidden until a result arrives)
	overlay = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.fromRGB(8, 6, 20),
		BackgroundTransparency = 0.05,
		Visible = false,
		ZIndex = 40,
		Active = true,
	}, parent)
	UI.corner(overlay, 16)
	reel = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.4),
		Size = UDim2.fromOffset(200, 130),
		Font = UI.Fonts.Bold,
		TextSize = 100,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "🎁",
		ZIndex = 41,
	})
	reelScale = UI.new("UIScale", {}, reel)
	reelName = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.62),
		Size = UDim2.new(1, -40, 0, 44),
		Font = UI.Fonts.Title,
		TextSize = 34,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTransparency = 1,
		Text = "",
		ZIndex = 41,
	})
	reelSub = UI.label(overlay, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.72),
		Size = UDim2.new(1, -40, 0, 30),
		Font = UI.Fonts.Bold,
		TextSize = 18,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextTransparency = 1,
		Text = "",
		ZIndex = 41,
	})
	reelButtons = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.fromOffset(360, 46),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 42,
	}, overlay)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 12),
	}, reelButtons)
	local wear = UI.button(reelButtons, { Size = UDim2.fromOffset(170, 44), Text = "WEAR IT", ZIndex = 43 }, "primary")
	local done = UI.button(reelButtons, { Size = UDim2.fromOffset(170, 44), Text = "CONTINUE", ZIndex = 43 }, "card")
	wear.Activated:Connect(function()
		Audio.click()
		if pending then
			Action:FireServer("Equip", pending.cosmeticId)
		end
		overlay.Visible = false
	end)
	done.Activated:Connect(function()
		Audio.click()
		overlay.Visible = false
	end)

	local function refresh()
		local free = player:GetAttribute("FreeCrates") or 0
		local aura = player:GetAttribute("Aura") or 0
		header.Text = string.format("Free crates: %d   ·   Duplicates level an item up (max %d★)", free, Config.MaxStars)
		for id, ref in cardRefs do
			local crate = ref.crate
			if id == "street" and free > 0 then
				ref.open.Text = "OPEN FREE (" .. free .. ")"
			else
				ref.open.Text = "✦ " .. Util.fmt(crate.Cost)
			end
			local canOpen = (id == "street" and free > 0) or aura >= crate.Cost
			ref.open.BackgroundTransparency = canOpen and 0 or 0.45
			if crate.PityAfter then
				local left = crate.PityAfter - (player:GetAttribute("Pity_" .. id) or 0)
				ref.pity.Text = string.format("%s+ guaranteed in %d", crate.PityMin, math.max(1, left))
			else
				ref.pity.Text = "Great for starting your look"
			end
		end
	end
	return { refresh = refresh }
end

local function pickIcon()
	local list = Config.Cosmetics
	return list[math.random(1, #list)].Icon
end

-- Plays the reel, then shows the result.
function TabCrates.reveal(crateId, cosmeticId, status, stars, refund)
	if not overlay then
		return
	end
	local c = Config.CosmeticById[cosmeticId]
	if not c then
		setBusy(false)
		return
	end
	pending = { cosmeticId = cosmeticId }
	overlay.Visible = true
	reelButtons.Visible = false
	reelName.TextTransparency = 1
	reelSub.TextTransparency = 1
	reelScale.Scale = 1

	task.spawn(function()
		local delay = 0.05
		for i = 1, 22 do
			reel.Text = pickIcon()
			Audio.crateTick(i)
			task.wait(delay)
			delay += 0.011
		end
		local rarity = Config.Rarities[c.Rarity]
		reel.Text = c.Icon
		UI.pop(reelScale, 1.5)
		reelName.Text = c.Name
		reelName.TextColor3 = rarity.Color
		reelSub.Text = c.Rarity:upper() .. " " .. string.lower(Config.SlotIcons[c.Slot] and c.Slot or "")
		UI.tween(reelName, 0.3, { TextTransparency = 0 })
		UI.tween(reelSub, 0.3, { TextTransparency = 0 })

		local note
		if status == "new" then
			note = "NEW!"
		elseif status == "star" then
			note = "LEVEL UP!  " .. string.rep("★", stars)
		else
			note = "MAXED — refunded ✦" .. Util.fmt(refund or 0)
		end
		reelSub.Text = reelSub.Text .. "   ·   " .. note
		reelSub.TextColor3 = status == "max" and C.Muted or (status == "new" and C.Good or C.Gold)

		Audio.reveal(rarity.Order + 1)
		if rarity.Order >= 4 then
			Fx.flash(rarity.Color, 0.5, 0.9)
			Fx.shake(0.35, 0.5)
		end
		task.wait(0.4)
		reelButtons.Visible = true
		setBusy(false)
	end)
end

return TabCrates
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="58">
            <Properties>
              <string name="Name">TabPets</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the Pets tab. Hatch eggs at the top, manage your pets below.
-- Tap a pet to equip / unequip it (3 slots).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Animals = require(Shared:WaitForChild("Animals"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabPets = {}

local function owned()
	local map = {}
	for id, n in string.gmatch(player:GetAttribute("Pets") or "", "(%w+):(%d+)") do
		map[id] = tonumber(n)
	end
	return map
end

local function equipped()
	local set = {}
	for id in string.gmatch(player:GetAttribute("PetsEq") or "", "%w+") do
		set[id] = true
	end
	return set
end

function TabPets.build(parent, Action)
	UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Title,
		TextSize = 20,
		TextWrapped = false,
		Text = "🐾  Pets",
	})
	local best = UI.button(parent, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -52, 0, 0),
		Size = UDim2.fromOffset(120, 26),
		BackgroundColor3 = C.Gold,
		Text = "⭐ EQUIP BEST",
		TextSize = 12,
		Radius = 8,
	}, "card")
	best.Activated:Connect(function()
		Audio.click()
		Action:FireServer("PetBest")
	end)
	local summary = UI.label(parent, {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 20),
		Font = UI.Fonts.Bold,
		TextSize = 13,
		TextColor3 = C.Mint,
		TextWrapped = false,
		Text = "",
	})

	-- Eggs
	local eggRow = UI.new("Frame", { Position = UDim2.fromOffset(0, 54), Size = UDim2.new(1, -8, 0, 92), BackgroundTransparency = 1 }, parent)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, eggRow)
	local eggButtons = {}
	for i, egg in Config.Eggs do
		local btn = UI.button(eggRow, {
			LayoutOrder = i,
			Size = UDim2.new(1 / #Config.Eggs, -7, 1, 0),
			BackgroundColor3 = egg.Color:Lerp(C.Card, 0.55),
			Text = "",
			Radius = 12,
		}, "card")
		UI.label(btn, {
			Position = UDim2.fromOffset(8, 4),
			Size = UDim2.new(1, -16, 0, 22),
			Font = UI.Fonts.Title,
			TextSize = 15,
			TextColor3 = egg.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "🥚 " .. egg.Name,
		})
		local odds = {}
		for _, rarity in Config.RarityOrder do
			if egg.Odds[rarity] then
				table.insert(odds, string.format("%s %d%%", rarity, egg.Odds[rarity]))
			end
		end
		UI.label(btn, {
			Position = UDim2.fromOffset(6, 26),
			Size = UDim2.new(1, -12, 0, 36),
			Font = UI.Fonts.Body,
			TextSize = 10,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = table.concat(odds, " · "),
		})
		local cost = UI.label(btn, {
			Position = UDim2.new(0, 0, 1, -26),
			Size = UDim2.new(1, 0, 0, 22),
			Font = UI.Fonts.Title,
			TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "🏆 " .. Util.fmt(egg.Cost),
		})
		btn.Activated:Connect(function()
			Audio.click()
			Action:FireServer("Hatch", egg.Id)
		end)
		eggButtons[egg.Id] = cost
	end

	-- Pet grid
	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 154),
		Size = UDim2.new(1, -8, 1, -154),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(112, 96),
		CellPadding = UDim2.fromOffset(8, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	local cards = {}
	for i, pet in Config.Pets do
		local color = Config.Rarities[pet.Rarity].Color
		local card = UI.button(scroll, {
			LayoutOrder = i,
			BackgroundColor3 = C.Card,
			Text = "",
			Radius = 10,
		}, "card")
		-- a little 3D preview of the animal
		local view = UI.new("ViewportFrame", {
			Position = UDim2.fromOffset(4, 2),
			Size = UDim2.new(1, -8, 0, 44),
			BackgroundTransparency = 1,
			Ambient = Color3.fromRGB(190, 190, 200),
			LightColor = Color3.fromRGB(255, 250, 240),
		}, card)
		pcall(function()
			local rig = Animals.build(pet.Species)
			rig.root.CFrame = CFrame.new(0, 0, 0)
			rig.model.Parent = view
			local extent = math.max(rig.def.len or rig.def.h or 2, rig.def.h or 2) * rig.scale
			local cam = Instance.new("Camera")
			cam.CFrame = CFrame.lookAt(Vector3.new(extent * 0.9, extent * 0.35, -extent * 1.5), Vector3.new(0, 0, 0))
			cam.FieldOfView = 40
			cam.Parent = view
			view.CurrentCamera = cam
		end)
		UI.label(card, {
			Position = UDim2.fromOffset(4, 46),
			Size = UDim2.new(1, -8, 0, 14),
			Font = UI.Fonts.Bold,
			TextSize = 10,
			TextColor3 = color,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = pet.Name,
		})
		local stat = UI.label(card, {
			Position = UDim2.fromOffset(4, 60),
			Size = UDim2.new(1, -8, 0, 30),
			Font = UI.Fonts.Body,
			TextSize = 10,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			Text = "",
		})
		card.Activated:Connect(function()
			Audio.click()
			local on = equipped()[pet.Id]
			Action:FireServer(on and "PetUnequip" or "PetEquip", pet.Id)
		end)
		cards[pet.Id] = { card = card, stat = stat, color = color }
	end

	local function refresh()
		local have, on = owned(), equipped()
		local aura = player:GetAttribute("Aura") or 0
		local count = 0
		for _ in on do
			count += 1
		end
		summary.Text = string.format("Equipped %d/%d   ·   Pet bonus +%d%% Aura", count, Config.PetSlots, math.floor((player:GetAttribute("PetMult") or 0) * 100 + 0.5))
		for id, cost in eggButtons do
			local egg = Config.EggById[id]
			cost.TextColor3 = aura >= egg.Cost and C.Yellow or C.Danger
		end
		for id, ref in cards do
			local pet = Config.PetById[id]
			local copies = have[id]
			local stroke = ref.card:FindFirstChildOfClass("UIStroke")
			if copies then
				ref.card.BackgroundTransparency = 0
				ref.stat.Text = string.format("+%d%% Aura  ·  %s Aura/s\n%s%s", math.floor(Config.PetMult(pet, copies) * 100 + 0.5), Util.fmt(Config.PetAps(pet, copies)), string.rep("★", Config.PetStars(copies)), on[id] and "  EQUIPPED" or "")
				stroke.Color = on[id] and C.Good or ref.color
			else
				ref.card.BackgroundTransparency = 0.6
				ref.stat.Text = "not found yet"
				stroke.Color = C.Stroke
			end
		end
	end
	return { refresh = refresh }
end

return TabPets
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="59">
            <Properties>
              <string name="Name">TabProfile</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: your character sheet: rank, stats, duel record and the current quest.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabProfile = {}

function TabProfile.build(parent)
	local hero = UI.panel(parent, {
		Size = UDim2.new(1, -8, 0, 110),
		BackgroundColor3 = C.Card,
		Radius = 16,
	})
	local rankLabel = UI.label(hero, {
		Position = UDim2.fromOffset(20, 12),
		Size = UDim2.new(1, -40, 0, 38),
		Font = UI.Fonts.Title,
		TextSize = 32,
		TextWrapped = false,
		Text = "",
	})
	local scoreLabel = UI.label(hero, {
		Position = UDim2.fromOffset(20, 52),
		Size = UDim2.new(1, -40, 0, 20),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})
	local rankBar = UI.bar(hero, { Position = UDim2.new(0, 20, 1, -26), Size = UDim2.new(1, -40, 0, 10) }, C.Accent)
	local rankHint = UI.label(hero, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -20, 0, 14),
		Size = UDim2.fromOffset(200, 18),
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Right,
		TextWrapped = false,
		Text = "",
	})

	-- Stat cards
	local statRow = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 122),
		Size = UDim2.new(1, -8, 0, 110),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10) }, statRow)
	local statRefs = {}
	for _, id in Config.StatOrder do
		local def = Config.Stats[id]
		local card = UI.panel(statRow, { Size = UDim2.new(1 / 3, -7, 1, 0), BackgroundColor3 = C.Card, Radius = 14 })
		card:FindFirstChildOfClass("UIStroke").Color = def.Color
		UI.label(card, {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 34),
			Font = UI.Fonts.Bold,
			TextSize = 28,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = def.Icon,
		})
		statRefs[id] = UI.label(card, {
			Position = UDim2.fromOffset(0, 42),
			Size = UDim2.new(1, 0, 0, 30),
			Font = UI.Fonts.Title,
			TextSize = 24,
			TextColor3 = def.Color,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "0",
		})
		UI.label(card, {
			Position = UDim2.fromOffset(0, 76),
			Size = UDim2.new(1, 0, 0, 20),
			Font = UI.Fonts.Bold,
			TextSize = 12,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = def.Name:upper() .. "  ·  " .. def.Station,
		})
	end

	local record = UI.label(parent, {
		Position = UDim2.fromOffset(0, 244),
		Size = UDim2.new(1, -8, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Text,
		TextWrapped = false,
		Text = "",
	})
	local questTitle = UI.label(parent, {
		Position = UDim2.fromOffset(0, 276),
		Size = UDim2.new(1, -8, 0, 20),
		Font = UI.Fonts.Title,
		TextSize = 14,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "CURRENT QUEST",
	})
	local questCard = UI.panel(parent, {
		Position = UDim2.fromOffset(0, 300),
		Size = UDim2.new(1, -8, 0, 70),
		BackgroundColor3 = C.Card,
		Radius = 14,
	})
	local questText = UI.label(questCard, {
		Position = UDim2.fromOffset(16, 8),
		Size = UDim2.new(1, -32, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 16,
		TextWrapped = false,
		Text = "",
	})
	local questBar = UI.bar(questCard, { Position = UDim2.new(0, 16, 1, -22), Size = UDim2.new(1, -32, 0, 10) }, C.Good)
	local questReward = UI.label(questCard, {
		Position = UDim2.fromOffset(16, 32),
		Size = UDim2.new(1, -32, 0, 16),
		Font = UI.Fonts.Body,
		TextSize = 12,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	local function refresh()
		local rankIndex = player:GetAttribute("Rank") or 1
		local rank = Config.Ranks[rankIndex]
		local nextRank = Config.Ranks[rankIndex + 1]
		local score = player:GetAttribute("GlowScore") or 0
		local rebirths = player:GetAttribute("Rebirths") or 0
		rankLabel.Text = (rebirths > 0 and ("★" .. rebirths .. "  ") or "") .. rank.Full:upper()
		rankLabel.TextColor3 = rank.Color
		scoreLabel.Text = string.format("Level %s   ·   Mog Power %s   ·   Rebirths %d", Util.fmt(player:GetAttribute("Level") or 1), Util.fmt(score), rebirths)
		rankBar.fill.BackgroundColor3 = rank.Color
		rankBar.set((player:GetAttribute("XP") or 0) / (player:GetAttribute("XPNeeded") or 1))
		if nextRank then
			rankHint.Text = string.format("Next tier: %s at level %s", nextRank.Full, Util.fmt(nextRank.Level))
		else
			rankHint.Text = "Highest tier reached"
		end
		for id, label in statRefs do
			label.Text = Util.fmt(player:GetAttribute(id) or 0)
		end
		record.Text = string.format(
			"⚔️  Duel wins %d     🔥 Win streak %d",
			player:GetAttribute("Wins") or 0,
			player:GetAttribute("DuelStreak") or 0
		)
		local kind = player:GetAttribute("QuestKind")
		if kind then
			local goal = player:GetAttribute("QuestGoal") or 1
			local progress = player:GetAttribute("QuestProgress") or 0
			questText.Text = "🎯 " .. Config.QuestText(kind, goal)
			questBar.set(progress / goal)
			questReward.Text = string.format("%d / %d   ·   Reward ✦ %s", progress, goal, Util.fmt(player:GetAttribute("QuestReward") or 0))
		end
	end
	return { refresh = refresh }
end

return TabProfile
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">TabRewards</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the Rewards window with three tabs, FREE (free crates + live event), Timed (play-time gifts
-- that arrive on their own) and Daily (7-day login streak with a big rainbow Day 7 card).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local TabStore = require(script.Parent.TabStore)

local player = Players.LocalPlayer
local C = UI.Colors

local TabRewards = {}

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 100, 255)),
})

local function box(parent, props, color, radius)
	props.BackgroundColor3 = color
	props.BorderSizePixel = 0
	props.ZIndex = props.ZIndex or 24
	local f = UI.new("Frame", props, parent)
	UI.corner(f, radius or 12)
	UI.stroke(f, Color3.fromRGB(10, 14, 30), 3, 0)
	return f
end

local function text(parent, props)
	props.ZIndex = props.ZIndex or 26
	props.TextXAlignment = props.TextXAlignment or Enum.TextXAlignment.Center
	if props.TextWrapped == nil then
		props.TextWrapped = false
	end
	return UI.label(parent, props)
end

function TabRewards.build(parent, Action, Menu)
	local body = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(34, 48, 96), BorderSizePixel = 0, ZIndex = 22 }, parent)
	UI.corner(body, 20)
	TabStore.header(parent, "🎁  REWARDS", Color3.fromRGB(255, 150, 60), function()
		Menu.close()
	end)

	-- Tab buttons
	local pages, buttons = {}, {}
	local function show(name)
		for key, page in pages do
			page.Visible = key == name
		end
		for key, b in buttons do
			b.BackgroundColor3 = key == name and C.Good or C.Disabled
		end
	end
	local tabRow = UI.new("Frame", { Position = UDim2.fromOffset(20, 66), Size = UDim2.fromOffset(330, 34), BackgroundTransparency = 1, ZIndex = 24 }, parent)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, tabRow)
	for i, name in { "FREE", "Timed", "Daily" } do
		local b = UI.button(tabRow, { LayoutOrder = i, Size = UDim2.fromOffset(100, 34), Text = name:upper(), TextSize = 15, Radius = 9, ZIndex = 25 }, "primary")
		b.Activated:Connect(function()
			Audio.click()
			show(name)
		end)
		buttons[name] = b
		pages[name] = UI.new("Frame", { Position = UDim2.fromOffset(20, 108), Size = UDim2.new(1, -40, 1, -122), BackgroundTransparency = 1, Visible = false, ZIndex = 23 }, parent)
	end
	local refreshers = {}

	----------------------------------------------------------------------------
	-- DAILY
	----------------------------------------------------------------------------
	local daily = pages.Daily
	local cells = {}
	local grid = UI.new("Frame", { Size = UDim2.new(1, -170, 1, -60), BackgroundTransparency = 1, ZIndex = 23 }, daily)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(150, 118), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
	for day = 1, 7 do
		local reward = Config.Daily[day]
		local isLast = day == 7
		local cell = box(isLast and daily or grid, isLast and {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.new(0, 150, 1, -60),
		} or { LayoutOrder = day }, isLast and Color3.new(1, 1, 1) or Color3.fromRGB(88, 160, 255))
		if isLast then
			UI.new("UIGradient", { Color = RAINBOW, Rotation = 60 }, cell)
		else
			UI.gradient(cell, Color3.new(1, 1, 1), Color3.fromRGB(165, 170, 200), 90)
		end
		text(cell, { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 20), Font = UI.Fonts.Title, TextSize = 15, Text = "DAY " .. day, TextStrokeTransparency = 0 })
		text(cell, {
			Position = UDim2.fromOffset(0, isLast and 40 or 28),
			Size = UDim2.new(1, 0, 0, isLast and 90 or 40),
			Font = UI.Fonts.Title,
			TextSize = isLast and 78 or 38,
			TextStrokeTransparency = 1,
			Text = isLast and "😎" or (reward.Crates and "🎁" or "✦"),
		})
		local label = "✦ " .. Util.fmt(reward.Aura)
		if reward.Crates then
			label ..= "  +" .. reward.Crates .. " 🎁"
		end
		text(cell, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, isLast and -34 or -8), Size = UDim2.new(1, -8, 0, 22), Font = UI.Fonts.Title, TextSize = 14, TextStrokeTransparency = 0, Text = label })
		if isLast then
			text(cell, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -8, 0, 20), Font = UI.Fonts.Title, TextSize = 12, TextStrokeTransparency = 0, Text = "BONUS DAY" })
		end
		local tick = text(cell, { Size = UDim2.fromScale(1, 1), Font = UI.Fonts.Title, TextSize = 54, TextColor3 = Color3.fromRGB(80, 255, 120), BackgroundTransparency = 0.45, BackgroundColor3 = Color3.fromRGB(10, 20, 40), Text = "✓", Visible = false, ZIndex = 30 })
		UI.corner(tick, 12)
		cells[day] = { cell = cell, tick = tick }
	end
	local claim = UI.button(daily, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, 0, 0, 46),
		Text = "CLAIM NOW",
		TextSize = 20,
		ZIndex = 26,
	}, "primary")
	claim.Activated:Connect(function()
		Audio.click()
		Action:FireServer("Claim")
	end)
	table.insert(refreshers, function()
		local ready = player:GetAttribute("DailyReady") == true
		local day = player:GetAttribute("DailyDay") or 1
		for d, entry in cells do
			local isNext = d == day
			entry.tick.Visible = d < day or (d == day and not ready)
			entry.cell:FindFirstChildOfClass("UIStroke").Color = (isNext and ready) and C.Gold or Color3.fromRGB(10, 14, 30)
		end
		claim.Text = ready and ("CLAIM DAY " .. day .. " NOW") or "COME BACK TOMORROW"
		claim.BackgroundColor3 = ready and C.Good or C.Disabled
	end)

	----------------------------------------------------------------------------
	-- TIMED (play-time gifts arrive on their own)
	----------------------------------------------------------------------------
	local timed = pages.Timed
	text(timed, { Size = UDim2.new(1, 0, 0, 22), Font = UI.Fonts.Bold, TextSize = 14, TextColor3 = C.Muted, Text = "Just stay and play. A gift arrives by itself each time a timer ends." })
	local row = UI.new("Frame", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32), BackgroundTransparency = 1, ZIndex = 23 }, timed)
	UI.new("UIGridLayout", { CellSize = UDim2.fromOffset(98, 150), CellPadding = UDim2.fromOffset(8, 8), SortOrder = Enum.SortOrder.LayoutOrder }, row)
	local gifts = {}
	for i, gift in Config.Gifts do
		local cell = box(row, { LayoutOrder = i }, Color3.fromRGB(88, 160, 255), 12)
		UI.gradient(cell, Color3.new(1, 1, 1), Color3.fromRGB(165, 170, 200), 90)
		text(cell, { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 20), Font = UI.Fonts.Title, TextSize = 13, TextStrokeTransparency = 0, Text = Util.clock(gift.Time) })
		text(cell, { Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 0, 44), Font = UI.Fonts.Title, TextSize = 36, TextStrokeTransparency = 1, Text = gift.Crates > 0 and "🎁" or "✦" })
		local amount = text(cell, { Position = UDim2.fromOffset(0, 80), Size = UDim2.new(1, 0, 0, 20), Font = UI.Fonts.Title, TextSize = 13, TextStrokeTransparency = 0, Text = "" })
		local state = text(cell, { Position = UDim2.fromOffset(0, 118), Size = UDim2.new(1, 0, 0, 22), Font = UI.Fonts.Title, TextSize = 12, TextStrokeTransparency = 0, Text = "" })
		gifts[i] = { cell = cell, amount = amount, state = state }
	end
	table.insert(refreshers, function()
		local claimed = player:GetAttribute("GiftsClaimed") or 0
		local at = player:GetAttribute("GiftAt") or 0
		local level = player:GetAttribute("Level") or 1
		for i, g in gifts do
			local gift = Config.Gifts[i]
			g.amount.Text = "+" .. Util.fmt(Config.GiftAura(level, gift.Size)) .. (gift.Crates > 0 and (" +" .. gift.Crates .. "🎁") or "")
			if i <= claimed then
				g.state.Text, g.state.TextColor3 = "✓ CLAIMED", Color3.fromRGB(110, 255, 140)
				g.cell.BackgroundColor3 = Color3.fromRGB(70, 150, 90)
			elseif i == claimed + 1 and at > 0 then
				g.state.Text, g.state.TextColor3 = Util.clock(math.max(0, at - workspace:GetServerTimeNow())), C.Yellow
				g.cell.BackgroundColor3 = Color3.fromRGB(88, 160, 255)
			else
				g.state.Text, g.state.TextColor3 = "LOCKED", C.Muted
				g.cell.BackgroundColor3 = Color3.fromRGB(88, 160, 255)
			end
		end
	end)

	----------------------------------------------------------------------------
	-- FREE (free crates + the live event)
	----------------------------------------------------------------------------
	local free = pages.FREE
	local crateCard = box(free, { Size = UDim2.new(1, 0, 0, 84) }, Color3.fromRGB(255, 112, 176), 12)
	UI.gradient(crateCard, Color3.new(1, 1, 1), Color3.fromRGB(190, 160, 200), 90)
	text(crateCard, { Position = UDim2.fromOffset(16, 0), Size = UDim2.fromOffset(70, 84), Font = UI.Fonts.Title, TextSize = 50, TextStrokeTransparency = 1, Text = "📦" })
	local crateText = text(crateCard, { Position = UDim2.fromOffset(92, 12), Size = UDim2.new(1, -250, 0, 60), Font = UI.Fonts.Title, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextStrokeTransparency = 0, Text = "" })
	local open = UI.button(crateCard, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(130, 44), Text = "OPEN", TextSize = 18, ZIndex = 27 }, "primary")
	open.Activated:Connect(function()
		Audio.click()
		Menu.open("Crates")
	end)
	local eventCard = box(free, { Position = UDim2.fromOffset(0, 96), Size = UDim2.new(1, 0, 0, 84) }, Color3.fromRGB(255, 190, 60), 12)
	UI.gradient(eventCard, Color3.new(1, 1, 1), Color3.fromRGB(200, 190, 160), 90)
	local eventText = text(eventCard, { Position = UDim2.fromOffset(16, 8), Size = UDim2.new(1, -32, 1, -16), Font = UI.Fonts.Title, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, TextStrokeTransparency = 0, Text = "" })
	table.insert(refreshers, function()
		local n = player:GetAttribute("FreeCrates") or 0
		crateText.Text = n > 0 and ("You have " .. n .. " free crate" .. (n == 1 and "" or "s") .. "!") or "No free crates right now. Gifts and daily rewards bring more."
		open.BackgroundColor3 = n > 0 and C.Good or C.Disabled
		local id = workspace:GetAttribute("Event")
		local ev = id and id ~= "" and Config.EventById[id]
		local left = (workspace:GetAttribute("EventEnd") or 0) - workspace:GetServerTimeNow()
		if ev and left > 0 then
			eventText.Text = string.format("%s %s is live (%s left)\n%s", ev.Icon, ev.Name, Util.clock(left), ev.Desc)
		else
			eventText.Text = "No event right now. Golden Hour, Duel Frenzy and Runway Night start every few minutes."
		end
	end)

	show("Daily")
	return {
		refresh = function()
			for _, fn in refreshers do
				fn()
			end
		end,
	}
end

return TabRewards
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">TabSettings</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: simple toggles. Settings are saved on the server so they follow the player.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabSettings = {}

local OPTIONS = {
	{ key = "Music", name = "Music", desc = "Ambient background music" },
	{ key = "Sfx", name = "Sound effects", desc = "Pickups, crates and fanfares" },
	{ key = "Voice", name = "Announcer voice", desc = "Deep voice: 3-2-1, Level up, Rebirth ready" },
	{ key = "Fx", name = "Screen effects", desc = "Camera punch, shake, flashes and floating numbers" },
	{ key = "Duels", name = "Duels", desc = "Allow duel matchmaking (turn off to stay out of fights)" },
}

-- Apply the saved settings to the live game (audio mostly).
function TabSettings.apply()
	Audio.setMusic(player:GetAttribute("Set_Music") ~= false)
	Audio.setSfx(player:GetAttribute("Set_Sfx") ~= false)
	Audio.setVoice(player:GetAttribute("Set_Voice") ~= false)
end

function TabSettings.build(parent, Action)
	UI.label(parent, {
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Title,
		TextSize = 20,
		TextWrapped = false,
		Text = "⚙️  Settings",
	})
	local list = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 36),
		Size = UDim2.new(1, -8, 1, -36),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)

	local toggles = {}
	for i, opt in OPTIONS do
		local row = UI.panel(list, { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = C.Card, Radius = 12 })
		UI.label(row, {
			Position = UDim2.fromOffset(16, 8),
			Size = UDim2.new(1, -130, 0, 22),
			Font = UI.Fonts.Bold,
			TextSize = 16,
			TextWrapped = false,
			Text = opt.name,
		})
		UI.label(row, {
			Position = UDim2.fromOffset(16, 32),
			Size = UDim2.new(1, -130, 0, 22),
			Font = UI.Fonts.Body,
			TextSize = 12,
			TextColor3 = C.Muted,
			TextWrapped = false,
			Text = opt.desc,
		})
		local track = UI.button(row, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -16, 0.5, 0),
			Size = UDim2.fromOffset(64, 32),
			Text = "",
			Radius = 16,
		}, "card")
		local knob = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 4, 0.5, 0),
			Size = UDim2.fromOffset(24, 24),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 3,
		}, track)
		UI.corner(knob, 12)
		track.Activated:Connect(function()
			Audio.click()
			local value = not (player:GetAttribute("Set_" .. opt.key) ~= false)
			player:SetAttribute("Set_" .. opt.key, value) -- instant local feedback; the server saves it
			Action:FireServer("Setting", opt.key, value)
			TabSettings.apply()
		end)
		toggles[opt.key] = { track = track, knob = knob }
	end

	local function refresh()
		for key, t in toggles do
			local on = player:GetAttribute("Set_" .. key) ~= false
			UI.tween(t.track, 0.15, { BackgroundColor3 = on and C.Good or C.Disabled })
			UI.tween(t.knob, 0.15, { Position = on and UDim2.new(1, -28, 0.5, 0) or UDim2.new(0, 4, 0.5, 0) })
		end
	end
	return { refresh = refresh }
end

return TabSettings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">TabStore</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the Store window. Colourful offer cards with a green Robux button each. Offers whose id
-- is still 0 in Config.Store show "Coming soon" under the button and cannot be bought yet.
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabStore = {}

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 90)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 200, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 230, 120)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 100, 255)),
})

-- The coloured title bar with a red X, shared by the Store and Rewards windows.
function TabStore.header(page, title, color, onClose)
	local bar = UI.new("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 23 }, page)
	UI.corner(bar, 20)
	UI.gradient(bar, Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 205), 90)
	-- square off the bottom corners so the bar meets the body cleanly
	UI.new("Frame", { Position = UDim2.new(0, 0, 1, -20), Size = UDim2.new(1, 0, 0, 20), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 23 }, bar)
	UI.label(bar, {
		Position = UDim2.fromOffset(24, 0),
		Size = UDim2.new(1, -90, 1, 0),
		Font = UI.Fonts.Title,
		TextSize = 30,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = title,
		ZIndex = 25,
	})
	local x = UI.button(bar, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -14, 0.5, 0),
		Size = UDim2.fromOffset(40, 40),
		BackgroundColor3 = C.Danger,
		Text = "X",
		TextSize = 22,
		Radius = 10,
		ZIndex = 26,
	}, "primary")
	x.Activated:Connect(function()
		Audio.click()
		onClose()
	end)
	return bar
end

local function card(parent, order, offer, kind, onBuy)
	local color = offer.Color or C.Accent
	local frame = UI.new("Frame", { LayoutOrder = order, BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 24 }, parent)
	UI.corner(frame, 14)
	UI.stroke(frame, Color3.fromRGB(10, 14, 30), 3, 0)
	if offer.Rainbow then
		UI.new("UIGradient", { Color = RAINBOW, Rotation = 35 }, frame)
	else
		UI.gradient(frame, Color3.new(1, 1, 1), Color3.fromRGB(165, 170, 190), 90)
	end
	UI.label(frame, {
		Position = UDim2.fromOffset(0, 14),
		Size = UDim2.new(1, 0, 0, 56),
		Font = UI.Fonts.Title,
		TextSize = 46,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 1,
		Text = offer.Icon or "⭐",
		ZIndex = 25,
	})
	UI.label(frame, {
		Position = UDim2.fromOffset(6, 74),
		Size = UDim2.new(1, -12, 0, 22),
		Font = UI.Fonts.Title,
		TextSize = 16,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = offer.Name,
		ZIndex = 25,
	})
	local desc = UI.label(frame, {
		Position = UDim2.fromOffset(8, 98),
		Size = UDim2.new(1, -16, 0, 32),
		Font = UI.Fonts.Bold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextStrokeTransparency = 0.2,
		Text = offer.Desc or "",
		ZIndex = 25,
	})
	local button = UI.button(frame, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -22),
		Size = UDim2.new(1, -20, 0, 34),
		BackgroundColor3 = C.Good,
		Text = "R$ " .. offer.Price,
		TextSize = 16,
		Radius = 9,
		ZIndex = 26,
	}, "primary")
	button.Activated:Connect(function()
		Audio.click()
		onBuy()
	end)
	local soon = UI.label(frame, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -4),
		Size = UDim2.new(1, -10, 0, 14),
		Font = UI.Fonts.Bold,
		TextSize = 10,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextColor3 = Color3.fromRGB(240, 240, 255),
		Text = "Coming soon",
		ZIndex = 25,
	})
	if offer.Tag then
		local ribbon = UI.new("TextLabel", {
			Position = UDim2.fromOffset(-6, 8),
			Size = UDim2.fromOffset(92, 20),
			BackgroundColor3 = C.Danger,
			Font = UI.Fonts.Title,
			TextSize = 11,
			TextColor3 = Color3.new(1, 1, 1),
			Text = offer.Tag,
			ZIndex = 27,
			Rotation = -8,
		}, frame)
		UI.corner(ribbon, 5)
		UI.stroke(ribbon, Color3.new(1, 1, 1), 1.5, 0)
	end
	return { button = button, soon = soon, desc = desc, frame = frame }
end

function TabStore.build(parent, Menu)
	local body = UI.new("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(34, 48, 96), BorderSizePixel = 0, ZIndex = 22 }, parent)
	UI.corner(body, 20)
	TabStore.header(parent, "🛒  STORE", Color3.fromRGB(255, 200, 40), function()
		Menu.close()
	end)
	local scroll = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(16, 68),
		Size = UDim2.new(1, -32, 1, -80),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ZIndex = 23,
	}, parent)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(166, 196),
		CellPadding = UDim2.fromOffset(10, 12),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroll)
	UI.new("UIPadding", { PaddingTop = UDim.new(0, 6), PaddingLeft = UDim.new(0, 4) }, scroll)

	local refreshers = {}
	local order = 0
	local function add(offer, kind)
		order += 1
		local owned = false
		local c = card(scroll, order, offer, kind, function()
			if kind == "pass" then
				if offer.PassId ~= 0 and not owned then
					pcall(function()
						MarketplaceService:PromptGamePassPurchase(player, offer.PassId)
					end)
				end
			elseif offer.ProductId ~= 0 then
				pcall(function()
					MarketplaceService:PromptProductPurchase(player, offer.ProductId)
				end)
			end
		end)
		table.insert(refreshers, function()
			local id = kind == "pass" and offer.PassId or offer.ProductId
			owned = kind == "pass" and player:GetAttribute("Pass_" .. offer.Id) == true
			if kind == "product" then
				local amount = Util.fmt(Config.ProductAura(player:GetAttribute("Level") or 1, offer.Size))
				c.desc.Text = "+" .. amount .. " Aura" .. (offer.Crates and (" · " .. offer.Crates .. " crates") or "")
			end
			if owned then
				c.button.Text, c.button.BackgroundColor3 = "OWNED", C.Disabled
				c.soon.Visible = false
			else
				c.button.Text, c.button.BackgroundColor3 = "R$ " .. offer.Price, C.Good
				c.soon.Visible = id == 0
			end
		end)
	end
	for _, product in Config.Store.Products do
		if product.Id == "starter" then
			add(product, "product")
		end
	end
	for _, pass in Config.Store.Passes do
		add(pass, "pass")
	end
	for _, product in Config.Store.Products do
		if product.Id ~= "starter" then
			add(product, "product")
		end
	end
	return {
		refresh = function()
			for _, fn in refreshers do
				fn()
			end
		end,
	}
end

return TabStore
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">TabUpgrades</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: upgrades (bought with Aura) and the rebirth button.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabUpgrades = {}

function TabUpgrades.build(parent, Action)
	local list = UI.new("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	UI.new("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, list)
	UI.new("UIPadding", { PaddingRight = UDim.new(0, 8), PaddingBottom = UDim.new(0, 8) }, list)

	local function row(order, height)
		local r = UI.panel(list, {
			LayoutOrder = order,
			Size = UDim2.new(1, 0, 0, height or 68),
			BackgroundColor3 = C.Card,
			Radius = 14,
		})
		return r
	end

	local refs = {}
	for i, def in Config.Upgrades do
		local r = row(i)
		UI.label(r, {
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.fromOffset(46, 68),
			Font = UI.Fonts.Bold,
			TextSize = 34,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = def.Icon,
		})
		local name = UI.label(r, {
			Position = UDim2.fromOffset(70, 10),
			Size = UDim2.new(1, -210, 0, 22),
			Font = UI.Fonts.Bold,
			TextSize = 17,
			TextWrapped = false,
			Text = def.Name,
		})
		UI.label(r, {
			Position = UDim2.fromOffset(70, 34),
			Size = UDim2.new(1, -210, 0, 20),
			Font = UI.Fonts.Body,
			TextSize = 13,
			TextColor3 = C.Muted,
			TextWrapped = false,
			Text = def.Desc,
		})
		local levelBar = UI.bar(r, { Position = UDim2.fromOffset(70, 56), Size = UDim2.new(1, -210, 0, 5) }, C.Accent)
		local buy = UI.button(r, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -12, 0.5, 0),
			Size = UDim2.fromOffset(110, 46),
			Text = "",
			TextSize = 16,
		}, "primary")
		buy.Activated:Connect(function()
			Audio.click()
			Action:FireServer("Buy", def.Id)
		end)
		refs[def.Id] = { name = name, buy = buy, bar = levelBar, def = def }
	end

	-- Rebirth
	local reb = row(100, 96)
	local rebStroke = reb:FindFirstChildOfClass("UIStroke")
	rebStroke.Color = C.Gold
	rebStroke.Transparency = 0.3
	UI.label(reb, {
		Position = UDim2.fromOffset(14, 0),
		Size = UDim2.fromOffset(46, 96),
		Font = UI.Fonts.Bold,
		TextSize = 38,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "🌟",
	})
	UI.label(reb, {
		Position = UDim2.fromOffset(70, 10),
		Size = UDim2.new(1, -210, 0, 24),
		Font = UI.Fonts.Title,
		TextSize = 19,
		TextColor3 = C.Gold,
		TextWrapped = false,
		Text = "REBIRTH",
	})
	local rebDesc = UI.label(reb, {
		Position = UDim2.fromOffset(70, 36),
		Size = UDim2.new(1, -210, 0, 50),
		Font = UI.Fonts.Body,
		TextSize = 13,
		TextColor3 = C.Muted,
		Text = "",
	})
	local rebButton = UI.button(reb, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -12, 0.5, 0),
		Size = UDim2.fromOffset(110, 46),
		Text = "REBIRTH",
		TextSize = 15,
	}, "primary")
	rebButton.Activated:Connect(function()
		Audio.click()
		Action:FireServer("Rebirth")
	end)

	local function refresh()
		local aura = player:GetAttribute("Aura") or 0
		for id, ref in refs do
			local lvl = player:GetAttribute("Lv_" .. id) or 0
			ref.name.Text = string.format("%s   Lv %d", ref.def.Name, lvl)
			ref.bar.set(lvl / ref.def.Max)
			if lvl >= ref.def.Max then
				ref.buy.Text = "MAX"
				ref.buy.BackgroundTransparency = 0.5
			else
				local cost = Config.UpgradeCost(ref.def, lvl)
				ref.buy.Text = "✦ " .. Util.fmt(cost)
				ref.buy.BackgroundTransparency = aura >= cost and 0 or 0.5
			end
		end
		local rebirths = player:GetAttribute("Rebirths") or 0
		local need = Config.RebirthRequirement(rebirths)
		local score = player:GetAttribute("Level") or 1
		rebDesc.Text = string.format(
			"Reset Aura, stats and upgrades (you keep your level, hammers and every cosmetic). Gain +50%% Aura and XP forever, plus 2 free crates.\nNeeds level %s  (you are level %s)",
			Util.fmt(need),
			Util.fmt(score)
		)
		rebButton.BackgroundTransparency = score >= need and 0 or 0.5
	end
	return { refresh = refresh }
end

return TabUpgrades
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">TabWardrobe</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the wardrobe. A collection grid: owned items can be worn, unowned ones show as locked
-- silhouettes so players can see what they're chasing.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local player = Players.LocalPlayer
local C = UI.Colors

local TabWardrobe = {}

function TabWardrobe.build(parent, Action)
	local filter = "All"
	local cards = {} -- cosmetic id -> card refs

	-- Header: collection counter and totals
	local summary = UI.label(parent, {
		Size = UDim2.new(1, -4, 0, 22),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextColor3 = C.Muted,
		TextWrapped = false,
		Text = "",
	})

	-- Slot filter
	local bar = UI.new("Frame", {
		Position = UDim2.fromOffset(0, 28),
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundTransparency = 1,
	}, parent)
	UI.new("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, bar)
	local filterButtons = {}
	local names = { "All" }
	for _, slot in Config.Slots do
		table.insert(names, slot)
	end

	local scroller = UI.new("ScrollingFrame", {
		Position = UDim2.fromOffset(0, 70),
		Size = UDim2.new(1, 0, 1, -70),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.Accent,
		CanvasSize = UDim2.new(),
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
	}, parent)
	UI.new("UIGridLayout", {
		CellSize = UDim2.fromOffset(136, 150),
		CellPadding = UDim2.fromOffset(10, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
	}, scroller)
	UI.new("UIPadding", { PaddingBottom = UDim.new(0, 10), PaddingRight = UDim.new(0, 8) }, scroller)

	local function applyFilter()
		for id, card in cards do
			local c = Config.CosmeticById[id]
			card.frame.Visible = filter == "All" or c.Slot == filter
		end
		for name, b in filterButtons do
			UI.tween(b, 0.12, { BackgroundColor3 = name == filter and C.Accent or C.Card })
		end
	end

	for i, name in names do
		local label = name == "All" and "All" or (Config.SlotIcons[name] .. " " .. name)
		local b = UI.button(bar, {
			LayoutOrder = i,
			Size = UDim2.fromOffset(name == "All" and 52 or 92, 30),
			Text = label,
			TextSize = 13,
			Radius = 15,
		}, "card")
		filterButtons[name] = b
		b.Activated:Connect(function()
			Audio.click()
			filter = name
			applyFilter()
		end)
	end

	-- Cards, ordered by slot then rarity
	local ordered = table.clone(Config.Cosmetics)
	table.sort(ordered, function(a, b)
		if a.Slot ~= b.Slot then
			return table.find(Config.Slots, a.Slot) < table.find(Config.Slots, b.Slot)
		end
		return Config.Rarities[a.Rarity].Order < Config.Rarities[b.Rarity].Order
	end)

	for i, c in ordered do
		local rarityColor = Config.Rarities[c.Rarity].Color
		local frame = UI.button(scroller, { LayoutOrder = i, Text = "" }, "card")
		local stroke = UI.stroke(frame, rarityColor, 2, 0.4)
		local icon = UI.label(frame, {
			Position = UDim2.fromOffset(0, 8),
			Size = UDim2.new(1, 0, 0, 52),
			Font = UI.Fonts.Bold,
			TextSize = 40,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = c.Icon,
		})
		local name = UI.label(frame, {
			Position = UDim2.fromOffset(6, 62),
			Size = UDim2.new(1, -12, 0, 18),
			Font = UI.Fonts.Bold,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = c.Name,
		})
		local rarity = UI.label(frame, {
			Position = UDim2.fromOffset(6, 80),
			Size = UDim2.new(1, -12, 0, 14),
			Font = UI.Fonts.Bold,
			TextSize = 11,
			TextColor3 = rarityColor,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = c.Rarity:upper(),
		})
		local stars = UI.label(frame, {
			Position = UDim2.fromOffset(6, 96),
			Size = UDim2.new(1, -12, 0, 16),
			Font = UI.Fonts.Bold,
			TextSize = 13,
			TextColor3 = C.Gold,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "",
		})
		local stat = UI.label(frame, {
			Position = UDim2.fromOffset(6, 114),
			Size = UDim2.new(1, -12, 0, 14),
			Font = UI.Fonts.Body,
			TextSize = 11,
			TextColor3 = C.Muted,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextWrapped = false,
			Text = "",
		})
		local tag = UI.label(frame, {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -6, 0, 6),
			Size = UDim2.fromOffset(70, 16),
			Font = UI.Fonts.Title,
			TextSize = 10,
			TextColor3 = C.Good,
			TextXAlignment = Enum.TextXAlignment.Right,
			TextWrapped = false,
			Text = "",
		})
		frame.Activated:Connect(function()
			local inv = Util.parseInventory(player:GetAttribute("Inv"))
			if not inv[c.Id] then
				Audio.error()
				return
			end
			Audio.equip()
			if player:GetAttribute("Eq_" .. c.Slot) == c.Id then
				Action:FireServer("Unequip", c.Slot)
			else
				Action:FireServer("Equip", c.Id)
			end
		end)
		cards[c.Id] = { frame = frame, icon = icon, name = name, stars = stars, stat = stat, tag = tag, stroke = stroke, c = c }
	end

	local function refresh()
		local inv = Util.parseInventory(player:GetAttribute("Inv"))
		local owned = 0
		for id, card in cards do
			local c = card.c
			local stars = inv[id]
			if stars then
				owned += 1
				card.icon.TextTransparency = 0
				card.name.Text = c.Name
				card.name.TextColor3 = C.Text
				card.stars.Text = string.rep("★", stars) .. string.rep("☆", Config.MaxStars - stars)
				card.stat.Text = string.format("+%s Glow · %s/s", Util.fmt(Config.CosmeticPower(c, stars)), Util.fmt(Config.CosmeticAps(c, stars)))
				local equipped = player:GetAttribute("Eq_" .. c.Slot) == id
				card.tag.Text = equipped and "WORN" or ""
				card.stroke.Transparency = equipped and 0 or 0.4
				card.stroke.Thickness = equipped and 3 or 2
			else
				card.icon.TextTransparency = 0.82
				card.name.Text = "???"
				card.name.TextColor3 = C.Muted
				card.stars.Text = ""
				card.stat.Text = "Find in crates"
				card.tag.Text = ""
				card.stroke.Transparency = 0.8
				card.stroke.Thickness = 1
			end
		end
		summary.Text = string.format(
			"Collection %d/%d   ·   Mog Power %s   ·   +%s Aura/s",
			owned,
			#Config.Cosmetics,
			Util.fmt(player:GetAttribute("GlowScore") or 0),
			Util.fmt(player:GetAttribute("AuraRate") or 0)
		)
	end

	applyFilter()
	return { refresh = refresh }
end

return TabWardrobe
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">Toasts</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: small, calm notifications. Max three at once, identical messages merge into "x2",
-- and they sit above the dock so they never cover the action.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local UI = require(ReplicatedStorage:WaitForChild("Shared"):WaitForChild("UI"))

local Toasts = {}

local holder
local active = {} -- list of { frame, text, count, label, token }

local KIND_COLOR = {
	info = UI.Colors.Cyan,
	good = UI.Colors.Good,
	gold = UI.Colors.Gold,
	bad = UI.Colors.Danger,
}

function Toasts.init(gui)
	holder = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -70),
		Size = UDim2.fromOffset(420, 110),
		BackgroundTransparency = 1,
	}, gui)
	UI.new("UIListLayout", {
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
	}, holder)
end

local order = 0

local function remove(entry)
	local i = table.find(active, entry)
	if i then
		table.remove(active, i)
	end
	UI.tween(entry.frame, 0.25, { BackgroundTransparency = 1 })
	UI.tween(entry.label, 0.25, { TextTransparency = 1 })
	task.delay(0.3, function()
		entry.frame:Destroy()
	end)
end

function Toasts.push(text, kind)
	if not holder then
		return
	end
	local color = KIND_COLOR[kind or "info"] or UI.Colors.Cyan

	for _, entry in active do
		if entry.text == text then
			entry.count += 1
			entry.label.Text = text .. "  x" .. entry.count
			entry.token += 1
			local token = entry.token
			task.delay(2.8, function()
				if entry.token == token and table.find(active, entry) then
					remove(entry)
				end
			end)
			return
		end
	end

	if #active >= 2 then
		remove(active[1])
	end

	order += 1
	local frame = UI.new("Frame", {
		LayoutOrder = order,
		Size = UDim2.fromOffset(10, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = UI.Colors.Panel,
		BackgroundTransparency = 0.05,
		BorderSizePixel = 0,
	}, holder)
	UI.corner(frame, 13)
	UI.stroke(frame, color, 2, 0)
	UI.new("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, frame)
	local label = UI.label(frame, {
		Size = UDim2.fromOffset(10, 26),
		AutomaticSize = Enum.AutomaticSize.X,
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextWrapped = false,
		TextColor3 = UI.Colors.Text,
		Text = text,
	})
	local entry = { frame = frame, text = text, count = 1, label = label, token = 0 }
	table.insert(active, entry)
	task.delay(2.8, function()
		if entry.token == 0 and table.find(active, entry) then
			remove(entry)
		end
	end)
end

return Toasts
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="66">
            <Properties>
              <string name="Name">TrainingUI</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the training minigame overlay. A marker sweeps a bar; press Space (or tap) while it
-- is inside the zone. The server decides the zone and grades the press, so this only draws it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)
local Toasts = require(script.Parent.Toasts)

local TrainingUI = {}

local C = UI.Colors
local panel, title, dots, bar, goodZone, perfectZone, marker, message, hint, scale, msgScale
local Action
local cfg, stat
local pressed = false
local frozenPos = 0
local resultText, resultColor
local active = false

local GRADE = {
	perfect = { text = "PERFECT", color = Color3.fromRGB(255, 214, 90) },
	good = { text = "GOOD", color = Color3.fromRGB(90, 230, 150) },
	miss = { text = "MISS", color = Color3.fromRGB(255, 100, 120) },
}

local function layoutZones()
	if not cfg then
		return
	end
	goodZone.Position = UDim2.fromScale(cfg.center - cfg.goodWidth / 2, 0)
	goodZone.Size = UDim2.fromScale(cfg.goodWidth, 1)
	perfectZone.Position = UDim2.fromScale(cfg.center - cfg.perfectWidth / 2, 0)
	perfectZone.Size = UDim2.fromScale(cfg.perfectWidth, 1)
end

local function press()
	if not active or not cfg or pressed then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < cfg.startedAt then
		return
	end
	pressed = true
	frozenPos = Util.tri((now - cfg.startedAt) * cfg.speed)
	Audio.click()
	Action:FireServer("TrainHit", now)
end

function TrainingUI.init(gui, action)
	Action = action
	panel = UI.panel(gui, {
		Name = "Training",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -66),
		Size = UDim2.fromOffset(340, 104),
		Visible = false,
		ZIndex = 10,
	})
	scale = UI.new("UIScale", {}, panel)
	title = UI.label(panel, {
		Position = UDim2.fromOffset(14, 8),
		Size = UDim2.fromOffset(220, 18),
		Font = UI.Fonts.Title,
		TextSize = 12,
		TextWrapped = false,
		Text = "TRAINING",
		ZIndex = 11,
	})
	dots = {}
	for i = 1, Config.TrainReps do
		local dot = UI.new("Frame", {
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, -14 - (Config.TrainReps - i) * 16, 0, 11),
			Size = UDim2.fromOffset(11, 11),
			BackgroundColor3 = C.Disabled,
			ZIndex = 11,
		}, panel)
		UI.corner(dot, 7)
		dots[i] = dot
	end

	local barButton = UI.new("TextButton", {
		Position = UDim2.fromOffset(14, 32),
		Size = UDim2.new(1, -28, 0, 26),
		BackgroundColor3 = Color3.fromRGB(14, 11, 32),
		AutoButtonColor = false,
		Text = "",
		ZIndex = 11,
		ClipsDescendants = true,
	}, panel)
	UI.corner(barButton, 12)
	UI.stroke(barButton, C.Stroke, 1.5, 0.5)
	bar = barButton
	goodZone = UI.new("Frame", { BackgroundColor3 = C.Good, BackgroundTransparency = 0.35, BorderSizePixel = 0, ZIndex = 12 }, bar)
	perfectZone = UI.new("Frame", { BackgroundColor3 = C.Gold, BackgroundTransparency = 0.1, BorderSizePixel = 0, ZIndex = 13 }, bar)
	marker = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Size = UDim2.new(0, 6, 1, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
		ZIndex = 14,
	}, bar)
	UI.corner(marker, 3)
	barButton.Activated:Connect(press)

	message = UI.label(panel, {
		Position = UDim2.fromOffset(14, 62),
		Size = UDim2.new(1, -28, 0, 22),
		Font = UI.Fonts.Title,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
		ZIndex = 11,
	})
	msgScale = UI.new("UIScale", {}, message)
	hint = UI.label(panel, {
		Position = UDim2.fromOffset(14, 84),
		Size = UDim2.new(1, -60, 0, 14),
		Font = UI.Fonts.Body,
		TextSize = 10,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "SPACE / tap when the marker is in the gold zone",
		ZIndex = 11,
	})
	local cancel = UI.button(panel, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(22, 22),
		Text = "✕",
		TextSize = 10,
		ZIndex = 12,
		Radius = 11,
	}, "card")
	cancel.Activated:Connect(function()
		Action:FireServer("TrainCancel")
	end)

	-- Space is "swallowed" while training so the character doesn't jump away.
	ContextActionService:BindActionAtPriority("GlowTrainPress", function(_, state)
		if active then
			if state == Enum.UserInputState.Begin then
				press()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)

	RunService.RenderStepped:Connect(function()
		if not active or not cfg then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < cfg.startedAt then
			marker.Position = UDim2.fromScale(0, 0)
			if resultText then
				message.Text = resultText
				message.TextColor3 = resultColor
			else
				message.Text = string.format("GET READY  %.1f", cfg.startedAt - now)
				message.TextColor3 = C.Muted
			end
			return
		end
		resultText = nil
		if pressed then
			marker.Position = UDim2.fromScale(frozenPos, 0)
		else
			message.Text = "NOW!"
			message.TextColor3 = C.Text
			marker.Position = UDim2.fromScale(Util.tri((now - cfg.startedAt) * cfg.speed), 0)
		end
	end)
end

local function setDots(upTo, grade)
	if grade then
		dots[upTo].BackgroundColor3 = GRADE[grade].color
	end
end

local function loadCfg(newCfg)
	cfg = newCfg
	pressed = false
	if cfg then
		layoutZones()
	end
end

function TrainingUI.start(statId, firstCfg)
	stat = statId
	local def = Config.Stats[statId]
	active = true
	resultText = nil
	title.Text = def.Icon .. "  " .. def.Station .. " TRAINING"
	title.TextColor3 = def.Color
	for _, dot in dots do
		dot.BackgroundColor3 = C.Disabled
	end
	loadCfg(firstCfg)
	panel.Visible = true
	UI.pop(scale, 0.92)
end

function TrainingUI.rep(repIndex, grade, gain, streak, nextCfg)
	local g = GRADE[grade]
	if not g then
		return
	end
	setDots(repIndex, grade)
	local def = Config.Stats[stat]
	if grade == "miss" then
		resultText = "MISS"
		Audio.error()
	else
		resultText = string.format("%s  +%.1f %s", g.text, gain, def and def.Name or "")
		if grade == "perfect" then
			Audio.pickup(8 + math.min(streak, 6), 3)
			Fx.punch(3)
		else
			Audio.pickup(3, 1)
		end
	end
	resultColor = g.color
	message.Text = resultText
	message.TextColor3 = resultColor
	UI.pop(msgScale, 1.2)
	if nextCfg then
		loadCfg(nextCfg)
	end
end

function TrainingUI.finish(statId, total)
	active = false
	cfg = nil
	if statId and total and total > 0 then
		local def = Config.Stats[statId]
		Toasts.push(string.format("%s +%.1f %s", def.Icon, total, def.Name), "good")
		Audio.quest()
	end
	task.delay(statId and 1.2 or 0, function()
		if not active then
			panel.Visible = false
		end
	end)
end

return TrainingUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="67">
            <Properties>
              <string name="Name">Tutorial</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the first-time tutorial card and the bouncing arrow that points at where to go.
-- It reads the TutStep attribute from the server (7 = finished). Players can skip it.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local Tutorial = {}

local player = Players.LocalPlayer
local C = UI.Colors
local DONE = #Config.Tutorial + 1

local card, title, body, bar, countLabel, scale
local pointer, pointerGui
local shownStep = 0

-- Where the arrow should point for each step (nil = no arrow).
local function target(step)
	if step == 2 then
		return Config.HammerPos(2) + Vector3.new(0, 11, 0)
	elseif step == 3 then
		local pos, front = Config.StationPos("Gym"), Config.StationFront("Gym")
		return pos + front * 7 + Vector3.new(0, 8, 0)
	elseif step == 5 then
		return Config.BattlePos() + Config.BattleFront() * 30 + Vector3.new(0, 10, 0)
	end
	return nil
end

local function ensurePointer()
	if pointer then
		return
	end
	pointer = UI.new("Part", {
		Name = "TutorialPointer",
		Size = Vector3.one,
		Transparency = 1,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, workspace)
	pointerGui = UI.new("BillboardGui", {
		Adornee = pointer,
		Size = UDim2.fromOffset(120, 90),
		AlwaysOnTop = true,
		MaxDistance = 400,
	}, pointer)
	UI.label(pointerGui, {
		Size = UDim2.new(1, 0, 0, 24),
		Font = UI.Fonts.Title,
		TextSize = 18,
		TextColor3 = C.Yellow,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = "GO HERE",
	})
	UI.label(pointerGui, {
		Position = UDim2.fromOffset(0, 22),
		Size = UDim2.new(1, 0, 0, 60),
		Font = UI.Fonts.Title,
		TextSize = 54,
		TextColor3 = C.Yellow,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = "▼",
	})
end

local function show(step)
	local def = Config.Tutorial[step]
	if not def then
		card.Visible = false
		if pointer then
			pointer.Parent = nil
		end
		return
	end
	card.Visible = true
	title.Text = string.format("TUTORIAL %d/%d  ·  %s", step, #Config.Tutorial, def.Title:upper())
	body.Text = def.Text
	bar.back.Visible = def.Goal ~= nil
	countLabel.Visible = def.Goal ~= nil
	if step ~= shownStep then
		shownStep = step
		UI.pop(scale, 1.1)
		if step == 1 then
			Audio.say("welcome")
		else
			Audio.say("nice")
		end
		Audio.quest()
	end
	local at = target(step)
	if at then
		ensurePointer()
		pointer.Parent = workspace
		pointer.Position = at
	elseif pointer then
		pointer.Parent = nil
	end
end

function Tutorial.init(gui, Action)
	card = UI.panel(gui, {
		Name = "TutorialCard",
		AnchorPoint = Vector2.new(0, 0),
		Position = UDim2.new(0, 84, 0.5, -185),
		Size = UDim2.fromOffset(250, 126),
		Visible = false,
		Radius = 12,
	})
	card:FindFirstChildOfClass("UIStroke").Color = C.Yellow
	scale = UI.new("UIScale", {}, card)
	title = UI.label(card, {
		Position = UDim2.fromOffset(10, 6),
		Size = UDim2.new(1, -20, 0, 16),
		Font = UI.Fonts.Title,
		TextSize = 11,
		TextColor3 = C.Yellow,
		TextWrapped = false,
		Text = "",
	})
	body = UI.label(card, {
		Position = UDim2.fromOffset(10, 24),
		Size = UDim2.new(1, -20, 0, 66),
		Font = UI.Fonts.Bold,
		TextSize = 12,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
	})
	bar = UI.bar(card, { Position = UDim2.new(0, 10, 1, -26), Size = UDim2.new(1, -90, 0, 8) }, C.Good)
	countLabel = UI.label(card, {
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(1, -78, 1, -22),
		Size = UDim2.fromOffset(30, 14),
		Font = UI.Fonts.Title,
		TextSize = 11,
		TextColor3 = C.Good,
		TextWrapped = false,
		Text = "",
	})
	local skip = UI.button(card, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -8, 1, -6),
		Size = UDim2.fromOffset(46, 20),
		BackgroundColor3 = C.Disabled,
		Text = "SKIP",
		TextSize = 10,
		Radius = 6,
	}, "card")
	skip.Activated:Connect(function()
		Audio.click()
		Action:FireServer("TutorialSkip")
	end)

	local lastStep = 0
	local t0 = os.clock()
	RunService.Heartbeat:Connect(function()
		local step = player:GetAttribute("TutStep") or DONE
		if step ~= lastStep then
			lastStep = step
			show(step)
		end
		if step < DONE then
			local goal = player:GetAttribute("TutGoal") or 0
			if goal > 0 then
				local progress = player:GetAttribute("TutProgress") or 0
				bar.set(progress / goal)
				countLabel.Text = progress .. "/" .. goal
			end
			if pointer and pointer.Parent then
				local at = target(step)
				if at then
					pointer.Position = at + Vector3.new(0, math.sin((os.clock() - t0) * 4) * 1.2, 0)
				end
			end
		end
	end)
end

-- True while the tutorial is still running (the HUD hides the quest so the screen stays simple).
function Tutorial.active()
	return (player:GetAttribute("TutStep") or DONE) < DONE
end

return Tutorial
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="68">
            <Properties>
              <string name="Name">WorldTags</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: floating signs over every building and treadmill that show what it costs, what it gives and
-- whether you own it. They are different for each player, so they are drawn here instead of in the world.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))

local WorldTags = {}

local player = Players.LocalPlayer
local C = UI.Colors
local anchors = {} -- kept so the signs have something to attach to
local buildingTags = {} -- id -> { status, stroke }
local treadTags = {} -- id -> { status, stroke }

local function owned(attr, fallback)
	local set = {}
	for key in string.gmatch(player:GetAttribute(attr) or fallback, "[%w_]+") do
		set[tonumber(key) or key] = true
	end
	return set
end

local function anchorAt(position)
	local part = UI.new("Part", {
		Name = "TagAnchor",
		Size = Vector3.one,
		Position = position,
		Transparency = 1,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, workspace)
	table.insert(anchors, part)
	return part
end

local function makeTag(adornee, offset, width, height, maxDistance)
	local gui = UI.new("BillboardGui", {
		Adornee = adornee,
		Size = UDim2.fromOffset(width, height),
		StudsOffset = offset,
		AlwaysOnTop = false,
		MaxDistance = maxDistance,
		LightInfluence = 0,
		ResetOnSpawn = false,
	}, player:WaitForChild("PlayerGui"))
	local frame = UI.panel(gui, { Size = UDim2.fromScale(1, 1), Radius = 10 })
	return frame, frame:FindFirstChildOfClass("UIStroke")
end

local function line(frame, y, h, size, color, text, font)
	return UI.label(frame, {
		Position = UDim2.fromOffset(4, y),
		Size = UDim2.new(1, -8, 0, h),
		Font = font or UI.Fonts.Title,
		TextSize = size,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0.3,
		Text = text,
	})
end

local function buildBuildingTags()
	for _, id in Config.BuildingOrder do
		local def = Config.Buildings[id]
		local at = Config.BuildingPos[id]()
		local height = (id == "stage" or id == "battle") and 40 or (id == "treadmills" and 28 or 22)
		local frame, stroke = makeTag(anchorAt(at + Vector3.new(0, height, 0)), Vector3.zero, 150, 38, 95)
		line(frame, 3, 18, 13, def.Main:Lerp(Color3.new(1, 1, 1), 0.4), def.Name:upper())
		local status = line(frame, 22, 20, 15, C.Yellow, "")
		buildingTags[id] = { status = status, stroke = stroke, def = def }
	end
end

local function buildTreadTags(row)
	for _, t in Config.Treadmills do
		local frame, stroke = makeTag(anchorAt(Config.TreadPos(t.Id) + Vector3.new(0, 12.5, 0)), Vector3.zero, 90, 36, 38)
		line(frame, 3, 22, 18, t.Color, "+" .. Util.fmt(t.Rate) .. "/s")
		local status = line(frame, 25, 16, 12, C.Yellow, "")
		treadTags[t.Id] = { status = status, stroke = stroke, def = t }
	end
end

local function refresh()
	local aura = player:GetAttribute("Aura") or 0
	local own = owned("Own", "gym")
	for id, tag in buildingTags do
		if own[id] then
			tag.status.Text = tag.def.Cost == 0 and "FREE" or "UNLOCKED"
			tag.status.TextColor3 = C.Good
			tag.stroke.Color = tag.def.Main
		else
			tag.status.Text = "🔒 🏆 " .. Util.fmt(tag.def.Cost)
			local can = aura >= tag.def.Cost
			tag.status.TextColor3 = can and C.Yellow or C.Danger
			tag.stroke.Color = can and C.Gold or C.Stroke
		end
	end
	local treads = owned("Treads", "1")
	local running = player:GetAttribute("Running") or 0
	for id, tag in treadTags do
		if running == id then
			tag.status.Text = "RUNNING"
			tag.status.TextColor3 = C.Mint
			tag.stroke.Color = C.Mint
		elseif treads[id] then
			tag.status.Text = "OWNED"
			tag.status.TextColor3 = C.Sky
			tag.stroke.Color = tag.def.Color
		else
			tag.status.Text = "🔒 🏆 " .. Util.fmt(tag.def.Price)
			local can = aura >= tag.def.Price
			tag.status.TextColor3 = can and C.Yellow or C.Danger
			tag.stroke.Color = can and C.Gold or C.Stroke
		end
	end
end

function WorldTags.init()
	buildBuildingTags()
	buildTreadTags()
	refresh()
	task.spawn(function()
		while true do
			task.wait(0.4)
			refresh()
		end
	end)
end

return WorldTags
]]></string>
            </Properties>
          </Item>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="69">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>