          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">CompetitionUI</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: Mog Competition overlay. Everyone on stage flexes (taps) for 8 seconds; a live
-- leaderboard shows who's ahead, then the final placings and your reward.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local CompetitionUI = {}

local C = UI.Colors
local Action
local root, title, center, tapButton, tapScale, listFrame, rows, resultPanel, resultTitle, resultBody
local comp -- { tStart, length, myTaps, lastTick, started }
local pendingSend, lastSend = 0, 0

local function tap()
	if not comp then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < comp.tStart or now > comp.tStart + comp.length then
		return
	end
	comp.myTaps += 1
	pendingSend += 1
	Audio.play("Tone", 0.9 + (comp.myTaps % 8) * 0.07, 0.35)
	UI.pop(tapScale, 0.93)
end

function CompetitionUI.init(gui, action)
	Action = action
	root = UI.new("Frame", {
		Name = "Competition",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
	}, gui)

	title = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(420, 26),
		Font = UI.Fonts.Title,
		TextSize = 18,
		TextColor3 = C.Gold,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "🏆 MOG COMPETITION",
		ZIndex = 31,
	})
	center = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(400, 70),
		Font = UI.Fonts.Title,
		TextSize = 56,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
		ZIndex = 32,
	})

	-- Live leaderboard (right side)
	listFrame = UI.panel(root, {
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, -20),
		Size = UDim2.fromOffset(190, 190),
		ZIndex = 31,
	})
	UI.label(listFrame, {
		Position = UDim2.fromOffset(10, 5),
		Size = UDim2.new(1, -20, 0, 16),
		Font = UI.Fonts.Title,
		TextSize = 11,
		TextWrapped = false,
		Text = "LIVE RANKING",
		ZIndex = 32,
	})
	rows = {}
	for i = 1, 6 do
		local row = UI.new("Frame", {
			Position = UDim2.fromOffset(8, 26 + (i - 1) * 26),
			Size = UDim2.new(1, -16, 0, 22),
			BackgroundColor3 = C.Card,
			ZIndex = 32,
		}, listFrame)
		UI.corner(row, 8)
		local fill = UI.new("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = C.Accent,
			BackgroundTransparency = 0.35,
			BorderSizePixel = 0,
			ZIndex = 32,
		}, row)
		UI.corner(fill, 8)
		local label = UI.label(row, {
			Position = UDim2.fromOffset(8, 0),
			Size = UDim2.new(1, -16, 1, 0),
			Font = UI.Fonts.Bold,
			TextSize = 10,
			TextWrapped = false,
			Text = "",
			ZIndex = 34,
		})
		rows[i] = { row = row, fill = fill, label = label }
	end

	tapButton = UI.button(root, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(180, 64),
		Text = "FLEX!",
		TextSize = 28,
		ZIndex = 33,
		Radius = 16,
	}, "primary")
	tapScale = UI.new("UIScale", {}, tapButton)
	tapButton.Activated:Connect(tap)

	-- Results panel
	resultPanel = UI.panel(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(340, 270),
		Visible = false,
		ZIndex = 40,
	})
	resultTitle = UI.label(resultPanel, {
		Position = UDim2.fromOffset(14, 10),
		Size = UDim2.new(1, -28, 0, 34),
		Font = UI.Fonts.Title,
		TextSize = 22,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
		ZIndex = 41,
	})
	resultBody = UI.label(resultPanel, {
		Position = UDim2.fromOffset(18, 52),
		Size = UDim2.new(1, -36, 1, -100),
		Font = UI.Fonts.Bold,
		TextSize = 13,
		TextYAlignment = Enum.TextYAlignment.Top,
		Text = "",
		ZIndex = 41,
	})
	local close = UI.button(resultPanel, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -12),
		Size = UDim2.fromOffset(140, 34),
		Text = "CONTINUE",
		ZIndex = 42,
	}, "primary")
	close.Activated:Connect(function()
		Audio.click()
		root.Visible = false
		resultPanel.Visible = false
	end)

	ContextActionService:BindActionAtPriority("GlowCompTap", function(_, state)
		if comp then
			if state == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)

	RunService.RenderStepped:Connect(function()
		if not comp then
			return
		end
		local now = workspace:GetServerTimeNow()
		if now < comp.tStart then
			local left = math.ceil(comp.tStart - now)
			center.Text = tostring(left)
			center.TextColor3 = C.Gold
			if left ~= comp.lastTick then
				comp.lastTick = left
				Audio.countdown(false, left)
			end
			tapButton.BackgroundTransparency = 0.5
		elseif now <= comp.tStart + comp.length then
			if not comp.started then
				comp.started = true
				Audio.countdown(true)
				Fx.punch(6)
			end
			center.Text = "FLEX!"
			center.TextColor3 = C.Good
			tapButton.BackgroundTransparency = 0
			title.Text = string.format("🏆 MOG COMPETITION  ·  %.1fs", comp.tStart + comp.length - now)
		end
		if pendingSend > 0 and os.clock() - lastSend > 0.1 then
			Action:FireServer("CompTaps", pendingSend)
			pendingSend = 0
			lastSend = os.clock()
		end
	end)
end

local function drawRoster(list)
	local top = 1
	for _, e in list do
		top = math.max(top, e.t or 0)
	end
	for i, ref in rows do
		local e = list[i]
		ref.row.Visible = e ~= nil
		if e then
			ref.label.Text = string.format("%d.  %s", i, e.n)
			ref.label.TextColor3 = e.m and C.Gold or C.Text
			ref.fill.Size = UDim2.fromScale(math.clamp((e.t or 0) / math.max(top, 20), 0, 1), 1)
			ref.fill.BackgroundColor3 = e.m and C.Gold or C.Accent
		end
	end
end

function CompetitionUI.start(tStart, length, roster)
	comp = { tStart = tStart, length = length, myTaps = 0, lastTick = 0 }
	pendingSend = 0
	local list = {}
	for _, e in roster do
		table.insert(list, { n = e.n, t = 0, m = e.m })
	end
	drawRoster(list)
	title.Text = "🏆 MOG COMPETITION"
	resultPanel.Visible = false
	tapButton.Visible = true
	listFrame.Visible = true
	center.Text = ""
	root.Visible = true
end

function CompetitionUI.progress(list)
	if comp then
		drawRoster(list)
	end
end

function CompetitionUI.finish(place, total, aura, winner, summary)
	if pendingSend > 0 then
		Action:FireServer("CompTaps", pendingSend)
		pendingSend = 0
	end
	comp = nil
	tapButton.Visible = false
	listFrame.Visible = false
	center.Text = ""
	title.Text = "🏆 MOG COMPETITION"
	local lines = {}
	for i, e in summary do
		table.insert(lines, string.format("%d.  %s  —  %d pts", i, e.n, e.p))
	end
	resultTitle.Text = winner and "YOU WON! 👑" or string.format("YOU PLACED #%d OF %d", place, total)
	resultTitle.TextColor3 = winner and C.Gold or C.Cyan
	resultBody.Text = table.concat(lines, "\n") .. string.format("\n\nReward: +✦%s Aura%s", Util.fmt(aura), winner and "  +  a free crate" or "")
	resultPanel.Visible = true
	if winner then
		Audio.win()
		Fx.flash(C.Gold, 0.4, 0.8)
		Fx.shake(0.5, 0.6)
	else
		Audio.lose()
	end
end

return CompetitionUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">DuelUI</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: duel overlay. Both sides tap as fast as they can for 7 seconds; Mog Power gives an
-- edge but speed can upset a higher rank. Win or lose, you always get rewarded.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))
local Fx = require(script.Parent.Fx)

local DuelUI = {}

local player = Players.LocalPlayer
local C = UI.Colors
local Action
local root, myName, myInfo, oppName, oppInfo, myBar, oppBar, center, tapButton, tapScale, resultLabel
local duel -- { tStart, length, myTaps, oppTaps, sent, lastTickSecond }
local pendingSend = 0
local lastSend = 0

local function card(parent, anchorX, color)
	local c = UI.panel(parent, {
		AnchorPoint = Vector2.new(anchorX, 0),
		Position = UDim2.new(anchorX, anchorX == 0 and 12 or -12, 0, 8),
		Size = UDim2.fromOffset(190, 52),
		ZIndex = 31,
	})
	c:FindFirstChildOfClass("UIStroke").Color = color
	local name = UI.label(c, {
		Position = UDim2.fromOffset(12, 5),
		Size = UDim2.new(1, -24, 0, 20),
		Font = UI.Fonts.Title,
		TextSize = 14,
		TextXAlignment = anchorX == 0 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = 32,
	})
	local info = UI.label(c, {
		Position = UDim2.fromOffset(12, 28),
		Size = UDim2.new(1, -24, 0, 18),
		Font = UI.Fonts.Bold,
		TextSize = 10,
		TextColor3 = C.Muted,
		TextXAlignment = anchorX == 0 and Enum.TextXAlignment.Left or Enum.TextXAlignment.Right,
		TextWrapped = false,
		ZIndex = 32,
	})
	return name, info
end

local function tap()
	if not duel then
		return
	end
	local now = workspace:GetServerTimeNow()
	if now < duel.tStart or now > duel.tStart + duel.length then
		return
	end
	duel.myTaps += 1
	pendingSend += 1
	Audio.play("Tone", 0.9 + (duel.myTaps % 8) * 0.07, 0.35)
	UI.pop(tapScale, 0.93)
end

function DuelUI.init(gui, action)
	Action = action
	root = UI.new("Frame", {
		Name = "Duel",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Visible = false,
		ZIndex = 30,
	}, gui)
	myName, myInfo = card(root, 0, C.Cyan)
	oppName, oppInfo = card(root, 1, C.Accent2)

	local bars = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(280, 36),
		BackgroundTransparency = 1,
		ZIndex = 31,
	}, root)
	myBar = UI.bar(bars, { Position = UDim2.fromOffset(0, 2), Size = UDim2.new(1, 0, 0, 12) }, C.Sky)
	oppBar = UI.bar(bars, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 12) }, C.Pink)

	center = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.32),
		Size = UDim2.fromOffset(400, 70),
		Font = UI.Fonts.Title,
		TextSize = 56,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0.2,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = "",
		ZIndex = 32,
	})
	resultLabel = UI.label(root, {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.43),
		Size = UDim2.fromOffset(520, 40),
		Font = UI.Fonts.Bold,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Center,
		Text = "",
		ZIndex = 32,
	})

	tapButton = UI.button(root, {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -24),
		Size = UDim2.fromOffset(180, 64),
		Text = "TAP!",
		TextSize = 28,
		ZIndex = 33,
		Radius = 16,
	}, "primary")
	tapButton.Font = UI.Fonts.Title
	tapScale = UI.new("UIScale", {}, tapButton)
	tapButton.Activated:Connect(tap)

	ContextActionService:BindActionAtPriority("GlowDuelTap", function(_, state)
		if duel then
			if state == Enum.UserInputState.Begin then
				tap()
			end
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.Space)

	RunService.RenderStepped:Connect(function()
		if not duel then
			return
		end
		local now = workspace:GetServerTimeNow()
		local maxTaps = Config.Duel.MaxTapsPerSecond * duel.length
		myBar.set(duel.myTaps / maxTaps * 2.2)
		oppBar.set(duel.oppTaps / maxTaps * 2.2)

		if now < duel.tStart then
			local left = math.ceil(duel.tStart - now)
			center.Text = tostring(left)
			center.TextColor3 = C.Gold
			if left ~= duel.lastTick then
				duel.lastTick = left
				Audio.countdown(false, left)
			end
			tapButton.BackgroundTransparency = 0.5
		elseif now <= duel.tStart + duel.length then
			if not duel.started then
				duel.started = true
				Audio.countdown(true)
				Fx.punch(6)
			end
			center.Text = "TAP!"
			center.TextColor3 = C.Good
			tapButton.BackgroundTransparency = 0
			local remaining = duel.tStart + duel.length - now
			resultLabel.Text = string.format("%.1fs", remaining)
			resultLabel.TextColor3 = C.Text
		end

		if pendingSend > 0 and os.clock() - lastSend > 0.1 then
			Action:FireServer("DuelTaps", pendingSend)
			pendingSend = 0
			lastSend = os.clock()
		end
	end)
end

function DuelUI.start(oppNameText, oppRank, oppScore, myScore, tStart, length)
	local myRank = Config.Ranks[player:GetAttribute("Rank") or 1]
	local opp = Config.Ranks[oppRank] or Config.Ranks[1]
	myName.Text = player.DisplayName
	myName.TextColor3 = myRank.Color
	myInfo.Text = string.format("%s  ·  POWER %s", myRank.Name:upper(), Util.fmt(myScore))
	oppName.Text = oppNameText
	oppName.TextColor3 = opp.Color
	oppInfo.Text = string.format("%s  ·  POWER %s", opp.Name:upper(), Util.fmt(oppScore))
	duel = { tStart = tStart, length = length, myTaps = 0, oppTaps = 0, lastTick = 0 }
	pendingSend = 0
	resultLabel.Text = ""
	tapButton.Visible = true
	root.Visible = true
end

function DuelUI.progress(oppTaps)
	if duel then
		duel.oppTaps = oppTaps
	end
end

function DuelUI.finish(win, given, myTaps, oppTaps, myEff, oppEff, streak)
	if not duel then
		return
	end
	if pendingSend > 0 then
		Action:FireServer("DuelTaps", pendingSend)
		pendingSend = 0
	end
	duel.oppTaps = oppTaps
	tapButton.Visible = false
	if win then
		center.Text = "MOG!"
		center.TextColor3 = C.Gold
		Audio.win()
		Fx.flash(C.Gold, 0.4, 0.8)
		Fx.shake(0.5, 0.6)
		resultLabel.Text = string.format("You out-glowed %s   ·   +✦%s%s", oppName.Text, Util.fmt(given), streak > 1 and ("   ·   🔥 streak " .. streak) or "")
	else
		center.Text = "RESPECT"
		center.TextColor3 = C.Cyan
		Audio.lose()
		resultLabel.Text = string.format("%s took this one   ·   still earned +✦%s", oppName.Text, Util.fmt(given))
	end
	resultLabel.TextColor3 = C.Text
	local finished = duel
	duel = nil
	task.delay(3.6, function()
		if duel == nil then
			root.Visible = false
		end
	end)
	return finished
end

return DuelUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Fx</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: game-feel effects. Camera punch/shake, floating text, particle bursts and the big
-- centred callouts. Everything respects the "Effects" setting so players can tone it down.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))

local Fx = {}

local player = Players.LocalPlayer
local camera = workspace:WaitForChild("Camera")
local gui
local baseFov, targetFov = 70, 70
local fovKick = 0
local shakeMag, shakeTime = 0, 0
local flashFrame

local function effectsOn()
	return player:GetAttribute("Set_Fx") ~= false
end

function Fx.init(screenGui)
	gui = screenGui
	flashFrame = UI.new("Frame", {
		Name = "Flash",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ZIndex = 90,
		Active = false,
	}, gui)

	RunService.RenderStepped:Connect(function(dt)
		fovKick = fovKick * (1 - math.min(1, dt * 12))
		baseFov += (targetFov - baseFov) * math.min(1, dt * 4)
		camera.FieldOfView = baseFov + fovKick
		local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if hum then
			if shakeTime > 0 and effectsOn() then
				shakeTime -= dt
				local m = shakeMag * math.clamp(shakeTime / 0.3, 0, 1)
				hum.CameraOffset = Vector3.new((math.random() - 0.5) * m, (math.random() - 0.5) * m, 0)
			else
				shakeMag = 0
				shakeTime = 0
				hum.CameraOffset = Vector3.zero
			end
		end
	end)
end

-- The zone cameras change the resting field of view through this.
function Fx.setBaseFov(fov)
	targetFov = fov or 70
end

function Fx.punch(amount)
	if effectsOn() then
		fovKick = math.max(fovKick, amount)
	end
end

function Fx.shake(mag, dur)
	if effectsOn() then
		shakeMag = math.max(shakeMag, mag)
		shakeTime = math.max(shakeTime, dur)
	end
end

function Fx.flash(color, strength, dur)
	if not effectsOn() or not flashFrame then
		return
	end
	flashFrame.BackgroundColor3 = color
	flashFrame.BackgroundTransparency = 1 - strength
	UI.tween(flashFrame, dur or 0.5, { BackgroundTransparency = 1 })
end

local function anchorAt(pos, lifetime)
	local anchor = UI.new("Part", {
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 1,
		Size = Vector3.one * 0.1,
		Position = pos,
	}, workspace)
	Debris:AddItem(anchor, lifetime)
	return anchor
end

-- Rising number in the world. Only used for notable pickups so the screen stays calm.
function Fx.floatText(pos, text, color, size)
	if not effectsOn() then
		return
	end
	local anchor = anchorAt(pos + Vector3.new((math.random() - 0.5) * 2, 0, (math.random() - 0.5) * 2), 1.3)
	local bb = UI.new("BillboardGui", {
		Adornee = anchor,
		AlwaysOnTop = true,
		Size = UDim2.fromOffset(240, size + 10),
	}, anchor)
	local label = UI.label(bb, {
		Size = UDim2.fromScale(1, 1),
		Font = UI.Fonts.Title,
		TextSize = size,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.25,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = text,
		TextWrapped = false,
	})
	local grow = UI.new("UIScale", { Scale = 0.4 }, label)
	UI.tween(grow, 0.18, { Scale = 1 }, Enum.EasingStyle.Back)
	UI.tween(bb, 1.1, { StudsOffset = Vector3.new(0, 6, 0) })
	UI.tween(label, 1.1, { TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
end

function Fx.burst(pos, color, count)
	if not effectsOn() then
		return
	end
	local anchor = anchorAt(pos, 1.5)
	local e = UI.new("ParticleEmitter", {
		Color = ColorSequence.new(color),
		LightEmission = 1,
		Rate = 0,
		Lifetime = NumberRange.new(0.4, 0.8),
		Speed = NumberRange.new(10, 22),
		SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.7), NumberSequenceKeypoint.new(1, 0) }),
		Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }),
	}, anchor)
	e:Emit(count)
end

-- Expanding shockwave ring on the ground.
function Fx.ring(pos, color, radius)
	if not effectsOn() then
		return
	end
	local part = UI.new("Part", {
		Name = "FxRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.4, 2, 2),
		CFrame = CFrame.new(pos.X, pos.Y - 2.5, pos.Z) * CFrame.Angles(0, 0, math.pi / 2),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.2,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, workspace)
	local d = (radius or 24) * 2
	UI.tween(part, 0.55, { Size = Vector3.new(0.4, d, d), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(part, 0.7)
end

-- A tall beam of light that shoots up and fades (level-ups, big hatches).
function Fx.pillar(pos, color, height)
	if not effectsOn() then
		return
	end
	local h = height or 70
	local part = UI.new("Part", {
		Name = "FxPillar",
		Size = Vector3.new(5, h, 5),
		Position = Vector3.new(pos.X, pos.Y - 2.5 + h / 2, pos.Z),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Transparency = 0.45,
		Anchored = true,
		CanCollide = false,
		CanQuery = false,
		CanTouch = false,
	}, workspace)
	UI.tween(part, 0.9, { Size = Vector3.new(0.4, h, 0.4), Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	Debris:AddItem(part, 1)
end

-- Big centred callout. Reserved for moments that deserve it (rank ups, rebirths, combos).
function Fx.announce(title, sub, color, y)
	if not gui then
		return
	end
	local holder = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, y or 0.2, 0),
		Size = UDim2.fromOffset(520, 80),
		BackgroundTransparency = 1,
		ZIndex = 60,
	}, gui)
	local scale = UI.new("UIScale", { Scale = 0.3 }, holder)
	local t = UI.label(holder, {
		Size = UDim2.new(1, 0, 0, 44),
		Font = UI.Fonts.Title,
		TextSize = 38,
		TextColor3 = color,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.1,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = title,
		ZIndex = 60,
	})
	local s = UI.label(holder, {
		Position = UDim2.fromOffset(0, 46),
		Size = UDim2.new(1, 0, 0, 26),
		Font = UI.Fonts.Bold,
		TextSize = 17,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextStrokeTransparency = 0.3,
		TextStrokeColor3 = Color3.fromRGB(18, 10, 44),
		Text = sub or "",
		ZIndex = 60,
	})
	UI.tween(scale, 0.32, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.9, function()
		UI.tween(t, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		UI.tween(s, 0.5, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.6)
		holder:Destroy()
	end)
end

return Fx
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Guide</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the welcome guide. Shown once on a player's very first visit (and again from the ? button):
-- four short pages that explain the goal, how to earn Aura, how to spend it, and what every button is for.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local UI = require(Shared:WaitForChild("UI"))
local Audio = require(Shared:WaitForChild("Audio"))

local Guide = {}

local player = Players.LocalPlayer
local C = UI.Colors

local PAGES = {
	{
		icon = "👑",
		title = "WELCOME!",
		color = C.Yellow,
		lines = {
			"You start as a SUB 5: short, round and a bit weird.",
			"Level up to become TRUE ADAM.",
			"Your face, body and aura change with every level. Everyone gets their own face!",
		},
	},
	{
		icon = "🏆",
		title = "EARN AURA",
		color = C.Gold,
		lines = {
			"🔨 Click or tap anywhere to swing your hammer. Hold to keep swinging.",
			"🏃 Run on treadmills to earn Aura every second.",
			"🐾 Pets earn Aura for you and make every swing stronger.",
		},
	},
	{
		icon = "🛒",
		title = "SPEND AURA",
		color = C.Mint,
		lines = {
			"Buy bigger hammers at the Hammer Shop (the glowing pedestals).",
			"Hatch pets, unlock treadmills and open new buildings.",
			"Walk up to anything and press the big button at the bottom (or E).",
		},
	},
	{
		icon = "🎮",
		title = "THE BUTTONS",
		color = C.Sky,
		lines = {
			"LEFT: 🛒 Shop · 🔄 Rebirth · 🎁 Rewards · 🐾 Pets · 👗 Outfit",
			"RIGHT: 📍 Places (jump anywhere) · 📦 Crates",
			"TOP: 💎 Store · ⚙️ Settings · ❓ this guide",
			"Follow the yellow tutorial card and the arrow to get started!",
		},
	},
}

local window, iconLabel, titleLabel, bodyLabel, dots, backButton, nextButton
local page = 1
local Action

local function render()
	local p = PAGES[page]
	iconLabel.Text = p.icon
	titleLabel.Text = p.title
	titleLabel.TextColor3 = p.color
	window:FindFirstChildOfClass("UIStroke").Color = p.color
	bodyLabel.Text = table.concat(p.lines, "\n\n")
	backButton.Visible = page > 1
	nextButton.Text = page < #PAGES and "NEXT ▶" or "LET'S GO!"
	nextButton.BackgroundColor3 = page < #PAGES and C.Accent or C.Good
	for i, dot in dots do
		dot.BackgroundColor3 = i == page and p.color or C.Disabled
	end
end

function Guide.close()
	window.Visible = false
	if player:GetAttribute("GuideSeen") ~= true then
		Action:FireServer("GuideSeen")
	end
end

function Guide.open()
	page = 1
	render()
	window.Visible = true
	Audio.quest()
end

function Guide.init(gui, action)
	Action = action
	window = UI.panel(gui, {
		Name = "Guide",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(460, 330),
		Visible = false,
		ZIndex = 40,
		Radius = 16,
	})
	UI.new("UIScale", {}, window)
	local function fit()
		local v = workspace:WaitForChild("Camera").ViewportSize
		window:FindFirstChildOfClass("UIScale").Scale = math.clamp(math.min(v.X / 520, v.Y / 380), 0.6, 1)
	end
	fit()
	iconLabel = UI.label(window, {
		Position = UDim2.fromOffset(18, 14),
		Size = UDim2.fromOffset(60, 60),
		Font = UI.Fonts.Bold,
		TextSize = 44,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 1,
		ZIndex = 41,
		Text = "",
	})
	titleLabel = UI.label(window, {
		Position = UDim2.fromOffset(86, 22),
		Size = UDim2.new(1, -110, 0, 44),
		Font = UI.Fonts.Title,
		TextSize = 30,
		TextWrapped = false,
		ZIndex = 41,
		Text = "",
	})
	bodyLabel = UI.label(window, {
		Position = UDim2.fromOffset(24, 84),
		Size = UDim2.new(1, -48, 0, 170),
		Font = UI.Fonts.Bold,
		TextSize = 16,
		TextColor3 = Color3.new(1, 1, 1),
		TextYAlignment = Enum.TextYAlignment.Top,
		ZIndex = 41,
		Text = "",
	})
	dots = {}
	local dotRow = UI.new("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -62), Size = UDim2.fromOffset(#PAGES * 18, 10), BackgroundTransparency = 1, ZIndex = 41 }, window)
	UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, dotRow)
	for i = 1, #PAGES do
		local dot = UI.new("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(10, 10), BackgroundColor3 = C.Disabled, BorderSizePixel = 0, ZIndex = 42 }, dotRow)
		UI.corner(dot, 5)
		dots[i] = dot
	end
	backButton = UI.button(window, {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 18, 1, -14),
		Size = UDim2.fromOffset(110, 42),
		BackgroundColor3 = C.Disabled,
		Text = "◀ BACK",
		TextSize = 15,
		ZIndex = 42,
	}, "card")
	nextButton = UI.button(window, {
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -18, 1, -14),
		Size = UDim2.fromOffset(150, 42),
		Text = "NEXT ▶",
		TextSize = 16,
		ZIndex = 42,
	})
	local skip = UI.button(window, {
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -12, 0, 10),
		Size = UDim2.fromOffset(56, 22),
		BackgroundColor3 = C.Disabled,
		Text = "SKIP",
		TextSize = 11,
		ZIndex = 42,
		Radius = 7,
	}, "card")
	backButton.Activated:Connect(function()
		Audio.click()
		page = math.max(1, page - 1)
		render()
	end)
	nextButton.Activated:Connect(function()
		Audio.click()
		if page < #PAGES then
			page += 1
			render()
		else
			Guide.close()
		end
	end)
	skip.Activated:Connect(function()
		Audio.click()
		Guide.close()
	end)

	-- First visit: show it once everything has loaded.
	task.spawn(function()
		task.wait(1.2)
		if player:GetAttribute("GuideSeen") ~= true then
			Guide.open()
		end
	end)
end

return Guide
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">HammerRow</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: floating OWNED / EQUIPPED / price labels over every hammer pedestal.
-- They are different for each player, so they are drawn here instead of on the pedestal itself.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))

local HammerRow = {}

local player = Players.LocalPlayer
local C = UI.Colors
local tags = {} -- hammer id -> { frame, status, stroke }

local function ownedSet()
	local set = {}
	for n in string.gmatch(player:GetAttribute("HammersOwned") or "1", "%d+") do
		set[tonumber(n)] = true
	end
	return set
end

local function refresh()
	local set = ownedSet()
	local equipped = player:GetAttribute("Hammer") or 1
	local aura = player:GetAttribute("Aura") or 0
	for id, tag in tags do
		local hammer = Config.HammerById[id]
		if id == equipped then
			tag.status.Text = "EQUIPPED"
			tag.status.TextColor3 = C.Good
			tag.stroke.Color = C.Good
		elseif set[id] then
			tag.status.Text = "OWNED"
			tag.status.TextColor3 = C.Sky
			tag.stroke.Color = C.Sky
		else
			tag.status.Text = "🏆 " .. Util.fmt(hammer.Price)
			local affordable = aura >= hammer.Price
			tag.status.TextColor3 = affordable and C.Yellow or C.Danger
			tag.stroke.Color = affordable and C.Gold or C.Stroke
		end
	end
end

local function makeTag(pedestal, hammer)
	local gui = UI.new("BillboardGui", {
		Name = "HammerTag" .. hammer.Id,
		Adornee = pedestal,
		Size = UDim2.fromOffset(104, 60),
		StudsOffset = Vector3.new(0, 11.5, 0),
		AlwaysOnTop = false,
		MaxDistance = 42,
		LightInfluence = 0,
		ResetOnSpawn = false,
	}, player:WaitForChild("PlayerGui"))
	local frame = UI.panel(gui, { Size = UDim2.fromScale(1, 1), Radius = 10 })
	local stroke = frame:FindFirstChildOfClass("UIStroke")
	UI.label(frame, {
		Position = UDim2.fromOffset(4, 3),
		Size = UDim2.new(1, -8, 0, 14),
		Font = UI.Fonts.Bold,
		TextSize = 11,
		TextColor3 = C.Muted,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = hammer.Name,
	})
	UI.label(frame, {
		Position = UDim2.fromOffset(4, 17),
		Size = UDim2.new(1, -8, 0, 30),
		Font = UI.Fonts.Title,
		TextSize = 26,
		TextColor3 = hammer.Head,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		TextStrokeTransparency = 0,
		Text = "x" .. hammer.Mult,
	})
	local status = UI.label(frame, {
		Position = UDim2.fromOffset(4, 48),
		Size = UDim2.new(1, -8, 0, 20),
		Font = UI.Fonts.Title,
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false,
		Text = "",
	})
	tags[hammer.Id] = { frame = frame, status = status, stroke = stroke }
end

function HammerRow.init()
	task.spawn(function()
		local world = workspace:WaitForChild("GlowWorld", 30)
		local row = world and world:WaitForChild("HammerRow", 30)
		if not row then
			return
		end
		for _, child in row:GetChildren() do
			local id = child:GetAttribute("HammerId")
			if id and Config.HammerById[id] then
				makeTag(child, Config.HammerById[id])
			end
		end
		refresh()
		for _, attr in { "Hammer", "HammersOwned" } do
			player:GetAttributeChangedSignal(attr):Connect(refresh)
		end
		-- Aura changes constantly; re-check which hammers are affordable a few times a second.
		while true do
			task.wait(0.4)
			refresh()
		end
	end)
end

return HammerRow
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- SUB 5 TO TRUE ADAM: the always-on screen.
--   Top centre: hint banner, then Aura / Rebirths / multiplier pills, then small status chips.
--   Left edge: big icon buttons (Shop, Rebirth with %, Rewards, PVP, MOG).
--   Right edge: smaller buttons (Hammers, Pets, Wardrobe, Crates, Battle, Treadmills).
--   Bottom centre: the big Aura counter and the wide LEVEL bar. Bottom left: the current quest.
-- Every button is a normal on-screen button, so it works the same from any camera angle.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared:WaitForChild("Config"))
local UI = require(Shared:WaitForChild("UI"))
local Util = require(Shared:WaitForChild("Util"))
local Audio = require(Shared:WaitForChild("Audio"))

local Hud = {}

local player = Players.LocalPlayer
local camera = workspace:WaitForChild("Camera")
local C = UI.Colors

local refs: { [string]: any } = {}
local fitScales = {} -- one UIScale per HUD block, resized together for small screens
local shownAura = 0
local pending, lastGain = 0, 0
local lastAura = 0

local function tint(panel, color)
	local stroke = panel:FindFirstChildOfClass("UIStroke")
	if stroke then
		stroke.Color = color
	end
end

local function pill(parent, name, size, color)
	local frame = UI.panel(parent, { Name = name, Size = size, Radius = 10 })
	tint(frame, color)
	return frame
end

local function addFit(frame)
	table.insert(fitScales, UI.new("UIScale", {}, frame))
end

-- Moves the character somewhere (the buttons that jump you to a place).
local function teleport(position, lookAt)
	local char = player.Character
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if root then
		root.AssemblyLinearVelocity = Vector3.zero
		root.CFrame = CFrame.lookAt(position, Vector3.new(lookAt.X, position.Y, lookAt.Z))
	end
end

-- Places you can jump to from the 📍 button. `building` says which unlock it needs (nil = open to everyone).
local function atStation(name)
	return function()
		local pos, front = Config.StationPos(name), Config.StationFront(name)
		teleport(pos + front * 30 + Vector3.new(0, 4, 0), pos)
	end
end
local PLACES = {
	{ name = "Hammer Shop", icon = "🔨", go = function()
		teleport(Vector3.new(0, 4, Config.HammerRowZ + 10), Vector3.new(0, 4, Config.HammerRowZ - 30))
	end },
	{ name = "Treadmills", icon = "🏃", building = "treadmills", go = function()
		local cf = Config.TreadHallCF() * CFrame.new(0, 4, -34)
		teleport(cf.Position, Config.TreadHallPos())
	end },
	{ name = "Gym", icon = "💪", building = "gym", go = atStation("Gym") },
	{ name = "Stage Battle", icon = "⚔️", building = "battle", go = function()
		local pos, front = Config.BattlePos(), Config.BattleFront()
		teleport(pos + front * 40 + Vector3.new(0, 4, 0), pos)
	end },
	{ name = "Style Studio", icon = "💈", building = "studio", go = atStation("Studio") },
	{ name = "Mog Stage", icon = "🏆", building = "stage", go = function()
		teleport(Vector3.new(0, 5, 12), Vector3.new(0, 5, -20))
	end },
	{ name = "Charm Lounge", icon = "🛋️", building = "lounge", go = atStation("Lounge") },
	{ name = "Duel Ring", icon = "🥊", building = "ring", go = atStation("Ring") },
	{ name = "Crate Shop", icon = "📦", building = "crates", go = atStation("Crates") },
}

